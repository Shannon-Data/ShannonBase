##############################################################################
# ShannonBase test case ported from the HeatWave AutoML examples repository
#   https://github.com/ShannonBase/heatwave-ml
#   -> sql/table_classification_bank_marketing.sql
#   -> python/heatwave/classification_bank_marketing.ipynb
#      (python/mysqlai/classification_bank_marketing.ipynb is the same flow)
#
# Upstream flow:
#   ML_TRAIN with NULL options (the notebook relies on classification being
#   the default task) -> ML_MODEL_LOAD -> ML_SCORE('accuracy') in the notebook
#   and ML_SCORE('balanced_accuracy') in the benchmark script ->
#   ML_PREDICT_TABLE -> MODEL_CATALOG.model_explanation.
#
# Data: the UCI bank marketing set (bank-full.csv out of
# https://archive.ics.uci.edu/ml/machine-learning-databases/00222/bank.zip),
# preprocessed the way sql/preprocess.py does it - split 70/30 stratified on y
# with random_state=1 - after a 10000 row stratified downsample.
# See std_data/ml/README.txt.
# ShannonBase copyright 2023-
##############################################################################

# LightGBM prints this while growing trees whenever a split stops paying off,
# which the smaller benchmark frames hit routinely.  It is ordinary training
# chatter, not a server problem, so keep it out of the error-log check.
--disable_query_log
CALL mtr.add_suppression("\\[LightGBM\\] \\[Warning\\] No further splits with positive gain");
--enable_query_log

--disable_warnings
DROP DATABASE IF EXISTS ML_SCHEMA_root;

SET @saved_local_infile = @@GLOBAL.local_infile;
SET GLOBAL local_infile = 1;
DROP DATABASE IF EXISTS heatwaveml_bench;
CREATE DATABASE heatwaveml_bench;
ALTER DATABASE heatwaveml_bench CHARACTER SET ascii COLLATE ascii_bin;
USE heatwaveml_bench;
--enable_warnings

--echo ########################################################################
--echo # Upstream table definition (sql/table_classification_bank_marketing.sql).
--echo ########################################################################

CREATE TABLE bank_marketing_train (age INT, job VARCHAR(255), marital VARCHAR(255), education VARCHAR(255), default1 VARCHAR(255), balance FLOAT, housing VARCHAR(255), loan VARCHAR(255), contact VARCHAR(255), day INT, month VARCHAR(255), duration FLOAT, campaign INT, pdays FLOAT, previous FLOAT, poutcome VARCHAR(255), y VARCHAR(255));
CREATE TABLE bank_marketing_test LIKE bank_marketing_train;

--disable_query_log
--eval LOAD DATA INFILE '$MYSQLTEST_VARDIR/std_data/ml/bank_marketing/bank_marketing_train_load.csv' INTO TABLE bank_marketing_train FIELDS TERMINATED BY ',' OPTIONALLY ENCLOSED BY '"' ;
--eval LOAD DATA INFILE '$MYSQLTEST_VARDIR/std_data/ml/bank_marketing/bank_marketing_test_load.csv' INTO TABLE bank_marketing_test FIELDS TERMINATED BY ',' OPTIONALLY ENCLOSED BY '"' ;
ALTER TABLE bank_marketing_train ADD COLUMN id INT AUTO_INCREMENT NOT SECONDARY PRIMARY KEY FIRST;
ALTER TABLE bank_marketing_test ADD COLUMN id INT AUTO_INCREMENT NOT SECONDARY PRIMARY KEY FIRST;

ALTER TABLE bank_marketing_train SECONDARY_ENGINE = RAPID;
ALTER TABLE bank_marketing_test SECONDARY_ENGINE = RAPID;
--enable_query_log

SELECT y, count(*) AS rows_per_class FROM bank_marketing_train GROUP BY y ORDER BY y;

ALTER TABLE bank_marketing_train SECONDARY_LOAD;
ALTER TABLE bank_marketing_test SECONDARY_LOAD;

--echo ########################################################################
--echo # Train the model. The notebook passes NULL options and relies on
--echo # classification being the default task.
--echo ########################################################################
SET @model_bank = 'bank_marketing_bench_model';
CALL sys.ML_TRAIN('heatwaveml_bench.bank_marketing_train', 'y', NULL, @model_bank);

SELECT JSON_UNQUOTE(MODEL_METADATA->'$.task') AS task,
       JSON_UNQUOTE(MODEL_METADATA->'$.target_column_name') AS target
FROM ML_SCHEMA_root.MODEL_CATALOG WHERE MODEL_HANDLE = @model_bank;

--echo ########################################################################
--echo # Load the model into HeatWave.
--echo ########################################################################
CALL sys.ML_MODEL_LOAD(@model_bank, NULL);

--echo ########################################################################
--echo # Score the model on the test data.
--echo ########################################################################
CALL sys.ML_SCORE('heatwaveml_bench.bank_marketing_test', 'y', @model_bank, 'accuracy', @score_bank, NULL);
SELECT @score_bank >= 0.0 AND @score_bank <= 1.0 AS accuracy_in_range;

CALL sys.ML_SCORE('heatwaveml_bench.bank_marketing_test', 'y', @model_bank, 'balanced_accuracy', @bal_bank, NULL);
SELECT @bal_bank >= 0.0 AND @bal_bank <= 1.0 AS balanced_accuracy_in_range;

--echo ########################################################################
--echo # Generate predictions for the unseen test data (ML_PREDICT_TABLE).
--echo # The input table carries the model features only, so the target column
--echo # and the non-secondary primary key are projected away.
--echo ########################################################################
CREATE TABLE bank_marketing_predict_in AS
  SELECT age, job, marital, education, default1, balance, housing, loan, contact,
         day, month, duration, campaign, pdays, previous, poutcome
  FROM heatwaveml_bench.bank_marketing_test ORDER BY id LIMIT 10;

CALL sys.ML_PREDICT_TABLE('heatwaveml_bench.bank_marketing_predict_in', @model_bank,
                          'heatwaveml_bench.bank_marketing_test_predictions', NULL);
SELECT count(*) AS predicted_rows,
       count(prediction) AS non_null_predictions,
       count(ml_results) AS non_null_ml_results
FROM bank_marketing_test_predictions;
SELECT count(*) AS rows_with_probabilities FROM bank_marketing_test_predictions
WHERE JSON_EXTRACT(ml_results, '$.probabilities') IS NOT NULL;

--echo ########################################################################
--echo # The notebook reads MODEL_CATALOG.model_explanation and plots its
--echo # permutation_importance entry; ML_EXPLAIN populates that column.
--echo ########################################################################
SELECT MODEL_EXPLANATION IS NULL AS explanation_is_null_before_explain
FROM ML_SCHEMA_root.MODEL_CATALOG WHERE MODEL_HANDLE = @model_bank;

CALL sys.ML_EXPLAIN('heatwaveml_bench.bank_marketing_train', 'y', @model_bank,
                    JSON_OBJECT('model_explainer', 'permutation_importance'));
SELECT JSON_EXTRACT(MODEL_EXPLANATION, '$.permutation_importance') IS NOT NULL AS has_permutation_importance
FROM ML_SCHEMA_root.MODEL_CATALOG WHERE MODEL_HANDLE = @model_bank;

CALL sys.ML_MODEL_UNLOAD(@model_bank);

--echo ########################################################################
--echo # Cleanup
--echo ########################################################################
SET GLOBAL local_infile = @saved_local_infile;
DROP DATABASE IF EXISTS ML_SCHEMA_root;
ALTER TABLE bank_marketing_train SECONDARY_UNLOAD;
ALTER TABLE bank_marketing_test SECONDARY_UNLOAD;
DROP DATABASE heatwaveml_bench;
