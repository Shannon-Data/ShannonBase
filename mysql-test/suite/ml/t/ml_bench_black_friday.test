##############################################################################
# ShannonBase test case ported from the HeatWave AutoML examples repository
#   https://github.com/ShannonBase/heatwave-ml
#   -> sql/table_regression_black_friday.sql
#
# Upstream flow:
#   CREATE train/test tables -> ML_TRAIN(regression) -> ML_MODEL_LOAD
#   -> ML_SCORE('r2') -> SELECT the score.
#
# Upstream is a performance benchmark (it times ML_TRAIN across cluster sizes),
# so this port keeps the API sequence but asserts shapes and ranges instead of
# timings or exact scores, which are not reproducible across LightGBM builds.
#
# Data: the OpenML Black Friday set
# (https://www.openml.org/data/get_csv/21230845/file639340bd9ca9.arff),
# split 70/30 unstratified as upstream does.
# 10000 of 166821 purchases.
# See std_data/ml/README.txt.
# ShannonBase copyright 2023-
##############################################################################

# LightGBM prints this while growing trees whenever a split stops paying off,
# which the smaller benchmark frames hit routinely.  It is ordinary training
# chatter, not a server problem, so keep it out of the error-log check.
--disable_query_log
CALL mtr.add_suppression("\\[LightGBM\\] \\[Warning\\] No further splits with positive gain");
CALL mtr.add_suppression("\\[LightGBM\\] \\[Warning\\] There are no meaningful features");
CALL mtr.add_suppression("\\[LightGBM\\] \\[Warning\\] Stopped training because there are no more leaves");
--enable_query_log

--disable_warnings
DROP DATABASE IF EXISTS ML_SCHEMA_root;

SET @saved_local_infile = @@GLOBAL.local_infile;
SET GLOBAL local_infile = 1;
DROP DATABASE IF EXISTS heatwaveml_bench;
CREATE DATABASE heatwaveml_bench;
ALTER DATABASE heatwaveml_bench CHARACTER SET ascii COLLATE ascii_bin;
USE heatwaveml_bench;
--enable_warnings

--echo ########################################################################
--echo # Upstream table definition (sql/table_regression_black_friday.sql).
--echo ########################################################################
--disable_query_log
CREATE TABLE black_friday_train (Gender VARCHAR(255), Age VARCHAR(255), Occupation VARCHAR(255), City_Category VARCHAR(255), Stay_In_Current_City_Years VARCHAR(255), Marital_Status VARCHAR(255), Product_Category_1 VARCHAR(255), Product_Category_2 VARCHAR(255), Product_Category_3 VARCHAR(255), Purchase FLOAT);
CREATE TABLE black_friday_test LIKE black_friday_train;

--eval LOAD DATA INFILE '$MYSQLTEST_VARDIR/std_data/ml/black_friday/black_friday_train_load.csv' INTO TABLE black_friday_train FIELDS TERMINATED BY ',' OPTIONALLY ENCLOSED BY '"' ;
--eval LOAD DATA INFILE '$MYSQLTEST_VARDIR/std_data/ml/black_friday/black_friday_test_load.csv' INTO TABLE black_friday_test FIELDS TERMINATED BY ',' OPTIONALLY ENCLOSED BY '"' ;
ALTER TABLE black_friday_train ADD COLUMN id INT AUTO_INCREMENT NOT SECONDARY PRIMARY KEY FIRST;
ALTER TABLE black_friday_test ADD COLUMN id INT AUTO_INCREMENT NOT SECONDARY PRIMARY KEY FIRST;

ALTER TABLE black_friday_train SECONDARY_ENGINE = RAPID;
ALTER TABLE black_friday_test SECONDARY_ENGINE = RAPID;
--enable_query_log

SELECT count(*) AS train_rows, round(avg(Purchase)) AS mean_purchase FROM black_friday_train;

ALTER TABLE black_friday_train SECONDARY_LOAD;
ALTER TABLE black_friday_test SECONDARY_LOAD;

--echo ########################################################################
--echo # Train the model.
--echo ########################################################################
SET @model_black_friday = 'black_friday_bench_model';
CALL sys.ML_TRAIN('heatwaveml_bench.black_friday_train', 'Purchase', JSON_OBJECT('task', 'regression'), @model_black_friday);

SELECT JSON_UNQUOTE(MODEL_METADATA->'$.task') AS task,
       JSON_UNQUOTE(MODEL_METADATA->'$.target_column_name') AS target,
       JSON_LENGTH(MODEL_METADATA->'$.column_names') AS feature_count
FROM ML_SCHEMA_root.MODEL_CATALOG WHERE MODEL_HANDLE = @model_black_friday;

CALL sys.ML_MODEL_LOAD(@model_black_friday, NULL);

--echo ########################################################################
--echo # Score the model on the held out rows.
--echo ########################################################################
CALL sys.ML_SCORE('heatwaveml_bench.black_friday_test', 'Purchase', @model_black_friday, 'r2', @score_black_friday, NULL);
SELECT @score_black_friday IS NOT NULL AND @score_black_friday <= 1.0 AS r2_in_range;

CALL sys.ML_MODEL_UNLOAD(@model_black_friday);

--echo ########################################################################
--echo # Cleanup
--echo ########################################################################
SET GLOBAL local_infile = @saved_local_infile;
DROP DATABASE IF EXISTS ML_SCHEMA_root;
ALTER TABLE black_friday_train SECONDARY_UNLOAD;
ALTER TABLE black_friday_test SECONDARY_UNLOAD;
DROP DATABASE heatwaveml_bench;
