ABS(JSON_EXTRACT(@row_result,'$.ml_results.attributions.f100'))>0 AS nonzero_contribution,
JSON_CONTAINS_PATH(@row_result,'one','$.ml_results.attributions.f99') AS omitted_tie_feature;
