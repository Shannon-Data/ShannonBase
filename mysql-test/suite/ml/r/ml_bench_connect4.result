DROP DATABASE IF EXISTS ML_SCHEMA_root;
SET @saved_local_infile = @@GLOBAL.local_infile;
SET GLOBAL local_infile = 1;
DROP DATABASE IF EXISTS heatwaveml_bench;
CREATE DATABASE heatwaveml_bench;
ALTER DATABASE heatwaveml_bench CHARACTER SET ascii COLLATE ascii_bin;
USE heatwaveml_bench;
########################################################################
# Upstream table definition (sql/table_classification_connect-4.sql).
########################################################################
SELECT class, count(*) AS positions FROM `connect-4_train` GROUP BY class ORDER BY class;
class	positions
draw	669
loss	1723
win	4608
ALTER TABLE `connect-4_train` SECONDARY_LOAD;
ALTER TABLE `connect-4_test` SECONDARY_LOAD;
########################################################################
# Train the model.
########################################################################
SET @model_connect4 = 'connect-4_bench_model';
CALL sys.ML_TRAIN('heatwaveml_bench.connect-4_train', 'class', JSON_OBJECT('task', 'classification'), @model_connect4);
SELECT JSON_UNQUOTE(MODEL_METADATA->'$.task') AS task,
JSON_UNQUOTE(MODEL_METADATA->'$.target_column_name') AS target,
JSON_LENGTH(MODEL_METADATA->'$.column_names') AS feature_count
FROM ML_SCHEMA_root.MODEL_CATALOG WHERE MODEL_HANDLE = @model_connect4;
task	target	feature_count
CLASSIFICATION	class	42
CALL sys.ML_MODEL_LOAD(@model_connect4, NULL);
########################################################################
# Score the model on the held out rows.
########################################################################
CALL sys.ML_SCORE('heatwaveml_bench.connect-4_test', 'class', @model_connect4, 'balanced_accuracy', @score_connect4, NULL);
SELECT @score_connect4 >= 0.0 AND @score_connect4 <= 1.0 AS balanced_accuracy_in_range;
balanced_accuracy_in_range
1
CALL sys.ML_MODEL_UNLOAD(@model_connect4);
########################################################################
# Cleanup
########################################################################
SET GLOBAL local_infile = @saved_local_infile;
DROP DATABASE IF EXISTS ML_SCHEMA_root;
ALTER TABLE `connect-4_train` SECONDARY_UNLOAD;
ALTER TABLE `connect-4_test` SECONDARY_UNLOAD;
DROP DATABASE heatwaveml_bench;
