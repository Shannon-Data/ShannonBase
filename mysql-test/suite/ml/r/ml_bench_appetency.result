DROP DATABASE IF EXISTS ML_SCHEMA_root;
SET @saved_local_infile = @@GLOBAL.local_infile;
SET GLOBAL local_infile = 1;
DROP DATABASE IF EXISTS heatwaveml_bench;
CREATE DATABASE heatwaveml_bench;
ALTER DATABASE heatwaveml_bench CHARACTER SET ascii COLLATE ascii_bin;
USE heatwaveml_bench;
########################################################################
# Upstream table definition (sql/table_classification_appetency.sql).
########################################################################
SELECT APPETENCY, count(*) AS customers FROM KDDCup09_appetency_train GROUP BY APPETENCY ORDER BY APPETENCY;
APPETENCY	customers
-1	6875
1	125
ALTER TABLE KDDCup09_appetency_train SECONDARY_LOAD;
ALTER TABLE KDDCup09_appetency_test SECONDARY_LOAD;
########################################################################
# Train the model.
########################################################################
SET @model_appetency = 'KDDCup09_appetency_bench_model';
CALL sys.ML_TRAIN('heatwaveml_bench.KDDCup09_appetency_train', 'APPETENCY', JSON_OBJECT('task', 'classification'), @model_appetency);
SELECT JSON_UNQUOTE(MODEL_METADATA->'$.task') AS task,
JSON_UNQUOTE(MODEL_METADATA->'$.target_column_name') AS target,
JSON_LENGTH(MODEL_METADATA->'$.column_names') AS feature_count
FROM ML_SCHEMA_root.MODEL_CATALOG WHERE MODEL_HANDLE = @model_appetency;
task	target	feature_count
CLASSIFICATION	APPETENCY	230
CALL sys.ML_MODEL_LOAD(@model_appetency, NULL);
########################################################################
# Score the model on the held out rows.
########################################################################
CALL sys.ML_SCORE('heatwaveml_bench.KDDCup09_appetency_test', 'APPETENCY', @model_appetency, 'balanced_accuracy', @score_appetency, NULL);
SELECT @score_appetency >= 0.0 AND @score_appetency <= 1.0 AS balanced_accuracy_in_range;
balanced_accuracy_in_range
1
CALL sys.ML_MODEL_UNLOAD(@model_appetency);
########################################################################
# Cleanup
########################################################################
SET GLOBAL local_infile = @saved_local_infile;
DROP DATABASE IF EXISTS ML_SCHEMA_root;
ALTER TABLE KDDCup09_appetency_train SECONDARY_UNLOAD;
ALTER TABLE KDDCup09_appetency_test SECONDARY_UNLOAD;
DROP DATABASE heatwaveml_bench;
