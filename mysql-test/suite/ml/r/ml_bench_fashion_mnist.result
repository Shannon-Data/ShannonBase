DROP DATABASE IF EXISTS ML_SCHEMA_root;
SET @saved_local_infile = @@GLOBAL.local_infile;
SET GLOBAL local_infile = 1;
DROP DATABASE IF EXISTS heatwaveml_bench;
CREATE DATABASE heatwaveml_bench;
ALTER DATABASE heatwaveml_bench CHARACTER SET ascii COLLATE ascii_bin;
USE heatwaveml_bench;
########################################################################
# Upstream table definition (sql/table_classification_fashion_mnist.sql):
# the 10 way label plus one column per pixel of the 28x28 image.
########################################################################
SELECT label, count(*) AS images FROM fashion_mnist_train GROUP BY label ORDER BY label;
label	images
0	300
1	300
2	300
3	300
4	300
5	300
6	300
7	300
8	300
9	300
SELECT count(*) AS feature_columns FROM information_schema.COLUMNS
WHERE TABLE_SCHEMA = 'heatwaveml_bench' AND TABLE_NAME = 'fashion_mnist_train'
  AND COLUMN_NAME NOT IN ('id', 'label');
feature_columns
784
########################################################################
# All 784 pixel columns load, the same as cnae-9's 856.  A table's Rapid
# sub-pool was once a flat 128MB carved out of the shared pool, which a
# table this wide exhausted even for 3000 images; it is now derived from
# the table's own InnoDB data volume, so there is no longer a column
# ceiling sitting between 376 and 784.
########################################################################
ALTER TABLE fashion_mnist_train SECONDARY_ENGINE = RAPID;
ALTER TABLE fashion_mnist_train SECONDARY_LOAD;
ALTER TABLE fashion_mnist_train SECONDARY_ENGINE = NULL;
########################################################################
# Train on a 14x14 subsample, which keeps the benchmark's runtime down:
# every other pixel of every other row.  That keeps the whole image in
# view -- unlike taking the leading 196 columns, which would be the
# mostly blank top of the frame -- so the ten classes stay separable and
# the multi-class flow is unaffected.
########################################################################
ALTER TABLE fashion_mnist_train_narrow SECONDARY_LOAD;
ALTER TABLE fashion_mnist_test_narrow SECONDARY_LOAD;
########################################################################
# Train the model.
########################################################################
SET @model_fashion = 'fashion_mnist_bench_model';
CALL sys.ML_TRAIN('heatwaveml_bench.fashion_mnist_train_narrow', 'label', JSON_OBJECT('task', 'classification'), @model_fashion);
SELECT JSON_UNQUOTE(MODEL_METADATA->'$.task') AS task,
JSON_UNQUOTE(MODEL_METADATA->'$.target_column_name') AS target,
JSON_LENGTH(MODEL_METADATA->'$.column_names') AS feature_count
FROM ML_SCHEMA_root.MODEL_CATALOG WHERE MODEL_HANDLE = @model_fashion;
task	target	feature_count
CLASSIFICATION	label	196
CALL sys.ML_MODEL_LOAD(@model_fashion, NULL);
########################################################################
# Score the model on the held out images.
########################################################################
CALL sys.ML_SCORE('heatwaveml_bench.fashion_mnist_test_narrow', 'label', @model_fashion, 'balanced_accuracy', @score_fashion, NULL);
SELECT @score_fashion >= 0.0 AND @score_fashion <= 1.0 AS balanced_accuracy_in_range;
balanced_accuracy_in_range
1
CALL sys.ML_MODEL_UNLOAD(@model_fashion);
########################################################################
# Cleanup
########################################################################
SET GLOBAL local_infile = @saved_local_infile;
DROP DATABASE IF EXISTS ML_SCHEMA_root;
ALTER TABLE fashion_mnist_train_narrow SECONDARY_UNLOAD;
ALTER TABLE fashion_mnist_test_narrow SECONDARY_UNLOAD;
DROP DATABASE heatwaveml_bench;
