DROP DATABASE IF EXISTS ML_SCHEMA_root;
SET GLOBAL local_infile = 1;
DROP DATABASE IF EXISTS shannon_ml;
CREATE DATABASE shannon_ml;
ALTER DATABASE shannon_ml CHARACTER SET ascii COLLATE ascii_bin;
USE shannon_ml;
########################################################################
# Setup: census_train table for classification, regression, anomaly
########################################################################
CREATE TABLE census_train (
age INT,
workclass VARCHAR(255),
fnlwgt INT,
education VARCHAR(255),
`education-num` INT,
`marital-status` VARCHAR(255),
occupation VARCHAR(255),
relationship VARCHAR(255),
race VARCHAR(255),
sex VARCHAR(255),
`capital-gain` INT,
`capital-loss` INT,
`hours-per-week` INT,
`native-country` VARCHAR(255),
revenue VARCHAR(255)
);
CREATE TABLE census_test LIKE census_train;
ALTER TABLE census_train SECONDARY_LOAD;
########################################################################
# Test 1: Classification (NULL options, defaults to classification)
########################################################################
SET @census_model = 'census_test_train';
CALL sys.ML_TRAIN('shannon_ml.census_train', 'revenue', NULL, @census_model);
########################################################################
# Test 2: Classification (explicit task)
########################################################################
SET @census_model = 'census_test_train1';
CALL sys.ML_TRAIN('shannon_ml.census_train', 'revenue', JSON_OBJECT('task', 'classification'), @census_model);
########################################################################
# Test 3: Classification with exclude_model_list
########################################################################
SET @census_model = 'census_test_train2';
CALL sys.ML_TRAIN('shannon_ml.census_train', 'revenue', JSON_OBJECT('task','classification', 'exclude_model_list', JSON_ARRAY('LogisticRegression', 'GaussianNB')),   @census_model);
########################################################################
# Test 4: Regression
########################################################################
SET @reg_model = 'census_reg_test';
CALL sys.ML_TRAIN('shannon_ml.census_train', 'hours-per-week', JSON_OBJECT('task', 'regression'), @reg_model);
########################################################################
# Test 5: Regression with exclude_model_list
########################################################################
SET @reg_model2 = 'census_reg_exclude';
CALL sys.ML_TRAIN('shannon_ml.census_train', 'hours-per-week', JSON_OBJECT('task', 'regression', 'exclude_model_list', JSON_ARRAY('LinearRegression')), @reg_model2);
########################################################################
# Test 6: Anomaly Detection (unsupervised, no target)
########################################################################
SET @anomaly_model = 'census_anomaly_test';
CALL sys.ML_TRAIN('shannon_ml.census_train', '', JSON_OBJECT('task', 'anomaly_detection'), @anomaly_model);
########################################################################
# Test 7: Anomaly Detection with contamination
########################################################################
SET @anomaly_model2 = 'census_anomaly_contamination';
CALL sys.ML_TRAIN('shannon_ml.census_train', '', JSON_OBJECT('task', 'anomaly_detection', 'contamination', '0.05'), @anomaly_model2);
########################################################################
# Test 8: Log Anomaly Detection
########################################################################
SET @logad_model = 'census_logad_test';
CALL sys.ML_TRAIN('shannon_ml.census_train', '', JSON_OBJECT('task', 'log_anomaly_detection', 'logad_options', JSON_OBJECT('window_size', '5', 'window_stride', '2')), @logad_model);
########################################################################
# Test 9: Topic Modeling
########################################################################
SET @topic_model = 'census_topic_test';
CALL sys.ML_TRAIN('shannon_ml.census_train', '', JSON_OBJECT('task', 'topic_modeling', 'document_column', 'workclass'), @topic_model);
########################################################################
# Setup: time-series table for forecasting
########################################################################
CREATE TABLE sales_ts (
sale_date DATE,
product_id INT,
quantity INT,
price DECIMAL(10,2)
);
INSERT INTO sales_ts (sale_date, product_id, quantity, price) VALUES
('2023-01-01', 1, 100, 10.50),
('2023-02-01', 1, 110, 10.75),
('2023-03-01', 1, 105, 11.00),
('2023-04-01', 1, 120, 11.25),
('2023-05-01', 1, 115, 11.50),
('2023-06-01', 1, 130, 11.75),
('2023-07-01', 1, 125, 12.00),
('2023-08-01', 1, 140, 12.25),
('2023-09-01', 1, 135, 12.50),
('2023-10-01', 1, 150, 12.75),
('2023-11-01', 1, 145, 13.00),
('2023-12-01', 1, 160, 13.25);
ALTER TABLE sales_ts ADD COLUMN id INT AUTO_INCREMENT NOT SECONDARY PRIMARY KEY FIRST;
ALTER TABLE sales_ts SECONDARY_ENGINE = RAPID;
ALTER TABLE sales_ts SECONDARY_LOAD;
########################################################################
# Test 10: Forecasting
########################################################################
SET @forecast_model = 'sales_forecast_test';
CALL sys.ML_TRAIN('shannon_ml.sales_ts', 'quantity', JSON_OBJECT('task', 'forecasting', 'datetime_index', 'sale_date'), @forecast_model);
########################################################################
# Setup: users-items table for recommendation
########################################################################
CREATE TABLE user_ratings (
users VARCHAR(255),
items VARCHAR(255),
rating INT
);
INSERT INTO user_ratings (users, items, rating) VALUES
('user1', 'item1', 5),
('user1', 'item2', 3),
('user1', 'item3', 4),
('user2', 'item1', 4),
('user2', 'item3', 5),
('user2', 'item4', 2),
('user3', 'item1', 3),
('user3', 'item2', 4),
('user3', 'item4', 5),
('user4', 'item2', 2),
('user4', 'item3', 3),
('user4', 'item4', 4),
('user5', 'item1', 5),
('user5', 'item2', 4),
('user5', 'item5', 3),
('user1', 'item5', 4),
('user2', 'item5', 1),
('user3', 'item5', 5),
('user4', 'item5', 4),
('user5', 'item3', 5);
ALTER TABLE user_ratings ADD COLUMN id INT AUTO_INCREMENT NOT SECONDARY PRIMARY KEY FIRST;
ALTER TABLE user_ratings SECONDARY_ENGINE = RAPID;
ALTER TABLE user_ratings SECONDARY_LOAD;
########################################################################
# Test 11: Recommendation
########################################################################
SET @rec_model = 'user_ratings_rec_test';
CALL sys.ML_TRAIN('shannon_ml.user_ratings', 'rating', JSON_OBJECT('task', 'recommendation', 'users', 'users', 'items', 'items'), @rec_model);
########################################################################
# Test 12: Anomaly Detection with exclude_model_list
########################################################################
SET @anomaly_model3 = 'census_anomaly_exclude';
CALL sys.ML_TRAIN('shannon_ml.census_train', '', JSON_OBJECT('task', 'anomaly_detection', 'exclude_model_list', JSON_ARRAY('PCA'), 'model_list', JSON_ARRAY('GKNN')), @anomaly_model3);
########################################################################
# Verify MODEL_CATALOG - all trained models
########################################################################
SELECT MODEL_ID, MODEL_HANDLE, MODEL_OBJECT, MODEL_OWNER,
JSON_UNQUOTE(MODEL_METADATA->'$.task') AS task, JSON_UNQUOTE(MODEL_METADATA->'$.column_names') as feature_names
FROM ML_SCHEMA_root.MODEL_CATALOG ORDER BY MODEL_ID;
MODEL_ID	MODEL_HANDLE	MODEL_OBJECT	MODEL_OWNER	task	feature_names
1	census_test_train	NULL	root	CLASSIFICATION	["age", "workclass", "fnlwgt", "education", "education-num", "marital-status", "occupation", "relationship", "race", "sex", "capital-gain", "capital-loss", "hours-per-week", "native-country"]
2	census_test_train1	NULL	root	CLASSIFICATION	["age", "workclass", "fnlwgt", "education", "education-num", "marital-status", "occupation", "relationship", "race", "sex", "capital-gain", "capital-loss", "hours-per-week", "native-country"]
3	census_test_train2	NULL	root	CLASSIFICATION	["age", "workclass", "fnlwgt", "education", "education-num", "marital-status", "occupation", "relationship", "race", "sex", "capital-gain", "capital-loss", "hours-per-week", "native-country"]
4	census_reg_test	NULL	root	REGRESSION	["age", "workclass", "fnlwgt", "education", "education-num", "marital-status", "occupation", "relationship", "race", "sex", "capital-gain", "capital-loss", "native-country", "revenue"]
5	census_reg_exclude	NULL	root	REGRESSION	["age", "workclass", "fnlwgt", "education", "education-num", "marital-status", "occupation", "relationship", "race", "sex", "capital-gain", "capital-loss", "native-country", "revenue"]
6	census_anomaly_test	NULL	root	ANOMALY_DETECTION	["age", "workclass", "fnlwgt", "education", "education-num", "marital-status", "occupation", "relationship", "race", "sex", "capital-gain", "capital-loss", "hours-per-week", "native-country", "revenue"]
7	census_anomaly_contamination	NULL	root	ANOMALY_DETECTION	["age", "workclass", "fnlwgt", "education", "education-num", "marital-status", "occupation", "relationship", "race", "sex", "capital-gain", "capital-loss", "hours-per-week", "native-country", "revenue"]
8	census_logad_test	NULL	root	LOG_ANOMALY_DETECTION	["age", "workclass", "fnlwgt", "education", "education-num", "marital-status", "occupation", "relationship", "race", "sex", "capital-gain", "capital-loss", "hours-per-week", "native-country", "revenue"]
9	census_topic_test	NULL	root	TOPIC_MODELING	["age", "workclass", "fnlwgt", "education", "education-num", "marital-status", "occupation", "relationship", "race", "sex", "capital-gain", "capital-loss", "hours-per-week", "native-country", "revenue"]
10	sales_forecast_test	NULL	root	FORECASTING	["sale_date", "product_id", "price"]
11	user_ratings_rec_test	NULL	root	RECOMMENDATION	["users", "items"]
12	census_anomaly_exclude	NULL	root	ANOMALY_DETECTION	["age", "workclass", "fnlwgt", "education", "education-num", "marital-status", "occupation", "relationship", "race", "sex", "capital-gain", "capital-loss", "hours-per-week", "native-country", "revenue"]
########################################################################
# Verify MODEL_OBJECT_CATALOG
########################################################################
SELECT CHUNK_ID, MODEL_HANDLE from ML_SCHEMA_root.MODEL_OBJECT_CATALOG ORDER BY CHUNK_ID, MODEL_HANDLE;
CHUNK_ID	MODEL_HANDLE
1	census_anomaly_contamination
