########################################################################
# Verify specific models by task type
########################################################################
SELECT MODEL_ID, MODEL_HANDLE, JSON_UNQUOTE(MODEL_METADATA->'$.task') AS task
FROM ML_SCHEMA_root.MODEL_CATALOG
WHERE JSON_UNQUOTE(MODEL_METADATA->'$.task') = 'REGRESSION'
ORDER BY MODEL_ID;
MODEL_ID	MODEL_HANDLE	task
4	census_reg_test	REGRESSION
5	census_reg_exclude	REGRESSION
SELECT MODEL_ID, MODEL_HANDLE, JSON_UNQUOTE(MODEL_METADATA->'$.task') AS task
FROM ML_SCHEMA_root.MODEL_CATALOG
WHERE JSON_UNQUOTE(MODEL_METADATA->'$.task') = 'ANOMALY_DETECTION'
ORDER BY MODEL_ID;
MODEL_ID	MODEL_HANDLE	task
6	census_anomaly_test	ANOMALY_DETECTION
7	census_anomaly_contamination	ANOMALY_DETECTION
12	census_anomaly_exclude	ANOMALY_DETECTION
SELECT MODEL_ID, MODEL_HANDLE, JSON_UNQUOTE(MODEL_METADATA->'$.task') AS task
FROM ML_SCHEMA_root.MODEL_CATALOG
WHERE JSON_UNQUOTE(MODEL_METADATA->'$.task') = 'LOG_ANOMALY_DETECTION'
ORDER BY MODEL_ID;
MODEL_ID	MODEL_HANDLE	task
8	census_logad_test	LOG_ANOMALY_DETECTION
SELECT MODEL_ID, MODEL_HANDLE, JSON_UNQUOTE(MODEL_METADATA->'$.task') AS task
FROM ML_SCHEMA_root.MODEL_CATALOG
WHERE JSON_UNQUOTE(MODEL_METADATA->'$.task') = 'TOPIC_MODELING'
ORDER BY MODEL_ID;
MODEL_ID	MODEL_HANDLE	task
9	census_topic_test	TOPIC_MODELING
########################################################################
# Cleanup
########################################################################
DROP DATABASE IF EXISTS ML_SCHEMA_root;
ALTER TABLE census_train SECONDARY_UNLOAD;
ALTER TABLE sales_ts SECONDARY_UNLOAD;
ALTER TABLE user_ratings SECONDARY_UNLOAD;
DROP DATABASE IF EXISTS shannon_ml;
