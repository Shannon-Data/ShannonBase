# sys routines that supersede them still resolve
SELECT COUNT(*) AS ml_rag_proc
FROM information_schema.ROUTINES
WHERE ROUTINE_SCHEMA = 'sys' AND ROUTINE_NAME = 'ML_RAG' AND ROUTINE_TYPE = 'PROCEDURE';
ml_rag_proc
1
SELECT COUNT(*) AS ml_rag_table_proc
FROM information_schema.ROUTINES
WHERE ROUTINE_SCHEMA = 'sys' AND ROUTINE_NAME = 'ML_RAG_TABLE' AND ROUTINE_TYPE = 'PROCEDURE';
ml_rag_table_proc
1
