DROP DATABASE IF EXISTS ML_SCHEMA_root;
SET @saved_local_infile = @@GLOBAL.local_infile;
SET GLOBAL local_infile = 1;
DROP DATABASE IF EXISTS heatwaveml_bench;
CREATE DATABASE heatwaveml_bench;
ALTER DATABASE heatwaveml_bench CHARACTER SET ascii COLLATE ascii_bin;
USE heatwaveml_bench;
########################################################################
# Upstream table definition (sql/table_regression_nyc_taxi.sql).
########################################################################
SELECT count(*) AS train_rows, round(avg(tip_amount), 2) AS mean_tip FROM nyc_taxi_train;
train_rows	mean_tip
7000	2.39
ALTER TABLE nyc_taxi_train SECONDARY_LOAD;
ALTER TABLE nyc_taxi_test SECONDARY_LOAD;
########################################################################
# Train the model.
########################################################################
SET @model_nyc_taxi = 'nyc_taxi_bench_model';
CALL sys.ML_TRAIN('heatwaveml_bench.nyc_taxi_train', 'tip_amount', JSON_OBJECT('task', 'regression'), @model_nyc_taxi);
SELECT JSON_UNQUOTE(MODEL_METADATA->'$.task') AS task,
JSON_UNQUOTE(MODEL_METADATA->'$.target_column_name') AS target,
JSON_LENGTH(MODEL_METADATA->'$.column_names') AS feature_count
FROM ML_SCHEMA_root.MODEL_CATALOG WHERE MODEL_HANDLE = @model_nyc_taxi;
task	target	feature_count
REGRESSION	tip_amount	14
CALL sys.ML_MODEL_LOAD(@model_nyc_taxi, NULL);
########################################################################
# Score the model on the held out rows.
########################################################################
CALL sys.ML_SCORE('heatwaveml_bench.nyc_taxi_test', 'tip_amount', @model_nyc_taxi, 'r2', @score_nyc_taxi, NULL);
SELECT @score_nyc_taxi IS NOT NULL AND @score_nyc_taxi <= 1.0 AS r2_in_range;
r2_in_range
1
CALL sys.ML_MODEL_UNLOAD(@model_nyc_taxi);
########################################################################
# Cleanup
########################################################################
SET GLOBAL local_infile = @saved_local_infile;
DROP DATABASE IF EXISTS ML_SCHEMA_root;
ALTER TABLE nyc_taxi_train SECONDARY_UNLOAD;
ALTER TABLE nyc_taxi_test SECONDARY_UNLOAD;
DROP DATABASE heatwaveml_bench;
