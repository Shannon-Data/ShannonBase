DROP DATABASE IF EXISTS ML_SCHEMA_root;
SET @saved_local_infile = @@GLOBAL.local_infile;
SET GLOBAL local_infile = 1;
DROP DATABASE IF EXISTS heatwaveml_bench;
CREATE DATABASE heatwaveml_bench;
ALTER DATABASE heatwaveml_bench CHARACTER SET ascii COLLATE ascii_bin;
USE heatwaveml_bench;
########################################################################
# Upstream table definition (sql/table_regression_twitter.sql).
########################################################################
SELECT count(*) AS train_rows FROM twitter_train;
train_rows
7000
ALTER TABLE twitter_train SECONDARY_LOAD;
ALTER TABLE twitter_test SECONDARY_LOAD;
########################################################################
# Train the model.
########################################################################
SET @model_twitter = 'twitter_bench_model';
CALL sys.ML_TRAIN('heatwaveml_bench.twitter_train', 'Annotation', JSON_OBJECT('task', 'regression'), @model_twitter);
SELECT JSON_UNQUOTE(MODEL_METADATA->'$.task') AS task,
JSON_UNQUOTE(MODEL_METADATA->'$.target_column_name') AS target,
JSON_LENGTH(MODEL_METADATA->'$.column_names') AS feature_count
FROM ML_SCHEMA_root.MODEL_CATALOG WHERE MODEL_HANDLE = @model_twitter;
task	target	feature_count
REGRESSION	Annotation	77
CALL sys.ML_MODEL_LOAD(@model_twitter, NULL);
########################################################################
# Score the model on the held out rows.
########################################################################
CALL sys.ML_SCORE('heatwaveml_bench.twitter_test', 'Annotation', @model_twitter, 'r2', @score_twitter, NULL);
SELECT @score_twitter IS NOT NULL AND @score_twitter <= 1.0 AS r2_in_range;
r2_in_range
1
CALL sys.ML_MODEL_UNLOAD(@model_twitter);
########################################################################
# Cleanup
########################################################################
SET GLOBAL local_infile = @saved_local_infile;
DROP DATABASE IF EXISTS ML_SCHEMA_root;
ALTER TABLE twitter_train SECONDARY_UNLOAD;
ALTER TABLE twitter_test SECONDARY_UNLOAD;
DROP DATABASE heatwaveml_bench;
