SET @shannon_agent_selfcheck_allow_writes=1;
USE test;
# Approval is bound to the displayed payload, database and exact approval token.
CALL sys.shannon_agent_selfcheck('harness','approval','digest');
k	v
saved	true
digest_shown	true
token_bound	true
tamper_rejected	true
bare_approval_rejected	true
wrong_database_rejected	true
# Execution-match checks compare actual tool results with independent SQL oracles.
CREATE TABLE harness_customers(id INT PRIMARY KEY);
CREATE TABLE harness_orders(id INT PRIMARY KEY,customer_id INT,amount DECIMAL(12,2),note VARCHAR(128));
INSERT INTO harness_customers VALUES(1),(2),(3);
INSERT INTO harness_orders VALUES(1,1,10.25,'ordinary'),(2,1,5.25,'special requests'),(3,2,NULL,NULL);
CALL sys.shannon_agent_selfcheck('harness','execution_match',NULL);
k	v
execution_match_1	true
execution_match_2	true
execution_match_3	true
execution_match_4	true
execution_match_5	true
execution_match_6	true
CALL sys.shannon_agent_selfcheck('harness','result_contract',NULL);
