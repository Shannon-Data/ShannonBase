ensemble_score_number_rejected	true
cancel_is_not_retried	true
cancelled_envelope_discarded	true
CALL sys.shannon_agent_selfcheck('harness','shared_execution','dedup');
k	v
ml_sequence_preserved	true
ml_failure_stops_sequence	true
