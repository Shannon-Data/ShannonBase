SET use_secondary_engine=OFF;
CREATE TABLE ga_s(id INT PRIMARY KEY, s VARCHAR(20)) SECONDARY_ENGINE=rapid;
INSERT INTO ga_s VALUES(1,'1'),(2,'01'),(3,'1.0'),(4,'2');
ALTER TABLE ga_s SECONDARY_LOAD;
SET optimizer_switch='hypergraph_optimizer=off';
SET use_secondary_engine=OFF;
SELECT id,s FROM ga_s WHERE s=1 ORDER BY id;
id	s
1	1
2	01
3	1.0
SELECT id,s FROM ga_s WHERE 1=s ORDER BY id;
id	s
1	1
2	01
3	1.0
SELECT id,s FROM ga_s WHERE s=1.0 ORDER BY id;
id	s
1	1
2	01
3	1.0
SELECT id,s FROM ga_s WHERE s=1e0 ORDER BY id;
id	s
1	1
2	01
3	1.0
SELECT id,s FROM ga_s WHERE s<>1 ORDER BY id;
id	s
4	2
SELECT id,s FROM ga_s WHERE s='01' ORDER BY id;
id	s
2	01
SELECT id,s FROM ga_s WHERE s='1' ORDER BY id;
id	s
1	1
SET optimizer_switch='hypergraph_optimizer=off';
