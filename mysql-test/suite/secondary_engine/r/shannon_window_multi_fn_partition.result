create database sh_wmf;
use sh_wmf;
create table wmf (id int primary key, p int not null, o int not null, v int not null) secondary_engine=rapid partition by range (id) (partition p0 values less than (4), partition p1 values less than (8), partition p2 values less than maxvalue);
insert into wmf values (1,1,10,100),(2,1,20,200),(3,1,30,300),(4,2,10,400),(5,2,20,500),(6,2,30,600),(7,3,10,700),(8,3,20,800);
alter table wmf secondary_load;
# ===== InnoDB baseline =====
set session use_secondary_engine = off;
select id, p, v, sum(v) over w as s, count(v) over w as c, min(v) over w as mn, max(v) over w as mx, rank() over (partition by p order by o) as rnk from wmf window w as (partition by p order by o) order by id;
id	p	v	s	c	mn	mx	rnk
1	1	100	100	1	100	100	1
2	1	200	300	2	100	200	2
3	1	300	600	3	100	300	3
4	2	400	400	1	400	400	1
5	2	500	900	2	400	500	2
6	2	600	1500	3	400	600	3
7	3	700	700	1	700	700	1
8	3	800	1500	2	700	800	2
# ===== Rapid =====
set session use_secondary_engine = forced;
select id, p, v, sum(v) over w as s, count(v) over w as c, min(v) over w as mn, max(v) over w as mx, rank() over (partition by p order by o) as rnk from wmf window w as (partition by p order by o) order by id;
id	p	v	s	c	mn	mx	rnk
1	1	100	100	1	100	100	1
2	1	200	300	2	100	200	2
3	1	300	600	3	100	300	3
4	2	400	400	1	400	400	1
5	2	500	900	2	400	500	2
6	2	600	1500	3	400	600	3
7	3	700	700	1	700	700	1
8	3	800	1500	2	700	800	2
use test;
drop database sh_wmf;
