CREATE DATABASE hjnc;
USE hjnc;
CREATE TABLE probe_t (
pid  INT NOT NULL PRIMARY KEY,
pkey INT NOT NULL,
pval INT NOT NULL
) SECONDARY_ENGINE=rapid;
CREATE TABLE build_t (
bid  INT NOT NULL PRIMARY KEY,
bkey INT NOT NULL,
bval INT NOT NULL
) SECONDARY_ENGINE=rapid;
INSERT INTO probe_t VALUES
(1,1,10),(2,2,20),(3,3,30),(4,4,40),(5,5,50),(6,6,60),
(7,7,70),(8,8,80),(9,9,90),(10,10,100),(11,11,110),(12,12,120);
INSERT INTO build_t VALUES (1,2,200),(2,4,400),(3,6,600),(4,8,800),(5,10,1000),(6,12,1200);
ALTER TABLE probe_t SECONDARY_LOAD;
ALTER TABLE build_t SECONDARY_LOAD;
SET SESSION optimizer_switch='hypergraph_optimizer=on';
Warnings:
Warning	1287	The hypergraph optimizer is highly experimental and is meant for testing only. Do not enable it unless you are a MySQL developer.
SET SESSION secondary_engine_cost_threshold=0;
#
# 1. LEFT JOIN grouped by a NOT NULL build column.
#
# The aggregate builds a group key twice: once from the columnar batch
# and once from the restored MySQL row image, and asserts they match.
# For a null-complemented row the batch said NULL while the row image
# said 0, because set_null() had done nothing -- an assertion failure on
# a debug build and, with no assert compiled in, a wrong group on a
# release one. The unmatched probe rows must all land in a single NULL
# group.
#
SET SESSION use_secondary_engine=FORCED;
SELECT b.bkey, COUNT(*) AS n, SUM(p.pval) AS s
FROM probe_t p LEFT JOIN build_t b ON p.pkey = b.bkey
GROUP BY b.bkey ORDER BY b.bkey;
bkey	n	s
NULL	6	360
2	1	20
4	1	40
6	1	60
8	1	80
10	1	100
12	1	120
SET SESSION use_secondary_engine=off;
SELECT b.bkey, COUNT(*) AS n, SUM(p.pval) AS s
FROM probe_t p LEFT JOIN build_t b ON p.pkey = b.bkey
GROUP BY b.bkey ORDER BY b.bkey;
bkey	n	s
NULL	6	360
2	1	20
4	1	40
6	1	60
8	1	80
10	1	100
12	1	120
#
# 2. Anti-join written as LEFT JOIN + IS NULL on a NOT NULL column.
#
# Reading 0 instead of NULL makes the IS NULL test false for every row,
# so the anti-join returns the empty set rather than the six unmatched
# rows.
#
SET SESSION use_secondary_engine=FORCED;
SELECT p.pid, p.pkey FROM probe_t p LEFT JOIN build_t b ON p.pkey = b.bkey
WHERE b.bkey IS NULL ORDER BY p.pid;
pid	pkey
1	1
3	3
5	5
7	7
9	9
11	11
SET SESSION use_secondary_engine=off;
SELECT p.pid, p.pkey FROM probe_t p LEFT JOIN build_t b ON p.pkey = b.bkey
WHERE b.bkey IS NULL ORDER BY p.pid;
pid	pkey
1	1
3	3
5	5
7	7
9	9
11	11
#
# 3. NOT EXISTS anti-join nested under a second join -- the TPC-H Q22
#    shape, and the one that survived every simpler reproduction.
#
# The planner rewrites NOT EXISTS into a left join plus an IS NULL test
# on a synthetic marker column, and that left join becomes the build
# side of the join above it. The outer join is an inner join, so it
# never null-complements and took the branch that cleared null_row
# AFTER loading the build row -- discarding the flag the row had
# legitimately inherited from the left join beneath it. Every IS NULL
# test then read non-NULL and the query returned nothing.
#
SET SESSION use_secondary_engine=FORCED;
SELECT COUNT(*) AS unmatched_above_avg FROM probe_t p
WHERE p.pval > (SELECT AVG(pval) FROM probe_t)
AND NOT EXISTS (SELECT 1 FROM build_t b WHERE b.bkey = p.pkey);
unmatched_above_avg
3
SET SESSION use_secondary_engine=off;
SELECT COUNT(*) AS unmatched_above_avg FROM probe_t p
WHERE p.pval > (SELECT AVG(pval) FROM probe_t)
AND NOT EXISTS (SELECT 1 FROM build_t b WHERE b.bkey = p.pkey);
unmatched_above_avg
3
#
# 4. The same shape grouped, so a lost null_row shows up as missing
#    groups rather than only a smaller count.
#
SET SESSION use_secondary_engine=FORCED;
SELECT p.pkey % 3 AS bucket, COUNT(*) AS n FROM probe_t p
WHERE NOT EXISTS (SELECT 1 FROM build_t b WHERE b.bkey = p.pkey)
GROUP BY bucket ORDER BY bucket;
bucket	n
0	2
1	2
2	2
SET SESSION use_secondary_engine=off;
SELECT p.pkey % 3 AS bucket, COUNT(*) AS n FROM probe_t p
WHERE NOT EXISTS (SELECT 1 FROM build_t b WHERE b.bkey = p.pkey)
GROUP BY bucket ORDER BY bucket;
bucket	n
0	2
1	2
2	2
#
# 5. Alternating matched and unmatched rows in one batch.
#
# set_null_row() is sticky and marks every column of the table NULL, so
# it has to be cleared before each row is restored. Without that, the
# first unmatched row turns every later row of that table NULL too --
# which a test whose unmatched rows all sort last would never notice.
#
SET SESSION use_secondary_engine=FORCED;
SELECT p.pid, b.bkey, b.bval FROM probe_t p LEFT JOIN build_t b ON p.pkey = b.bkey
ORDER BY p.pid;
pid	bkey	bval
1	NULL	NULL
2	2	200
3	NULL	NULL
4	4	400
5	NULL	NULL
6	6	600
7	NULL	NULL
8	8	800
9	NULL	NULL
10	10	1000
11	NULL	NULL
12	12	1200
SET SESSION use_secondary_engine=off;
SELECT p.pid, b.bkey, b.bval FROM probe_t p LEFT JOIN build_t b ON p.pkey = b.bkey
ORDER BY p.pid;
pid	bkey	bval
1	NULL	NULL
2	2	200
3	NULL	NULL
4	4	400
5	NULL	NULL
6	6	600
7	NULL	NULL
8	8	800
9	NULL	NULL
10	10	1000
11	NULL	NULL
12	12	1200
DROP DATABASE hjnc;
