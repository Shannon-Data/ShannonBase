396	792	1
SET optimizer_switch='hypergraph_optimizer=on';
SET use_secondary_engine=FORCED;
SET secondary_engine_cost_threshold=0;
SET join_buffer_size=4096;
SET debug='+d,rapid_operator_budget_floor,rapid_sort_tiny_budget,rapid_hash_aggregate_tiny_budget,rapid_reservation_hold_a';
SELECT pkey,SUM(bval) AS total,COUNT(*) AS n FROM p JOIN b ON pkey=bkey GROUP BY pkey ORDER BY pkey DESC LIMIT 5;
SET DEBUG_SYNC='now WAIT_FOR rapid_reservation_a_ready';
SET optimizer_switch='hypergraph_optimizer=on';
SET use_secondary_engine=FORCED;
SET secondary_engine_cost_threshold=0;
SET join_buffer_size=4096;
SET debug='+d,rapid_operator_budget_floor,rapid_sort_tiny_budget,rapid_hash_aggregate_tiny_budget,rapid_reservation_hold_b';
SELECT pkey,SUM(bval) AS total,COUNT(*) AS n FROM p JOIN b ON pkey=bkey GROUP BY pkey ORDER BY pkey DESC LIMIT 5;
SET DEBUG_SYNC='now WAIT_FOR rapid_reservation_b_ready';
# Two live queries hold their operator grants; a third must refuse.
SELECT pkey,SUM(bval) AS total,COUNT(*) AS n FROM p JOIN b ON pkey=bkey
GROUP BY pkey ORDER BY pkey DESC LIMIT 5;
ERROR HY000: Rapid hash join auxiliary memory exhausted
SET DEBUG_SYNC='now SIGNAL rapid_reservation_continue_a';
pkey	total	n
400	800	1
399	798	1
398	796	1
397	794	1
396	792	1
SET debug='-d,rapid_reservation_hold_a';
# A completed query returns capacity while the other query is still live.
SET optimizer_switch='hypergraph_optimizer=off';
SELECT bid FROM b ORDER BY bval DESC LIMIT 5;
