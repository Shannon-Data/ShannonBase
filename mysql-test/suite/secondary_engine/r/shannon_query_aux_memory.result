CREATE DATABASE sh_aux_memory;
USE sh_aux_memory;
CREATE TABLE b (bid INT PRIMARY KEY, bkey INT NOT NULL, bval INT NOT NULL, pad CHAR(32)) SECONDARY_ENGINE=rapid;
CREATE TABLE p (pid INT PRIMARY KEY, pkey INT NOT NULL, pval INT NOT NULL, pad CHAR(32)) SECONDARY_ENGINE=rapid;
INSERT INTO b WITH RECURSIVE seq(n) AS
(SELECT 1 UNION ALL SELECT n+1 FROM seq WHERE n<400)
SELECT n,n,n*2,CONCAT('build',n) FROM seq;
INSERT INTO p WITH RECURSIVE seq(n) AS
(SELECT 1 UNION ALL SELECT n+1 FROM seq WHERE n<800)
SELECT n,MOD(n,500)+1,n,CONCAT('probe',n) FROM seq;
ALTER TABLE b SECONDARY_LOAD;
ALTER TABLE p SECONDARY_LOAD;
# Primary result for the concurrent join/aggregate query.
SET use_secondary_engine=OFF;
SELECT pkey,SUM(bval) AS total,COUNT(*) AS n FROM p JOIN b ON pkey=bkey
GROUP BY pkey ORDER BY pkey DESC LIMIT 5;
pkey	total	n
400	800	1
399	798	1
398	796	1
397	794	1
396	792	1
SET optimizer_switch='hypergraph_optimizer=on';
SET use_secondary_engine=FORCED;
SET secondary_engine_cost_threshold=0;
SET join_buffer_size=4096;
SET debug='+d,rapid_operator_budget_floor,rapid_sort_tiny_budget,rapid_hash_aggregate_tiny_budget';
EXPLAIN FORMAT=TREE SELECT pkey,SUM(bval) AS total,COUNT(*) AS n FROM p JOIN b ON pkey=bkey
GROUP BY pkey ORDER BY pkey DESC LIMIT 5;
EXPLAIN
-> Limit: 5 row(s)  (...)
    -> Group vectorized aggregate: sum(b.bval), count(0)  (...)
        -> Vectorized inner hash join (p.pkey = b.bkey)  (...)
            -> Vectorized table scan on p in secondary engine Rapid  (...)
            -> Hash
                -> Vectorized table scan on b in secondary engine Rapid  (...)

Warnings:
Note	1003	Query is executed in secondary engine; the actual query plan may diverge from the printed one
