CALL mtr.add_suppression("Rapid COMMITTED_BINLOG: Change propagation failed: committed transaction exceeds the reader memory budget");
SET use_secondary_engine=OFF;
SET GLOBAL rapid_change_propagation_mode=COMMITTED_BINLOG;
CREATE TABLE cb_big (id INT PRIMARY KEY,b LONGBLOB) SECONDARY_ENGINE=rapid;
INSERT INTO cb_big VALUES (1,'small');
ALTER TABLE cb_big SECONDARY_LOAD;
UPDATE cb_big SET b=REPEAT('x',2*1024*1024) WHERE id=1;
SET use_secondary_engine=FORCED;
SELECT LENGTH(b) FROM cb_big;
ERROR HY000: Secondary engine operation failed. Change propagation failed: committed transaction exceeds the reader memory budget; unload and reload the table.
SHOW WARNINGS;
Level	Code	Message
Error	3889	Secondary engine operation failed. Change propagation failed: committed transaction exceeds the reader memory budget; unload and reload the table.
SET use_secondary_engine=ON;
SELECT LENGTH(b) FROM cb_big;
LENGTH(b)
2097152
SET use_secondary_engine=OFF;
ALTER TABLE cb_big SECONDARY_UNLOAD;
ALTER TABLE cb_big SECONDARY_LOAD;
SET use_secondary_engine=FORCED;
SELECT LENGTH(b) FROM cb_big;
LENGTH(b)
2097152
SET use_secondary_engine=OFF;
ALTER TABLE cb_big SECONDARY_UNLOAD;
DROP TABLE cb_big;
SET GLOBAL rapid_change_propagation_mode=CAPTURE;
