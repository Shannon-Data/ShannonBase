create database sh_setop;
use sh_setop;
create table s1 (id int primary key, k int null, g int not null) secondary_engine=rapid;
create table s2 (id int primary key, k int null, g int not null) secondary_engine=rapid;
insert into s1 values (1,1,10),(2,1,10),(3,2,20),(4,2,20),(5,2,30),
(6,null,10),(7,null,30),(8,3,20),(9,4,30);
insert into s2 values (1,1,10),(2,2,20),(3,2,30),(4,null,10),(5,5,10);
alter table s1 secondary_load;
alter table s2 secondary_load;
# ----- InnoDB baseline -----
set session use_secondary_engine = off;
set session optimizer_switch='hypergraph_optimizer=off';
