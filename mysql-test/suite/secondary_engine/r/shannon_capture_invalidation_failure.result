INSERT INTO t2 VALUES (2,20);
SET SESSION debug='-d,rapid_capture_wal_write_error,rapid_capture_wal_invalidation_error,rapid_revoke_skip_epoch_reset';
SET use_secondary_engine=OFF;
SELECT id,v FROM t2 ORDER BY id;
