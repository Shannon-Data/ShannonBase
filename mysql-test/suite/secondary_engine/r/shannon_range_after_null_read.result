#
# A trigger poisoned the session for as long as nothing reloaded the
# buffer. A probe that returns no rows does not reload it, so the fault
# used to persist across repeated identical statements.
#
# after: SELECT dt FROM t
#   all three agree: 1,2
FLUSH TABLES;
SET USE_SECONDARY_ENGINE=FORCED;
# three identical probes after one trigger: 1,2 / 1,2 / 1,2
