CREATE DATABASE sh_parity;
USE sh_parity;
SET time_zone = '+00:00';
CREATE TABLE t_idx (
pk INT PRIMARY KEY,
i  INT,
u  BIGINT UNSIGNED,
n  DECIMAL(10,2),
w  DECIMAL(20,2),
f  DOUBLE,
s  VARCHAR(32),
c  CHAR(8),
e  ENUM('a','b','c'),
dt DATE,
tm DATETIME,
tz TIMESTAMP NULL,
t  TEXT,
KEY k_i (i), KEY k_u (u), KEY k_n (n), KEY k_w (w), KEY k_f (f),
KEY k_s (s), KEY k_c (c), KEY k_e (e), KEY k_dt (dt), KEY k_tm (tm), KEY k_tz (tz)
) SECONDARY_ENGINE=RAPID;
CREATE TABLE t_noidx (
pk INT PRIMARY KEY,
i  INT,
u  BIGINT UNSIGNED,
n  DECIMAL(10,2),
w  DECIMAL(20,2),
f  DOUBLE,
s  VARCHAR(32),
c  CHAR(8),
e  ENUM('a','b','c'),
dt DATE,
tm DATETIME,
tz TIMESTAMP NULL,
t  TEXT
) SECONDARY_ENGINE=RAPID;
INSERT INTO t_idx VALUES
