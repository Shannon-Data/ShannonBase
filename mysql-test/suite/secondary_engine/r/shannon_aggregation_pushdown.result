CREATE DATABASE rapid_agg_pushdown_test;
USE rapid_agg_pushdown_test;
CREATE TABLE customers (
id     INT PRIMARY KEY,
region INT NOT NULL
) SECONDARY_ENGINE=rapid;
CREATE TABLE customers_nonunique (
row_no INT PRIMARY KEY,
id     INT NOT NULL,
region INT NOT NULL,
KEY (id)
) SECONDARY_ENGINE=rapid;
CREATE TABLE orders (
id           INT PRIMARY KEY,
customer_id  INT NOT NULL,
region_code  INT NOT NULL,
amount       INT NOT NULL
) SECONDARY_ENGINE=rapid;
# ============================================================
#  Scenario 1: InnoDB (ground truth)
# ============================================================
SET SESSION optimizer_switch='hypergraph_optimizer=off';
SET USE_SECONDARY_ENGINE=OFF;
# P1: push-eligible shape -- INNER join, GROUP BY/agg on push side (orders),
#     keep side (customers) has a UNIQUE NOT NULL join key.
SELECT o.customer_id, COUNT(*) AS cnt, SUM(o.amount) AS total
FROM orders o JOIN customers c ON o.customer_id = c.id
GROUP BY o.customer_id ORDER BY o.customer_id;
customer_id	cnt	total
1	10	3300
2	10	2730
3	10	2760
4	10	2790
5	10	2820
6	10	2850
7	10	2880
8	10	2910
9	10	2940
10	10	2970
11	10	3000
12	10	3030
13	10	3060
14	10	3090
15	10	3120
16	10	3150
17	10	3180
18	10	3210
19	10	3240
20	10	3270
# P2: same as P1 with the join operands swapped (push_side becomes the join's other child).
SELECT o.customer_id, COUNT(*) AS cnt, SUM(o.amount) AS total
FROM customers c JOIN orders o ON c.id = o.customer_id
GROUP BY o.customer_id ORDER BY o.customer_id;
customer_id	cnt	total
1	10	3300
2	10	2730
3	10	2760
