13	3060
14	3090
15	3120
16	3150
17	3180
18	3210
19	3240
20	3270
NULL	60300
ALTER TABLE customers SECONDARY_LOAD;
ALTER TABLE customers_nonunique SECONDARY_LOAD;
ALTER TABLE orders SECONDARY_LOAD;
SET USE_SECONDARY_ENGINE=FORCED;
SET secondary_engine_cost_threshold=0;
# ============================================================
#  Scenario 2: Rapid, legacy optimizer (hypergraph_optimizer=off)
# ============================================================
SET SESSION optimizer_switch='hypergraph_optimizer=off';
# P1 (legacy, HASH_JOIN hint)
EXPLAIN FORMAT=TREE SELECT /*+ HASH_JOIN(o, c) NO_JOIN_INDEX(c PRIMARY) */ o.customer_id, COUNT(*) AS cnt, SUM(o.amount) AS total
FROM orders o JOIN customers c ON o.customer_id = c.id
GROUP BY o.customer_id;
EXPLAIN
-> Table scan on <temporary>
    -> Aggregate using temporary table
        -> Inner hash join (c.id = o.customer_id)  (rows=433)
            -> Table scan on c in secondary engine Rapid  (rows=21)
            -> Hash
                -> Table scan on o in secondary engine Rapid  (rows=206)

Warnings:
Note	1003	Query is executed in secondary engine; the actual query plan may diverge from the printed one
