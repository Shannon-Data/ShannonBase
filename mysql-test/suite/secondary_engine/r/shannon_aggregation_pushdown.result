19	30
20	0
# N4: GROUP BY (region_code) does not cover the join key (customer_id) read from the push
#     side. region_code=0 must exclude the 6 dangling-customer_id orders rows (cnt=66,
#     not 72), which only a real per-row join evaluation guarantees.
SELECT o.region_code, COUNT(*) AS cnt, SUM(o.amount) AS total
FROM orders o JOIN customers c ON o.customer_id = c.id
GROUP BY o.region_code ORDER BY o.region_code;
region_code	cnt	total
0	66	19899
1	67	20100
2	67	20301
# N5: ROLLUP adds a super-aggregate (customer_id=NULL) row -- not provably safe to
#     relocate below the join, since that row's join key is NULL and an INNER join would
#     silently drop it (NULL never equi-matches).
SELECT o.customer_id, SUM(o.amount) AS total
FROM orders o JOIN customers c ON o.customer_id = c.id
GROUP BY o.customer_id WITH ROLLUP;
customer_id	total
1	3300
2	2730
3	2760
4	2790
5	2820
6	2850
7	2880
8	2910
9	2940
10	2970
11	3000
