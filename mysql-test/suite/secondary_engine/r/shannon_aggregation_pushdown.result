15	20	6240
16	20	6300
17	20	6360
18	20	6420
19	20	6480
20	20	6540
# N3: GROUP BY and aggregate argument come from opposite sides -- not exclusive to one side.
SELECT o.customer_id, SUM(c.region) AS total_region
FROM orders o JOIN customers c ON o.customer_id = c.id
GROUP BY o.customer_id ORDER BY o.customer_id;
customer_id	total_region
1	10
2	20
3	30
4	0
