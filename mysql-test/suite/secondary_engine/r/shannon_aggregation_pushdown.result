13	10	3060
14	10	3090
15	10	3120
16	10	3150
17	10	3180
18	10	3210
19	10	3240
20	10	3270
# N1: LEFT JOIN -- not provably INNER, must not push. customers.id=21 has no matching
#     orders and must still surface as its own (NULL-keyed) group with cnt=1 (the
#     NULL-extended row), not cnt=NULL (which a wrongly-pushed pre-grouping would give,
#     since that group simply would not exist on the push side).
SELECT o.customer_id, COUNT(*) AS cnt, SUM(o.amount) AS total
FROM customers c LEFT JOIN orders o ON o.customer_id = c.id
GROUP BY o.customer_id ORDER BY o.customer_id;
customer_id	cnt	total
NULL	1	NULL
1	10	3300
2	10	2730
3	10	2760
4	10	2790
5	10	2820
6	10	2850
7	10	2880
8	10	2910
9	10	2940
10	10	2970
11	10	3000
12	10	3030
13	10	3060
14	10	3090
15	10	3120
16	10	3150
17	10	3180
18	10	3210
19	10	3240
20	10	3270
# N2: keep side (customers_nonunique) genuinely has 2 rows per id and no UNIQUE NOT NULL
#     join key -- child_multiplicity cannot be proven kAtMostOne. cnt/total must come out
#     2x P1's (real fan-out), not equal to P1's (which a wrongly-pushed pre-grouped-then
#     -joined-without-re-aggregating execution would give).
SELECT o.customer_id, COUNT(*) AS cnt, SUM(o.amount) AS total
FROM orders o JOIN customers_nonunique c ON o.customer_id = c.id
GROUP BY o.customer_id ORDER BY o.customer_id;
customer_id	cnt	total
1	20	6600
2	20	5460
3	20	5520
4	20	5580
5	20	5640
6	20	5700
