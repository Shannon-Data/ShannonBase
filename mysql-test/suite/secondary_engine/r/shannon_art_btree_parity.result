=== InnoDB B+Tree baseline ===
[01] PRIMARY exact lookup
SELECT id, i, s FROM t FORCE INDEX (PRIMARY) WHERE id = 8;
id	i	s
8	10	Éclair
[02] signed INT range
SELECT i FROM t FORCE INDEX (idx_i)
WHERE i BETWEEN -10 AND 10
ORDER BY i;
i
-10
-1
0
1
2
3
10
[03] signed INT lower_bound without exact key
SELECT i FROM t FORCE INDEX (idx_i)
WHERE i >= 50
ORDER BY i
LIMIT 2;
i
100
2147483647
[04] nullable ASC index ordering
SELECT i FROM t FORCE INDEX (idx_i)
ORDER BY i;
i
