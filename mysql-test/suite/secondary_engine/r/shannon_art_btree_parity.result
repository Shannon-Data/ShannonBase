[08] FLOAT +0/-0 canonical equality
SELECT id FROM t FORCE INDEX (idx_f)
WHERE f = 0
ORDER BY id;
id
4
5
[09] DOUBLE +0/-0 canonical equality
SELECT id FROM t FORCE INDEX (idx_g)
WHERE g = 0
ORDER BY id;
id
4
5
[10] utf8mb4_0900_ai_ci case-insensitive equality
SELECT id FROM t FORCE INDEX (idx_s)
WHERE s = 'alpha'
ORDER BY id;
id
1
2
3
[11] utf8mb4_0900_ai_ci accent/case-insensitive equality
SELECT id FROM t FORCE INDEX (idx_s)
WHERE s = 'cafe'
ORDER BY id;
id
4
5
6
12
[12] utf8mb4 collation range
SELECT id FROM t FORCE INDEX (idx_s)
WHERE s >= 'eclair' AND s < 'omega'
ORDER BY id;
id
8
9
[13] multipart index: first-part prefix
SELECT b, c FROM t FORCE INDEX (idx_abc)
WHERE a = 1
ORDER BY b, c;
b	c
alpha	1
beta	2
beta	3
beta	7
charlie	4
delta	5
echo	6
[14] multipart index: two-part exact prefix
SELECT c FROM t FORCE INDEX (idx_abc)
WHERE a = 1 AND b = 'beta'
ORDER BY c;
c
2
3
7
[15] multipart index: prefix + second-part range
SELECT b, c FROM t FORCE INDEX (idx_abc)
WHERE a = 1 AND b >= 'beta' AND b < 'echo'
ORDER BY b, c;
b	c
beta	2
beta	3
beta	7
charlie	4
delta	5
[16] non-unique ART leaf / duplicate key
SELECT id FROM t FORCE INDEX (idx_dup)
WHERE dup = 7
ORDER BY id;
id
1
2
3
6
9
11
12
[17] DESC physical key, forward SQL ordering
SELECT i FROM t FORCE INDEX (idx_i_desc)
WHERE i IS NOT NULL
ORDER BY i DESC;
