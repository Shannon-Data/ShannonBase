DEALLOCATE PREPARE cardinality_stmt;
SET optimizer_trace='enabled=off';
SET use_secondary_engine=OFF;
DROP TABLE cardinality_t;
CREATE TABLE cardinality_b (id INT PRIMARY KEY, k INT) SECONDARY_ENGINE=rapid;
CREATE TABLE cardinality_p (id INT PRIMARY KEY, k INT) SECONDARY_ENGINE=rapid;
SET cte_max_recursion_depth=3000;
INSERT INTO cardinality_b WITH RECURSIVE n AS
(SELECT 1 AS i UNION ALL SELECT i+1 FROM n WHERE i<256) SELECT i,i FROM n;
INSERT INTO cardinality_p WITH RECURSIVE n AS
(SELECT 1 AS i UNION ALL SELECT i+1 FROM n WHERE i<2048) SELECT i,i FROM n;
ALTER TABLE cardinality_b SECONDARY_LOAD;
ALTER TABLE cardinality_p SECONDARY_LOAD;
SET use_secondary_engine=FORCED;
SET optimizer_trace='enabled=on';
SELECT COUNT(*) FROM cardinality_p p JOIN cardinality_b b ON p.k=b.k;
COUNT(*)
256
SET @observation=(SELECT TRACE FROM information_schema.OPTIMIZER_TRACE);
SELECT o.actual_rows FROM JSON_TABLE(@observation, '$**.rapid_cardinality_observation'
  COLUMNS (op VARCHAR(16) PATH '$.operator', actual_rows INT PATH '$.actual_rows')) o
WHERE o.op='scan' ORDER BY o.actual_rows;
actual_rows
