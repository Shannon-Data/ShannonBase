SET @cutoff=100;
EXECUTE cardinality_stmt USING @cutoff;
id
SET @observation=(SELECT TRACE FROM information_schema.OPTIMIZER_TRACE);
SELECT o.actual_rows, o.q_error >= 1 AS valid_error
FROM JSON_TABLE(@observation, '$**.rapid_cardinality_observation'
  COLUMNS (op VARCHAR(16) PATH '$.operator', actual_rows INT PATH '$.actual_rows',
q_error DOUBLE PATH '$.q_error')) o WHERE o.op='filter';
