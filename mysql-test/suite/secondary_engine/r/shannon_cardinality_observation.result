incomplete_filter_skipped
1
PREPARE cardinality_stmt FROM 'SELECT id FROM cardinality_t WHERE ABS(v)>?';
SET @cutoff=5;
EXECUTE cardinality_stmt USING @cutoff;
id
6
7
8
