CREATE DATABASE sh_deferred_stop;
USE sh_deferred_stop;
CREATE TABLE t(id INT PRIMARY KEY, v INT) SECONDARY_ENGINE=rapid;
INSERT INTO t VALUES(1,10);
ALTER TABLE t SECONDARY_LOAD;
# restart: --rapid_reload_on_restart=ON
USE sh_deferred_stop;
SET GLOBAL rapid_lazy_commit_marker=ON;
SET GLOBAL innodb_flush_log_at_trx_commit=2;
SET debug='+d,rapid_deferred_unflushed_lsn,rapid_deferred_stop_after_enqueue';
INSERT INTO t VALUES(2,20);
SET debug='-d,rapid_deferred_unflushed_lsn,rapid_deferred_stop_after_enqueue';
SET GLOBAL innodb_flush_log_at_trx_commit=1;
FLUSH ENGINE LOGS;
# Kill and restart: --rapid_reload_on_restart=ON
USE sh_deferred_stop;
SELECT VARIABLE_VALUE FROM performance_schema.global_status WHERE VARIABLE_NAME='rapid_recovery_primary_reloads';
VARIABLE_VALUE
1
SET use_secondary_engine=OFF;
SELECT * FROM t ORDER BY id;
id	v
1	10
2	20
DROP DATABASE sh_deferred_stop;
