SET use_secondary_engine=OFF;
CREATE TABLE expr_batch_src (id INT PRIMARY KEY, g INT, v INT, d DECIMAL(12,2)) SECONDARY_ENGINE=rapid;
INSERT INTO expr_batch_src WITH RECURSIVE n AS
(SELECT 1 AS i UNION ALL SELECT i+1 FROM n WHERE i<1000)
SELECT i,MOD(i,5),IF(MOD(i,7)=0,NULL,i),IF(MOD(i,11)=0,NULL,i*1.25) FROM n;
ALTER TABLE expr_batch_src SECONDARY_LOAD;
SET optimizer_switch='hypergraph_optimizer=on';
SET use_secondary_engine=FORCED;
EXPLAIN FORMAT=TREE SELECT g,SUM(v*2),AVG(d*2),COUNT(v*2) FROM expr_batch_src GROUP BY g;
EXPLAIN
-> Group vectorized aggregate: sum((expr_batch_src.v * 2)), avg((expr_batch_src.d * 2)), count((expr_batch_src.v * 2))  (...)
    -> Vectorized table scan on expr_batch_src in secondary engine Rapid  (...)

Warnings:
Note	1003	Query is executed in secondary engine; the actual query plan may diverge from the printed one
SET use_secondary_engine=OFF;
DROP TABLE expr_batch_src;
