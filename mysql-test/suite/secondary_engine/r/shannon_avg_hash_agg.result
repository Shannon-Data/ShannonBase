SET use_secondary_engine=OFF;
SELECT g, AVG(d)*2, AVG(d)+AVG(d2) FROM t1 GROUP BY g ORDER BY g;
g	AVG(d)*2	AVG(d)+AVG(d2)
2	33.330000	25.0667895000
3	-15.550000	-9.0250000000
4	70.850000	39.4373400000
5	66.660000	42.4534560000
7	30.750000	17.1651225000
9	110.900000	61.6840175000
SET use_secondary_engine=OFF;
DROP TABLE t1;
#
# A decimal AVG must now be hash-aggregated, not sorted. Group keys are
# inserted out of ascending order: hash aggregation emits groups in
# first-seen order (808,101,505,202,707,303,404,606), sorted aggregation
# would emit them in key order. SUM over DECIMAL has always been hash
# aggregated and is the reference ordering.
#
CREATE TABLE t2 (id INT PRIMARY KEY, g INT, d DECIMAL(15,2), dbl DOUBLE)
SECONDARY_ENGINE RAPID;
INSERT INTO t2 VALUES
(1,808,10.50,1.5),(2,101,20.25,2.5),(3,505,30.75,3.5),(4,202,40.10,4.5),
(5,707,50.00,5.5),(6,303,60.90,6.5),(7,404,11.11,7.5),(8,606,22.22,8.5),
(9,808,33.33,9.5),(10,101,44.44,1.25);
ALTER TABLE t2 SECONDARY_LOAD;
SET use_secondary_engine=FORCED;
# reference: SUM over DECIMAL (hash aggregated all along)
SELECT g, SUM(d) FROM t2 GROUP BY g;
g	SUM(d)
808	43.83
101	64.69
505	30.75
202	40.10
707	50.00
303	60.90
404	11.11
606	22.22
# AVG over DECIMAL must follow the same group ordering
SELECT g, AVG(d) FROM t2 GROUP BY g;
g	AVG(d)
808	21.915000
101	32.345000
505	30.750000
202	40.100000
707	50.000000
303	60.900000
404	11.110000
606	22.220000
# AVG over DOUBLE, permitted on hash aggregation before this change too
SELECT g, AVG(dbl) FROM t2 GROUP BY g;
g	AVG(dbl)
808	5.5
101	1.875
505	3.5
202	4.5
707	5.5
303	6.5
404	7.5
606	8.5
SET use_secondary_engine=OFF;
DROP TABLE t2;
DROP DATABASE sh_avg_hash_db;
