(12,3,0.00,0.000000,0.0000000000,0,0,0,0,0);
ALTER TABLE t1 SECONDARY_LOAD;
#
# Each block prints the Rapid result and then the InnoDB result; the
# recorded output is identical for both by construction.
#
# --- AVG over DECIMAL of several precision/scale combinations
SET use_secondary_engine=FORCED;
SELECT g, AVG(d), AVG(d2), AVG(d3) FROM t1 GROUP BY g ORDER BY g;
g	AVG(d)	AVG(d2)	AVG(d3)
