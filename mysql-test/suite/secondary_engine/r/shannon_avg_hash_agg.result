CREATE DATABASE sh_avg_hash_db;
USE sh_avg_hash_db;
CREATE TABLE t1 (
id INT PRIMARY KEY, g INT,
d DECIMAL(15,2), d2 DECIMAL(20,6), d3 DECIMAL(30,10),
i INT, bi BIGINT, si SMALLINT, f FLOAT, dbl DOUBLE
) SECONDARY_ENGINE RAPID;
