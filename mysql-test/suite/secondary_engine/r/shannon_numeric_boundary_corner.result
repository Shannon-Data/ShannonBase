##### BIT is not a loadable Rapid type
# A BIT column makes the whole table unloadable, and the error has to name
# the offending column -- a table that silently loaded without it would
# answer queries from an incomplete IMCS.
create table nb_bit (id int primary key, k int, b8 bit(8)) secondary_engine=rapid;
insert into nb_bit values (1,1,b'00000001'),(2,2,b'11111111');
alter table nb_bit secondary_load;
ERROR HY000: nb_bit.b8 type not allowed
# and with the column gone the same table loads and offloads normally
alter table nb_bit secondary_engine = NULL;
alter table nb_bit drop column b8;
alter table nb_bit secondary_engine = rapid;
alter table nb_bit secondary_load;
set session use_secondary_engine = forced;
select id, k from nb_bit order by id;
id	k
1	1
2	2
set session use_secondary_engine = off;
use test;
drop database sh_numb;
