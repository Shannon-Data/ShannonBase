create database sh_bjk;
use sh_bjk;
create table bk_left (id int primary key, kkey text not null, v int not null) secondary_engine=rapid;
create table bk_right (id int primary key, kkey text not null, w int not null) secondary_engine=rapid;
insert into bk_left values (1,'aaa',100),(2,'bbb',200),(3,'ccc',300),(4,'ddd',400);
insert into bk_right values (1,'aaa',1000),(2,'bbb',2000),(3,'bbb',3000),(4,'eee',5000);
alter table bk_left secondary_load;
alter table bk_right secondary_load;
set session optimizer_switch='hypergraph_optimizer=on';
# ===== InnoDB baseline =====
set session use_secondary_engine = off;
select l.id, r.id, l.kkey, l.v, r.w from bk_left l join bk_right r on l.kkey = r.kkey order by l.id, r.id;
id	id	kkey	v	w
1	1	aaa	100	1000
2	2	bbb	200	2000
2	3	bbb	200	3000
select count(*) as n from bk_left l join bk_right r on l.kkey = r.kkey;
n
3
# ===== Rapid =====
set session use_secondary_engine = forced;
select l.id, r.id, l.kkey, l.v, r.w from bk_left l join bk_right r on l.kkey = r.kkey order by l.id, r.id;
id	id	kkey	v	w
1	1	aaa	100	1000
2	2	bbb	200	2000
2	3	bbb	200	3000
select count(*) as n from bk_left l join bk_right r on l.kkey = r.kkey;
n
3
use test;
drop database sh_bjk;
