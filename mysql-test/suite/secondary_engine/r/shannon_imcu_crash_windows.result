CREATE DATABASE sh_crash;
USE sh_crash;
CREATE TABLE t_crash (id INT PRIMARY KEY, v INT NOT NULL) SECONDARY_ENGINE=RAPID;
INSERT INTO t_crash VALUES (1,10),(2,20),(3,30);
ALTER TABLE t_crash SECONDARY_LOAD;
SET SESSION use_secondary_engine = FORCED;
# The row WAL only exists while the recovery scheduler runs, so this
# restart (and every later one) passes rapid_reload_on_restart=ON.
# restart: --rapid_reload_on_restart=ON
USE sh_crash;
SET SESSION use_secondary_engine = FORCED;
SELECT COUNT(*) AS rows_before FROM t_crash;
rows_before
3
# Wait for the published checkpoint manifest, not just its directory.
#
# 1. rapid_crash_before_row_write: the slot is reserved and nothing is
#    durable. Recovery must not duplicate the row, and the rows the
#    crashed statement did not touch must survive the restart unchanged.
#
# The worker must be a new one so it inherits the global debug state, so
# let the idle worker time out first (TABLE_WORKER_IDLE_TIMEOUT = 5s).
SET GLOBAL debug = '+d,rapid_crash_before_row_write';
INSERT INTO t_crash VALUES (4,40);
USE sh_crash;
SET SESSION use_secondary_engine = FORCED;
SELECT CONCAT(id, ':', v) AS stable_rows FROM t_crash WHERE id < 4 ORDER BY id;
stable_rows
1:10
2:20
3:30
SELECT COUNT(*) AS unwritten_rows FROM t_crash WHERE id = 4;
unwritten_rows
0
include/assert.inc [A row without WAL must not appear in snapshot recovery]
#
# 2. rapid_crash_after_row_commit: the COMMIT is durable and the row is
#    not published yet. Recovery must replay it, and the table must still
#    accept writes afterwards.
#
SET GLOBAL debug = '+d,rapid_crash_after_row_commit';
INSERT INTO t_crash VALUES (5,50);
USE sh_crash;
SET SESSION use_secondary_engine = FORCED;
SELECT CONCAT(id, ':', v) AS stable_rows FROM t_crash WHERE id < 4 ORDER BY id;
stable_rows
1:10
2:20
3:30
# The committed row must be replayed from WAL, exactly once.
SELECT CONCAT(id, ':', v) AS committed_row FROM t_crash WHERE id = 5;
committed_row
5:50
include/assert.inc [The durable COMMIT must replay exactly once]
# A write after a crash-recovery must reach Rapid as usual.
INSERT INTO t_crash VALUES (6,60);
SELECT CONCAT(id, ':', v) AS after_write FROM t_crash WHERE id = 6;
after_write
6:60
#
# 3. An unflushed PREPARE is lost on power cut and must not replay.
#
SET GLOBAL debug = '+d,rapid_crash_after_row_prepare';
INSERT INTO t_crash VALUES (8,80);
USE sh_crash;
SET SESSION use_secondary_engine = FORCED;
SELECT COUNT(*) AS uncommitted_rows FROM t_crash WHERE id = 8;
uncommitted_rows
0
include/assert.inc [An uncommitted PREPARE must not replay]
SELECT CONCAT(id, ':', v) AS durable_rows FROM t_crash WHERE id IN (5,6) ORDER BY id;
durable_rows
5:50
6:60
SET GLOBAL debug = '-d,secondary_engine_rapid_load_table_error,rapid_simulate_power_loss';
SET SESSION debug = '-d,secondary_engine_rapid_load_table_error,rapid_simulate_power_loss';
#
# 4. secondary_engine_rapid_wal_append_error: a clean WAL failure, no
#    crash. The server must survive it, InnoDB keeps the row, and the
#    failed Rapid write must leave nothing behind that a reload would
#    duplicate or resurrect.
#
call mtr.add_suppression("Rapid propagation retry .* to imcs failed");
call mtr.add_suppression("Rapid propagation quarantined table .* to imcs failed");
SET GLOBAL debug = '+d,secondary_engine_rapid_wal_append_error';
INSERT INTO t_crash VALUES (7,70);
SET GLOBAL debug = '-d,secondary_engine_rapid_wal_append_error';
SET SESSION use_secondary_engine = OFF;
SELECT COUNT(*) AS innodb_rows FROM t_crash;
innodb_rows
8
ALTER TABLE t_crash SECONDARY_UNLOAD;
ALTER TABLE t_crash SECONDARY_LOAD;
SET SESSION use_secondary_engine = FORCED;
SELECT COUNT(*) AS rapid_rows FROM t_crash;
rapid_rows
8
DROP DATABASE sh_crash;
