# W20: temporal, YEAR, BIT and ENUM arguments are outside the subset:
#      their value and storage representations differ, so reading them
#      back through val_int() would drop e.g. fractional seconds. They
#      must fall back and stay exact.
SELECT id, p,
MIN(dt) OVER w AS mn_dt, MAX(dt) OVER w AS mx_dt,
MIN(yr) OVER w AS mn_yr, MAX(yr) OVER w AS mx_yr,
MIN(e)  OVER w AS mn_e,  MAX(e)  OVER w AS mx_e,
SUM(yr) OVER w AS s_yr
FROM wf WINDOW w AS (PARTITION BY p ORDER BY o) ORDER BY id;
