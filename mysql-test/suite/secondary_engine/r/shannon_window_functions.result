# W5: PARTITION BY without ORDER BY -- the whole partition is one peer
#     group, so the default RANGE frame degenerates to the partition.
SELECT id, p, SUM(i4) OVER (PARTITION BY p) AS s, COUNT(*) OVER (PARTITION BY p) AS c
FROM wf ORDER BY id;
