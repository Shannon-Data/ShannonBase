SET SESSION debug = '-d,rapid_disable_vectorized_window';
#
# ---- The vectorized operator must actually have run ----
#
# A window that is entirely inside the supported subset raises the
# counter by exactly one per output row; a window that is not must leave
# it untouched.
SELECT p, o, SUM(i4) OVER (PARTITION BY p ORDER BY o) FROM wf;
# rows emitted by the vectorized window operator (12 expected):
12
# LAG() is outside the subset, so this window must stay on the native
# iterator and add nothing to the counter.
SELECT p, o, LAG(i4) OVER (PARTITION BY p ORDER BY o) FROM wf;
# rows emitted by the vectorized window operator (0 expected):
0
#
# ---- Batch, partition and peer-group boundaries ----
#
# The operator ingests 1024 rows per pass, so a partition and a peer
# group both have to be able to span passes. big.p has one partition of
# 4000 rows; big.grp holds peer groups of 1500 rows, longer than a pass;
# and big.uniq makes every row its own peer group.
SET SESSION use_secondary_engine = OFF;
SET SESSION cte_max_recursion_depth = 10000;
CREATE TABLE big (
id   INT PRIMARY KEY,
p    INT,
grp  INT,
uniq INT,
v    INT,
vd   DECIMAL(12,3),
vf   DOUBLE,
nv   INT
) SECONDARY_ENGINE RAPID;
INSERT INTO big (id, p, grp, uniq, v, vd, vf, nv)
WITH RECURSIVE seq(n) AS (
SELECT 1 UNION ALL SELECT n + 1 FROM seq WHERE n < 6000
)
SELECT n,
IF(n <= 4000, 1, 2),
n DIV 1500,
n,
(n * 7) % 1000 - 500,
((n * 13) % 99999) / 1000,
((n * 17) % 7919) / 7.0,
IF(n % 5 = 0, NULL, n % 97)
FROM seq;
SET SESSION cte_max_recursion_depth = DEFAULT;
ANALYZE TABLE big;
Table	Op	Msg_type	Msg_text
sh_wf_db.big	analyze	status	OK
ALTER TABLE big SECONDARY_LOAD;
# B1: a 4000-row partition under a ROWS running frame. That frame needs no
#     frame buffer, so this one stays on MySQL's non-buffering iterator in
#     both engines; it is here to pin the answer, not the operator.
SELECT SUM(s), MIN(s), MAX(s), COUNT(s), BIT_XOR(CAST(s AS UNSIGNED))
FROM (SELECT SUM(v) OVER (PARTITION BY p ORDER BY id
ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS s
FROM big) t;
SUM(s)	MIN(s)	MAX(s)	COUNT(s)	BIT_XOR(CAST(s AS UNSIGNED))
-75578000	-19750	71	6000	1064
# B2: peer groups of 1500 rows under the default RANGE frame: a group
#     stays open across passes and every row of it must land on the value
#     the group ends with.
SELECT SUM(s), MIN(s), MAX(s), COUNT(DISTINCT s)
FROM (SELECT SUM(v) OVER (ORDER BY grp) AS s FROM big) t;
SUM(s)	MIN(s)	MAX(s)	COUNT(DISTINCT s)
-63734250	-20250	-1000	5
# B3: every row its own peer group, so a pass closes 1024 groups at once.
SELECT SUM(s), MIN(s), MAX(s), COUNT(s)
FROM (SELECT SUM(v) OVER (ORDER BY uniq) AS s FROM big) t;
SUM(s)	MIN(s)	MAX(s)	COUNT(s)
-79578000	-20750	71	6000
# B4: whole-partition frame over 4000 and 2000 rows -- nothing may be
#     emitted before the partition closes.
SELECT p, MIN(s), MAX(s), MIN(a), MAX(a), COUNT(*)
FROM (SELECT p,
SUM(v) OVER (PARTITION BY p ORDER BY id
ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) AS s,
AVG(v) OVER (PARTITION BY p ORDER BY id
ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) AS a
FROM big) t
GROUP BY p ORDER BY p;
p	MIN(s)	MAX(s)	MIN(a)	MAX(a)	COUNT(*)
1	-2000	-2000	-0.5000	-0.5000	4000
2	-1000	-1000	-0.5000	-0.5000	2000
# B5: decimal and double running aggregates at scale.
SELECT SUM(sd), MIN(sd), MAX(sd), ROUND(SUM(sf), 6), ROUND(MIN(sf), 6), ROUND(MAX(sf), 6)
FROM (SELECT SUM(vd) OVER (PARTITION BY p ORDER BY id) AS sd,
SUM(vf) OVER (PARTITION BY p ORDER BY id) AS sf
FROM big) t;
SUM(sd)	MIN(sd)	MAX(sd)	ROUND(SUM(sf), 6)	ROUND(MIN(sf), 6)	ROUND(MAX(sf), 6)
260182026.000	0.013	130013.000	5521257545.281403	2.428571	2198290.714284
# B6: NULLs spread through a large partition.
SELECT SUM(c), SUM(s), ROUND(SUM(a), 6), MIN(mn), MAX(mx)
FROM (SELECT COUNT(nv) OVER w AS c, SUM(nv) OVER w AS s, AVG(nv) OVER w AS a,
MIN(nv) OVER w AS mn, MAX(nv) OVER w AS mx
FROM big WINDOW w AS (PARTITION BY p ORDER BY id)) t;
SUM(c)	SUM(s)	ROUND(SUM(a), 6)	MIN(mn)	MAX(mx)
8004800	381846267	282669.6199	0	96
# B7: ranking across pass boundaries -- rank must keep counting from the
#     partition start, not from the start of the buffered block.
SELECT MAX(rn), MAX(rnk), MAX(drnk), SUM(rn), SUM(rnk), SUM(drnk)
FROM (SELECT ROW_NUMBER() OVER w AS rn, RANK() OVER w AS rnk,
DENSE_RANK() OVER w AS drnk, SUM(v) OVER w AS s
FROM big WINDOW w AS (PARTITION BY p ORDER BY grp)) t;
MAX(rn)	MAX(rnk)	MAX(drnk)	SUM(rn)	SUM(rnk)	SUM(drnk)
4000	3000	3	10003000	6006998	11004
SET SESSION use_secondary_engine = FORCED;
