9	3	10	1	1	1
10	4	10	1	1	1
11	4	20	2	2	2
12	4	30	3	3	3
# W2: default frame (RANGE UNBOUNDED PRECEDING .. CURRENT ROW): every row
#     of a peer group sees the same running aggregate.
SELECT id, p, o,
COUNT(i4) OVER w AS c,
SUM(i4)   OVER w AS s,
AVG(i4)   OVER w AS a,
MIN(i4)   OVER w AS mn,
MAX(i4)   OVER w AS mx
FROM wf WINDOW w AS (PARTITION BY p ORDER BY o) ORDER BY id;
