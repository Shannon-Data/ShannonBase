# W3: same aggregates over ROWS UNBOUNDED PRECEDING .. CURRENT ROW, where
#     peers no longer share a value -- a running value per row.
SELECT id, p, o,
COUNT(i4) OVER w AS c,
SUM(i4)   OVER w AS s,
AVG(i4)   OVER w AS a,
MIN(i4)   OVER w AS mn,
MAX(i4)   OVER w AS mx
FROM wf
WINDOW w AS (PARTITION BY p ORDER BY o ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)
ORDER BY id;
