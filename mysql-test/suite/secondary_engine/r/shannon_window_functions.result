# Those three run on MySQL's iterators (a ROWS running frame needs no
# buffer, and the trailing ORDER BY materializes above the window step).
# The overflow fold itself is this operator's own code, so drive it
# through the shape the operator survives -- a bare select with a single
# window step, captured with CREATE TABLE ... AS -- and compare row by
# row. A second window step in the same query would materialize the
# first one and take the whole island native again, so they are split.
# AVG stays out of the capture: materializing AVG() of these extremes
# overflows MySQL's own frame-buffer column, in both engines alike. The
# fold under test is the SUM accumulator, and I1/I2 above still pin AVG.
SET SESSION use_secondary_engine = OFF;
CREATE TABLE sh_wf_base.i1 AS
SELECT id, p, SUM(b) OVER w AS sb, SUM(ub) OVER w AS sub,
MIN(b) OVER w AS mnb, MAX(ub) OVER w AS mxub
FROM wf_big_int
WINDOW w AS (PARTITION BY p ORDER BY id
ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING);
CREATE TABLE sh_wf_base.i2 AS
SELECT id, p, SUM(b) OVER w AS sb, SUM(ub) OVER w AS sub
FROM wf_big_int WINDOW w AS (PARTITION BY p ORDER BY id);
SET SESSION use_secondary_engine = FORCED;
CREATE TABLE sh_wf_rpd.i1 AS
SELECT id, p, SUM(b) OVER w AS sb, SUM(ub) OVER w AS sub,
MIN(b) OVER w AS mnb, MAX(ub) OVER w AS mxub
FROM wf_big_int
WINDOW w AS (PARTITION BY p ORDER BY id
ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING);
CREATE TABLE sh_wf_rpd.i2 AS
SELECT id, p, SUM(b) OVER w AS sb, SUM(ub) OVER w AS sub
FROM wf_big_int WINDOW w AS (PARTITION BY p ORDER BY id);
# rows emitted by the vectorized window operator (16 expected, eight rows twice):
16
SET SESSION use_secondary_engine = OFF;
# every number must be 0:
SELECT (SELECT COUNT(*) FROM sh_wf_base.i1) - (SELECT COUNT(*) FROM sh_wf_rpd.i1) AS row_delta,
(SELECT COUNT(*) FROM (SELECT * FROM sh_wf_base.i1 EXCEPT ALL SELECT * FROM sh_wf_rpd.i1) x) AS only_innodb,
(SELECT COUNT(*) FROM (SELECT * FROM sh_wf_rpd.i1 EXCEPT ALL SELECT * FROM sh_wf_base.i1) y) AS only_rapid;
row_delta	only_innodb	only_rapid
0	0	0
SELECT (SELECT COUNT(*) FROM sh_wf_base.i2) - (SELECT COUNT(*) FROM sh_wf_rpd.i2) AS row_delta,
(SELECT COUNT(*) FROM (SELECT * FROM sh_wf_base.i2 EXCEPT ALL SELECT * FROM sh_wf_rpd.i2) x) AS only_innodb,
(SELECT COUNT(*) FROM (SELECT * FROM sh_wf_rpd.i2 EXCEPT ALL SELECT * FROM sh_wf_base.i2) y) AS only_rapid;
row_delta	only_innodb	only_rapid
0	0	0
