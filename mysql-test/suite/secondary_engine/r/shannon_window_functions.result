# W4: whole-partition frame -- one value for every row of the partition.
SELECT id, p,
COUNT(i4) OVER w AS c,
SUM(i4)   OVER w AS s,
AVG(i4)   OVER w AS a,
MIN(i4)   OVER w AS mn,
MAX(i4)   OVER w AS mx
FROM wf
WINDOW w AS (PARTITION BY p ORDER BY o ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING)
ORDER BY id;
