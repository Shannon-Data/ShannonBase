#
# ---- The operator itself: partitions ending on an ingest-pass boundary ----
#
# Everything above compares Rapid against InnoDB, but a trailing ORDER BY
# or a derived table materializes above the window step and turns the
# whole physical island native, so those queries exercise MySQL's window
# iterators under both engines. The block below uses the shape that keeps
# VectorizedWindowIterator in the plan -- a bare select, captured with
# CREATE TABLE ... AS so it can be compared without an ORDER BY -- and
# asserts the operator's row counter, so a future fallback shows up as a
# failure instead of silently making all of this vacuous.
#
# The row that ends a partition is carried over to open the next one, and
# an ingest pass is 1024 rows. algn ends a partition exactly on a pass
# boundary twice: partition 0 is 1024 rows (a pass counted from the first
# row of the input) and partition 1 is 1025 rows (a pass counted from the
# carried-over row). Partition 2 (2048 rows) ends mid-pass as a control.
SET SESSION use_secondary_engine = OFF;
SET SESSION cte_max_recursion_depth = 10000;
CREATE TABLE algn (
id INT PRIMARY KEY,
p  INT,
o  INT,
v  INT,
nv INT,
vd DECIMAL(12,3),
vf DOUBLE
) SECONDARY_ENGINE RAPID;
INSERT INTO algn (id, p, o, v, nv, vd, vf)
WITH RECURSIVE seq(n) AS (
SELECT 1 UNION ALL SELECT n + 1 FROM seq WHERE n < 4103
)
SELECT n,
CASE WHEN n <= 1024 THEN 0 WHEN n <= 2049 THEN 1
WHEN n <= 4097 THEN 2 ELSE 3 END,
n DIV 100,
(n * 7) % 1000 - 500,
IF(n % 5 = 0, NULL, n % 97),
((n * 13) % 99999) / 1000,
((n * 17) % 7919) / 7.0
FROM seq;
SET SESSION cte_max_recursion_depth = DEFAULT;
ANALYZE TABLE algn;
Table	Op	Msg_type	Msg_text
sh_wf_db.algn	analyze	status	OK
ALTER TABLE algn SECONDARY_LOAD;
CREATE DATABASE sh_wf_base;
CREATE DATABASE sh_wf_rpd;
CREATE DATABASE sh_wf_spill;
# The InnoDB answer.
USE sh_wf_base;
# A1: RANGE running frame with 100-row peer groups, so a peer group is
#     still open when a pass runs out of rows, together with the ranking
#     functions -- all partition scoped, so nothing may cross a boundary.
CREATE TABLE a1 AS
SELECT id, p, SUM(v) OVER w AS s, ROW_NUMBER() OVER w AS rn,
RANK() OVER w AS rnk, DENSE_RANK() OVER w AS drnk
FROM sh_wf_db.algn WINDOW w AS (PARTITION BY p ORDER BY o);
# A2: every row its own peer group, so one pass closes 1024 groups and
#     partition 0 ends with the last group of a pass.
CREATE TABLE a2 AS
SELECT id, p, SUM(v) OVER w AS s, COUNT(nv) OVER w AS c, AVG(nv) OVER w AS a,
MIN(nv) OVER w AS mn, MAX(nv) OVER w AS mx
FROM sh_wf_db.algn WINDOW w AS (PARTITION BY p ORDER BY id);
