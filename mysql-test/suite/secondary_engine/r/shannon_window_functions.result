# W15: a supported and an unsupported function sharing one window; the
#      whole step falls back, so the supported one must still be right.
SELECT id, p, o,
SUM(i4) OVER w AS s,
LAG(i4) OVER w AS lg
FROM wf WINDOW w AS (PARTITION BY p ORDER BY o) ORDER BY id;
