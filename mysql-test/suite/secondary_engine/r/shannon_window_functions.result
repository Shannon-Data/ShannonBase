# A3: whole-partition frame over the same boundaries: nothing may be
#     emitted before the partition closes, and every accumulator must
#     restart from zero for the next one.
CREATE TABLE a3 AS
SELECT id, p, SUM(v) OVER w AS s, COUNT(nv) OVER w AS c, AVG(nv) OVER w AS a,
MIN(nv) OVER w AS mn, MAX(nv) OVER w AS mx
FROM sh_wf_db.algn
WINDOW w AS (PARTITION BY p ORDER BY id
ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING);
Warnings:
Note	1265	Data truncated for column 'a' at row 2050
# A4: decimal and double arguments over a single 4103-row partition --
#     no PARTITION BY, so one partition spans four ingest passes.
CREATE TABLE a4 AS
SELECT id, SUM(vd) OVER w AS sd, AVG(vd) OVER w AS ad, MIN(vd) OVER w AS mnd,
SUM(vf) OVER w AS sf, MIN(vf) OVER w AS mnf, MAX(vf) OVER w AS mxf
FROM sh_wf_db.algn WINDOW w AS (ORDER BY o);
# The Rapid answer.
USE sh_wf_rpd;
SET SESSION use_secondary_engine = FORCED;
# A1: RANGE running frame with 100-row peer groups, so a peer group is
#     still open when a pass runs out of rows, together with the ranking
#     functions -- all partition scoped, so nothing may cross a boundary.
CREATE TABLE a1 AS
SELECT id, p, SUM(v) OVER w AS s, ROW_NUMBER() OVER w AS rn,
RANK() OVER w AS rnk, DENSE_RANK() OVER w AS drnk
FROM sh_wf_db.algn WINDOW w AS (PARTITION BY p ORDER BY o);
# A2: every row its own peer group, so one pass closes 1024 groups and
#     partition 0 ends with the last group of a pass.
CREATE TABLE a2 AS
SELECT id, p, SUM(v) OVER w AS s, COUNT(nv) OVER w AS c, AVG(nv) OVER w AS a,
MIN(nv) OVER w AS mn, MAX(nv) OVER w AS mx
FROM sh_wf_db.algn WINDOW w AS (PARTITION BY p ORDER BY id);
# A3: whole-partition frame over the same boundaries: nothing may be
#     emitted before the partition closes, and every accumulator must
#     restart from zero for the next one.
CREATE TABLE a3 AS
SELECT id, p, SUM(v) OVER w AS s, COUNT(nv) OVER w AS c, AVG(nv) OVER w AS a,
MIN(nv) OVER w AS mn, MAX(nv) OVER w AS mx
FROM sh_wf_db.algn
WINDOW w AS (PARTITION BY p ORDER BY id
ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING);
# A4: decimal and double arguments over a single 4103-row partition --
#     no PARTITION BY, so one partition spans four ingest passes.
CREATE TABLE a4 AS
SELECT id, SUM(vd) OVER w AS sd, AVG(vd) OVER w AS ad, MIN(vd) OVER w AS mnd,
SUM(vf) OVER w AS sf, MIN(vf) OVER w AS mnf, MAX(vf) OVER w AS mxf
FROM sh_wf_db.algn WINDOW w AS (ORDER BY o);
# rows emitted by the vectorized window operator (16412 expected):
16412
#
# The Rapid answer again with the buffer budget shrunk to four records.
# A running frame can no longer serve a partial pass: the spill file is
# read strictly forward, so the operator holds every row back until the
# partition closes and then drains it in one sweep, four partitions in a
# row, each restarting the file.
USE sh_wf_spill;
SET SESSION debug = '+d,rapid_window_tiny_buffer';
# A1: RANGE running frame with 100-row peer groups, so a peer group is
#     still open when a pass runs out of rows, together with the ranking
#     functions -- all partition scoped, so nothing may cross a boundary.
CREATE TABLE a1 AS
SELECT id, p, SUM(v) OVER w AS s, ROW_NUMBER() OVER w AS rn,
RANK() OVER w AS rnk, DENSE_RANK() OVER w AS drnk
FROM sh_wf_db.algn WINDOW w AS (PARTITION BY p ORDER BY o);
# A2: every row its own peer group, so one pass closes 1024 groups and
#     partition 0 ends with the last group of a pass.
CREATE TABLE a2 AS
SELECT id, p, SUM(v) OVER w AS s, COUNT(nv) OVER w AS c, AVG(nv) OVER w AS a,
MIN(nv) OVER w AS mn, MAX(nv) OVER w AS mx
FROM sh_wf_db.algn WINDOW w AS (PARTITION BY p ORDER BY id);
# A3: whole-partition frame over the same boundaries: nothing may be
#     emitted before the partition closes, and every accumulator must
#     restart from zero for the next one.
CREATE TABLE a3 AS
SELECT id, p, SUM(v) OVER w AS s, COUNT(nv) OVER w AS c, AVG(nv) OVER w AS a,
MIN(nv) OVER w AS mn, MAX(nv) OVER w AS mx
FROM sh_wf_db.algn
WINDOW w AS (PARTITION BY p ORDER BY id
ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING);
# A4: decimal and double arguments over a single 4103-row partition --
#     no PARTITION BY, so one partition spans four ingest passes.
CREATE TABLE a4 AS
SELECT id, SUM(vd) OVER w AS sd, AVG(vd) OVER w AS ad, MIN(vd) OVER w AS mnd,
SUM(vf) OVER w AS sf, MIN(vf) OVER w AS mnf, MAX(vf) OVER w AS mxf
FROM sh_wf_db.algn WINDOW w AS (ORDER BY o);
SET SESSION debug = '-d,rapid_window_tiny_buffer';
