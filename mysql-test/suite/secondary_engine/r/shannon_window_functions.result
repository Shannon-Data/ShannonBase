#
# ============ Rapid with the vectorized operator switched off ==========
#
# Same engine, same plan, MySQL's window iterators underneath: this
# isolates the operator from everything else Rapid does to the query.
SET SESSION debug = '+d,rapid_disable_vectorized_window';
# W1: ranking only -- no framing function, so the window does not buffer
#     and stays on MySQL's streaming WindowIterator even under Rapid.
SELECT id, p, o,
ROW_NUMBER() OVER w AS rn,
RANK()       OVER w AS rnk,
DENSE_RANK() OVER w AS drnk
FROM wf WINDOW w AS (PARTITION BY p ORDER BY o) ORDER BY id;
