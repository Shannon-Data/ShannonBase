#
# The rows straddling every partition boundary, spelled out, so a value
# leaking across a boundary shows up as a row rather than as a count.
# Partitions are ids 1-1024, 1025-2049, 2050-4097, 4098-4103.
SELECT * FROM sh_wf_rpd.a2
WHERE id IN (1, 2, 1023, 1024, 1025, 1026, 2048, 2049, 2050, 2051,
4096, 4097, 4098, 4099, 4103)
ORDER BY id;
