#
# ---- Kernel dispatch: NULL granularity ----
#
# The SIMD kernels take no NULL mask, so they need a NULL-free range.
# That question is asked per segment (one peer group), not per ingest
# pass: with sparse NULLs nearly every peer group is clean even though
# the pass as a whole is not, and asking per pass would give the
# vectorized path away for all of them.
#
# nb makes the split exact: 8192 rows, 32 peer groups of 256, and one
# NULL landing in each of 8 distinct groups. Asking per pass would put
# all 8192 rows x 4 kernels on the scalar path, because every 1024-row
# pass holds a NULL. Asking per segment leaves only the 8 groups that
# really contain one.
SET SESSION use_secondary_engine = OFF;
SET SESSION cte_max_recursion_depth = 20000;
CREATE TABLE nb (id INT PRIMARY KEY, o INT, v INT, nv INT) SECONDARY_ENGINE RAPID;
INSERT INTO nb (id, o, v, nv)
WITH RECURSIVE seq(n) AS (
SELECT 1 UNION ALL SELECT n + 1 FROM seq WHERE n < 8192
)
SELECT n, (n - 1) DIV 256, n % 1000, IF(n % 1024 = 0, NULL, n % 997)
FROM seq;
SET SESSION cte_max_recursion_depth = DEFAULT;
ANALYZE TABLE nb;
Table	Op	Msg_type	Msg_text
sh_wf_db.nb	analyze	status	OK
ALTER TABLE nb SECONDARY_LOAD;
CREATE TABLE sh_wf_base.n1 AS
SELECT id, COUNT(nv) OVER w AS c, SUM(nv) OVER w AS s, MIN(nv) OVER w AS mn, MAX(nv) OVER w AS mx
FROM nb WINDOW w AS (ORDER BY o);
SET SESSION use_secondary_engine = FORCED;
CREATE TABLE sh_wf_rpd.n1 AS
SELECT id, COUNT(nv) OVER w AS c, SUM(nv) OVER w AS s, MIN(nv) OVER w AS mn, MAX(nv) OVER w AS mx
FROM nb WINDOW w AS (ORDER BY o);
# sparse NULLs, 24 clean groups x 256 rows x 4 kernels
# rows through the SIMD kernels (24576 expected):
24576
# rows through the scalar kernels (8192 expected):
8192
# Control: the same four kernels over a column with no NULL at all.
SELECT id, COUNT(v) OVER w AS c, SUM(v) OVER w AS s, MIN(v) OVER w AS mn, MAX(v) OVER w AS mx
FROM nb WINDOW w AS (ORDER BY o);
# rows through the SIMD kernels (32768 expected):
32768
# rows through the scalar kernels (0 expected):
0
SET SESSION use_secondary_engine = OFF;
# and the dispatch must not have changed a single value:
SELECT (SELECT COUNT(*) FROM sh_wf_base.n1) - (SELECT COUNT(*) FROM sh_wf_rpd.n1) AS row_delta,
(SELECT COUNT(*) FROM (SELECT * FROM sh_wf_base.n1 EXCEPT ALL SELECT * FROM sh_wf_rpd.n1) x) AS only_innodb,
(SELECT COUNT(*) FROM (SELECT * FROM sh_wf_rpd.n1 EXCEPT ALL SELECT * FROM sh_wf_base.n1) y) AS only_rapid;
row_delta	only_innodb	only_rapid
0	0	0
#
# ---- Integer accumulator overflow ----
#
# SUM() over an integer argument returns DECIMAL, and MySQL accumulates it
# one decimal addition per row. The operator accumulates in int64 instead
# and only folds into a decimal carry on overflow, so a running frame that
# crosses the int64 range on both the signed and the unsigned side has to
# produce the same decimal.
CREATE TABLE wf_big_int (
id INT PRIMARY KEY,
p  INT,
b  BIGINT,
ub BIGINT UNSIGNED
) SECONDARY_ENGINE RAPID;
INSERT INTO wf_big_int VALUES
(1, 1,  9223372036854775807, 18446744073709551615),
(2, 1,  9223372036854775806, 18446744073709551614),
(3, 1,  9223372036854775805, 18446744073709551613),
(4, 1, -9223372036854775808,                    1),
(5, 1,  9223372036854775807, 18446744073709551615),
(6, 2, -9223372036854775808,                    0),
(7, 2, -9223372036854775807,                    1),
(8, 2, -9223372036854775806, 18446744073709551615);
