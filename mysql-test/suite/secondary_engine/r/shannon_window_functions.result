ALTER TABLE wf SECONDARY_LOAD;
#
# ============ InnoDB baseline ============
#
SET SESSION use_secondary_engine = OFF;
# W1: ranking only -- no framing function, so the window does not buffer
#     and stays on MySQL's streaming WindowIterator even under Rapid.
SELECT id, p, o,
ROW_NUMBER() OVER w AS rn,
RANK()       OVER w AS rnk,
DENSE_RANK() OVER w AS drnk
FROM wf WINDOW w AS (PARTITION BY p ORDER BY o) ORDER BY id;
id	p	o	rn	rnk	drnk
