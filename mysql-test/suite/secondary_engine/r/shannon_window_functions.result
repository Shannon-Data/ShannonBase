# B2: peer groups of 1500 rows under the default RANGE frame: a group
#     stays open across passes and every row of it must land on the value
#     the group ends with.
SELECT SUM(s), MIN(s), MAX(s), COUNT(DISTINCT s)
FROM (SELECT SUM(v) OVER (ORDER BY grp) AS s FROM big) t;
