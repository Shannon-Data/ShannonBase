#
# ---- Boundary cases, through the operator ----
#
# An all-NULL frame, single-row partitions, one peer group that outlives
# both an ingest pass and the memory budget, and arguments at the top of
# the unsigned BIGINT and DECIMAL ranges. Captured and compared exactly
# like the algn block above, and run a third time with the buffer budget
# shrunk so the giant peer group has to go through the spill file.
SET SESSION use_secondary_engine = OFF;
SET SESSION cte_max_recursion_depth = 10000;
CREATE TABLE edge (
id INT PRIMARY KEY,
p  INT,
o  INT,
v  INT,
nv INT,
ud BIGINT UNSIGNED,
dc DECIMAL(30,4)
) SECONDARY_ENGINE RAPID;
INSERT INTO edge (id, p, o, v, nv, ud, dc) VALUES
(1, 0, 1,  10, NULL, 1, 1.5000),
(2, 0, 2, -20, NULL, 2, 2.5000),
(3, 0, 3,  30, NULL, 3, 3.5000),
(4, 1, 1,   7,    7, 4, 4.5000),
(5, 2, 1,   9, NULL, 5, 5.5000);
INSERT INTO edge (id, p, o, v, nv, ud, dc)
WITH RECURSIVE seq(n) AS (
SELECT 1 UNION ALL SELECT n + 1 FROM seq WHERE n < 1500
)
SELECT n + 5, 3, 0, (n * 7) % 1000 - 500, IF(n % 3 = 0, NULL, n % 53), n * 1000, n / 7
FROM seq;
