CREATE DATABASE sh_wf_db;
USE sh_wf_db;
CREATE TABLE wf (
id    INT PRIMARY KEY,
p     INT,              # partition key
o     INT,              # order key, deliberately with ties
i4    INT,
i8    BIGINT,
u8    BIGINT UNSIGNED,
d     DOUBLE,
dec1  DECIMAL(15,2),
ni    INT,              # nullable integer
nd    DECIMAL(15,2),    # nullable decimal
s     VARCHAR(10),
dt    DATETIME(6),
yr    YEAR,
e     ENUM('lo','mid','hi')
) SECONDARY_ENGINE RAPID;
