#
# ---- Spilling the buffered partition ----
#
# A whole-partition frame cannot emit anything until the partition has
# been read, so its record images are what overflows the operator's memory
# budget and goes to a temporary file. Reaching 64MB with real data would
# take a very large partition, so shrink the budget to four records.
SET SESSION use_secondary_engine = OFF;
# S1: whole-partition frame -- every record image is buffered until the
#     partition closes, so all but the first few come back off disk.
SELECT p, MIN(s), MAX(s), MIN(c), MAX(c), COUNT(*)
FROM (SELECT p,
SUM(v) OVER (PARTITION BY p ORDER BY id
ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) AS s,
COUNT(v) OVER (PARTITION BY p ORDER BY id
ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) AS c
FROM big) t
GROUP BY p ORDER BY p;
p	MIN(s)	MAX(s)	MIN(c)	MAX(c)	COUNT(*)
1	-2000	-2000	4000	4000	4000
2	-1000	-1000	2000	2000	2000
# S2: a long peer group under the default RANGE frame spills the same way,
#     and ranking must survive the round trip through the file.
SELECT MAX(rn), MAX(rnk), MAX(drnk), SUM(s), MIN(s), MAX(s)
FROM (SELECT ROW_NUMBER() OVER w AS rn, RANK() OVER w AS rnk,
DENSE_RANK() OVER w AS drnk, SUM(v) OVER w AS s
FROM big WINDOW w AS (PARTITION BY p ORDER BY grp)) t;
MAX(rn)	MAX(rnk)	MAX(drnk)	SUM(s)	MIN(s)	MAX(s)
4000	3000	3	-41466000	-18750	-500
# S3: a running ROWS frame needs no frame buffer at all, so it never
#     reaches this operator and the shrunken budget cannot move its
#     values either; kept as a control on the surrounding queries.
SELECT SUM(s), MIN(s), MAX(s), COUNT(s)
FROM (SELECT SUM(v) OVER (PARTITION BY p ORDER BY id
ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS s
FROM big) t;
SUM(s)	MIN(s)	MAX(s)	COUNT(s)
-75578000	-19750	71	6000
# S4: the spilled rows carry the non-window columns too, so select them
#     back out alongside the window value.
SELECT id, p, grp, v, SUM(v) OVER (PARTITION BY p ORDER BY id
ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) AS s
FROM big WHERE id IN (1, 2, 3, 4, 5, 6, 4000, 4001, 5999, 6000) ORDER BY id;
id	p	grp	v	s
1	1	0	-493	-3353
2	1	0	-486	-3353
3	1	0	-479	-3353
4	1	0	-472	-3353
5	1	0	-465	-3353
6	1	0	-458	-3353
4000	1	2	-500	-3353
4001	2	2	-493	-500
5999	2	3	493	-500
6000	2	4	-500	-500
SET SESSION use_secondary_engine = FORCED;
SET SESSION debug = '+d,rapid_window_tiny_buffer';
# S1: whole-partition frame -- every record image is buffered until the
#     partition closes, so all but the first few come back off disk.
SELECT p, MIN(s), MAX(s), MIN(c), MAX(c), COUNT(*)
FROM (SELECT p,
SUM(v) OVER (PARTITION BY p ORDER BY id
ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) AS s,
COUNT(v) OVER (PARTITION BY p ORDER BY id
ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) AS c
FROM big) t
GROUP BY p ORDER BY p;
p	MIN(s)	MAX(s)	MIN(c)	MAX(c)	COUNT(*)
1	-2000	-2000	4000	4000	4000
2	-1000	-1000	2000	2000	2000
# S2: a long peer group under the default RANGE frame spills the same way,
#     and ranking must survive the round trip through the file.
SELECT MAX(rn), MAX(rnk), MAX(drnk), SUM(s), MIN(s), MAX(s)
FROM (SELECT ROW_NUMBER() OVER w AS rn, RANK() OVER w AS rnk,
DENSE_RANK() OVER w AS drnk, SUM(v) OVER w AS s
FROM big WINDOW w AS (PARTITION BY p ORDER BY grp)) t;
MAX(rn)	MAX(rnk)	MAX(drnk)	SUM(s)	MIN(s)	MAX(s)
4000	3000	3	-41466000	-18750	-500
# S3: a running ROWS frame needs no frame buffer at all, so it never
#     reaches this operator and the shrunken budget cannot move its
#     values either; kept as a control on the surrounding queries.
SELECT SUM(s), MIN(s), MAX(s), COUNT(s)
FROM (SELECT SUM(v) OVER (PARTITION BY p ORDER BY id
ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS s
FROM big) t;
SUM(s)	MIN(s)	MAX(s)	COUNT(s)
-75578000	-19750	71	6000
# S4: the spilled rows carry the non-window columns too, so select them
#     back out alongside the window value.
SELECT id, p, grp, v, SUM(v) OVER (PARTITION BY p ORDER BY id
ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) AS s
FROM big WHERE id IN (1, 2, 3, 4, 5, 6, 4000, 4001, 5999, 6000) ORDER BY id;
id	p	grp	v	s
1	1	0	-493	-3353
2	1	0	-486	-3353
3	1	0	-479	-3353
4	1	0	-472	-3353
5	1	0	-465	-3353
6	1	0	-458	-3353
4000	1	2	-500	-3353
4001	2	2	-493	-500
5999	2	3	493	-500
6000	2	4	-500	-500
# The spilled queries must have gone through the vectorized operator, not
# quietly fallen back to the native one.
SELECT id, SUM(v) OVER (PARTITION BY p ORDER BY id
ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING)
FROM big;
# rows emitted by the vectorized window operator while spilling (6000 expected):
6000
SET SESSION debug = '-d,rapid_window_tiny_buffer';
#
# ---- Empty input ----
#
CREATE TABLE wf_empty (id INT PRIMARY KEY, p INT, o INT, v INT) SECONDARY_ENGINE RAPID;
ANALYZE TABLE wf_empty;
Table	Op	Msg_type	Msg_text
sh_wf_db.wf_empty	analyze	status	OK
ALTER TABLE wf_empty SECONDARY_LOAD;
SET SESSION use_secondary_engine = OFF;
SELECT p, ROW_NUMBER() OVER w, SUM(v) OVER w FROM wf_empty
WINDOW w AS (PARTITION BY p ORDER BY o);
p	ROW_NUMBER() OVER w	SUM(v) OVER w
SET SESSION use_secondary_engine = FORCED;
SELECT p, ROW_NUMBER() OVER w, SUM(v) OVER w FROM wf_empty
WINDOW w AS (PARTITION BY p ORDER BY o);
p	ROW_NUMBER() OVER w	SUM(v) OVER w
SET SESSION use_secondary_engine = DEFAULT;
DROP TABLE wf_empty;
