EXPLAIN FORMAT=TREE SELECT a.id AS left_id,b.id AS right_id FROM ga_a a IGNORE INDEX(PRIMARY) LEFT JOIN ga_a b IGNORE INDEX(PRIMARY) ON a.id+10=b.id WHERE a.v IS NULL ORDER BY a.id;
EXPLAIN
-> Nested loop left join  (...)
    -> Sort: a.id  (...)
        -> Filter: (a.v is null)  (...)
