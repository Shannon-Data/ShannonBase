SET use_secondary_engine=OFF;
CREATE TABLE ga_a(id INT PRIMARY KEY, v INT) SECONDARY_ENGINE=rapid;
CREATE TABLE ga_b(id INT PRIMARY KEY, v INT) SECONDARY_ENGINE=rapid;
INSERT INTO ga_a VALUES(1,NULL),(2,20),(3,30);
INSERT INTO ga_b VALUES(1,100),(2,NULL);
ALTER TABLE ga_a SECONDARY_LOAD;
ALTER TABLE ga_b SECONDARY_LOAD;
SET optimizer_switch='hypergraph_optimizer=off';
SET use_secondary_engine=OFF;
SELECT a.id AS left_id,b.id AS right_id FROM ga_a a IGNORE INDEX(PRIMARY) LEFT JOIN ga_a b IGNORE INDEX(PRIMARY) ON a.id+10=b.id WHERE a.v IS NULL ORDER BY a.id;
left_id	right_id
1	NULL
SELECT a.id,b.id FROM ga_a a IGNORE INDEX(PRIMARY)
LEFT JOIN ga_b b IGNORE INDEX(PRIMARY) ON a.id=b.id AND b.v<0
ORDER BY a.id;
id	id
1	NULL
2	NULL
3	NULL
SELECT a.id,b.id FROM ga_a a IGNORE INDEX(PRIMARY)
LEFT JOIN ga_b b IGNORE INDEX(PRIMARY) ON a.id+1=b.id
ORDER BY a.id;
