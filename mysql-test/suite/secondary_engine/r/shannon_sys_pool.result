SELECT COUNT(*) AS removed_memory_knobs
FROM performance_schema.global_variables
WHERE VARIABLE_NAME IN ('rapid_query_memory_size_total','rapid_query_memory_size_max',
'rapid_operator_memory_size_max','rapid_checkpoint_memory_size_max',
'rapid_pop_buffer_size_max');
