SELECT CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(VARIABLE_VALUE,'peak=',-1),' ',1) AS UNSIGNED)>0 AS allocated_in_sys_pool
FROM performance_schema.global_status WHERE VARIABLE_NAME='rapid_sys_pool_status';
