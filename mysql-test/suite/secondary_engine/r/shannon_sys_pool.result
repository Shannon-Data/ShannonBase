SELECT REGEXP_SUBSTR(VARIABLE_VALUE,'used=[0-9]+') AS released_buffers,
REGEXP_SUBSTR(VARIABLE_VALUE,'reserved=[0-9]+') AS released_grants
FROM performance_schema.global_status WHERE VARIABLE_NAME='rapid_sys_pool_status';
