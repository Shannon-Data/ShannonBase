CREATE DATABASE storage_pred_types;
USE storage_pred_types;
CREATE TABLE t (
id INT PRIMARY KEY, d DATE, dt0 DATETIME, dt6 DATETIME(6),
d15 DECIMAL(15,2), d16 DECIMAL(16,2),
ts TIMESTAMP NULL, c CHAR(10), v VARCHAR(20), ui INT UNSIGNED, ubi BIGINT UNSIGNED
) SECONDARY_ENGINE=RAPID;
INSERT INTO t VALUES
(1,'1995-01-01','1995-01-01 10:00:00','1995-01-01 10:00:00.500000',
10.50,10.50,'1995-01-01 10:00:00','ab','ab',1,1),
(2,'1996-06-15','1996-06-15 11:00:00','1996-01-01 10:00:00.750000',
20.50,20.50,'1996-06-15 11:00:00','abc','abc',4294967295,18446744073709551615),
(3,'1997-12-31','1997-12-31 12:00:00','1997-01-01 10:00:00.250000',
1234567890123.45,12345678901234.56,'1997-12-31 12:00:00','ab  ','ab  ',7,7);
ALTER TABLE t SECONDARY_LOAD;
SET SESSION use_secondary_engine=FORCED;
SET SESSION optimizer_switch='hypergraph_optimizer=on';
Warnings:
Warning	1287	The hypergraph optimizer is highly experimental and is meant for testing only. Do not enable it unless you are a MySQL developer.
# CHAR equality pushes. A stored 'abc' must not match the constant 'ab',
# and CHAR's trailing pad blanks must not make 'ab  ' differ from 'ab'.
EXPLAIN FORMAT=TREE SELECT id FROM t WHERE c = 'ab' ORDER BY id;
EXPLAIN
-> Sort: t.id  (rows=0.3)
    -> Vectorized table scan on t in secondary engine Rapid [filter: t.c = ab]  (rows=1)

Warnings:
Note	1003	Query is executed in secondary engine; the actual query plan may diverge from the printed one
SELECT id FROM t WHERE c = 'ab' ORDER BY id;
id
1
3
SELECT id FROM t WHERE c = 'abc' ORDER BY id;
id
2
SELECT id FROM t WHERE c <> 'ab' ORDER BY id;
id
2
# VARCHAR is NO PAD under the 0900 collations: 'ab  ' stays distinct.
SELECT id FROM t WHERE v = 'ab' ORDER BY id;
id
1
# A string ordering comparison stays above the scan: the range filter is
# not proven PAD SPACE correct and the zone map's min/max is binary.
EXPLAIN FORMAT=TREE SELECT id FROM t WHERE c > 'ab' ORDER BY id;
EXPLAIN
-> Sort: t.id  (rows=1)
    -> Filter: (t.c > 'ab')  (rows=1)
        -> Vectorized table scan on t in secondary engine Rapid  (rows=3)

Warnings:
Note	1003	Query is executed in secondary engine; the actual query plan may diverge from the printed one
SELECT id FROM t WHERE c > 'ab' ORDER BY id;
id
2
# DATE and whole-second DATETIME push.
EXPLAIN FORMAT=TREE SELECT id FROM t WHERE d <= '1996-12-31' ORDER BY id;
EXPLAIN
-> Sort: t.id  (rows=1)
    -> Vectorized table scan on t in secondary engine Rapid [filter: t.d <= 19961231]  (rows=1)

Warnings:
Note	1003	Query is executed in secondary engine; the actual query plan may diverge from the printed one
SELECT id FROM t WHERE d <= '1996-12-31' ORDER BY id;
id
1
2
SELECT id FROM t WHERE d BETWEEN '1995-06-01' AND '1997-01-01' ORDER BY id;
id
2
EXPLAIN FORMAT=TREE SELECT id FROM t WHERE dt0 <= '1996-12-31 23:59:59' ORDER BY id;
EXPLAIN
-> Sort: t.id  (rows=1)
    -> Vectorized table scan on t in secondary engine Rapid [filter: t.dt0 <= 19961231235959]  (rows=1)

Warnings:
Note	1003	Query is executed in secondary engine; the actual query plan may diverge from the printed one
SELECT id FROM t WHERE dt0 <= '1996-12-31 23:59:59' ORDER BY id;
id
1
2
# DATETIME(6) does not: the column side truncates to whole seconds, so a
# pushed comparison would qualify rows with a different sub-second part.
EXPLAIN FORMAT=TREE SELECT id FROM t WHERE dt6 = '1995-01-01 10:00:00.500000' ORDER BY id;
EXPLAIN
-> Sort: t.id  (rows=0.3)
    -> Filter: (t.dt6 = TIMESTAMP'1995-01-01 10:00:00.5')  (rows=1)
        -> Vectorized table scan on t in secondary engine Rapid  (rows=3)

Warnings:
Note	1003	Query is executed in secondary engine; the actual query plan may diverge from the printed one
SELECT id FROM t WHERE dt6 = '1995-01-01 10:00:00.500000' ORDER BY id;
id
1
SELECT id FROM t WHERE dt6 = '1995-01-01 10:00:00.100000' ORDER BY id;
id
# TIMESTAMP does not push: the column decodes to Unix epoch seconds while
# the constant becomes YYYYMMDDHHMMSS, so a pushed comparison would match
# nothing at all.
EXPLAIN FORMAT=TREE SELECT id FROM t WHERE ts <= '1996-12-31 23:59:59' ORDER BY id;
EXPLAIN
-> Sort: t.id  (rows=1)
    -> Filter: (t.ts <= TIMESTAMP'1996-12-31 23:59:59')  (rows=1)
        -> Vectorized table scan on t in secondary engine Rapid  (rows=3)

Warnings:
Note	1003	Query is executed in secondary engine; the actual query plan may diverge from the printed one
SELECT id FROM t WHERE ts <= '1996-12-31 23:59:59' ORDER BY id;
id
1
2
SELECT id FROM t WHERE ts BETWEEN '1995-06-01 00:00:00' AND '1997-01-01 00:00:00' ORDER BY id;
id
2
# DECIMAL pushes up to the 15 digits that round-trip through double.
EXPLAIN FORMAT=TREE SELECT id FROM t WHERE d15 <= 20.50 ORDER BY id;
EXPLAIN
-> Sort: t.id  (rows=1)
    -> Vectorized table scan on t in secondary engine Rapid [filter: t.d15 <= 20.500000]  (rows=1)

Warnings:
Note	1003	Query is executed in secondary engine; the actual query plan may diverge from the printed one
SELECT id FROM t WHERE d15 <= 20.50 ORDER BY id;
id
1
2
EXPLAIN FORMAT=TREE SELECT id FROM t WHERE d16 <= 20.50 ORDER BY id;
EXPLAIN
-> Sort: t.id  (rows=1)
    -> Filter: (t.d16 <= 20.50)  (rows=1)
        -> Vectorized table scan on t in secondary engine Rapid  (rows=3)

Warnings:
Note	1003	Query is executed in secondary engine; the actual query plan may diverge from the printed one
SELECT id FROM t WHERE d16 <= 20.50 ORDER BY id;
id
1
2
# Unsigned integers narrower than 64 bits push; BIGINT UNSIGNED does not,
# because only the column side tags its value unsigned.
EXPLAIN FORMAT=TREE SELECT id FROM t WHERE ui >= 7 ORDER BY id;
EXPLAIN
-> Sort: t.id  (rows=1)
    -> Vectorized table scan on t in secondary engine Rapid [filter: t.ui >= 7]  (rows=2)

Warnings:
Note	1003	Query is executed in secondary engine; the actual query plan may diverge from the printed one
SELECT id FROM t WHERE ui >= 7 ORDER BY id;
id
2
3
