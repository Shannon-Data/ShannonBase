SET GLOBAL rapid_resource_isolation=AUTO;
CREATE DATABASE sh_sort_runs;
USE sh_sort_runs;
CREATE TABLE t (id INT PRIMARY KEY, s CHAR(200) CHARACTER SET latin1 NOT NULL)
SECONDARY_ENGINE=rapid;
SET cte_max_recursion_depth=12000;
INSERT INTO t WITH RECURSIVE seq(n) AS
(SELECT 1 UNION ALL SELECT n+1 FROM seq WHERE n<12000)
SELECT n, CONCAT('key',LPAD(12001-n,5,'0')) FROM seq;
ALTER TABLE t SECONDARY_LOAD;
SET use_secondary_engine=FORCED;
SET debug='+d,rapid_sort_tiny_budget';
SET @ordinal=0;
CREATE TABLE sorted_rows AS
SELECT @ordinal:=@ordinal+1 AS ordinal,id FROM t ORDER BY s,id;
Warnings:
Warning	1287	Setting user variables within expressions is deprecated and will be removed in a future release. Consider alternatives: 'SET variable=expression, ...', or 'SELECT expression(s) INTO variables(s)'.
SET debug='-d,rapid_sort_tiny_budget';
SET use_secondary_engine=OFF;
SELECT COUNT(*) AS rows_sorted, SUM(id<>12001-ordinal) AS wrong_positions FROM sorted_rows;
rows_sorted	wrong_positions
12000	0
DROP DATABASE sh_sort_runs;
SELECT VARIABLE_VALUE LIKE 'enabled=YES %' AS automatic_io,
VARIABLE_VALUE LIKE '%active=0 waiting=0 %' AS leases_released,
CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(VARIABLE_VALUE,'admitted=',-1),' ',1) AS UNSIGNED)>0 AS spill_admitted,
VARIABLE_VALUE LIKE '%physical_iops=unavailable throughput_limit=unavailable' AS coverage_honest
FROM performance_schema.global_status WHERE VARIABLE_NAME='rapid_resource_io_status';
automatic_io	leases_released	spill_admitted	coverage_honest
1	1	1	1
SET GLOBAL rapid_resource_isolation=OFF;
