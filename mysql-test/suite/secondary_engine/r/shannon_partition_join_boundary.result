create database sh_pjb;
use sh_pjb;
create table jb_a (id int primary key, k int not null, v int not null) secondary_engine=rapid partition by range (id) (partition p0 values less than (1024), partition p1 values less than (2048), partition p2 values less than (3072), partition p3 values less than maxvalue);
create table jb_b (id int primary key, k int not null, w int not null) secondary_engine=rapid partition by range (id) (partition p0 values less than (1024), partition p1 values less than (2048), partition p2 values less than (3072), partition p3 values less than maxvalue);
set session cte_max_recursion_depth = 5000;
insert into jb_a (id, k, v)
with recursive seq(n) as (select 1 union all select n + 1 from seq where n < 2500)
select n, n div 100, n from seq;
insert into jb_b (id, k, w)
with recursive seq(n) as (select 1 union all select n + 1 from seq where n < 2500)
select n, n div 100, n * 10 from seq;
set session cte_max_recursion_depth = default;
alter table jb_a secondary_load;
alter table jb_b secondary_load;
set session optimizer_switch='hypergraph_optimizer=on';
# ===== InnoDB baseline =====
set session use_secondary_engine = off;
select count(*) as n from jb_a a join jb_b b on a.id = b.id;
n
2500
select a.id, a.v, b.w from jb_a a join jb_b b on a.id = b.id where a.id in (1023,1024,1025,2047,2048,2049,2499) order by a.id;
id	v	w
1023	1023	10230
1024	1024	10240
1025	1025	10250
2047	2047	20470
2048	2048	20480
2049	2049	20490
2499	2499	24990
select a.k, count(*) as c, sum(a.v) as sv from jb_a a join jb_b b on a.k = b.k group by a.k order by a.k limit 5;
k	c	sv
0	9801	490050
1	10000	1495000
2	10000	2495000
3	10000	3495000
4	10000	4495000
# ===== Rapid =====
set session use_secondary_engine = forced;
select count(*) as n from jb_a a join jb_b b on a.id = b.id;
n
2500
select a.id, a.v, b.w from jb_a a join jb_b b on a.id = b.id where a.id in (1023,1024,1025,2047,2048,2049,2499) order by a.id;
id	v	w
1023	1023	10230
1024	1024	10240
1025	1025	10250
2047	2047	20470
2048	2048	20480
2049	2049	20490
2499	2499	24990
select a.k, count(*) as c, sum(a.v) as sv from jb_a a join jb_b b on a.k = b.k group by a.k order by a.k limit 5;
k	c	sv
0	9801	490050
1	10000	1495000
2	10000	2495000
3	10000	3495000
4	10000	4495000
use test;
drop database sh_pjb;
