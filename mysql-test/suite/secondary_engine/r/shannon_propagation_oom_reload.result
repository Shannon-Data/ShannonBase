CALL mtr.add_suppression('Rapid propagation buffer full');
CALL mtr.add_suppression('Rapid COPY_INFO could not enqueue row change');
CALL mtr.add_suppression('Rapid row notification failed');
CREATE DATABASE sh_oom_reload;
USE sh_oom_reload;
SET @saved_self_load_enabled=@@GLOBAL.rapid_self_load_enabled;
SET GLOBAL rapid_self_load_enabled=OFF;
CREATE TABLE t (id INT PRIMARY KEY, v INT) SECONDARY_ENGINE=rapid;
INSERT INTO t VALUES (1,10);
ALTER TABLE t SECONDARY_LOAD;
SET debug='+d,rapid_propagation_buffer_full';
INSERT INTO t VALUES (2,20);
SET debug='-d,rapid_propagation_buffer_full';
SET debug='+d,rapid_notification_bad_alloc';
UPDATE t SET v=30 WHERE id=1;
SET debug='-d,rapid_notification_bad_alloc';
# Stale table: ON EXPLAIN plan matches OFF (InnoDB), with offload cost threshold zero.
SELECT * FROM t ORDER BY id;
id	v
1	30
2	20
SET use_secondary_engine=FORCED;
SELECT COUNT(*) FROM t;
ERROR HY000: Secondary engine operation failed. table has failed DML propagation and must be reloaded.
SET use_secondary_engine=OFF;
ALTER TABLE t SECONDARY_UNLOAD;
ALTER TABLE t SECONDARY_LOAD;
CREATE TABLE p (id INT PRIMARY KEY, v INT) SECONDARY_ENGINE=rapid PARTITION BY HASH(id) PARTITIONS 2;
INSERT INTO p VALUES (1,10);
ALTER TABLE p SECONDARY_LOAD;
SET debug='+d,rapid_propagation_buffer_full';
INSERT INTO p VALUES (2,20);
SET debug='-d,rapid_propagation_buffer_full';
DROP DATABASE sh_oom_reload;
SET GLOBAL rapid_self_load_enabled=@saved_self_load_enabled;
