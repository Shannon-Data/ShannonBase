create database sh_ns;
use sh_ns;
create table ns (
id    int primary key,
c_int int,
c_sec varchar(20) NOT SECONDARY,
c_big bigint
) secondary_engine=rapid;
insert into ns values (1,10,'aaa',100),(2,20,'bbb',200),(3,30,null,300);
alter table ns secondary_load;
# ===== only secondary columns read =====
# --- InnoDB ---
set session use_secondary_engine = off;
select id, c_int, c_big from ns order by id;
id	c_int	c_big
1	10	100
2	20	200
3	30	300
# --- Rapid ---
set session use_secondary_engine = forced;
select id, c_int, c_big from ns order by id;
id	c_int	c_big
1	10	100
2	20	200
3	30	300
# ===== a NOT SECONDARY column is read =====
# --- InnoDB ---
set session use_secondary_engine = off;
select id, c_sec from ns order by id;
id	c_sec
1	aaa
2	bbb
3	NULL
select id, c_sec, c_big from ns order by id;
id	c_sec	c_big
1	aaa	100
2	bbb	200
3	NULL	300
# --- ON: falls back to the primary engine, same answers ---
set session use_secondary_engine = on;
select id, c_sec from ns order by id;
id	c_sec
1	aaa
2	bbb
3	NULL
select id, c_sec, c_big from ns order by id;
id	c_sec	c_big
1	aaa	100
2	bbb	200
3	NULL	300
# --- FORCED: cannot offload, so it must fail rather than answer ---
# The reason has to name the column; "all plans were rejected" would
# leave the user with nothing to act on.
set session use_secondary_engine = forced;
select id, c_sec from ns order by id;
ERROR HY000: Secondary engine operation failed. Column c_sec is marked as NOT SECONDARY, so it is not loaded into Rapid.
select id, c_sec, c_big from ns order by id;
ERROR HY000: Secondary engine operation failed. Column c_sec is marked as NOT SECONDARY, so it is not loaded into Rapid.
# --- ON still offloads when only secondary columns are read ---
set session use_secondary_engine = on;
select id, c_int, c_big from ns order by id;
id	c_int	c_big
1	10	100
2	20	200
3	30	300
use test;
drop database sh_ns;
