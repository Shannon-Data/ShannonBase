CREATE DATABASE sh_ib_db;
USE sh_ib_db;
CREATE TABLE t1 (id INT PRIMARY KEY, d DECIMAL(15,2) NOT NULL, e DECIMAL(15,4) NOT NULL) SECONDARY_ENGINE RAPID;
INSERT INTO t1 VALUES
(1,-0.01,-0.0100),(2,0.00,0.0000),(3,0.04,0.0400),(4,0.05,0.0450),
(5,0.06,0.0600),(6,0.07,0.0750),(7,0.08,0.0800),(8,24.00,24.0000);
ALTER TABLE t1 SECONDARY_LOAD;
SET SESSION optimizer_switch = 'hypergraph_optimizer=on';
SET SESSION secondary_engine_cost_threshold = 0;
#
# A bound the column cannot represent is no longer pushed as 0: the plan
# shows it carrying its own digits. Only the inexact bound is printed --
# how an exact one is formatted depends on whether it reaches the
# predicate as digits or as a double, which is not what this test is
# about, and the row results below cover the exact case.
#
SET SESSION use_secondary_engine = FORCED;
EXPLAIN FORMAT=TREE SELECT id FROM t1 WHERE d BETWEEN 0.045 AND 0.075;
EXPLAIN
-> Vectorized table scan on t1 in secondary engine Rapid [filter: t1.d BETWEEN 0.045 AND 0.075]  

Warnings:
Note	1003	Query is executed in secondary engine; the actual query plan may diverge from the printed one
