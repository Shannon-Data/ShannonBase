CREATE DATABASE sh_conc;
USE sh_conc;
CREATE TABLE t_c (id INT PRIMARY KEY, v INT NOT NULL, pad CHAR(64) NOT NULL) SECONDARY_ENGINE=rapid;
ALTER TABLE t_c SECONDARY_LOAD;
SET SESSION use_secondary_engine = forced;
SET SESSION secondary_engine_cost_threshold = 0;
#
# 1. Baseline from Rapid: 20000 rows summing to 200010000.
#
SELECT COUNT(*) AS n, SUM(v) AS s FROM t_c;
n	s
20000	200010000
#
# 2. Read while a writer works on the same table.
#
#    The writer adds 20 rows. However many a given read observes, the
#    count must stay inside [20000, 20020] and the sum must never drop
#    below the baseline -- both would break if a scan returned a
#    reserved-but-unwritten slot.
#
SET SESSION use_secondary_engine = off;
SELECT COUNT(*) BETWEEN 20000 AND 20020 AS count_in_range_1 FROM t_c;
count_in_range_1
1
SELECT SUM(v) >= 200010000 AS sum_not_regressed_1 FROM t_c;
sum_not_regressed_1
1
SELECT COUNT(*) BETWEEN 20000 AND 20020 AS count_in_range_2 FROM t_c;
count_in_range_2
1
SELECT SUM(v) >= 200010000 AS sum_not_regressed_2 FROM t_c;
sum_not_regressed_2
1
SELECT COUNT(*) BETWEEN 20000 AND 20020 AS count_in_range_3 FROM t_c;
count_in_range_3
1
SELECT SUM(v) >= 200010000 AS sum_not_regressed_3 FROM t_c;
sum_not_regressed_3
1
SELECT COUNT(*) BETWEEN 20000 AND 20020 AS count_in_range_4 FROM t_c;
count_in_range_4
1
SELECT SUM(v) >= 200010000 AS sum_not_regressed_4 FROM t_c;
sum_not_regressed_4
1
SELECT COUNT(*) BETWEEN 20000 AND 20020 AS count_in_range_5 FROM t_c;
count_in_range_5
1
SELECT SUM(v) >= 200010000 AS sum_not_regressed_5 FROM t_c;
sum_not_regressed_5
1
SELECT COUNT(*) BETWEEN 20000 AND 20020 AS count_in_range_6 FROM t_c;
count_in_range_6
1
SELECT SUM(v) >= 200010000 AS sum_not_regressed_6 FROM t_c;
sum_not_regressed_6
1
#
# 3. Read-your-writes: each write is visible to the very next Rapid read.
#
SELECT COUNT(*) AS n_1 FROM t_c WHERE id >= 30001;
n_1
1
SELECT COUNT(*) AS n_2 FROM t_c WHERE id >= 30001;
n_2
2
SELECT COUNT(*) AS n_3 FROM t_c WHERE id >= 30001;
n_3
3
SELECT COUNT(*) AS n_4 FROM t_c WHERE id >= 30001;
n_4
4
SELECT COUNT(*) AS n_5 FROM t_c WHERE id >= 30001;
n_5
5
SELECT COUNT(*) AS n_6 FROM t_c WHERE id >= 30001;
n_6
6
SELECT COUNT(*) AS n_7 FROM t_c WHERE id >= 30001;
n_7
7
SELECT COUNT(*) AS n_8 FROM t_c WHERE id >= 30001;
n_8
8
#
# 4. Once quiesced, Rapid and InnoDB agree exactly.
#
SELECT COUNT(*) AS n_rapid, SUM(v) AS s_rapid FROM t_c;
n_rapid	s_rapid
20028	220010036
SET SESSION use_secondary_engine = off;
SELECT COUNT(*) AS n_innodb, SUM(v) AS s_innodb FROM t_c;
n_innodb	s_innodb
20028	220010036
#
# 5. Concurrent UPDATE, then concurrent DELETE.
#
#    An UPDATE changes no row count, so the count is exactly stable
#    across it. The DELETE removes 100 rows, so its reads are bounded
#    instead.
#
SET SESSION use_secondary_engine = off;
UPDATE t_c SET v = v + 1 WHERE id <= 500;
SET SESSION use_secondary_engine = forced;
SELECT COUNT(*) AS n_stable_1 FROM t_c;
n_stable_1
20028
SELECT COUNT(*) AS n_stable_2 FROM t_c;
n_stable_2
20028
SELECT COUNT(*) AS n_stable_3 FROM t_c;
n_stable_3
20028
SELECT COUNT(*) AS n_stable_4 FROM t_c;
n_stable_4
20028
DELETE FROM t_c WHERE id BETWEEN 1000 AND 1099;
SELECT COUNT(*) BETWEEN 20028 AND 20128 AS count_in_range_d1 FROM t_c;
count_in_range_d1
1
SELECT COUNT(*) BETWEEN 20028 AND 20128 AS count_in_range_d2 FROM t_c;
count_in_range_d2
1
SELECT COUNT(*) BETWEEN 20028 AND 20128 AS count_in_range_d3 FROM t_c;
count_in_range_d3
1
SELECT COUNT(*) BETWEEN 20028 AND 20128 AS count_in_range_d4 FROM t_c;
count_in_range_d4
1
SELECT COUNT(*) AS n_rapid_final, SUM(v) AS s_rapid_final FROM t_c;
n_rapid_final	s_rapid_final
19928	219905586
SET SESSION use_secondary_engine = off;
SELECT COUNT(*) AS n_innodb_final, SUM(v) AS s_innodb_final FROM t_c;
n_innodb_final	s_innodb_final
19928	219905586
DROP TABLE t_c;
DROP DATABASE sh_conc;
