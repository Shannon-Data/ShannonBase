CREATE DATABASE sh_bitpack;
USE sh_bitpack;
SET USE_SECONDARY_ENGINE=FORCED;
# tiny_val 0..7 -> 3 bits, int_val -1000..1000 -> 11 bits,
# big_val a 4-value BIGINT domain -> 3 bits instead of 8 bytes.
CREATE TABLE t_bp (
id INT PRIMARY KEY,
tiny_val TINYINT COMMENT 'RAPID_COLUMN=ENCODING=BITPACK',
int_val INT COMMENT 'RAPID_COLUMN=ENCODING=BITPACK',
big_val BIGINT COMMENT 'RAPID_COLUMN=ENCODING=BITPACK',
plain INT
) SECONDARY_ENGINE=RAPID;
INSERT INTO t_bp VALUES
(1, 0,    -1000, 999999999999, 7),
(2, 3,       0, 1000000000000, NULL),
(3, 7,    1000, 1000000000001, 9),
(4, 1,    -999,  999999999998, 7),
(5, NULL, NULL,            NULL, NULL),
(6, 2,     500, 1000000000002, 7);
ALTER TABLE t_bp SECONDARY_LOAD;
# Three tagged columns, three bit-packed CUs, otherwise the tag was parsed
# but the column stayed in canonical slots. The counters are sampled when a
# statement ends on the Rapid handler, so read them through a forced query.
SELECT COUNT(*) FROM t_bp;
COUNT(*)
6
# Scans, predicates and aggregates over the packed columns.
SELECT * FROM t_bp ORDER BY id;
id	tiny_val	int_val	big_val	plain
1	0	-1000	999999999999	7
2	3	0	1000000000000	NULL
3	7	1000	1000000000001	9
4	1	-999	999999999998	7
5	NULL	NULL	NULL	NULL
6	2	500	1000000000002	7
SELECT id FROM t_bp WHERE tiny_val = 3 ORDER BY id;
id
2
SELECT id FROM t_bp WHERE int_val BETWEEN -999 AND 500 ORDER BY id;
id
2
4
6
SELECT id FROM t_bp WHERE big_val > 1000000000000 ORDER BY id;
id
3
6
SELECT id FROM t_bp WHERE int_val IS NULL ORDER BY id;
id
5
SELECT COUNT(*), SUM(int_val), MIN(tiny_val), MAX(big_val) FROM t_bp;
COUNT(*)	SUM(int_val)	MIN(tiny_val)	MAX(big_val)
6	-499	0	1000000000002
# A GROUP BY needs the values, and a filter sits between the scan and the
# aggregate: neither may take the code-reduction path, both must agree.
SELECT int_val, COUNT(*), SUM(big_val) FROM t_bp GROUP BY int_val ORDER BY int_val;
int_val	COUNT(*)	SUM(big_val)
NULL	1	NULL
-1000	1	999999999999
-999	1	999999999998
0	1	1000000000000
500	1	1000000000002
1000	1	1000000000001
SELECT SUM(int_val), MIN(tiny_val), MAX(big_val) FROM t_bp WHERE plain > 5;
SUM(int_val)	MIN(tiny_val)	MAX(big_val)
-499	0	1000000000002
# The comparisons above are single integer ranges, so the packed stream
# must have been matched a word at a time rather than decoded per row.
# The scans that fed them decoded whole batches through the unpack kernel.
SET USE_SECONDARY_ENGINE=OFF;
SELECT CAST(VARIABLE_VALUE AS UNSIGNED) > 0 AS used_range_kernel
FROM performance_schema.global_status
WHERE VARIABLE_NAME = 'rapid_query_bitpacked_predicate_rows_total';
used_range_kernel
SELECT CAST(VARIABLE_VALUE AS UNSIGNED) > 0 AS used_unpack_kernel
FROM performance_schema.global_status
WHERE VARIABLE_NAME = 'rapid_query_bitpacked_unpack_rows_total';
used_unpack_kernel
SET USE_SECONDARY_ENGINE=FORCED;
# The packed stream has to reach a checkpoint, and the restart after it
# has to read it back: the CU snapshot carries the code width and bias.
# The first restart reloads from InnoDB (there is no generation yet) and
# repacks the column; the second one must restore from that generation.
# restart: --rapid_reload_on_restart=ON
USE sh_bitpack;
# restart: --rapid_reload_on_restart=ON
USE sh_bitpack;
SET USE_SECONDARY_ENGINE=FORCED;
SELECT * FROM t_bp ORDER BY id;
id	tiny_val	int_val	big_val	plain
1	0	-1000	999999999999	7
2	3	0	1000000000000	NULL
3	7	1000	1000000000001	9
4	1	-999	999999999998	7
5	NULL	NULL	NULL	NULL
6	2	500	1000000000002	7
SELECT id FROM t_bp WHERE int_val >= 501 ORDER BY id;
id
3
# DML on the restored stream: the INSERT has to write a new code, the
# UPDATE falls back to canonical slots, the DELETE has to hide the row.
INSERT INTO t_bp VALUES (7, 5, 250, 1000000000003, 1);
UPDATE t_bp SET int_val = int_val + 1 WHERE id <= 3;
DELETE FROM t_bp WHERE id = 4;
SELECT * FROM t_bp ORDER BY id;
id	tiny_val	int_val	big_val	plain
1	0	-999	999999999999	7
2	3	1	1000000000000	NULL
3	7	1001	1000000000001	9
5	NULL	NULL	NULL	NULL
6	2	500	1000000000002	7
7	5	250	1000000000003	1
# An aggregate can read the codes instead of materialising the column,
# but only a scan of a whole batch reaches that path: a handful of rows is
# served from the scan's row buffer. So drive it with a table that fills
# several batches, and check the numbers against InnoDB.
CREATE TABLE t_bp_big (
id INT PRIMARY KEY,
bp_val INT COMMENT 'RAPID_COLUMN=ENCODING=BITPACK',
plain INT
) SECONDARY_ENGINE=RAPID;
SET cte_max_recursion_depth = 20000;
INSERT INTO t_bp_big
WITH RECURSIVE seq(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM seq WHERE n < 3000)
SELECT n, n + 10, n % 3 FROM seq;
ALTER TABLE t_bp_big SECONDARY_LOAD;
SELECT COUNT(*), SUM(bp_val), MIN(bp_val), MAX(bp_val) FROM t_bp_big;
COUNT(*)	SUM(bp_val)	MIN(bp_val)	MAX(bp_val)
3000	4531500	11	3010
# A GROUP BY still needs the values, and must stay correct.
SELECT plain, COUNT(*), SUM(bp_val) FROM t_bp_big GROUP BY plain ORDER BY plain;
plain	COUNT(*)	SUM(bp_val)
0	1000	1511500
1	1000	1509500
2	1000	1510500
# An UPDATE unpacks the column, so the reduction must fall back to values.
UPDATE t_bp_big SET bp_val = bp_val + 1 WHERE id <= 10;
SELECT COUNT(*), SUM(bp_val), MIN(bp_val), MAX(bp_val) FROM t_bp_big;
COUNT(*)	SUM(bp_val)	MIN(bp_val)	MAX(bp_val)
3000	4531510	12	3010
DROP TABLE t_bp_big;
SELECT COUNT(*), SUM(big_val) FROM t_bp;
COUNT(*)	SUM(big_val)
6	5000000000005
SET USE_SECONDARY_ENGINE=OFF;
DROP DATABASE sh_bitpack;
