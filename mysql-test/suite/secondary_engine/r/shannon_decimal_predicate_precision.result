CREATE DATABASE sh_dec_pred_db;
USE sh_dec_pred_db;
CREATE TABLE t1 (
id INT PRIMARY KEY,
d18 DECIMAL(18,0),
d20 DECIMAL(20,4),
d30 DECIMAL(30,10),
d10 DECIMAL(10,2)
) SECONDARY_ENGINE RAPID;
INSERT INTO t1 VALUES
(1,  123456789012345678,  1234567890123456.7891,  12345678901234567890.1234567891,  12.34),
(2,  123456789012345679,  1234567890123456.7892,  12345678901234567890.1234567892,  56.78),
(3,  123456789012345680,  1234567890123456.7893,  12345678901234567890.1234567893,  90.12),
(4, -123456789012345678, -1234567890123456.7891, -12345678901234567890.1234567891, -12.34),
(5, -123456789012345679, -1234567890123456.7892, -12345678901234567890.1234567892, -56.78),
(6,  999999999999999999,  9999999999999999.9999,  99999999999999999999.9999999999,  99.99),
(7,  1,                   1.0001,                 1.0000000001,                     1.00),
(8,  0,                   0.0000,                 0.0000000000,                     0.00),
(9,  NULL,                NULL,                   NULL,                             NULL),
(10, 100000000000000001,  1000000000000000.0001,  10000000000000000000.0000000001,  10.01),
(11, 100000000000000002,  1000000000000000.0002,  10000000000000000000.0000000002,  10.02),
(12, 2,                   2.0002,                 2.0000000002,                     2.00);
ALTER TABLE t1 SECONDARY_LOAD;
# Each block prints Rapid/hypergraph, Rapid/legacy, then InnoDB. All three
# must be identical.
# --- equality on an 18-digit DECIMAL: must not also match the neighbour
SET use_secondary_engine=FORCED;
SET SESSION optimizer_switch='hypergraph_optimizer=on';
SELECT id FROM t1 WHERE d18 = 123456789012345678 ORDER BY id;
id
1
SET SESSION optimizer_switch='hypergraph_optimizer=off';
SELECT id FROM t1 WHERE d18 = 123456789012345678 ORDER BY id;
id
1
SET use_secondary_engine=OFF;
SELECT id FROM t1 WHERE d18 = 123456789012345678 ORDER BY id;
id
1
# --- strict range across the collapsing pair
SET use_secondary_engine=FORCED;
SET SESSION optimizer_switch='hypergraph_optimizer=on';
SELECT id FROM t1 WHERE d18 > 123456789012345678 ORDER BY id;
id
