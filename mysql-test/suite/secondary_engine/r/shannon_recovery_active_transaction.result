CREATE DATABASE sh_recovery_active;
USE sh_recovery_active;
CREATE TABLE t (id INT PRIMARY KEY, v INT) SECONDARY_ENGINE=rapid;
INSERT INTO t VALUES (1,10),(2,20),(3,30);
ALTER TABLE t SECONDARY_LOAD;
# restart: --rapid_reload_on_restart=ON
USE sh_recovery_active;
INSERT INTO t VALUES (4,40);
BEGIN;
INSERT INTO t VALUES (5,50);
UPDATE t SET v=999 WHERE id=1;
DELETE FROM t WHERE id=2;
SET use_secondary_engine=FORCED;
SELECT id,v FROM t ORDER BY id;
id	v
1	10
2	20
3	30
4	40
# Kill and restart: --rapid_reload_on_restart=ON
USE sh_recovery_active;
SELECT VARIABLE_VALUE FROM performance_schema.global_status WHERE VARIABLE_NAME='rapid_recovery_storage_restores';
VARIABLE_VALUE
1
SET use_secondary_engine=OFF;
SELECT id,v FROM t ORDER BY id;
id	v
1	10
2	20
3	30
4	40
INSERT INTO t VALUES (6,60);
UPDATE t SET v=31 WHERE id=3;
DELETE FROM t WHERE id=4;
# Kill and restart: --rapid_reload_on_restart=ON
USE sh_recovery_active;
SET use_secondary_engine=OFF;
SELECT id,v FROM t ORDER BY id;
id	v
1	10
2	20
3	31
6	60
DROP DATABASE sh_recovery_active;
