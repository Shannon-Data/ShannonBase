CREATE DATABASE sh_storage_recovery;
USE sh_storage_recovery;
CREATE TABLE t (id INT PRIMARY KEY, v INT NOT NULL) SECONDARY_ENGINE=rapid;
INSERT INTO t VALUES (1,10),(2,20),(3,30);
ALTER TABLE t SECONDARY_LOAD;
# restart: --rapid_reload_on_restart=ON
USE sh_storage_recovery;
CALL mtr.add_suppression("recovery eligibility is revoked or cannot be verified; automatic recovery stopped");
CALL mtr.add_suppression("RecoveryManager: a source change reached sh_storage_recovery.t");
CREATE TABLE healthy (id INT PRIMARY KEY, v INT) SECONDARY_ENGINE=rapid;
INSERT INTO healthy VALUES (1,100);
ALTER TABLE healthy SECONDARY_LOAD;
# restart: --rapid_reload_on_restart=ON
USE sh_storage_recovery;
SET sql_log_bin=OFF;
UPDATE t SET v=11 WHERE id=1;
SET sql_log_bin=ON;
UPDATE healthy SET v=101 WHERE id=1;
# Kill and restart: --rapid_reload_on_restart=ON
USE sh_storage_recovery;
include/wait_for_pattern_in_file.inc [sh_storage_recovery.t recovery eligibility is revoked or cannot be verified; automatic recovery stopped]
SELECT TABLE_NAME FROM performance_schema.rpd_table_id WHERE SCHEMA_NAME='sh_storage_recovery' ORDER BY TABLE_NAME;
TABLE_NAME
healthy
SELECT VARIABLE_NAME,VARIABLE_VALUE FROM performance_schema.global_status WHERE VARIABLE_NAME IN ('rapid_recovery_storage_restores','rapid_recovery_primary_reloads') ORDER BY VARIABLE_NAME;
VARIABLE_NAME	VARIABLE_VALUE
rapid_recovery_primary_reloads	0
rapid_recovery_storage_restores	1
SET use_secondary_engine=FORCED;
SELECT id,v FROM healthy ORDER BY id;
id	v
1	101
SELECT id,v FROM t ORDER BY id;
ERROR HY000: Table has not been loaded
SET use_secondary_engine=ON;
SELECT id,v FROM t ORDER BY id;
id	v
1	11
2	20
3	30
SET use_secondary_engine=OFF;
UPDATE t SET v=12 WHERE id=1;
ALTER TABLE t SECONDARY_LOAD;
SET use_secondary_engine=FORCED;
SELECT id,v FROM t ORDER BY id;
id	v
1	12
2	20
3	30
SELECT id,v FROM healthy ORDER BY id;
id	v
1	101
DROP DATABASE sh_storage_recovery;
