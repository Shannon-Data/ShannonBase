#
# The same keys through the *row* encoder. A string column in the batch
# forces HashInputMode::ROW, so these build their keys with
# AppendGroupKeyValue() rather than from the chunk. Both encoders have to
# agree -- a spill and rebuild mixes them -- and grouping the same data
# both ways is what shows it.
#
SELECT c, d, COUNT(*), SUM(i) FROM t1 GROUP BY c, d;
c	d	COUNT(*)	SUM(i)
