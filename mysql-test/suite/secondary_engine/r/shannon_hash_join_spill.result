#
# ---- A build side that fits must NOT spill (guards against always-spill) ----
#
SET SESSION join_buffer_size = 4194304;
SELECT pkey, SUM(bval) AS sb FROM probe_side JOIN build_side ON pkey = bkey
GROUP BY pkey ORDER BY pkey LIMIT 5;
pkey	sb
1	2
2	8
3	12
4	16
5	20
#
# ---- Numeric-only inputs: the batch consumer path ----
#
# The tables above pad with CHAR(32), which keeps both join inputs on the
# row-image path; the aggregate above the join then consumes it row by row
# with Read(). With every column numeric the join can serve columnar
# batches, so the aggregate binds to ReadBatch() in its own Init() -- long
# before the build side spills, and with no way to change its mind
# afterwards. ReadBatch() therefore has to run the ordered-merge protocol
# too; probing instead would index a hash table the spill already released.
#
SET SESSION use_secondary_engine = OFF;
CREATE TABLE num_build (
bid   INT NOT NULL PRIMARY KEY,
bkey  INT NOT NULL,
bval  INT NOT NULL,
bpad  BIGINT NOT NULL
) SECONDARY_ENGINE=rapid;
CREATE TABLE num_probe (
pid   INT NOT NULL PRIMARY KEY,
pkey  INT NOT NULL,
pval  INT NOT NULL,
ppad  BIGINT NOT NULL
) SECONDARY_ENGINE=rapid;
ALTER TABLE num_build SECONDARY_LOAD;
ALTER TABLE num_probe SECONDARY_LOAD;
# ---- InnoDB baseline ----
SELECT pkey, SUM(bval) AS sb, SUM(pval) AS sp, COUNT(*) AS n
FROM num_probe JOIN num_build ON pkey = bkey GROUP BY pkey ORDER BY pkey LIMIT 12;
