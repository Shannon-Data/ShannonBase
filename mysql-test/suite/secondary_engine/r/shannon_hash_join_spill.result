5	20	508	2
6	24	510	2
7	28	512	2
8	32	514	2
9	36	516	2
10	40	518	2
11	44	520	2
12	48	522	2
SELECT COUNT(*), SUM(bval), SUM(pval) FROM probe_side JOIN build_side ON pkey = bkey;
COUNT(*)	SUM(bval)	SUM(pval)
700	251300	275450
SELECT bkey, COUNT(*) AS n FROM probe_side LEFT JOIN build_side ON pkey = bkey
GROUP BY bkey ORDER BY bkey LIMIT 12;
bkey	n
