#
# ---- Rapid, join buffer far too small ----
#
# The Rapid vectorized hash join is only selected when probe order is part
# of the physical contract -- IsGroupingSort() must see a SORT feeding the
# join, which is the shape the hypergraph optimizer builds for a grouped
# join. Without that the plan uses MySQL's own spilling iterator and this
# file would test nothing, so the EXPLAIN below is the real assertion.
#
SET SESSION optimizer_switch='hypergraph_optimizer=on';
Warnings:
Warning	1287	The hypergraph optimizer is highly experimental and is meant for testing only. Do not enable it unless you are a MySQL developer.
SET SESSION use_secondary_engine = FORCED;
SET SESSION secondary_engine_cost_threshold = 0;
SET SESSION join_buffer_size = 4096;
# Two things to read in this plan: "Vectorized" (Rapid's operator, not the
# server's) and the Sort feeding the join (the preserves_probe_order path
# under test). With join_buffer_size at 4096 and a 400-row build side,
# that operator has no choice but to partition to disk.
# Costs and row estimates are elided: they drift with statistics and cost
# model changes, while the plan shape is what this test asserts.
EXPLAIN FORMAT=TREE SELECT pkey, SUM(bval) AS sb, SUM(pval) AS sp, COUNT(*) AS n
FROM probe_side JOIN build_side ON pkey = bkey GROUP BY pkey;
EXPLAIN
-> Group vectorized aggregate: sum(build_side.bval), sum(probe_side.pval), count(0)  (...)
    -> Vectorized inner hash join (probe_side.pkey = build_side.bkey)  (...)
        -> Sort: build_side.bkey  (...)
            -> Vectorized table scan on build_side in secondary engine Rapid  (...)
        -> Hash
            -> Vectorized table scan on probe_side in secondary engine Rapid  (...)

Warnings:
Note	1003	Query is executed in secondary engine; the actual query plan may diverge from the printed one
