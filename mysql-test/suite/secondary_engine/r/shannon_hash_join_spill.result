#
# ---- One join key, larger than the whole join buffer ----
#
# Re-splitting a partition redistributes distinct keys, so it can never
# break up rows that all share one key: the recursion just walks to its
# depth limit. From there the pair is finished by joining the probe
# partition against one memory-sized block of the build partition at a
# time, each block writing its own (still ordinal-ascending) run.
#
# A block sees only part of the build side, so it can answer "these rows
# match" but not "did this probe row match anywhere" -- which OUTER, SEMI
# and ANTI all have to know. That is carried in a match-flag file rewritten
# by each block pass, so the state is per-partition on disk rather than
# per-ordinal in memory, and a final pass emits whatever the flags say was
# never matched. All four join types are covered below.
#
SET SESSION use_secondary_engine = OFF;
CREATE TABLE skew_build (
bid   INT NOT NULL PRIMARY KEY,
bkey  INT NOT NULL,
bval  INT NOT NULL,
bpad1 BIGINT NOT NULL,
bpad2 BIGINT NOT NULL,
bpad3 BIGINT NOT NULL
) SECONDARY_ENGINE=rapid;
CREATE TABLE skew_probe (
pid   INT NOT NULL PRIMARY KEY,
pkey  INT NOT NULL,
pval  INT NOT NULL,
ppad1 BIGINT NOT NULL,
ppad2 BIGINT NOT NULL,
ppad3 BIGINT NOT NULL
) SECONDARY_ENGINE=rapid;
ALTER TABLE skew_build SECONDARY_LOAD;
ALTER TABLE skew_probe SECONDARY_LOAD;
# ---- InnoDB baseline ----
# INNER
SELECT pkey, COUNT(*) AS n, SUM(bval) AS sb, SUM(pval) AS sp
FROM skew_probe JOIN skew_build ON pkey = bkey GROUP BY pkey ORDER BY pkey;
pkey	n	sb	sp
7	40000	4020000	4020000
# LEFT -- key 9 must survive as a null-complemented group
SELECT pkey, COUNT(*) AS n, SUM(bval) AS sb, COUNT(bkey) AS matched
FROM skew_probe LEFT JOIN skew_build ON pkey = bkey GROUP BY pkey ORDER BY pkey;
pkey	n	sb	matched
7	40000	4020000	40000
9	20	NULL	0
# SEMI -- at most one output per probe row
SELECT COUNT(*) FROM skew_probe WHERE pkey IN (SELECT bkey FROM skew_build);
COUNT(*)
200
# ANTI -- exactly the rows that matched nowhere
SELECT COUNT(*) FROM skew_probe WHERE pkey NOT IN (SELECT bkey FROM skew_build);
COUNT(*)
20
# ---- Rapid, one key and a 4KB join buffer ----
# 200 build rows of ~40 bytes cannot fit a 4KB join buffer, and a single
# join key cannot be split by hashing, so reaching any answer at all here
# means the recursion hit its depth limit and the blockwise path finished
# the join. Each of the four join types then has to agree with InnoDB.
SET SESSION use_secondary_engine = FORCED;
# INNER
SELECT pkey, COUNT(*) AS n, SUM(bval) AS sb, SUM(pval) AS sp
FROM skew_probe JOIN skew_build ON pkey = bkey GROUP BY pkey ORDER BY pkey;
pkey	n	sb	sp
7	40000	4020000	4020000
# LEFT
SELECT pkey, COUNT(*) AS n, SUM(bval) AS sb, COUNT(bkey) AS matched
FROM skew_probe LEFT JOIN skew_build ON pkey = bkey GROUP BY pkey ORDER BY pkey;
pkey	n	sb	matched
7	40000	4020000	40000
9	20	NULL	0
# SEMI
SELECT COUNT(*) FROM skew_probe WHERE pkey IN (SELECT bkey FROM skew_build);
COUNT(*)
200
# ANTI
SELECT COUNT(*) FROM skew_probe WHERE pkey NOT IN (SELECT bkey FROM skew_build);
COUNT(*)
20
SET SESSION join_buffer_size = default;
SET SESSION optimizer_switch = default;
SET SESSION use_secondary_engine = OFF;
DROP TABLE skew_probe;
DROP TABLE skew_build;
DROP TABLE num_probe;
DROP TABLE num_build;
DROP TABLE probe_side;
DROP TABLE build_side;
DROP DATABASE sh_hj_spill_db;
