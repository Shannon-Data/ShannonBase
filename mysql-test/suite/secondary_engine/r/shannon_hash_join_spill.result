# The build side must actually have been partitioned to disk. Without
# this the plan could have gone to MySQL's native spilling iterator --
# EXPLAIN prints the same "Inner hash join" for both -- and every result
# above would be vacuous. Session-scoped, so a concurrent connection
# cannot move it, and available in release builds.
SET SESSION use_secondary_engine = OFF;
SELECT VARIABLE_VALUE > 0 AS did_spill FROM performance_schema.session_status
WHERE VARIABLE_NAME = 'rapid_hash_join_spills';
did_spill
1
SET @spills_after = (SELECT VARIABLE_VALUE FROM performance_schema.session_status
WHERE VARIABLE_NAME = 'rapid_hash_join_spills');
SET SESSION use_secondary_engine = FORCED;
#
# ---- A build side that fits must NOT spill (guards against always-spill) ----
#
SET SESSION join_buffer_size = 4194304;
SELECT pkey, SUM(bval) AS sb FROM probe_side JOIN build_side ON pkey = bkey
GROUP BY pkey ORDER BY pkey LIMIT 5;
pkey	sb
1	2
2	8
3	12
4	16
5	20
# ...and with a large buffer the count must NOT have grown: a build side
# that fits still runs entirely in memory.
SET SESSION use_secondary_engine = OFF;
SELECT VARIABLE_VALUE = @spills_after AS stayed_in_memory
FROM performance_schema.session_status WHERE VARIABLE_NAME = 'rapid_hash_join_spills';
stayed_in_memory
1
SET SESSION join_buffer_size = default;
SET SESSION optimizer_switch = default;
SET SESSION use_secondary_engine = OFF;
DROP TABLE probe_side;
DROP TABLE build_side;
DROP DATABASE sh_hj_spill_db;
