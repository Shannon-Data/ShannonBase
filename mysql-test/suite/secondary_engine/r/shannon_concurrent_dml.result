7	Grace	110	active
9	Iris	101	active
11	Kate	97	active
12	Leo	103	active
14	Noah	94	active
15	Olivia	96	inactive
[con1] Final verification - all connections see same state (12 rows)
SELECT COUNT(*) FROM t_concur;
COUNT(*)
12
SELECT id, name, score, status FROM t_concur ORDER BY id;
id	name	score	status
1	Alice	100	active
2	Bob	95	active
3	Charlie	95	inactive
