count(*) as c
from eh
group by grp
having (sum(case when a is null then 1 else 0 end) >= 1
or sum(case when b is null then 1 else 0 end) >= 1)
and max(coalesce(a,b,0)) > 0
order by grp;
grp	null_a	null_b	max_cb	c
1	2	2	30	4
2	3	1	9	4
3	2	2	9	4
select grp,
sum(case when a is null and b is null then 1 else 0 end) as both_null,
sum(case when coalesce(a,b,0) > 0 then 1 else 0 end) as pos_cnt,
min(case when a is null then b else a end) as min_expr
from eh
where case when a is null then b else a end is not null
group by grp
having sum(case when coalesce(a,b,0) > 0 then 1 else 0 end) >= 2
order by grp;
grp	both_null	pos_cnt	min_expr
1	0	3	2
2	0	3	5
3	0	3	4
# ===== Rapid (hypergraph optimizer) =====
set session optimizer_switch='hypergraph_optimizer=on';
select grp,
count(*) as c,
sum(case when a is null then 0 else a end) as sum_a,
avg(case when b is null then null else b end) as avg_b,
max(case when a is null and b is null then 0 else coalesce(a,b,0) end) as max_expr
from eh
where a is not null or b is not null
group by grp
having count(*) >= 2
and avg(case when b is null then null else b end) is not null
order by grp;
grp	c	sum_a	avg_b	max_expr
1	3	40	16.0000	30
2	3	5	7.0000	9
3	3	16	6.5000	9
