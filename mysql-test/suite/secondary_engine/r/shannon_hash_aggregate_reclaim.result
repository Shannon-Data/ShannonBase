SET use_secondary_engine=OFF;
CREATE TABLE reclaim_seq (i INT PRIMARY KEY);
INSERT INTO reclaim_seq WITH RECURSIVE n AS (SELECT 0 i UNION ALL SELECT i+1 FROM n WHERE i<999) SELECT i FROM n;
CREATE TABLE reclaim_src (id INT PRIMARY KEY, g INT, v INT) SECONDARY_ENGINE=rapid;
INSERT INTO reclaim_src SELECT a.i*32+b.i,a.i*32+b.i,IF(MOD(b.i,7)=0,NULL,b.i)
FROM reclaim_seq a JOIN reclaim_seq b ON b.i<32 WHERE a.i<250;
CREATE TABLE reclaim_ref AS SELECT g,SUM(v*2) AS s,COUNT(v) AS c FROM reclaim_src GROUP BY g;
CREATE TABLE reclaim_ref_small AS SELECT g,SUM(v) AS s FROM reclaim_src WHERE id<3200 GROUP BY g;
ALTER TABLE reclaim_src SECONDARY_LOAD;
# Actual test system pool capacity: 25165824
SET optimizer_switch='hypergraph_optimizer=on';
SET use_secondary_engine=FORCED;
SET secondary_engine_cost_threshold=0;
SET debug='+d,rapid_test_hash_reclaim,rapid_pause_hash_before_reclaim,rapid_pause_hash_after_reclaim';
CREATE TABLE reclaim_got AS SELECT g,SUM(v*2) AS s,COUNT(v) AS c FROM reclaim_src GROUP BY g;
SET DEBUG_SYNC='now WAIT_FOR rapid_hash_before_reclaim_ready TIMEOUT 45';
SET DEBUG_SYNC='now SIGNAL rapid_hash_before_reclaim_continue';
SET DEBUG_SYNC='now WAIT_FOR rapid_hash_after_reclaim_ready TIMEOUT 45';
# Pressure returned a live reservation before the query completed.
SET DEBUG_SYNC='now SIGNAL rapid_hash_after_reclaim_continue';
SET debug='-d,rapid_test_hash_reclaim,rapid_pause_hash_before_reclaim,rapid_pause_hash_after_reclaim';
SET debug='+d,rapid_test_hash_output_reclaim,rapid_pause_hash_output_reclaim';
CREATE TABLE reclaim_got_small AS SELECT g,SUM(v) AS s FROM reclaim_src WHERE id<3200 GROUP BY g;
SET DEBUG_SYNC='now WAIT_FOR rapid_hash_output_reclaim_ready TIMEOUT 45';
SET DEBUG_SYNC='now SIGNAL rapid_hash_output_reclaim_continue';
SET debug='-d,rapid_test_hash_output_reclaim,rapid_pause_hash_output_reclaim';
SET DEBUG_SYNC='RESET';
SET use_secondary_engine=OFF;
SELECT COUNT(*) AS missing FROM (SELECT * FROM reclaim_ref EXCEPT ALL SELECT * FROM reclaim_got) x;
missing
0
SELECT COUNT(*) AS extra FROM (SELECT * FROM reclaim_got EXCEPT ALL SELECT * FROM reclaim_ref) x;
extra
0
SELECT COUNT(*) AS small_missing FROM (SELECT * FROM reclaim_ref_small EXCEPT ALL SELECT * FROM reclaim_got_small) x;
small_missing
0
SELECT COUNT(*) AS small_extra FROM (SELECT * FROM reclaim_got_small EXCEPT ALL SELECT * FROM reclaim_ref_small) x;
small_extra
0
DROP TABLE reclaim_ref,reclaim_ref_small,reclaim_got,reclaim_got_small,reclaim_src,reclaim_seq;
