# --- InnoDB baseline (hypergraph) ---
# A1-hg: 2-table join, filter on both sides (hypergraph)
# EXPLAIN:
EXPLAIN FORMAT=TREE SELECT COUNT(*) FROM t_big a JOIN t_med b ON a.grp = b.grp WHERE a.id < 100 AND b.val > 10;
EXPLAIN
-> Aggregate: count(0)  (cost=55..55 rows=1)
    -> Inner hash join (a.grp = b.grp)  (cost=7.11..38.6 rows=165)
        -> Index range scan on a using PRIMARY over (id < 100)  (cost=0.103..10.2 rows=99)
        -> Hash
            -> Filter: (b.val > 10)  (cost=0.315..5.25 rows=16.7)
                -> Table scan on b  (cost=0.005..0.25 rows=50)

SELECT COUNT(*) FROM t_big a JOIN t_med b ON a.grp = b.grp
WHERE a.id < 100 AND b.val > 10;
COUNT(*)
220
