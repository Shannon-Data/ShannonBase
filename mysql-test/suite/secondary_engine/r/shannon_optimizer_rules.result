create database vec_rules_test;
use vec_rules_test;
CREATE TABLE t_small (
id    INT PRIMARY KEY,
grp   INT,
val   INT
) SECONDARY_ENGINE=rapid;
CREATE TABLE t_med (
id    INT PRIMARY KEY,
grp   INT,
val   INT,
name  CHAR(10)
) SECONDARY_ENGINE=rapid;
CREATE TABLE t_big (
id    INT PRIMARY KEY,
grp   INT,
val   INT,
name  CHAR(10),
extra CHAR(50)
) SECONDARY_ENGINE=rapid;
SET USE_SECONDARY_ENGINE=OFF;
# --- InnoDB baseline ---
# A1: 2-table join, filter on both sides
SELECT COUNT(*) FROM t_big a JOIN t_med b ON a.grp = b.grp
WHERE a.id < 100 AND b.val > 10;
COUNT(*)
220
# A2: selective PK range filter
SELECT COUNT(*) FROM t_big WHERE id BETWEEN 10 AND 50;
COUNT(*)
41
# A3: project specific columns + ORDER BY
SELECT id, name FROM t_big WHERE id < 20 ORDER BY id;
id	name
1	b_1
2	b_2
3	b_3
4	b_4
5	b_5
6	b_6
7	b_7
8	b_8
9	b_9
10	b_10
11	b_11
12	b_12
13	b_13
14	b_14
15	b_15
16	b_16
17	b_17
18	b_18
19	b_19
# A4: ORDER BY + LIMIT
SELECT * FROM t_big ORDER BY id LIMIT 5;
id	grp	val	name	extra
1	1	1	b_1	yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy
2	2	2	b_2	yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy
3	3	3	b_3	yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy
4	4	4	b_4	yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy
5	5	5	b_5	yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy
# A5: COUNT(*) with 2-table join
SELECT COUNT(*) FROM t_big a JOIN t_med b ON a.grp = b.grp;
COUNT(*)
500
# A6: GROUP BY + SUM with join
SELECT b.grp, SUM(a.val)
FROM t_big a JOIN t_med b ON a.grp = b.grp
GROUP BY b.grp ORDER BY b.grp;
grp	SUM(a.val)
0	5500
1	4550
2	4600
3	4650
4	4700
5	4750
6	4800
7	4850
8	4900
9	4950
# A6b: GROUP BY + SUM with join (no ORDER BY)
SELECT b.grp, SUM(a.val)
FROM t_big a JOIN t_med b ON a.grp = b.grp
GROUP BY b.grp;
grp	SUM(a.val)
1	4550
2	4600
3	4650
4	4700
5	4750
6	4800
7	4850
8	4900
9	4950
0	5500
# A7: 3-table join
SELECT COUNT(*)
FROM t_big a JOIN t_med b ON a.grp = b.grp
JOIN t_small c ON b.grp = c.grp;
COUNT(*)
500
# A8: STRAIGHT_JOIN (3 tables)
SELECT COUNT(*)
FROM t_big a STRAIGHT_JOIN t_med b ON a.grp = b.grp
STRAIGHT_JOIN t_small c ON b.grp = c.grp;
COUNT(*)
500
# A9: LATERAL — max val per group
SELECT a.id, b.max_val
FROM t_small a,
LATERAL (SELECT MAX(val) AS max_val FROM t_med WHERE t_med.grp = a.grp) b
ORDER BY a.id;
id	max_val
1	82
2	84
3	86
4	88
5	100
6	82
7	84
8	86
9	88
10	100
# A10: LATERAL — count & sum per group
SELECT a.id, a.name, b.cnt, b.sum_val
FROM t_big a,
LATERAL (SELECT COUNT(*) AS cnt, SUM(val) AS sum_val
FROM t_med WHERE t_med.grp = a.grp) b
ORDER BY a.id LIMIT 5;
id	name	cnt	sum_val
1	b_1	5	210
2	b_2	5	220
3	b_3	5	230
4	b_4	5	240
5	b_5	5	250
# A11: LATERAL — avg & min per group
SELECT a.id, b.avg_val, b.min_val
FROM t_small a,
LATERAL (SELECT AVG(val) AS avg_val, MIN(val) AS min_val
FROM t_med WHERE t_med.grp = a.grp) b
ORDER BY a.id;
id	avg_val	min_val
1	42.0000	2
2	44.0000	4
3	46.0000	6
4	48.0000	8
5	60.0000	20
6	42.0000	2
7	44.0000	4
8	46.0000	6
9	48.0000	8
10	60.0000	20
# A12: LATERAL — multi aggregates (count, sum, avg, min, max)
explain format=tree SELECT a.id, b.cnt, b.sum_val, b.avg_val, b.min_val, b.max_val
FROM t_small a,
LATERAL (SELECT COUNT(*) AS cnt, SUM(val) AS sum_val, AVG(val) AS avg_val,
MIN(val) AS min_val, MAX(val) AS max_val
FROM t_med WHERE t_med.grp = a.grp) b
ORDER BY a.id;
EXPLAIN
-> Nested loop inner join  (cost=32.9 rows=10)
    -> Invalidate materialized tables (row from a)  (cost=1.25 rows=10)
        -> Index scan on a using PRIMARY  (cost=1.25 rows=10)
    -> Table scan on b  (cost=3.86..3.86 rows=1)
        -> Materialize (invalidate on row from a)  (cost=1.35..1.35 rows=1)
            -> Aggregate: count(0), sum(t_med.val), avg(t_med.val), min(t_med.val), max(t_med.val)  (cost=1.25 rows=1)
                -> Filter: (t_med.grp = a.grp)  (cost=0.75 rows=5)
                    -> Table scan on t_med  (cost=0.75 rows=50)

Warnings:
Note	1276	Field or reference 'vec_rules_test.a.grp' of SELECT #2 was resolved in SELECT #1
SELECT a.id, b.cnt, b.sum_val, b.avg_val, b.min_val, b.max_val
FROM t_small a,
LATERAL (SELECT COUNT(*) AS cnt, SUM(val) AS sum_val, AVG(val) AS avg_val,
MIN(val) AS min_val, MAX(val) AS max_val
FROM t_med WHERE t_med.grp = a.grp) b
ORDER BY a.id;
id	cnt	sum_val	avg_val	min_val	max_val
