# --- Rapid hypergraph ---
# B1 — PredicatePushDown
# EXPLAIN:
EXPLAIN FORMAT=TREE SELECT COUNT(*) FROM t_big a JOIN t_med b ON a.grp = b.grp WHERE a.id < 100 AND b.val > 10;
EXPLAIN
-> Vectorized aggregate: count(0)
    -> Inner hash join (a.grp = b.grp)
        -> Vectorized table scan on a in secondary engine Rapid [filter: a.id < 100]
        -> Hash
            -> Vectorized table scan on b in secondary engine Rapid [filter: (b.val > 10)]

Warnings:
Note	1003	Query is executed in secondary engine; the actual query plan may diverge from the printed one
SELECT COUNT(*) FROM t_big a JOIN t_med b ON a.grp = b.grp
WHERE a.id < 100 AND b.val > 10;
COUNT(*)
220
# B2 — StorageIndexPrune
# EXPLAIN:
EXPLAIN FORMAT=TREE SELECT COUNT(*) FROM t_big WHERE id BETWEEN 10 AND 50;
EXPLAIN
-> Vectorized aggregate: count(0)
    -> Vectorized table scan on t_big in secondary engine Rapid [filter: (t_big.id BETWEEN 10 AND 50 AND (t_big.id >= 10 AND t_big.id <= 50))]

Warnings:
Note	1003	Query is executed in secondary engine; the actual query plan may diverge from the printed one
