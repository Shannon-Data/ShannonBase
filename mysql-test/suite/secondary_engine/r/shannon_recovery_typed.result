CREATE DATABASE sh_recovery_typed;
USE sh_recovery_typed;
CREATE TABLE t (id INT PRIMARY KEY, v INT, s VARCHAR(32), n DECIMAL(10,2), b TEXT) SECONDARY_ENGINE=rapid;
INSERT INTO t VALUES (1,10,'alpha',1.25,REPEAT('a',5000)),(2,20,'beta',2.50,REPEAT('b',5000)),(3,30,NULL,NULL,REPEAT('c',5000));
ALTER TABLE t SECONDARY_LOAD;
# restart: --rapid_reload_on_restart=ON
USE sh_recovery_typed;
SET SESSION sql_log_bin=OFF;
SET GLOBAL DEBUG='+d,secondary_engine_rapid_propagation_stall';
BEGIN;
INSERT INTO t VALUES (4,40,'delta',4.75,REPEAT('d',6000));
UPDATE t SET v=11,s='changed',n=NULL,b=REPEAT('z',7000) WHERE id=1;
DELETE FROM t WHERE id=2;
COMMIT;
# Kill and restart: --rapid_reload_on_restart=ON
USE sh_recovery_typed;
SELECT VARIABLE_VALUE FROM performance_schema.global_status WHERE VARIABLE_NAME='rapid_recovery_storage_restores';
VARIABLE_VALUE
1
SET use_secondary_engine=OFF;
SELECT id,v FROM t ORDER BY id;
id	v
1	11
3	30
4	40
INSERT INTO t VALUES (6,60,'six',6.25,REPEAT('f',8000));
UPDATE t SET v=31,s='three',n=3.50,b=REPEAT('e',9000) WHERE id=3;
DELETE FROM t WHERE id=4;
# Kill and restart: --rapid_reload_on_restart=ON
USE sh_recovery_typed;
SET use_secondary_engine=OFF;
SELECT id,v FROM t ORDER BY id;
id	v
1	11
3	31
6	60
DROP DATABASE sh_recovery_typed;
