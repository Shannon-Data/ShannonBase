SET @saved_debug=@@GLOBAL.debug;
CALL mtr.add_suppression("Rapid COMMITTED_BINLOG: committed batch propagation failed");
SET use_secondary_engine=OFF;
SET GLOBAL rapid_change_propagation_mode=COMMITTED_BINLOG;
CREATE TABLE cb_prepare (id INT PRIMARY KEY,v INT) SECONDARY_ENGINE=rapid;
INSERT INTO cb_prepare VALUES (1,10);
ALTER TABLE cb_prepare SECONDARY_LOAD;
INSERT INTO cb_prepare VALUES (2,20);
SET use_secondary_engine=FORCED;
SELECT SUM(v) FROM cb_prepare;
ERROR HY000: Secondary engine operation failed. committed batch propagation failed; reload required.
SET use_secondary_engine=ON;
SELECT COUNT(*),SUM(v) FROM cb_prepare;
COUNT(*)	SUM(v)
2	30
SET use_secondary_engine=OFF;
ALTER TABLE cb_prepare SECONDARY_UNLOAD;
SET GLOBAL debug='-d,rapid_committed_prepare_failure';
ALTER TABLE cb_prepare SECONDARY_LOAD;
INSERT INTO cb_prepare VALUES (3,30);
SET use_secondary_engine=FORCED;
SELECT COUNT(*),SUM(v) FROM cb_prepare;
COUNT(*)	SUM(v)
3	60
SET use_secondary_engine=OFF;
ALTER TABLE cb_prepare SECONDARY_UNLOAD;
DROP TABLE cb_prepare;
SET GLOBAL rapid_change_propagation_mode=CAPTURE;
SET GLOBAL debug=@saved_debug;
