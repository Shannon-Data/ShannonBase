create database sh_imcs_scan;
use sh_imcs_scan;
SET USE_SECONDARY_ENGINE=FORCED;
########################################################################
# Test 1: Storage Index pruning — range queries that skip IMCUs
########################################################################
CREATE TABLE t_si_prune (
id INT PRIMARY KEY,
category INT,
value DOUBLE
) SECONDARY_ENGINE=RAPID;
ALTER TABLE t_si_prune SECONDARY_LOAD;
SELECT COUNT(*) FROM t_si_prune;
COUNT(*)
9000
SELECT COUNT(*) FROM t_si_prune WHERE value < 100;
COUNT(*)
99
SELECT COUNT(*) FROM t_si_prune WHERE value > 8000;
COUNT(*)
1000
SELECT COUNT(*) FROM t_si_prune WHERE value BETWEEN 3000 AND 3100;
COUNT(*)
101
SELECT * FROM t_si_prune WHERE id BETWEEN 500 AND 510 ORDER BY id;
id	category	value
500	1	500
501	1	501
502	1	502
503	1	503
504	1	504
505	1	505
506	1	506
507	1	507
508	1	508
509	1	509
510	1	510
SELECT * FROM t_si_prune WHERE id > 8990 ORDER BY id;
id	category	value
8991	3	8991
8992	3	8992
8993	3	8993
8994	3	8994
8995	3	8995
8996	3	8996
8997	3	8997
8998	3	8998
8999	3	8999
9000	3	9000
DROP TABLE t_si_prune;
