SET @save_rapid_use_dynamic_offload = @@GLOBAL.rapid_use_dynamic_offload;
SET GLOBAL rapid_use_dynamic_offload=off;
create database vec_iter_wide;
use vec_iter_wide;
CREATE TABLE t_wide (
id        BIGINT PRIMARY KEY AUTO_INCREMENT,
grp_low   INT,
grp_high  INT,
val_int   INT,
val_big   BIGINT,
val_dec   DECIMAL(12,2),
val_float FLOAT,
val_dbl   DOUBLE,
val_char  CHAR(50),
pad       VARCHAR(200)
) SECONDARY_ENGINE=rapid;
SELECT COUNT(*) AS total_rows FROM t_wide;
total_rows
1000
SET USE_SECONDARY_ENGINE=OFF;
# --- InnoDB ---
# Scalar COUNT(*) self-join with filter
SELECT COUNT(*)
FROM t_wide a JOIN t_wide b ON a.grp_low = b.grp_low
WHERE a.id < 500;
COUNT(*)
4423
# GROUP BY self-join — exercises ProcessGroupVectorized boundary detection
SELECT a.grp_low, COUNT(*)
FROM t_wide a JOIN t_wide b ON a.grp_low = b.grp_low
WHERE a.id < 500
GROUP BY a.grp_low
ORDER BY a.grp_low
LIMIT 5;
grp_low	COUNT(*)
0	32
1	45
2	45
3	45
4	45
# GROUP BY self-join with SUM / AVG
SELECT a.grp_high,
COUNT(*),
SUM(a.val_int),
ROUND(SUM(a.val_dbl), 6),
ROUND(AVG(a.val_dbl), 6)
FROM t_wide a JOIN t_wide b ON a.grp_high = b.grp_high
WHERE a.id < 500
GROUP BY a.grp_high
ORDER BY a.grp_high;
grp_high	COUNT(*)	SUM(a.val_int)	ROUND(SUM(a.val_dbl), 6)	ROUND(AVG(a.val_dbl), 6)
0	2888	2196324	271149.375744	93.888288
1	3003	2234232	275829.345792	91.851264
2	3003	2243241	276941.560896	92.221632
3	3003	2252250	278053.776	92.592
4	3003	2261259	279165.991104	92.962368
5	3003	2270268	280278.206208	93.332736
6	2926	2163777	267131.253312	91.295712
7	2926	2172555	268214.95008	91.66608
8	2926	2181333	269298.646848	92.036448
9	2926	2190111	270382.343616	92.406816
10	2926	2198889	271466.040384	92.777184
11	2926	2207667	272549.737152	93.147552
12	2926	2216445	273633.43392	93.51792
# Self-join with two GROUP BY columns
SELECT a.grp_low, a.grp_high, COUNT(*)
FROM t_wide a JOIN t_wide b ON a.grp_low = b.grp_low
WHERE a.id < 500
GROUP BY a.grp_low, a.grp_high
ORDER BY a.grp_low, a.grp_high
LIMIT 5;
grp_low	grp_high	COUNT(*)
0	1	8
0	5	8
0	9	8
0	10	8
1	1	9
# GROUP BY self-join without ORDER BY must not lose groups
SELECT COUNT(*) AS groups_found, SUM(group_rows) AS joined_rows
FROM (SELECT a.grp_low, COUNT(*) AS group_rows
FROM t_wide a JOIN t_wide b ON a.grp_low = b.grp_low
WHERE a.id < 500 GROUP BY a.grp_low) g;
groups_found	joined_rows
113	4423
# Reversing join inputs must preserve grouped results
SELECT COUNT(*) AS groups_found, SUM(group_rows) AS joined_rows
FROM (SELECT b.grp_low, COUNT(*) AS group_rows
FROM t_wide b JOIN t_wide a ON b.grp_low = a.grp_low
WHERE a.id < 500 GROUP BY b.grp_low) g;
groups_found	joined_rows
113	4423
# Subquery — scalar in WHERE
SELECT COUNT(*)
FROM t_wide
WHERE grp_low = (SELECT grp_low FROM t_wide WHERE id = 10);
COUNT(*)
9
# Subquery — IN clause
SELECT COUNT(*)
FROM t_wide
WHERE grp_low IN (SELECT grp_low FROM t_wide WHERE id < 20);
COUNT(*)
171
# Subquery as derived table
SELECT COUNT(*), SUM(x.c)
FROM (SELECT grp_low, COUNT(*) AS c FROM t_wide WHERE id < 500 GROUP BY grp_low) x;
COUNT(*)	SUM(x.c)
113	499
SET USE_SECONDARY_ENGINE=FORCED;
ALTER TABLE t_wide SECONDARY_LOAD;
SET secondary_engine_cost_threshold=0;
SET SESSION optimizer_switch='hypergraph_optimizer=on';
