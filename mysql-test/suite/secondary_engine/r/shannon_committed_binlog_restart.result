ALTER TABLE cb_restart SECONDARY_LOAD;
UPDATE cb_restart SET v=11 WHERE id=1;
SET use_secondary_engine=FORCED;
SELECT COUNT(*),SUM(v) FROM cb_restart;
COUNT(*)	SUM(v)
