create database sh_pbk;
use sh_pbk;
create table pb_p (id int primary key, kkey text not null, v int not null) secondary_engine=rapid partition by range (id) (partition p0 values less than (5), partition p1 values less than (10), partition p2 values less than maxvalue);
create table pb_q (id int primary key, kkey text not null, w int not null) secondary_engine=rapid;
insert into pb_p values (1,'aaa',100),(2,'bbb',200),(3,'bbb',300),(4,'ccc',400),(6,'aaa',500),(8,'ddd',600);
insert into pb_q values (1,'aaa',1000),(2,'bbb',2000),(4,'ccc',4000),(5,'eee',5000);
alter table pb_p secondary_load;
alter table pb_q secondary_load;
set session optimizer_switch='hypergraph_optimizer=on';
# ===== InnoDB baseline =====
set session use_secondary_engine = off;
select l.id, r.id, l.kkey, l.v, r.w from pb_p l join pb_q r on l.kkey = r.kkey order by l.id;
id	id	kkey	v	w
1	1	aaa	100	1000
2	2	bbb	200	2000
3	2	bbb	300	2000
4	4	ccc	400	4000
6	1	aaa	500	1000
select count(*) as n from pb_p l join pb_q r on l.kkey = r.kkey;
n
5
# ===== Rapid =====
set session use_secondary_engine = forced;
select l.id, r.id, l.kkey, l.v, r.w from pb_p l join pb_q r on l.kkey = r.kkey order by l.id;
id	id	kkey	v	w
1	1	aaa	100	1000
2	2	bbb	200	2000
3	2	bbb	300	2000
4	4	ccc	400	4000
6	1	aaa	500	1000
select count(*) as n from pb_p l join pb_q r on l.kkey = r.kkey;
n
5
use test;
drop database sh_pbk;
