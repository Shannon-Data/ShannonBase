DROP DATABASE IF EXISTS sh_vlen_txn;
Warnings:
Note	1008	Can't drop database 'sh_vlen_txn'; database doesn't exist
CREATE DATABASE sh_vlen_txn;
USE sh_vlen_txn;
CREATE TABLE t_vlen (
id INT PRIMARY KEY,
t TEXT,
b BLOB
) SECONDARY_ENGINE=RAPID;
INSERT INTO t_vlen VALUES
(1, REPEAT('A',1024), REPEAT('B',1024)),
(2, REPEAT('C',1024), REPEAT('D',1024));
ALTER TABLE t_vlen SECONDARY_LOAD;
SET SESSION USE_SECONDARY_ENGINE=OFF;
BEGIN;
UPDATE t_vlen SET t = REPEAT('X',2048), b = REPEAT('Y',2048) WHERE id = 1;
SELECT id, CHAR_LENGTH(t), OCTET_LENGTH(b) FROM t_vlen WHERE id = 1;
id	CHAR_LENGTH(t)	OCTET_LENGTH(b)
1	2048	2048
SET SESSION USE_SECONDARY_ENGINE=FORCED;
SET SESSION optimizer_switch='hypergraph_optimizer=off';
SELECT id, CHAR_LENGTH(t), OCTET_LENGTH(b) FROM t_vlen WHERE id = 1;
id	CHAR_LENGTH(t)	OCTET_LENGTH(b)
1	1024	1024
ROLLBACK;
SET SESSION USE_SECONDARY_ENGINE=FORCED;
SELECT id, CHAR_LENGTH(t), OCTET_LENGTH(b) FROM t_vlen WHERE id = 1;
id	CHAR_LENGTH(t)	OCTET_LENGTH(b)
1	1024	1024
# ----- the same committed state under the hypergraph optimizer -----
# Visibility is decided by the engine's MVCC, not by the planner. What
# this adds is that a hypergraph plan reads large TEXT/BLOB values back out of
# Rapid and agrees with the legacy reads above -- only one planner ever
# reached those Rapid iterators.
SET SESSION optimizer_switch='hypergraph_optimizer=on';
SELECT id, CHAR_LENGTH(t), OCTET_LENGTH(b) FROM t_vlen WHERE id = 1;
id	CHAR_LENGTH(t)	OCTET_LENGTH(b)
1	1024	1024
SET SESSION optimizer_switch = default;
DROP TABLE t_vlen;
DROP DATABASE sh_vlen_txn;
