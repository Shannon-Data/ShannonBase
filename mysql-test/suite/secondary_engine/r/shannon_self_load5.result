# restart
#
# rapid_change_propagation_status mirrors HeatWave's global Change
# Propagation on/off status: ON while the Rapid propagation coordinator
# is running.
#
SHOW GLOBAL STATUS LIKE 'rapid_change_propagation_status';
Variable_name	Value
rapid_change_propagation_status	OFF
SHOW GLOBAL STATUS LIKE 'rapid_pop_thread_running';
Variable_name	Value
SHOW GLOBAL STATUS LIKE 'rapid_mempool_capacity_bytes';
Variable_name	Value
rapid_mempool_capacity_bytes	2147483648
SELECT VARIABLE_NAME FROM performance_schema.global_status
WHERE VARIABLE_NAME LIKE 'rapid%' ORDER BY VARIABLE_NAME;
VARIABLE_NAME
rapid_bg_queue_size
rapid_bg_tasks_failed
rapid_change_propagation_status
rapid_estimated_compressed_size_bytes
rapid_loaded_tables
rapid_mempool_capacity_bytes
rapid_mempool_failed_allocs
rapid_mempool_usage_percentage
rapid_mempool_used_bytes
rapid_parallel_worker_status
rapid_pop_data_remaining_bytes
rapid_pop_tables_in_progress
rapid_query_offload_fallback_total
rapid_query_offload_total
rapid_query_rows_read_total
rapid_resource_io_status
rapid_resource_plan
rapid_resource_status
rapid_sys_pool_status
rapid_total_rows
SELECT VARIABLE_VALUE FROM performance_schema.global_status
WHERE VARIABLE_NAME = 'rapid_change_propagation_status';
VARIABLE_VALUE
OFF
create database sh_self_load5;
use sh_self_load5;
set @saved_dynamic_offload = @@global.rapid_use_dynamic_offload;
set global rapid_use_dynamic_offload = off;
set @saved_cost_threshold = @@global.secondary_engine_cost_threshold;
set global secondary_engine_cost_threshold = -1;
Warnings:
Warning	1292	Truncated incorrect secondary_engine_cost_threshold value: '-1'
set session secondary_engine_cost_threshold = -1;
Warnings:
Warning	1292	Truncated incorrect secondary_engine_cost_threshold value: '-1'
SELECT PLUGIN_NAME, PLUGIN_STATUS FROM information_schema.plugins WHERE PLUGIN_NAME='Rapid';
PLUGIN_NAME	PLUGIN_STATUS
Rapid	ACTIVE
#
# RECOMMENDED_READ_THREADS is recorded at load time.
#
set session innodb_parallel_read_threads = 4;
create table rt1 (id int primary key, v int) secondary_engine=rapid;
insert into rt1 values (1,1),(2,2),(3,3);
alter table rt1 secondary_load;
select recommended_read_threads from performance_schema.rpd_mirror where table_name='rt1';
recommended_read_threads
4
# Changing the session setting afterwards must not change the recorded value.
set session innodb_parallel_read_threads = 1;
select recommended_read_threads from performance_schema.rpd_mirror where table_name='rt1';
recommended_read_threads
4
set session innodb_parallel_read_threads = default;
#
# QUERIED_PARTITIONS tracks partitions actually touched by queries,
# accumulating across queries.
#
create table pt1 (id int primary key, v int)
partition by range(id) (
partition p0 values less than (10),
partition p1 values less than (20),
partition p2 values less than (30),
partition p3 values less than maxvalue);
insert into pt1 values (1,1),(11,2),(21,3),(31,4);
alter table pt1 secondary_engine=rapid;
alter table pt1 secondary_load;
# No query has touched pt1 yet.
select queried_partitions from performance_schema.rpd_mirror where table_name='pt1';
queried_partitions
[]
# Pruned to p0 only.
select * from pt1 where id < 10;
id	v
1	1
select mysql_access_count, queried_partitions from performance_schema.rpd_mirror where table_name='pt1';
mysql_access_count	queried_partitions
0	["p0"]
# Pruned to p2 only; queried_partitions accumulates across queries.
select * from pt1 where id >= 20 and id < 30;
id	v
21	3
select queried_partitions from performance_schema.rpd_mirror where table_name='pt1';
queried_partitions
["p0", "p2"]
set global secondary_engine_cost_threshold = @saved_cost_threshold;
set session secondary_engine_cost_threshold = default;
set global rapid_use_dynamic_offload = @saved_dynamic_offload;
drop database sh_self_load5;
