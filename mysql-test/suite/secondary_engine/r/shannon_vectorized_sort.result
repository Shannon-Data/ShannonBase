CREATE DATABASE sh_vsort_db;
USE sh_vsort_db;
CREATE TABLE t1 (
id INT PRIMARY KEY,
i  INT NOT NULL,
u  INT UNSIGNED NOT NULL,
bi BIGINT NOT NULL,
si SMALLINT NOT NULL,
d  DECIMAL(15,2) NOT NULL,
f  DOUBLE NOT NULL,
dt DATE NOT NULL,
ts DATETIME NOT NULL,
y  YEAR NOT NULL,
ni INT,
nd DECIMAL(10,3),
c  CHAR(8) NOT NULL,
v  VARCHAR(32) NOT NULL,
e  ENUM('x','y','z') NOT NULL,
tx TEXT
) SECONDARY_ENGINE RAPID;
