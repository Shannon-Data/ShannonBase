#
# The whole spilled ordering, not just its ends: captured once per arm
# into its own table through a variable that counts the rows as the sort
# emits them, so the comparison is order-sensitive without printing 400
# rows three times.
#
CREATE DATABASE sh_vsort_cap;
SET SESSION use_secondary_engine = FORCED;
SET SESSION debug = '+d,rapid_sort_tiny_budget';
SET @r := 0;
CREATE TABLE sh_vsort_cap.spilled AS SELECT @r := @r + 1 AS rn, id, g FROM t_spill ORDER BY s, id;
Warnings:
Warning	1287	Setting user variables within expressions is deprecated and will be removed in a future release. Consider alternatives: 'SET variable=expression, ...', or 'SELECT expression(s) INTO variables(s)'.
SET SESSION debug = '-d,rapid_sort_tiny_budget';
SET SESSION debug = '+d,rapid_disable_vectorized_sort';
SET @r := 0;
CREATE TABLE sh_vsort_cap.native AS SELECT @r := @r + 1 AS rn, id, g FROM t_spill ORDER BY s, id;
Warnings:
Warning	1287	Setting user variables within expressions is deprecated and will be removed in a future release. Consider alternatives: 'SET variable=expression, ...', or 'SELECT expression(s) INTO variables(s)'.
SET SESSION debug = '-d,rapid_disable_vectorized_sort';
SET SESSION use_secondary_engine = OFF;
SET @r := 0;
CREATE TABLE sh_vsort_cap.innodb AS SELECT @r := @r + 1 AS rn, id, g FROM t_spill ORDER BY s, id;
Warnings:
Warning	1287	Setting user variables within expressions is deprecated and will be removed in a future release. Consider alternatives: 'SET variable=expression, ...', or 'SELECT expression(s) INTO variables(s)'.
# every number must be 0: the three orderings agree row for row
SELECT COUNT(*) FROM sh_vsort_cap.spilled s JOIN sh_vsort_cap.native n USING (rn) WHERE s.id <> n.id;
COUNT(*)
0
SELECT COUNT(*) FROM sh_vsort_cap.spilled s JOIN sh_vsort_cap.innodb b USING (rn) WHERE s.id <> b.id;
COUNT(*)
0
SELECT (SELECT COUNT(*) FROM sh_vsort_cap.spilled) - (SELECT COUNT(*) FROM sh_vsort_cap.innodb);
(SELECT COUNT(*) FROM sh_vsort_cap.spilled) - (SELECT COUNT(*) FROM sh_vsort_cap.innodb)
0
#
# Re-running a sort must reset its state: the second Init() has to drop
# the runs and buffers the first one left behind.
#
SET SESSION use_secondary_engine = FORCED;
SET SESSION debug = '+d,rapid_sort_tiny_budget';
SELECT id, g FROM t_spill ORDER BY s, id LIMIT 2;
id	g
400	0
79	27
SELECT id, g FROM t_spill ORDER BY s, id LIMIT 2;
id	g
400	0
79	27
SET SESSION debug = '-d,rapid_sort_tiny_budget';
SET SESSION use_secondary_engine = DEFAULT;
DROP DATABASE sh_vsort_cap;
DROP TABLE t1, t_empty, t_wide, t_spill;
DROP DATABASE sh_vsort_db;
USE test;
