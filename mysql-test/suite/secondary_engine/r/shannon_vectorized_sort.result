#
# An empty table.
#
CREATE TABLE t_empty (id INT PRIMARY KEY, a INT) SECONDARY_ENGINE RAPID;
ALTER TABLE t_empty SECONDARY_LOAD;
SET SESSION use_secondary_engine = FORCED;
SELECT id, a FROM t_empty ORDER BY a, id;
id	a
#
# Shapes the operator declines, so MySQL's filesort runs instead and the
# counter must not move: an ORDER BY expression rather than a column, a
# key it cannot encode (TEXT), and a key too wide to encode -- a utf8mb4
# CHAR(100) needs ~20 bytes per character, well past kMaxKeyPartBytes.
#
CREATE TABLE t_wide (id INT PRIMARY KEY, s CHAR(100)) SECONDARY_ENGINE RAPID;
INSERT INTO t_wide VALUES (1,'b'),(2,'a');
ALTER TABLE t_wide SECONDARY_LOAD;
SET SESSION use_secondary_engine = FORCED;
SELECT id, i FROM t1 ORDER BY i + 0, id;
id	i
6	-99
2	-5
3	0
7	1
8	1
1	5
4	5
5	99
