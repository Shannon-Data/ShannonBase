id	tx
2	NULL
5	NULL
1	tt
3	uu
4	vv
6	ww
7	xx
8	yy
SELECT id, s FROM t_wide ORDER BY s, id;
id	s
2	a
1	b
# rows through the vectorized sort for the declined shapes (0 expected):
0
#
# SELECT DISTINCT needs duplicate removal inside the sort, which the
# operator declines -- but the ORDER BY above the de-duplicated stream is
# still its own sort, and that one it does run.
#
SELECT DISTINCT i FROM t1 ORDER BY i;
i
-99
-5
0
1
5
99
#
# Spilling. A latin1 CHAR(1000) key is 1000 bytes per row, so with the
# budget shrunk to 64KB a few dozen rows already cross it and the sort
# writes several runs and merges them back. Run three ways again: the
# spilling operator, the operator switched off, and InnoDB.
#
CREATE TABLE t_spill (
id INT PRIMARY KEY,
s  CHAR(200) CHARACTER SET latin1 NOT NULL,
g  INT NOT NULL
) SECONDARY_ENGINE RAPID;
SET SESSION cte_max_recursion_depth = 10000;
INSERT INTO t_spill (id, s, g)
WITH RECURSIVE seq(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM seq WHERE n < 400)
SELECT n, CONCAT('k', LPAD((n * 7919) % 400, 4, '0')), (n * 13) % 50 FROM seq;
SET SESSION cte_max_recursion_depth = DEFAULT;
ANALYZE TABLE t_spill;
Table	Op	Msg_type	Msg_text
sh_vsort_db.t_spill	analyze	status	OK
ALTER TABLE t_spill SECONDARY_LOAD;
SET SESSION use_secondary_engine = FORCED;
SET SESSION debug = '+d,rapid_sort_tiny_budget';
SELECT id, g FROM t_spill ORDER BY s, id;
# did the vectorized sort spill to disk (1 expected):
1
# --- the ends of the spilling ordering, and a top-N over the same table
# (a LIMIT uses the bounded heap, so it does not spill)
