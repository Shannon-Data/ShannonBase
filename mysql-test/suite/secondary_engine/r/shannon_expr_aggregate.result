ANALYZE TABLE lineitem_lite;
Table	Op	Msg_type	Msg_text
sh_expr_agg_db.lineitem_lite	analyze	status	OK
ALTER TABLE lineitem_lite SECONDARY_LOAD;
#
# ---- InnoDB baseline ----
#
SET SESSION use_secondary_engine = OFF;
# B1: SUM over a product-of-difference (TPC-H Q1 disc_price)
SELECT SUM(extprice * (1 - discount)) FROM lineitem_lite;
SUM(extprice * (1 - discount))
306997.2964
# B2: nested product (TPC-H Q1 charge)
SELECT SUM(extprice * (1 - discount) * (1 + tax)) FROM lineitem_lite;
SUM(extprice * (1 - discount) * (1 + tax))
317109.094650
# B3: mixed +/- across four columns
SELECT SUM(extprice * (1 - discount) - supplycost * quantity) FROM lineitem_lite;
SUM(extprice * (1 - discount) - supplycost * quantity)
-985454.0036
# B4: AVG over an expression
SELECT AVG(extprice * (1 - discount)) FROM lineitem_lite;
AVG(extprice * (1 - discount))
30699.72964000
# B5: COUNT over a nullable expression -- NULLs must not be counted
SELECT COUNT(nullable_d * 2) FROM lineitem_lite;
COUNT(nullable_d * 2)
7
# B6: integer arithmetic
SELECT SUM(n_int * m_int), SUM(n_int - m_int) FROM lineitem_lite;
SUM(n_int * m_int)	SUM(n_int - m_int)
4600	70
# B7: grouped, the shape that actually reaches hash aggregation
SELECT flag, SUM(extprice * (1 - discount)) AS disc_price,
AVG(extprice * (1 - discount)) AS avg_disc,
COUNT(*) AS cnt
FROM lineitem_lite GROUP BY flag ORDER BY flag;
flag	disc_price	avg_disc	cnt
A	133522.7754	33380.69385000	4
B	40516.4892	13505.49640000	3
C	132958.0318	44319.34393333	3
# B8: unary minus and division
SELECT SUM(-extprice), SUM(extprice / 4) FROM lineitem_lite;
SUM(-extprice)	SUM(extprice / 4)
-329620.57	82405.142500
# B9: MIN/MAX over an expression stay on the scalar path (excluded from
#     the rewrite because their reduced path re-drives aggregator_add())
SELECT MIN(extprice * (1 - discount)), MAX(extprice * (1 - discount)) FROM lineitem_lite;
MIN(extprice * (1 - discount))	MAX(extprice * (1 - discount))
2188.2168	50814.5670
#
# ---- Rapid: every answer must match the baseline above exactly ----
#
SET SESSION use_secondary_engine = FORCED;
# B1
SELECT SUM(extprice * (1 - discount)) FROM lineitem_lite;
SUM(extprice * (1 - discount))
306997.2964
# B2
SELECT SUM(extprice * (1 - discount) * (1 + tax)) FROM lineitem_lite;
SUM(extprice * (1 - discount) * (1 + tax))
317109.094650
# B3
SELECT SUM(extprice * (1 - discount) - supplycost * quantity) FROM lineitem_lite;
SUM(extprice * (1 - discount) - supplycost * quantity)
-985454.0036
# B4
SELECT AVG(extprice * (1 - discount)) FROM lineitem_lite;
AVG(extprice * (1 - discount))
30699.72964000
# B5
SELECT COUNT(nullable_d * 2) FROM lineitem_lite;
COUNT(nullable_d * 2)
7
# B6
SELECT SUM(n_int * m_int), SUM(n_int - m_int) FROM lineitem_lite;
SUM(n_int * m_int)	SUM(n_int - m_int)
4600	70
# B7
SELECT flag, SUM(extprice * (1 - discount)) AS disc_price,
AVG(extprice * (1 - discount)) AS avg_disc,
COUNT(*) AS cnt
FROM lineitem_lite GROUP BY flag ORDER BY flag;
flag	disc_price	avg_disc	cnt
