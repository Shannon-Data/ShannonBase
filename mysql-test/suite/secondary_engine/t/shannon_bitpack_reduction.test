--source include/no_ps_protocol.inc
--disable_warnings
SET use_secondary_engine=OFF;
CREATE TABLE bp_reduction(id INT PRIMARY KEY,v INT COMMENT 'RAPID_COLUMN=ENCODING=BITPACK') SECONDARY_ENGINE=rapid;
INSERT INTO bp_reduction WITH RECURSIVE n AS (SELECT 1 i UNION ALL SELECT i+1 FROM n WHERE i<1000)
 SELECT (a.i-1)*10+b.i,IF(MOD(b.i,5)=0,NULL,100000+(a.i-1)*10+b.i)
 FROM n a JOIN n b ON b.i<=10;
ALTER TABLE bp_reduction SECONDARY_LOAD;
SET optimizer_switch='hypergraph_optimizer=on';
SET use_secondary_engine=FORCED;
--echo # NULL codes must not contribute to COUNT(column), SUM or extrema.
--let $rapid_stats_action = begin
--source suite/secondary_engine/include/rapid_stats_check.inc
SELECT COUNT(*),COUNT(v),SUM(v),MIN(v),MAX(v) FROM bp_reduction;
--let $rapid_stats_field = bitpack_aggregate
--let $rapid_stats_action = end
--source suite/secondary_engine/include/rapid_stats_check.inc
--let $assert_digest = SELECT COUNT(*),COUNT(v),SUM(v),MIN(v),MAX(v) FROM bp_reduction
--source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
--echo # Trailing NULL inserts need no packed code or increase of the written frontier.
INSERT INTO bp_reduction VALUES(10001,NULL),(10002,NULL);
--let $assert_digest = SELECT COUNT(*),COUNT(v),SUM(v),MIN(v),MAX(v) FROM bp_reduction
--source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
--echo # An expression consumer requires its base column as values.
--let $assert_digest = SELECT SUM(v),SUM(v+1),COUNT(v+1),MIN(v),MAX(v) FROM bp_reduction
--source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
--let $assert_digest = SELECT SUM(v+1),SUM(v),AVG(v+2) FROM bp_reduction
--source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
SET use_secondary_engine=OFF;
CREATE TABLE bp_expression(id INT PRIMARY KEY,v INT NOT NULL COMMENT 'RAPID_COLUMN=ENCODING=BITPACK') SECONDARY_ENGINE=rapid;
INSERT INTO bp_expression SELECT id,100000+id FROM bp_reduction;
ALTER TABLE bp_expression SECONDARY_LOAD;
SET use_secondary_engine=FORCED;
--let $assert_digest = SELECT SUM(v),SUM(v+1) FROM bp_expression
--source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
SET use_secondary_engine=OFF;
DROP TABLE bp_expression,bp_reduction;
--enable_warnings
