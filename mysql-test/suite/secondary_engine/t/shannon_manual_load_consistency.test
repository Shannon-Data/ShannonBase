--source include/have_debug.inc
--source include/have_debug_sync.inc
--source include/no_ps_protocol.inc
CREATE DATABASE sh_manual_consistency;
USE sh_manual_consistency;
CREATE TABLE t(id INT PRIMARY KEY,v INT) SECONDARY_ENGINE=rapid;
INSERT INTO t VALUES(1,10),(2,20);
connect(loader,localhost,root,,sh_manual_consistency);
SET SESSION debug='+d,before_secondary_engine_load_start';
--send ALTER TABLE t SECONDARY_LOAD
connection default;
SET DEBUG_SYNC='now WAIT_FOR before_load_start';
connect(writer,localhost,root,,sh_manual_consistency);
SET use_secondary_engine=OFF;
--send UPDATE t SET v=11 WHERE id=1
connection default;
--let $wait_condition = SELECT COUNT(*)=1 FROM information_schema.processlist WHERE INFO='UPDATE t SET v=11 WHERE id=1' AND STATE='Waiting for table metadata lock'
--source include/wait_condition.inc
SELECT COUNT(*) AS partially_published FROM performance_schema.rpd_table_id WHERE SCHEMA_NAME='sh_manual_consistency' AND TABLE_NAME='t';
SET DEBUG_SYNC='now SIGNAL metadata_check_done';
connection loader;
--reap
SET SESSION debug='';
connection writer;
--reap
connection default;
--let $assert_digest = SELECT GROUP_CONCAT(CONCAT(id,':',v) ORDER BY id) FROM t
--source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
SET use_secondary_engine=FORCED;
SELECT id,v FROM t ORDER BY id;
SET use_secondary_engine=OFF;
disconnect loader;
disconnect writer;
SET DEBUG_SYNC='RESET';
DROP DATABASE sh_manual_consistency;
