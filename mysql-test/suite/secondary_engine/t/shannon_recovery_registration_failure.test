# Failed publication after propagation attach must remove the consumer entry,
# share and partial IMCS image. Repeating the job must preserve the failure.
--let $shannon_storage_layer_case = baseline
--source suite/secondary_engine/include/shannon_storage_layer.inc
--let $storage_restart_debug = --debug=d,rapid_recovery_publish_failure,rapid_recovery_repeat_job
--let $storage_expected = 1:10,2:20,3:30
--let $shannon_storage_layer_case = manual_load
--source suite/secondary_engine/include/shannon_storage_layer.inc
--let $grep_file = $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $grep_pattern = RecoveryFramework: repeated recovery returned the same result
--let $wait_timeout = 60
--source include/wait_for_pattern_in_file.inc
