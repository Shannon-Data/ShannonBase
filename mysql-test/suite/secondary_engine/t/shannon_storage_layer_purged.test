--let $shannon_storage_layer_case = baseline
--source suite/secondary_engine/include/shannon_storage_layer.inc
# Loss of the required source history must choose InnoDB reload.
FLUSH BINARY LOGS;
--let $current_binlog = query_get_value(SHOW BINARY LOG STATUS, File, 1)
--disable_query_log
--eval PURGE BINARY LOGS TO '$current_binlog'
--enable_query_log
UPDATE t SET v=11 WHERE id=1;
# Recovery is expected to fall back to a primary reload: the native image is
# unavailable or unusable, so the rows come back through the SQL layer.
--let $storage_expected = 1:11,2:20,3:30
--let $shannon_storage_layer_case = verify
--source suite/secondary_engine/include/shannon_storage_layer.inc
