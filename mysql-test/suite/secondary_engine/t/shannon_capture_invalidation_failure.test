--source include/have_debug.inc
--source include/no_ps_protocol.inc
--disable_query_log
CALL mtr.add_suppression("Rapid COPY_INFO could not register COPY_INFO transaction participation");
CALL mtr.add_suppression("Rapid could not durably revoke fast recovery for table");
CALL mtr.add_suppression("Rapid could not persist source transaction outcome");
--enable_query_log
CREATE DATABASE sh_invalidation_failure;
USE sh_invalidation_failure;
CREATE TABLE t (id INT PRIMARY KEY, v INT) SECONDARY_ENGINE=rapid;
INSERT INTO t VALUES (1,10);
ALTER TABLE t SECONDARY_LOAD;
--disable_query_log
--let $datadir = `SELECT @@datadir`
--enable_query_log
--let $manifest = $datadir/rapid_snapshots/sh_invalidation_failure/t/checkpoints/checkpoint-1.manifest
--file_exists $manifest 60
# A restart must not fast-restore an image this instance could not certify, but
# the source transaction is not Rapid's to refuse: it commits in InnoDB either
# way. So when capture fails AND the capture journal cannot be revoked in place,
# the fast-recovery proof is revoked instead (the checkpoint generation is
# discarded), the table is quarantined, and the committed row survives in the
# primary for the restart to reload.
SET SESSION debug='+d,rapid_capture_wal_write_error,rapid_capture_wal_invalidation_error';
INSERT INTO t VALUES (2,20);
SET SESSION debug='-d,rapid_capture_wal_write_error,rapid_capture_wal_invalidation_error';
# The source committed the row.
SET use_secondary_engine=OFF;
SELECT id,v FROM t ORDER BY id;
# Rapid refuses to serve the quarantined image.
SET use_secondary_engine=FORCED;
--error ER_SECONDARY_ENGINE
SELECT id,v FROM t ORDER BY id;
SET use_secondary_engine=OFF;
# The marker is on disk outside the capture journal, so a restart cannot trust
# whatever certificate that journal still holds.
--let $taint = $datadir/rapid_snapshots/sh_invalidation_failure/t/reload_required
--file_exists $taint 60
# The restart takes the primary-reload lane, not the fast-restore lane: that is
# what proves the revocation was durable (a surviving certificate would have
# restored an image missing the committed row, with no error at all).
--let $restart_parameters = restart: --rapid_reload_on_restart=ON
--source include/kill_and_restart_mysqld.inc
USE sh_invalidation_failure;
--let $wait_condition = SELECT COUNT(*)=1 FROM performance_schema.rpd_table_id WHERE SCHEMA_NAME='sh_invalidation_failure' AND TABLE_NAME='t'
--source include/wait_condition.inc
--let $wait_condition = SELECT CAST(VARIABLE_VALUE AS UNSIGNED)>=1 FROM performance_schema.global_status WHERE VARIABLE_NAME='rapid_recovery_primary_reloads'
--source include/wait_condition.inc
SET use_secondary_engine=OFF;
SELECT id,v FROM t ORDER BY id;
--let $assert_digest = SELECT GROUP_CONCAT(CONCAT(id,':',v) ORDER BY id) FROM t
--source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
INSERT INTO t VALUES (3,30);
--let $assert_digest = SELECT GROUP_CONCAT(CONCAT(id,':',v) ORDER BY id) FROM t
--source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
SET use_secondary_engine=FORCED;
SELECT id,v FROM t ORDER BY id;
SET use_secondary_engine=OFF;

# ---------------------------------------------------------------------------
# The journal's own revocation machinery is broken as well
# (rapid_revoke_skip_epoch_reset), so neither revoking the journal nor dropping
# the epoch succeeds and the valid checkpoint survives on disk. The reload
# marker is then the only thing that can keep a restart from fast-restoring an
# image that predates the committed row.
# ---------------------------------------------------------------------------
CREATE TABLE t2 (id INT PRIMARY KEY, v INT) SECONDARY_ENGINE=rapid;
INSERT INTO t2 VALUES (1,10);
ALTER TABLE t2 SECONDARY_LOAD;
--disable_query_log
--let $manifest2 = $datadir/rapid_snapshots/sh_invalidation_failure/t2/checkpoints/checkpoint-1.manifest
--enable_query_log
--file_exists $manifest2 60
SET SESSION debug='+d,rapid_capture_wal_write_error,rapid_capture_wal_invalidation_error,rapid_revoke_skip_epoch_reset';
INSERT INTO t2 VALUES (2,20);
SET SESSION debug='-d,rapid_capture_wal_write_error,rapid_capture_wal_invalidation_error,rapid_revoke_skip_epoch_reset';
SET use_secondary_engine=OFF;
SELECT id,v FROM t2 ORDER BY id;
--let $taint2 = $datadir/rapid_snapshots/sh_invalidation_failure/t2/reload_required
--file_exists $taint2 60
--let $restart_parameters = restart: --rapid_reload_on_restart=ON
--source include/kill_and_restart_mysqld.inc
USE sh_invalidation_failure;
--let $wait_condition = SELECT COUNT(*)=1 FROM performance_schema.rpd_table_id WHERE SCHEMA_NAME='sh_invalidation_failure' AND TABLE_NAME='t2'
--source include/wait_condition.inc
--let $wait_condition = SELECT CAST(VARIABLE_VALUE AS UNSIGNED)>=1 FROM performance_schema.global_status WHERE VARIABLE_NAME='rapid_recovery_primary_reloads'
--source include/wait_condition.inc
# The surviving checkpoint predates (2,20). Had it been trusted, the row would
# be missing here and Rapid would still have matched nothing that noticed.
SET use_secondary_engine=OFF;
SELECT id,v FROM t2 ORDER BY id;
--let $assert_digest = SELECT GROUP_CONCAT(CONCAT(id,':',v) ORDER BY id) FROM t2
--source suite/secondary_engine/include/assert_rapid_matches_innodb.inc

# ---------------------------------------------------------------------------
# The marker's first location is unwritable as well, so the only thing left is
# the copy in the separate tree.
# ---------------------------------------------------------------------------
CREATE TABLE t3 (id INT PRIMARY KEY, v INT) SECONDARY_ENGINE=rapid;
INSERT INTO t3 VALUES (1,10);
ALTER TABLE t3 SECONDARY_LOAD;
--disable_query_log
--let $manifest3 = $datadir/rapid_snapshots/sh_invalidation_failure/t3/checkpoints/checkpoint-1.manifest
--enable_query_log
--file_exists $manifest3 60
SET SESSION debug='+d,rapid_capture_wal_write_error,rapid_capture_wal_invalidation_error,rapid_revoke_skip_epoch_reset,rapid_taint_marker_primary_error';
INSERT INTO t3 VALUES (2,20);
SET SESSION debug='-d,rapid_capture_wal_write_error,rapid_capture_wal_invalidation_error,rapid_revoke_skip_epoch_reset,rapid_taint_marker_primary_error';
SET use_secondary_engine=OFF;
SELECT id,v FROM t3 ORDER BY id;
--let $taint3 = $datadir/rapid_taint/sh_invalidation_failure/t3/reload_required
--file_exists $taint3 60
--let $restart_parameters = restart: --rapid_reload_on_restart=ON
--source include/kill_and_restart_mysqld.inc
USE sh_invalidation_failure;
--let $wait_condition = SELECT COUNT(*)=1 FROM performance_schema.rpd_table_id WHERE SCHEMA_NAME='sh_invalidation_failure' AND TABLE_NAME='t3'
--source include/wait_condition.inc
--let $wait_condition = SELECT CAST(VARIABLE_VALUE AS UNSIGNED)>=1 FROM performance_schema.global_status WHERE VARIABLE_NAME='rapid_recovery_primary_reloads'
--source include/wait_condition.inc
SET use_secondary_engine=OFF;
SELECT id,v FROM t3 ORDER BY id;
--let $assert_digest = SELECT GROUP_CONCAT(CONCAT(id,':',v) ORDER BY id) FROM t3
--source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
DROP DATABASE sh_invalidation_failure;
