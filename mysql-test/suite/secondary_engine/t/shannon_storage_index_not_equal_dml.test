##############################################################################
# ShannonBase: storage-index NOT_EQUAL pruning correctness after DML.
#
# The storage index skips an IMCU for a NOT_EQUAL predicate only when
# null_cnt == 0 and min == max == target. After INSERT / UPDATE / DELETE the
# zone map (min/max/null count) must stay accurate, otherwise NOT_EQUAL and the
# equality/range pruning that shares it would drop or keep the wrong rows. The
# DML is applied once, then the reads are taken under InnoDB (OFF) and Rapid
# (FORCED) and must agree.
# ShannonBase copyright 2023-
##############################################################################

--source include/no_ps_protocol.inc

create database sh_sine;
use sh_sine;
--disable_warnings
create table sin (id int primary key, k int null) secondary_engine=rapid;
--enable_warnings

insert into sin values (1,5),(2,5),(3,5),(4,null),(5,5),(6,9);
alter table sin secondary_load;

--echo # ===== baseline read: InnoDB =====
set session use_secondary_engine = off;
select count(*) as c from sin where k = 5;
select count(*) as c from sin where k <> 5;
select count(*) as c from sin where k < 6;

--echo # ===== baseline read: Rapid (legacy optimizer) =====
set session use_secondary_engine = forced;
--disable_warnings
set session optimizer_switch='hypergraph_optimizer=off';
--enable_warnings
select count(*) as c from sin where k = 5;
select count(*) as c from sin where k <> 5;
select count(*) as c from sin where k < 6;

--echo # ===== baseline read: Rapid (hypergraph optimizer) =====
--disable_warnings
set session optimizer_switch='hypergraph_optimizer=on';
--enable_warnings
select count(*) as c from sin where k = 5;
select count(*) as c from sin where k <> 5;
select count(*) as c from sin where k < 6;
set session optimizer_switch = default;

--echo # ===== apply DML once (primary engine): shrink max, add a 5, drop a 5 =====
set session use_secondary_engine = off;
update sin set k = 7 where id = 6;
insert into sin values (7,5);
delete from sin where id = 2;

--echo # ===== post-DML read: InnoDB =====
set session use_secondary_engine = off;
select count(*) as c from sin where k = 5;
select count(*) as c from sin where k <> 5;
select count(*) as c from sin where k < 6;
select count(*) as c from sin where k is null;

--echo # ===== post-DML read: Rapid (legacy optimizer) =====
set session use_secondary_engine = forced;
--disable_warnings
set session optimizer_switch='hypergraph_optimizer=off';
--enable_warnings
select count(*) as c from sin where k = 5;
select count(*) as c from sin where k <> 5;
select count(*) as c from sin where k < 6;
select count(*) as c from sin where k is null;

--echo # ===== post-DML read: Rapid (hypergraph optimizer) =====
--disable_warnings
set session optimizer_switch='hypergraph_optimizer=on';
--enable_warnings
select count(*) as c from sin where k = 5;
select count(*) as c from sin where k <> 5;
select count(*) as c from sin where k < 6;
select count(*) as c from sin where k is null;
set session optimizer_switch = default;

use test;
drop database sh_sine;
