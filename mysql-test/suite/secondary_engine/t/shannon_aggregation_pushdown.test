# Regression coverage for AggregationPushDown (storage/rapid_engine/optimizer/rules/
# condition_pushdown.cpp), which relocates a LocalAgg below its HashJoin child in place.
#
# The rewrite is only correctness-safe when ALL of these hold (see
# AggregationPushDown::try_push_below_join's doc comment):
#   1. The HashJoin is provably INNER.
#   2. GROUP BY and every aggregate argument resolve exclusively to one side (push_side).
#   3. The other side (keep_side) is proven to contribute at most one row per join-key value
#      (HashJoin::child_multiplicity == kAtMostOne), which today only holds when a UNIQUE NOT
#      NULL index on keep_side's table is fully bound by the equi-join condition.
#   4. push_side is a bare scan (or Filter directly over one).
#   5. Every join-key column the equi-join reads from push_side's table is already a GROUP BY
#      column.
#   No ROLLUP, no dependent hash output order.
#
# Getting any of these wrong is a correctness bug (wrong aggregated values), not just a missed
# optimization, so this test pairs one query that should push (P1/P2) with one negative query per
# gate (N1..N5) that must NOT push, and each negative case is built so that incorrectly allowing
# the push would visibly change the aggregated numbers (fan-out via a real duplicate join key,
# a dropped/duplicated group, a dangling join key, or a lost ROLLUP super-aggregate row) -- not
# just "doesn't crash".
#
# NOTE on EXPLAIN: EXPLAIN FORMAT=TREE for a secondary-engine-forced query prints the AccessPath
# MySQL chose *before* handing off to Rapid; Rapid's internal Plan-tree rewrites (including
# AggregationPushDown) happen afterward and are not reflected in it -- hence the standard
# "the actual query plan may diverge from the printed one" note. EXPLAIN is kept here only to pin
# the join algorithm MySQL selects (so a regression in access-path selection is also caught); the
# actual AggregationPushDown correctness protection comes from the recorded SELECT results.
#
# Run the same battery under three scenarios:
#   1. InnoDB                                   -- ground truth.
#   2. Rapid, legacy optimizer (hypergraph_optimizer=off), HASH_JOIN hint forced so the join
#      algorithm matches scenario 3 (without the hint, the legacy optimizer prefers an indexed
#      nested-loop join for these PK-equality joins, and AggregationPushDown never even
#      considers a NestLoopJoin -- see try_push_below_join).
#   3. Rapid, hypergraph optimizer (hypergraph_optimizer=on).

--disable_query_log
CALL mtr.add_suppression("ML operation failed. cannot find ONNX model for: multilingual-e5-small");
--enable_query_log

# EXPLAIN FORMAT=TREE cost figures for Rapid plans are not portable across
# machines or data distributions -- elide them and keep checking the row
# estimates and plan shape, which are deterministic.
--source include/elide_costs.inc

CREATE DATABASE rapid_agg_pushdown_test;
USE rapid_agg_pushdown_test;

# customers: PRIMARY KEY(id) is a UNIQUE NOT NULL index -- joining on customers.id lets
# child_multiplicity prove "at most one" for this side.
# The ONNX model notice fires on CREATE TABLE only in build trees without
# extra/llm-models installed; silence it so this .result is valid in both a
# build tree and an installed tree.
--disable_warnings
CREATE TABLE customers (
  id     INT PRIMARY KEY,
  region INT NOT NULL
) SECONDARY_ENGINE=rapid;

# Same id domain as customers, but id is declared with only a non-unique KEY (row_no is an
# unrelated surrogate PRIMARY KEY, required for Rapid loading, that the join never uses) --
# and, unlike customers, id genuinely repeats (two rows per id). child_multiplicity must stay
# kUnknown here: if it were wrongly proven kAtMostOne, pre-grouping the push side (orders) before
# this join would silently drop the real x2 fan-out this join produces.
CREATE TABLE customers_nonunique (
  row_no INT PRIMARY KEY,
  id     INT NOT NULL,
  region INT NOT NULL,
  KEY (id)
) SECONDARY_ENGINE=rapid;

# orders: the push side. region_code is unrelated to the join key (customer_id), used to test
# the "join key must be a GROUP BY column" precondition. A handful of rows carry a dangling
# customer_id (999, matching no customer) purely to give that precondition teeth: a correct
# (unpushed) execution filters them out of the INNER JOIN row-by-row, while a buggy push that
# pre-groups by region_code before joining would keep or drop each *entire* region_code group
# based on one arbitrary representative row's customer_id.
CREATE TABLE orders (
  id           INT PRIMARY KEY,
  customer_id  INT NOT NULL,
  region_code  INT NOT NULL,
  amount       INT NOT NULL
) SECONDARY_ENGINE=rapid;
--enable_warnings

--disable_query_log
let $i = 1;
while ($i <= 20) {
  --eval INSERT INTO customers VALUES ($i, MOD($i, 4))
  --eval INSERT INTO customers_nonunique VALUES ($i, $i, MOD($i, 4))
  --eval INSERT INTO customers_nonunique VALUES (20 + $i, $i, MOD($i, 4))
  inc $i;
}
# customers.id = 21 has no matching orders -- exercises LEFT JOIN unmatched-row handling in N1.
INSERT INTO customers VALUES (21, 9);

let $i = 1;
while ($i <= 200) {
  let $c = `SELECT 1 + MOD($i, 20)`;
  --eval INSERT INTO orders VALUES ($i, $c, MOD($i, 3), $i * 3)
  inc $i;
}
# Dangling customer_id, all in region_code 0 -- never match customers.id, so a correct join
# excludes them from every group; see the orders table comment above.
let $i = 1;
while ($i <= 6) {
  --eval INSERT INTO orders VALUES (200 + $i, 999, 0, 100)
  inc $i;
}
--enable_query_log

--echo # ============================================================
--echo #  Scenario 1: InnoDB (ground truth)
--echo # ============================================================
SET SESSION optimizer_switch='hypergraph_optimizer=off';
SET USE_SECONDARY_ENGINE=OFF;

--echo # P1: push-eligible shape -- INNER join, GROUP BY/agg on push side (orders),
--echo #     keep side (customers) has a UNIQUE NOT NULL join key.
SELECT o.customer_id, COUNT(*) AS cnt, SUM(o.amount) AS total
FROM orders o JOIN customers c ON o.customer_id = c.id
GROUP BY o.customer_id ORDER BY o.customer_id;

--echo # P2: same as P1 with the join operands swapped (push_side becomes the join's other child).
SELECT o.customer_id, COUNT(*) AS cnt, SUM(o.amount) AS total
FROM customers c JOIN orders o ON c.id = o.customer_id
GROUP BY o.customer_id ORDER BY o.customer_id;

--echo # N1: LEFT JOIN -- not provably INNER, must not push. customers.id=21 has no matching
--echo #     orders and must still surface as its own (NULL-keyed) group with cnt=1 (the
--echo #     NULL-extended row), not cnt=NULL (which a wrongly-pushed pre-grouping would give,
--echo #     since that group simply would not exist on the push side).
SELECT o.customer_id, COUNT(*) AS cnt, SUM(o.amount) AS total
FROM customers c LEFT JOIN orders o ON o.customer_id = c.id
GROUP BY o.customer_id ORDER BY o.customer_id;

--echo # N2: keep side (customers_nonunique) genuinely has 2 rows per id and no UNIQUE NOT NULL
--echo #     join key -- child_multiplicity cannot be proven kAtMostOne. cnt/total must come out
--echo #     2x P1's (real fan-out), not equal to P1's (which a wrongly-pushed pre-grouped-then
--echo #     -joined-without-re-aggregating execution would give).
SELECT o.customer_id, COUNT(*) AS cnt, SUM(o.amount) AS total
FROM orders o JOIN customers_nonunique c ON o.customer_id = c.id
GROUP BY o.customer_id ORDER BY o.customer_id;

--echo # N3: GROUP BY and aggregate argument come from opposite sides -- not exclusive to one side.
SELECT o.customer_id, SUM(c.region) AS total_region
FROM orders o JOIN customers c ON o.customer_id = c.id
GROUP BY o.customer_id ORDER BY o.customer_id;

--echo # N4: GROUP BY (region_code) does not cover the join key (customer_id) read from the push
--echo #     side. region_code=0 must exclude the 6 dangling-customer_id orders rows (cnt=66,
--echo #     not 72), which only a real per-row join evaluation guarantees.
SELECT o.region_code, COUNT(*) AS cnt, SUM(o.amount) AS total
FROM orders o JOIN customers c ON o.customer_id = c.id
GROUP BY o.region_code ORDER BY o.region_code;

--echo # N5: ROLLUP adds a super-aggregate (customer_id=NULL) row -- not provably safe to
--echo #     relocate below the join, since that row's join key is NULL and an INNER join would
--echo #     silently drop it (NULL never equi-matches).
SELECT o.customer_id, SUM(o.amount) AS total
FROM orders o JOIN customers c ON o.customer_id = c.id
GROUP BY o.customer_id WITH ROLLUP;

ALTER TABLE customers SECONDARY_LOAD;
ALTER TABLE customers_nonunique SECONDARY_LOAD;
ALTER TABLE orders SECONDARY_LOAD;
SET USE_SECONDARY_ENGINE=FORCED;
SET secondary_engine_cost_threshold=0;

--echo # ============================================================
--echo #  Scenario 2: Rapid, legacy optimizer (hypergraph_optimizer=off)
--echo # ============================================================
SET SESSION optimizer_switch='hypergraph_optimizer=off';

--echo # P1 (legacy, HASH_JOIN hint)
--replace_regex $elide_costs
EXPLAIN FORMAT=TREE SELECT /*+ HASH_JOIN(o, c) NO_JOIN_INDEX(c PRIMARY) */ o.customer_id, COUNT(*) AS cnt, SUM(o.amount) AS total
FROM orders o JOIN customers c ON o.customer_id = c.id
GROUP BY o.customer_id;
SELECT /*+ HASH_JOIN(o, c) NO_JOIN_INDEX(c PRIMARY) */ o.customer_id, COUNT(*) AS cnt, SUM(o.amount) AS total
FROM orders o JOIN customers c ON o.customer_id = c.id
GROUP BY o.customer_id ORDER BY o.customer_id;

--echo # P2 (legacy, HASH_JOIN hint): join operands swapped.
--replace_regex $elide_costs
EXPLAIN FORMAT=TREE SELECT /*+ HASH_JOIN(c, o) NO_JOIN_INDEX(c PRIMARY) */ o.customer_id, COUNT(*) AS cnt, SUM(o.amount) AS total
FROM customers c JOIN orders o ON c.id = o.customer_id
GROUP BY o.customer_id;
SELECT /*+ HASH_JOIN(c, o) NO_JOIN_INDEX(c PRIMARY) */ o.customer_id, COUNT(*) AS cnt, SUM(o.amount) AS total
FROM customers c JOIN orders o ON c.id = o.customer_id
GROUP BY o.customer_id ORDER BY o.customer_id;

--echo # N1 (legacy): LEFT JOIN -- must not push.
--replace_regex $elide_costs
EXPLAIN FORMAT=TREE SELECT o.customer_id, COUNT(*) AS cnt, SUM(o.amount) AS total
FROM customers c LEFT JOIN orders o ON o.customer_id = c.id
GROUP BY o.customer_id;
SELECT o.customer_id, COUNT(*) AS cnt, SUM(o.amount) AS total
FROM customers c LEFT JOIN orders o ON o.customer_id = c.id
GROUP BY o.customer_id ORDER BY o.customer_id;

--echo # N2 (legacy, HASH_JOIN hint): keep side not proven unique -- must not push.
--replace_regex $elide_costs
EXPLAIN FORMAT=TREE SELECT /*+ HASH_JOIN(o, c) NO_JOIN_INDEX(c id) */ o.customer_id, COUNT(*) AS cnt, SUM(o.amount) AS total
FROM orders o JOIN customers_nonunique c ON o.customer_id = c.id
GROUP BY o.customer_id;
SELECT /*+ HASH_JOIN(o, c) NO_JOIN_INDEX(c id) */ o.customer_id, COUNT(*) AS cnt, SUM(o.amount) AS total
FROM orders o JOIN customers_nonunique c ON o.customer_id = c.id
GROUP BY o.customer_id ORDER BY o.customer_id;

--echo # N3 (legacy, HASH_JOIN hint): GROUP BY/aggregate columns from opposite sides -- must not push.
--replace_regex $elide_costs
EXPLAIN FORMAT=TREE SELECT /*+ HASH_JOIN(o, c) NO_JOIN_INDEX(c PRIMARY) */ o.customer_id, SUM(c.region) AS total_region
FROM orders o JOIN customers c ON o.customer_id = c.id
GROUP BY o.customer_id;
SELECT /*+ HASH_JOIN(o, c) NO_JOIN_INDEX(c PRIMARY) */ o.customer_id, SUM(c.region) AS total_region
FROM orders o JOIN customers c ON o.customer_id = c.id
GROUP BY o.customer_id ORDER BY o.customer_id;

--echo # N4 (legacy, HASH_JOIN hint): GROUP BY does not cover the join key -- must not push.
--replace_regex $elide_costs
EXPLAIN FORMAT=TREE SELECT /*+ HASH_JOIN(o, c) NO_JOIN_INDEX(c PRIMARY) */ o.region_code, COUNT(*) AS cnt, SUM(o.amount) AS total
FROM orders o JOIN customers c ON o.customer_id = c.id
GROUP BY o.region_code;
SELECT /*+ HASH_JOIN(o, c) NO_JOIN_INDEX(c PRIMARY) */ o.region_code, COUNT(*) AS cnt, SUM(o.amount) AS total
FROM orders o JOIN customers c ON o.customer_id = c.id
GROUP BY o.region_code ORDER BY o.region_code;

--echo # N5 (legacy, HASH_JOIN hint): ROLLUP -- must not push.
--replace_regex $elide_costs
EXPLAIN FORMAT=TREE SELECT /*+ HASH_JOIN(o, c) NO_JOIN_INDEX(c PRIMARY) */ o.customer_id, SUM(o.amount) AS total
FROM orders o JOIN customers c ON o.customer_id = c.id
GROUP BY o.customer_id WITH ROLLUP;
SELECT /*+ HASH_JOIN(o, c) NO_JOIN_INDEX(c PRIMARY) */ o.customer_id, SUM(o.amount) AS total
FROM orders o JOIN customers c ON o.customer_id = c.id
GROUP BY o.customer_id WITH ROLLUP;

--echo # ============================================================
--echo #  Scenario 3: Rapid, hypergraph optimizer (hypergraph_optimizer=on)
--echo # ============================================================
SET SESSION optimizer_switch='hypergraph_optimizer=on';

--echo # P1 (hypergraph)
--replace_regex $elide_costs
EXPLAIN FORMAT=TREE SELECT o.customer_id, COUNT(*) AS cnt, SUM(o.amount) AS total
FROM orders o JOIN customers c ON o.customer_id = c.id
GROUP BY o.customer_id;
SELECT o.customer_id, COUNT(*) AS cnt, SUM(o.amount) AS total
FROM orders o JOIN customers c ON o.customer_id = c.id
GROUP BY o.customer_id ORDER BY o.customer_id;

--echo # P2 (hypergraph): join operands swapped.
--replace_regex $elide_costs
EXPLAIN FORMAT=TREE SELECT o.customer_id, COUNT(*) AS cnt, SUM(o.amount) AS total
FROM customers c JOIN orders o ON c.id = o.customer_id
GROUP BY o.customer_id;
SELECT o.customer_id, COUNT(*) AS cnt, SUM(o.amount) AS total
FROM customers c JOIN orders o ON c.id = o.customer_id
GROUP BY o.customer_id ORDER BY o.customer_id;

--echo # N1 (hypergraph): LEFT JOIN -- must not push.
--replace_regex $elide_costs
EXPLAIN FORMAT=TREE SELECT o.customer_id, COUNT(*) AS cnt, SUM(o.amount) AS total
FROM customers c LEFT JOIN orders o ON o.customer_id = c.id
GROUP BY o.customer_id;
SELECT o.customer_id, COUNT(*) AS cnt, SUM(o.amount) AS total
FROM customers c LEFT JOIN orders o ON o.customer_id = c.id
GROUP BY o.customer_id ORDER BY o.customer_id;

--echo # N2 (hypergraph): keep side not proven unique -- must not push.
--replace_regex $elide_costs
EXPLAIN FORMAT=TREE SELECT o.customer_id, COUNT(*) AS cnt, SUM(o.amount) AS total
FROM orders o JOIN customers_nonunique c ON o.customer_id = c.id
GROUP BY o.customer_id;
SELECT o.customer_id, COUNT(*) AS cnt, SUM(o.amount) AS total
FROM orders o JOIN customers_nonunique c ON o.customer_id = c.id
GROUP BY o.customer_id ORDER BY o.customer_id;

--echo # N3 (hypergraph): GROUP BY/aggregate columns from opposite sides -- must not push.
--replace_regex $elide_costs
EXPLAIN FORMAT=TREE SELECT o.customer_id, SUM(c.region) AS total_region
FROM orders o JOIN customers c ON o.customer_id = c.id
GROUP BY o.customer_id;
SELECT o.customer_id, SUM(c.region) AS total_region
FROM orders o JOIN customers c ON o.customer_id = c.id
GROUP BY o.customer_id ORDER BY o.customer_id;

--echo # N4 (hypergraph): GROUP BY does not cover the join key -- must not push.
--replace_regex $elide_costs
EXPLAIN FORMAT=TREE SELECT o.region_code, COUNT(*) AS cnt, SUM(o.amount) AS total
FROM orders o JOIN customers c ON o.customer_id = c.id
GROUP BY o.region_code;
SELECT o.region_code, COUNT(*) AS cnt, SUM(o.amount) AS total
FROM orders o JOIN customers c ON o.customer_id = c.id
GROUP BY o.region_code ORDER BY o.region_code;

--echo # N5 (hypergraph): ROLLUP -- must not push.
--replace_regex $elide_costs
EXPLAIN FORMAT=TREE SELECT o.customer_id, SUM(o.amount) AS total
FROM orders o JOIN customers c ON o.customer_id = c.id
GROUP BY o.customer_id WITH ROLLUP;
SELECT o.customer_id, SUM(o.amount) AS total
FROM orders o JOIN customers c ON o.customer_id = c.id
GROUP BY o.customer_id WITH ROLLUP;

SET SESSION optimizer_switch='hypergraph_optimizer=off';
SET USE_SECONDARY_ENGINE=OFF;

DROP TABLE orders;
DROP TABLE customers_nonunique;
DROP TABLE customers;
DROP DATABASE rapid_agg_pushdown_test;
