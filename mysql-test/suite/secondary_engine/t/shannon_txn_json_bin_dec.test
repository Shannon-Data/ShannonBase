##############################################################################
# ShannonBase: JSON, BINARY and DECIMAL transaction visibility + SAVEPOINT edge cases
#
# Scenarios covered:
#  - BEGIN; DML on JSON/BINARY/DECIMAL; concurrent connection should not see uncommitted
#  - SAVEPOINT then ROLLBACK TO SAVEPOINT restores previous values
#  - COMMIT path makes changes visible
#  - Attempt ROLLBACK TO SAVEPOINT after COMMIT (edge case / propagation-related)
##############################################################################

DROP DATABASE IF EXISTS sh_jbd;
CREATE DATABASE sh_jbd;
USE sh_jbd;

# The ROLLBACK TO SAVEPOINT cases below deliberately trip Rapid's quarantine,
# which logs a warning. That warning is the behaviour under test, not a failure.
CALL mtr.add_suppression("Rapid immediate COPY_INFO quarantined");
--disable_warnings

CREATE TABLE t_jbd (
  id INT PRIMARY KEY,
  bin VARBINARY(16),
  j JSON,
  d DECIMAL(18,6),
  name VARCHAR(64)
) SECONDARY_ENGINE=RAPID;

INSERT INTO t_jbd VALUES
(1, UNHEX('00112233445566778899AABBCCDDEEFF'), JSON_OBJECT('k', 1), 123456.123456, 'orig1'),
(2, UNHEX('FFEEDDCCBBAA99887766554433221100'), JSON_OBJECT('k', 2), 0.000001, 'orig2');

ALTER TABLE t_jbd SECONDARY_LOAD;

--connect(con1,localhost,root,,sh_jbd)
--connect(con2,localhost,root,,sh_jbd)

--connection con1
SET SESSION USE_SECONDARY_ENGINE=OFF;
BEGIN;
# update all three types in a transaction
UPDATE t_jbd SET bin = UNHEX('AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'), j = JSON_OBJECT('z', 9999), d = 99999.999999, name = 'tx1' WHERE id = 1;
# visible to self
SELECT id, HEX(bin), JSON_EXTRACT(j, '$.z'), d, name FROM t_jbd WHERE id = 1;

--connection con2
SET SESSION USE_SECONDARY_ENGINE=FORCED;
# should NOT see uncommitted tx
SELECT id, HEX(bin), JSON_EXTRACT(j, '$.z'), d, name FROM t_jbd WHERE id = 1;

--connection con1
# test SAVEPOINT semantics
SAVEPOINT sp_j1;
UPDATE t_jbd SET d = d + 0.000001 WHERE id = 1;
SELECT d FROM t_jbd WHERE id = 1;
ROLLBACK TO SAVEPOINT sp_j1;
SELECT d FROM t_jbd WHERE id = 1;

# fully rollback transaction and check other session still sees original
ROLLBACK;

--connection con2
SET SESSION USE_SECONDARY_ENGINE=FORCED;
# The ROLLBACK TO SAVEPOINT above undid DML that Rapid had already propagated.
# Rapid supports transaction-level COMMIT/ROLLBACK but not partial savepoint
# undo, so it quarantines the table until it is reloaded.
--error ER_SECONDARY_ENGINE
SELECT id, HEX(bin), JSON_EXTRACT(j, '$.z'), d, name FROM t_jbd WHERE id = 1;

--connection default
ALTER TABLE t_jbd SECONDARY_UNLOAD;
ALTER TABLE t_jbd SECONDARY_LOAD;

--connection con2
SELECT id, HEX(bin), JSON_EXTRACT(j, '$.z'), d, name FROM t_jbd WHERE id = 1;

# now test commit path and visibility
--connection con1
SET SESSION USE_SECONDARY_ENGINE=OFF;
BEGIN;
UPDATE t_jbd SET bin = UNHEX('DEADBEEFDEADBEEFDEADBEEFDEADBEEF'), j = JSON_OBJECT('z', 42), d = 42.424242, name = 'committed' WHERE id = 2;
COMMIT;

--connection con2
SET SESSION USE_SECONDARY_ENGINE=FORCED;
SELECT id, HEX(bin), JSON_EXTRACT(j, '$.z'), d, name FROM t_jbd WHERE id = 2;

# Edge case: SAVEPOINT + COMMIT then ROLLBACK TO SAVEPOINT (invalid after commit)
# This demonstrates the SAVEPOINT lifecycle / propagation edge case; behavior may vary by engine.
--connection con1
SET SESSION USE_SECONDARY_ENGINE=OFF;
BEGIN;
UPDATE t_jbd SET name = 'tmp' WHERE id = 1;
SAVEPOINT sp_after;
COMMIT;
# Attempting to rollback to a savepoint after commit should fail; include as an assertion point
# ROLLBACK TO SAVEPOINT sp_after;

# Cleanup
--connection default
DROP TABLE t_jbd;
DROP DATABASE sh_jbd;

--enable_warnings
