--source include/have_debug.inc
--source include/no_ps_protocol.inc
--disable_warnings
SET use_secondary_engine=OFF;
CREATE TABLE distinct_spill(id INT PRIMARY KEY,k INT,g INT) SECONDARY_ENGINE=rapid;
INSERT INTO distinct_spill WITH RECURSIVE seq(i) AS
 (SELECT 0 UNION ALL SELECT i+1 FROM seq WHERE i<999)
 SELECT a.i*100+b.i,IF(MOD(a.i+b.i,17)=0,NULL,MOD(a.i+b.i,37)),MOD(a.i,3)
 FROM seq a JOIN seq b ON b.i<100;
ALTER TABLE distinct_spill SECONDARY_LOAD;
SET optimizer_switch='hypergraph_optimizer=on';
SET use_secondary_engine=FORCED;
SET debug='+d,rapid_sort_tiny_budget';
--echo # Duplicates cross input batches and multiple bounded spill/merge runs.
--let $rapid_stats_action = begin
--source suite/secondary_engine/include/rapid_stats_check.inc
SELECT COUNT(*) FROM distinct_spill c LEFT JOIN (SELECT DISTINCT k FROM distinct_spill) d ON c.id=d.k WHERE d.k IS NULL;
--let $rapid_stats_field = sort_spill
--let $rapid_stats_action = end
--source suite/secondary_engine/include/rapid_stats_check.inc
--let $assert_query = SELECT DISTINCT g,k FROM distinct_spill ORDER BY g,k
--let $assert_ordered = 1
--source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
--let $assert_query = SELECT DISTINCT k FROM distinct_spill ORDER BY k DESC LIMIT 4,9
--let $assert_ordered = 1
--source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
--echo # Count materialized rows: duplicate build keys cannot hide behind an anti join.
--let $assert_digest = SELECT COUNT(*),SUM(k),SUM(k IS NULL) FROM (SELECT DISTINCT k FROM distinct_spill) d
--source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
--let $assert_digest = SELECT COUNT(*) FROM (SELECT DISTINCT g,k FROM distinct_spill) d
--source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
--let $assert_digest = SELECT COUNT(*),SUM(k),SUM(k IS NULL) FROM (SELECT DISTINCT k FROM distinct_spill ORDER BY k LIMIT 4) d
--source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
--let $assert_digest = SELECT COUNT(*),SUM(k) FROM (SELECT DISTINCT k FROM distinct_spill ORDER BY k DESC LIMIT 4,9) d
--source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
SET debug='+d,rapid_sort_compare_distinct';
--let $assert_query = SELECT DISTINCT g,k FROM distinct_spill ORDER BY g,k
--let $assert_ordered = 1
--source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
SET debug='-d,rapid_sort_compare_distinct,rapid_sort_tiny_budget';
--echo # Failed spill releases its files and reservations; a later DISTINCT succeeds.
SET debug='+d,rapid_sort_tiny_budget,rapid_sort_spill_write_error';
--error ER_SECONDARY_ENGINE_PLUGIN
SELECT COUNT(*) FROM distinct_spill c LEFT JOIN (SELECT DISTINCT k FROM distinct_spill) d ON c.id=d.k WHERE d.k IS NULL;
SET debug='-d,rapid_sort_tiny_budget,rapid_sort_spill_write_error';
--let $assert_query = SELECT DISTINCT k FROM distinct_spill ORDER BY k LIMIT 8
--let $assert_ordered = 1
--source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
SET use_secondary_engine=OFF;
DROP TABLE distinct_spill;
--enable_warnings
