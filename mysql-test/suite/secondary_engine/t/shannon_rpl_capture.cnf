!include suite/rpl/rpl_1slave_base.cnf
[mysqld]
binlog-format=ROW
binlog-row-image=FULL
binlog-row-metadata=FULL
sync-binlog=1
innodb-flush-log-at-trx-commit=1
loose-rapid_schema_embedding=OFF
rapid-use-dynamic-offload=OFF
rapid-resource-isolation=AUTO
[mysqld.2]
log-replica-updates=ON
replica-parallel-workers=4
replica-preserve-commit-order=ON
