--source include/have_debug.inc
--disable_query_log
SET use_secondary_engine=OFF;
SET @saved_gc_batch=@@GLOBAL.rapid_purge_batch_size;
SET @saved_gc_min=@@GLOBAL.rapid_min_versions_for_purge;
SET @saved_gc_ratio=@@GLOBAL.rapid_purge_efficiency_threshold;
SET GLOBAL rapid_max_purger_timeout=1;
SET GLOBAL rapid_gc_interval_scn=1;
CREATE TABLE review_gc(id INT PRIMARY KEY,v INT) SECONDARY_ENGINE=rapid;
INSERT INTO review_gc VALUES(1,10);
ALTER TABLE review_gc SECONDARY_LOAD;
--connect (old,localhost,root,,test)
SET use_secondary_engine=OFF;
# Build the RR view through InnoDB alone, without the Rapid snapshot callback.
START TRANSACTION;
SELECT v INTO @old_value FROM review_gc;
--connection default
--let $i= 40
while ($i) {
  # Exercise configuration publication while maintenance and apply are active.
  --eval SET GLOBAL rapid_purge_batch_size=16 + MOD($i, 2)
  --eval SET GLOBAL rapid_min_versions_for_purge=1 + MOD($i, 2)
  --eval SET GLOBAL rapid_purge_efficiency_threshold=0.1 + MOD($i, 2) * 0.1
  UPDATE review_gc SET v=v+1;
  --dec $i
}
SET use_secondary_engine=FORCED;
SELECT v INTO @new_value FROM review_gc;
SET use_secondary_engine=OFF;
# A zero safe horizon no longer schedules no-op GC tasks. The counters that used
# to witness "nothing was purged" are debug-only now, so the protection is
# asserted where it matters: the old ReadView below still reads its version.
# Require several bounded passes after the old reader releases its view.
# No subsequent DML advances the safe SCN.
SET GLOBAL rapid_purge_batch_size=2;
--connection old
SET use_secondary_engine=FORCED;
--enable_query_log
SELECT v FROM review_gc;
--let $assert_query = SELECT v FROM review_gc
--source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
--disable_query_log
COMMIT;
SET use_secondary_engine=OFF;
--connection default
# The purge runs on the background worker, and RAPID_STATS only samples at
# statement end, so a pure wait could never observe it. Let the worker finish its
# bounded passes instead; the data assertions below are what prove the outcome.
--sleep 5
SET use_secondary_engine=FORCED;
--enable_query_log
SELECT v FROM review_gc;
--let $assert_query = SELECT v FROM review_gc
--source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
--disable_query_log
SET use_secondary_engine=OFF;
ALTER TABLE review_gc SECONDARY_UNLOAD;
DROP TABLE review_gc;
SET GLOBAL rapid_purge_batch_size=@saved_gc_batch;
SET GLOBAL rapid_min_versions_for_purge=@saved_gc_min;
SET GLOBAL rapid_purge_efficiency_threshold=@saved_gc_ratio;
SET GLOBAL rapid_max_purger_timeout=DEFAULT;
SET GLOBAL rapid_gc_interval_scn=DEFAULT;
--disconnect old
--enable_query_log
