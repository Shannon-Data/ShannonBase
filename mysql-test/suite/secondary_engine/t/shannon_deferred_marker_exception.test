--source include/have_debug.inc
--source include/no_ps_protocol.inc
# Quarantine can reject a row already being applied when the injected failure occurs.
--disable_query_log
CALL mtr.add_suppression('Rapid propagation (retry [1-3]/3 for|quarantined) table .*sh_deferred_exception.t to imcs failed');
CALL mtr.add_suppression('Rapid propagation (retry [1-3]/3 for|quarantined) table .*Rapid could not apply an indexed row update');
--enable_query_log
CALL mtr.add_suppression('Rapid deferred COMMIT marker failed; restart requires primary reload');
CALL mtr.add_suppression('Rapid deferred COMMIT enqueue failed; restart requires primary reload');
CALL mtr.add_suppression('Rapid transaction callback failed; affected loaded tables require reload');
CREATE DATABASE sh_deferred_exception;
USE sh_deferred_exception;
CREATE TABLE t(id INT PRIMARY KEY, v INT) SECONDARY_ENGINE=rapid;
INSERT INTO t VALUES (1,10);
ALTER TABLE t SECONDARY_LOAD;
SET GLOBAL rapid_lazy_commit_marker=ON;
# Capture the fault in the enqueueing THD; the worker returns failure.
SET debug='+d,rapid_deferred_marker_bad_alloc';
INSERT INTO t VALUES (2,20);
SET debug='-d,rapid_deferred_marker_bad_alloc';
SET use_secondary_engine=FORCED;
--error ER_SECONDARY_ENGINE
SELECT COUNT(*) FROM t;
SET use_secondary_engine=OFF;
SELECT * FROM t ORDER BY id;
ALTER TABLE t SECONDARY_UNLOAD;
ALTER TABLE t SECONDARY_LOAD;
--let $assert_digest = SELECT GROUP_CONCAT(CONCAT(id,':',v) ORDER BY id) FROM t
--source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
SET debug='+d,rapid_deferred_enqueue_bad_alloc';
UPDATE t SET v=30 WHERE id=1;
SET debug='-d,rapid_deferred_enqueue_bad_alloc';
SET use_secondary_engine=FORCED;
--error ER_SECONDARY_ENGINE
SELECT COUNT(*) FROM t;
SET use_secondary_engine=OFF;
SELECT * FROM t ORDER BY id;
SET GLOBAL rapid_lazy_commit_marker=OFF;
ALTER TABLE t SECONDARY_UNLOAD;
ALTER TABLE t SECONDARY_LOAD;
--let $assert_digest = SELECT GROUP_CONCAT(CONCAT(id,':',v) ORDER BY id) FROM t
--source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
DROP DATABASE sh_deferred_exception;
