##############################################################################
# ShannonBase: partitioned table falls back to a native (non-vectorized) scan.
#
# query_plan.cpp forces path->vectorized=false for partitioned tables, so the
# scan must go through MySQL's TableScanIterator rather than
# VectorizedTableScanIterator. This test loads a partitioned SECONDARY_ENGINE
# table and checks the answers match InnoDB under both optimizers -- a wrongly
# vectorized (or wrongly pruned) partition scan would diverge.
# ShannonBase copyright 2023-
##############################################################################

--source include/no_ps_protocol.inc

create database sh_pt;
use sh_pt;
--disable_warnings
create table t_part (id int primary key, v int not null) secondary_engine=rapid partition by range (id) (partition p0 values less than (10), partition p1 values less than (20), partition p2 values less than maxvalue);
--enable_warnings

insert into t_part values (1,100),(5,200),(9,300),(10,400),(12,500),(15,600),(20,700),(25,800);
alter table t_part secondary_load;

--echo # ===== InnoDB baseline =====
set session use_secondary_engine = off;
select count(*) as c from t_part;
select id, v from t_part where v >= 500 order by id;

--echo # ===== Rapid =====
set session use_secondary_engine = forced;
select count(*) as c from t_part;
select id, v from t_part where v >= 500 order by id;

use test;
drop database sh_pt;
