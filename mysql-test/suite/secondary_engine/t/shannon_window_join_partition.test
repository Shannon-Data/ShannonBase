##############################################################################
# ShannonBase: window function over a join whose probe side is partitioned.
#
# The join output feeds a running-sum window. The left (probe) table is
# partitioned, so its scan is native, but the join and the window still
# offload to the secondary engine. This checks the running sum over the join
# output matches InnoDB -- a join that drops/misorders rows, or a window that
# misreads the join's batch transport, would diverge.
# ShannonBase copyright 2023-
##############################################################################

--source include/no_ps_protocol.inc

create database sh_wjp;
use sh_wjp;
--disable_warnings
create table wjp_left (id int primary key, k int not null, v int not null) secondary_engine=rapid partition by range (id) (partition p0 values less than (5), partition p1 values less than (10), partition p2 values less than maxvalue);
create table wjp_right (id int primary key, k int not null, w int not null) secondary_engine=rapid;
--enable_warnings

insert into wjp_left values (1,10,100),(2,20,200),(3,20,300),(4,30,400),(6,10,500);
insert into wjp_right values (1,10,1000),(2,20,2000),(4,30,4000),(6,10,6000);

alter table wjp_left secondary_load;
alter table wjp_right secondary_load;

--disable_warnings
set session optimizer_switch='hypergraph_optimizer=on';
--enable_warnings

--echo # ===== InnoDB baseline =====
set session use_secondary_engine = off;
select l.id, l.k, r.w, sum(r.w) over (partition by l.k order by l.id) as running from wjp_left l join wjp_right r on l.id = r.id order by l.id;
select count(*) as n from wjp_left l join wjp_right r on l.id = r.id;

--echo # ===== Rapid =====
set session use_secondary_engine = forced;
select l.id, l.k, r.w, sum(r.w) over (partition by l.k order by l.id) as running from wjp_left l join wjp_right r on l.id = r.id order by l.id;
select count(*) as n from wjp_left l join wjp_right r on l.id = r.id;

use test;
drop database sh_wjp;
