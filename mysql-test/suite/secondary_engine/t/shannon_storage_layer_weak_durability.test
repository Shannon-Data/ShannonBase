--disable_query_log
CALL mtr.add_suppression("CheckpointScheduler: on-demand checkpoint failed sh_storage_recovery.t");
--enable_query_log
--source suite/secondary_engine/include/storage_layer_baseline.inc
# Do not persist source rows whose configured durability permits losing them.
SET GLOBAL sync_binlog=0;
UPDATE t SET v=11 WHERE id=1;
# Restore strict settings before a clean OS-level crash; the Rapid fence stays.
SET GLOBAL sync_binlog=1;
--let $storage_route = primary_reloads
--let $storage_expected = 1:11,2:20,3:30
--source suite/secondary_engine/include/storage_layer_verify.inc
