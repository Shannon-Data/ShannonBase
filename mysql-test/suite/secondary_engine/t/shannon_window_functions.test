##############################################################################
# ShannonBase: vectorized window functions.
#
# Buffered window steps used to run on MySQL's BufferingWindowIterator, which
# materializes every input row into the window's frame-buffer temporary table
# and then walks that table back once per output row, calling Item_sum::add()
# for each visited row.
#
# Rapid now evaluates the running-frame subset natively
# (VectorizedWindowIterator): window function arguments are collected into
# typed column vectors and the frame aggregate is produced with one pass --
# a SIMD reduction per peer group / per partition where the frame allows it,
# and a prefix scan where it does not. Only the output record image is
# buffered, and only while its value is still undetermined.
#
# Supported subset (everything else keeps using MySQL's own iterators):
#   functions : ROW_NUMBER, RANK, DENSE_RANK, COUNT, SUM, AVG, MIN, MAX
#   frames    : RANGE UNBOUNDED PRECEDING .. CURRENT ROW -- the implicit frame
#                     of an aggregate with ORDER BY
#               UNBOUNDED PRECEDING .. UNBOUNDED FOLLOWING (ROWS and RANGE)
#   arguments : integer / real / decimal, no DISTINCT
#
# ROWS .. CURRENT ROW is deliberately absent: such a window needs no frame
# buffer, so MySQL streams it on its own non-buffering WindowIterator and this
# operator is never built for it. Queries below that use that frame are still
# checked against InnoDB, but they exercise MySQL's iterator, not this one.
#
# Every answer below is compared against the InnoDB answer for the same query
# rather than against a hand-written constant, and
# rapid_query_vectorized_window_rows_total proves the new operator actually
# ran instead of the test silently passing on the fallback path.
# ShannonBase copyright 2023-
##############################################################################

--source include/no_ps_protocol.inc

CREATE DATABASE sh_wf_db;
USE sh_wf_db;

CREATE TABLE wf (
  id    INT PRIMARY KEY,
  p     INT,              # partition key
  o     INT,              # order key, deliberately with ties
  i4    INT,
  i8    BIGINT,
  u8    BIGINT UNSIGNED,
  d     DOUBLE,
  dec1  DECIMAL(15,2),
  ni    INT,              # nullable integer
  nd    DECIMAL(15,2),    # nullable decimal
  s     VARCHAR(10),
  dt    DATETIME(6),
  yr    YEAR,
  e     ENUM('lo','mid','hi')
) SECONDARY_ENGINE RAPID;

INSERT INTO wf VALUES
 ( 1, 1, 10,   5,  100000000001,  9000000000000000001,  1.5,   10.01,    7,  1.10, 'a', '2026-01-01 00:00:00.123456', 2001, 'lo'),
 ( 2, 1, 10,  -3,  100000000002,  9000000000000000002,  2.25,  20.02, NULL,  2.20, 'b', '2026-01-01 00:00:00.000001', 2002, 'hi'),
 ( 3, 1, 20,  11,  100000000003,  9000000000000000003, -0.5,   30.03,    9,  NULL, 'c', '2025-06-30 23:59:59.999999', 1999, 'mid'),
 ( 4, 1, 20,   0,  100000000004,  9000000000000000004,  8.125, 40.04,    0,  4.40, 'd', '2027-12-31 12:00:00.500000', 2030, 'lo'),
 ( 5, 1, 30,   7,  100000000005,  9000000000000000005,  3.75,  50.05,   -2,  5.50, 'e', '2026-01-01 00:00:00.123457', 2026, 'hi'),
 ( 6, 2, 10,  42,  200000000001,  1000000000000000001,  0.0,   60.06, NULL,  NULL, 'f', '2020-02-29 06:30:00.000000', 2020, 'mid'),
 ( 7, 2, 10, -42,  200000000002,  1000000000000000002, -7.5,   70.07,    3,  7.70, 'g', '2020-02-29 06:30:00.000001', 2021, 'lo'),
 ( 8, 2, 15,   1,  200000000003,  1000000000000000003,  6.25,  80.08,    4,  8.80, 'h', '2019-01-01 00:00:00.000000', 2019, 'hi'),
 ( 9, 3, 10,   9,  300000000001,  1,                    2.5,   90.09,    5,  9.90, 'i', '2024-07-04 08:08:08.080808', 2024, 'mid'),
 (10, 4, 10, NULL, 400000000001,  2,                    1.0,  100.10, NULL,  NULL, 'j', NULL, NULL, NULL),
 (11, 4, 20, NULL, 400000000002,  3,                    2.0,  110.11, NULL,  NULL, 'k', '2022-03-03 03:03:03.030303', 2022, 'lo'),
 (12, 4, 30, NULL, 400000000003,  4,                    4.0,  120.12, NULL,  NULL, 'l', '2023-04-04 04:04:04.040404', 2023, 'hi');

ANALYZE TABLE wf;
ALTER TABLE wf SECONDARY_LOAD;

--echo #
--echo # ============ InnoDB baseline ============
--echo #
SET SESSION use_secondary_engine = OFF;
--source suite/secondary_engine/include/shannon_window_queries.inc

--echo #
--echo # ============ Rapid: every answer must match the baseline exactly ======
--echo #
SET SESSION use_secondary_engine = FORCED;
--source suite/secondary_engine/include/shannon_window_queries.inc

--echo #
--echo # ============ Rapid with the vectorized operator switched off ==========
--echo #
--echo # Same engine, same plan, MySQL's window iterators underneath: this
--echo # isolates the operator from everything else Rapid does to the query.
--source include/have_debug.inc
SET SESSION debug = '+d,rapid_disable_vectorized_window';
--source suite/secondary_engine/include/shannon_window_queries.inc
SET SESSION debug = '-d,rapid_disable_vectorized_window';

--echo #
--echo # ---- The vectorized operator must actually have run ----
--echo #
--echo # A window that is entirely inside the supported subset raises the
--echo # counter by exactly one per output row; a window that is not must leave
--echo # it untouched.

let $before = query_get_value(SHOW GLOBAL STATUS LIKE 'rapid_query_vectorized_window_rows_total', Value, 1);

--disable_result_log
SELECT p, o, SUM(i4) OVER (PARTITION BY p ORDER BY o) FROM wf;
--enable_result_log

let $after = query_get_value(SHOW GLOBAL STATUS LIKE 'rapid_query_vectorized_window_rows_total', Value, 1);
--let $emitted = `SELECT $after - $before`
--echo # rows emitted by the vectorized window operator (12 expected):
--echo $emitted

--echo # LAG() is outside the subset, so this window must stay on the native
--echo # iterator and add nothing to the counter.
let $before = query_get_value(SHOW GLOBAL STATUS LIKE 'rapid_query_vectorized_window_rows_total', Value, 1);
--disable_result_log
SELECT p, o, LAG(i4) OVER (PARTITION BY p ORDER BY o) FROM wf;
--enable_result_log
let $after = query_get_value(SHOW GLOBAL STATUS LIKE 'rapid_query_vectorized_window_rows_total', Value, 1);
--let $emitted = `SELECT $after - $before`
--echo # rows emitted by the vectorized window operator (0 expected):
--echo $emitted

--echo #
--echo # ---- Batch, partition and peer-group boundaries ----
--echo #
--echo # The operator ingests 1024 rows per pass, so a partition and a peer
--echo # group both have to be able to span passes. big.p has one partition of
--echo # 4000 rows; big.grp holds peer groups of 1500 rows, longer than a pass;
--echo # and big.uniq makes every row its own peer group.
SET SESSION use_secondary_engine = OFF;
SET SESSION cte_max_recursion_depth = 10000;

CREATE TABLE big (
  id   INT PRIMARY KEY,
  p    INT,
  grp  INT,
  uniq INT,
  v    INT,
  vd   DECIMAL(12,3),
  vf   DOUBLE,
  nv   INT
) SECONDARY_ENGINE RAPID;

INSERT INTO big (id, p, grp, uniq, v, vd, vf, nv)
WITH RECURSIVE seq(n) AS (
  SELECT 1 UNION ALL SELECT n + 1 FROM seq WHERE n < 6000
)
SELECT n,
       IF(n <= 4000, 1, 2),
       n DIV 1500,
       n,
       (n * 7) % 1000 - 500,
       ((n * 13) % 99999) / 1000,
       ((n * 17) % 7919) / 7.0,
       IF(n % 5 = 0, NULL, n % 97)
FROM seq;

SET SESSION cte_max_recursion_depth = DEFAULT;

ANALYZE TABLE big;
ALTER TABLE big SECONDARY_LOAD;

--source suite/secondary_engine/include/shannon_window_big.inc
SET SESSION use_secondary_engine = FORCED;
--source suite/secondary_engine/include/shannon_window_big.inc

--echo #
--echo # ---- The operator itself: partitions ending on an ingest-pass boundary ----
--echo #
--echo # Everything above compares Rapid against InnoDB, but a trailing ORDER BY
--echo # or a derived table materializes above the window step and turns the
--echo # whole physical island native, so those queries exercise MySQL's window
--echo # iterators under both engines. The block below uses the shape that keeps
--echo # VectorizedWindowIterator in the plan -- a bare select, captured with
--echo # CREATE TABLE ... AS so it can be compared without an ORDER BY -- and
--echo # asserts the operator's row counter, so a future fallback shows up as a
--echo # failure instead of silently making all of this vacuous.
--echo #
--echo # The row that ends a partition is carried over to open the next one, and
--echo # an ingest pass is 1024 rows. algn ends a partition exactly on a pass
--echo # boundary twice: partition 0 is 1024 rows (a pass counted from the first
--echo # row of the input) and partition 1 is 1025 rows (a pass counted from the
--echo # carried-over row). Partition 2 (2048 rows) ends mid-pass as a control.
SET SESSION use_secondary_engine = OFF;
SET SESSION cte_max_recursion_depth = 10000;

CREATE TABLE algn (
  id INT PRIMARY KEY,
  p  INT,
  o  INT,
  v  INT,
  nv INT,
  vd DECIMAL(12,3),
  vf DOUBLE
) SECONDARY_ENGINE RAPID;

INSERT INTO algn (id, p, o, v, nv, vd, vf)
WITH RECURSIVE seq(n) AS (
  SELECT 1 UNION ALL SELECT n + 1 FROM seq WHERE n < 4103
)
SELECT n,
       CASE WHEN n <= 1024 THEN 0 WHEN n <= 2049 THEN 1
            WHEN n <= 4097 THEN 2 ELSE 3 END,
       n DIV 100,
       (n * 7) % 1000 - 500,
       IF(n % 5 = 0, NULL, n % 97),
       ((n * 13) % 99999) / 1000,
       ((n * 17) % 7919) / 7.0
FROM seq;

SET SESSION cte_max_recursion_depth = DEFAULT;

ANALYZE TABLE algn;
ALTER TABLE algn SECONDARY_LOAD;

CREATE DATABASE sh_wf_base;
CREATE DATABASE sh_wf_rpd;
CREATE DATABASE sh_wf_spill;

--echo # The InnoDB answer.
USE sh_wf_base;
--source suite/secondary_engine/include/shannon_window_align.inc

--echo # The Rapid answer.
USE sh_wf_rpd;
SET SESSION use_secondary_engine = FORCED;
let $before = query_get_value(SHOW GLOBAL STATUS LIKE 'rapid_query_vectorized_window_rows_total', Value, 1);
--source suite/secondary_engine/include/shannon_window_align.inc
let $after = query_get_value(SHOW GLOBAL STATUS LIKE 'rapid_query_vectorized_window_rows_total', Value, 1);
--let $emitted = `SELECT $after - $before`
--echo # rows emitted by the vectorized window operator (16412 expected):
--echo $emitted

--echo #
--echo # The Rapid answer again with the buffer budget shrunk to four records.
--echo # A running frame can no longer serve a partial pass: the spill file is
--echo # read strictly forward, so the operator holds every row back until the
--echo # partition closes and then drains it in one sweep, four partitions in a
--echo # row, each restarting the file.
USE sh_wf_spill;
SET SESSION debug = '+d,rapid_window_tiny_buffer';
let $before = query_get_value(SHOW GLOBAL STATUS LIKE 'rapid_query_vectorized_window_rows_total', Value, 1);
--source suite/secondary_engine/include/shannon_window_align.inc
let $after = query_get_value(SHOW GLOBAL STATUS LIKE 'rapid_query_vectorized_window_rows_total', Value, 1);
SET SESSION debug = '-d,rapid_window_tiny_buffer';
--let $emitted = `SELECT $after - $before`
--echo # rows emitted by the vectorized window operator while spilling (16412 expected):
--echo $emitted

USE sh_wf_db;
SET SESSION use_secondary_engine = OFF;

--echo #
--echo # Rapid against the InnoDB baseline, row by row: every number must be 0.
--let $rpd = sh_wf_rpd
--source suite/secondary_engine/include/shannon_window_align_check.inc

--echo #
--echo # ... and the spilled Rapid run against the same baseline.
--let $rpd = sh_wf_spill
--source suite/secondary_engine/include/shannon_window_align_check.inc

--echo #
--echo # The rows straddling every partition boundary, spelled out, so a value
--echo # leaking across a boundary shows up as a row rather than as a count.
--echo # Partitions are ids 1-1024, 1025-2049, 2050-4097, 4098-4103.
SELECT * FROM sh_wf_rpd.a2
WHERE id IN (1, 2, 1023, 1024, 1025, 1026, 2048, 2049, 2050, 2051,
             4096, 4097, 4098, 4099, 4103)
ORDER BY id;

--echo #
--echo # ---- Boundary cases, through the operator ----
--echo #
--echo # An all-NULL frame, single-row partitions, one peer group that outlives
--echo # both an ingest pass and the memory budget, and arguments at the top of
--echo # the unsigned BIGINT and DECIMAL ranges. Captured and compared exactly
--echo # like the algn block above, and run a third time with the buffer budget
--echo # shrunk so the giant peer group has to go through the spill file.
SET SESSION use_secondary_engine = OFF;
SET SESSION cte_max_recursion_depth = 10000;

CREATE TABLE edge (
  id INT PRIMARY KEY,
  p  INT,
  o  INT,
  v  INT,
  nv INT,
  ud BIGINT UNSIGNED,
  dc DECIMAL(30,4)
) SECONDARY_ENGINE RAPID;

INSERT INTO edge (id, p, o, v, nv, ud, dc) VALUES
 (1, 0, 1,  10, NULL, 1, 1.5000),
 (2, 0, 2, -20, NULL, 2, 2.5000),
 (3, 0, 3,  30, NULL, 3, 3.5000),
 (4, 1, 1,   7,    7, 4, 4.5000),
 (5, 2, 1,   9, NULL, 5, 5.5000);

INSERT INTO edge (id, p, o, v, nv, ud, dc)
WITH RECURSIVE seq(n) AS (
  SELECT 1 UNION ALL SELECT n + 1 FROM seq WHERE n < 1500
)
SELECT n + 5, 3, 0, (n * 7) % 1000 - 500, IF(n % 3 = 0, NULL, n % 53), n * 1000, n / 7
FROM seq;

INSERT INTO edge (id, p, o, v, nv, ud, dc) VALUES
 (1506, 4, 1, 1,    1, 18446744073709551615,  999999999999999999999999.9999),
 (1507, 4, 2, 2, NULL, 18446744073709551614,  888888888888888888888888.8888),
 (1508, 4, 3, 3,    3, 18446744073709551615,  777777777777777777777777.7777),
 (1509, 4, 4, 4,    4,                    1,                        0.0001),
 (1510, 4, 5, 5, NULL,                    0, -999999999999999999999999.9999);

SET SESSION cte_max_recursion_depth = DEFAULT;

ANALYZE TABLE edge;
ALTER TABLE edge SECONDARY_LOAD;

--echo # The InnoDB answer.
USE sh_wf_base;
--source suite/secondary_engine/include/shannon_window_edge.inc

--echo # The Rapid answer.
USE sh_wf_rpd;
SET SESSION use_secondary_engine = FORCED;
let $before = query_get_value(SHOW GLOBAL STATUS LIKE 'rapid_query_vectorized_window_rows_total', Value, 1);
--source suite/secondary_engine/include/shannon_window_edge.inc
let $after = query_get_value(SHOW GLOBAL STATUS LIKE 'rapid_query_vectorized_window_rows_total', Value, 1);
--let $emitted = `SELECT $after - $before`
--echo # rows emitted by the vectorized window operator (6040 expected):
--echo $emitted

--echo # The Rapid answer with the buffer budget shrunk to four records.
USE sh_wf_spill;
SET SESSION debug = '+d,rapid_window_tiny_buffer';
let $before = query_get_value(SHOW GLOBAL STATUS LIKE 'rapid_query_vectorized_window_rows_total', Value, 1);
--source suite/secondary_engine/include/shannon_window_edge.inc
let $after = query_get_value(SHOW GLOBAL STATUS LIKE 'rapid_query_vectorized_window_rows_total', Value, 1);
SET SESSION debug = '-d,rapid_window_tiny_buffer';
--let $emitted = `SELECT $after - $before`
--echo # rows emitted by the vectorized window operator while spilling (6040 expected):
--echo $emitted

USE sh_wf_db;
SET SESSION use_secondary_engine = OFF;

--echo #
--echo # Rapid against the InnoDB baseline: every number must be 0.
--let $rpd = sh_wf_rpd
--source suite/secondary_engine/include/shannon_window_edge_check.inc

--echo #
--echo # ... and the spilled run against the same baseline.
--let $rpd = sh_wf_spill
--source suite/secondary_engine/include/shannon_window_edge_check.inc

--echo #
--echo # The small partitions spelled out: an all-NULL frame yields NULL for
--echo # SUM/AVG/MIN/MAX but 0 for COUNT, and a single-row partition ranks 1.
SELECT * FROM sh_wf_rpd.e1 WHERE p IN (0, 1, 2, 4) ORDER BY id;
SELECT * FROM sh_wf_rpd.e3 WHERE p = 4 ORDER BY id;

--echo #
--echo # ---- Kernel dispatch: NULL granularity ----
--echo #
--echo # The SIMD kernels take no NULL mask, so they need a NULL-free range.
--echo # That question is asked per segment (one peer group), not per ingest
--echo # pass: with sparse NULLs nearly every peer group is clean even though
--echo # the pass as a whole is not, and asking per pass would give the
--echo # vectorized path away for all of them.
--echo #
--echo # nb makes the split exact: 8192 rows, 32 peer groups of 256, and one
--echo # NULL landing in each of 8 distinct groups. Asking per pass would put
--echo # all 8192 rows x 4 kernels on the scalar path, because every 1024-row
--echo # pass holds a NULL. Asking per segment leaves only the 8 groups that
--echo # really contain one.
SET SESSION use_secondary_engine = OFF;
SET SESSION cte_max_recursion_depth = 20000;

CREATE TABLE nb (id INT PRIMARY KEY, o INT, v INT, nv INT) SECONDARY_ENGINE RAPID;
INSERT INTO nb (id, o, v, nv)
WITH RECURSIVE seq(n) AS (
  SELECT 1 UNION ALL SELECT n + 1 FROM seq WHERE n < 8192
)
SELECT n, (n - 1) DIV 256, n % 1000, IF(n % 1024 = 0, NULL, n % 997)
FROM seq;

SET SESSION cte_max_recursion_depth = DEFAULT;
ANALYZE TABLE nb;
ALTER TABLE nb SECONDARY_LOAD;

CREATE TABLE sh_wf_base.n1 AS
SELECT id, COUNT(nv) OVER w AS c, SUM(nv) OVER w AS s, MIN(nv) OVER w AS mn, MAX(nv) OVER w AS mx
FROM nb WINDOW w AS (ORDER BY o);

SET SESSION use_secondary_engine = FORCED;
let $s0 = query_get_value(SHOW GLOBAL STATUS LIKE 'rapid_query_vectorized_window_simd_rows_total', Value, 1);
let $c0 = query_get_value(SHOW GLOBAL STATUS LIKE 'rapid_query_vectorized_window_scalar_rows_total', Value, 1);
CREATE TABLE sh_wf_rpd.n1 AS
SELECT id, COUNT(nv) OVER w AS c, SUM(nv) OVER w AS s, MIN(nv) OVER w AS mn, MAX(nv) OVER w AS mx
FROM nb WINDOW w AS (ORDER BY o);
let $s1 = query_get_value(SHOW GLOBAL STATUS LIKE 'rapid_query_vectorized_window_simd_rows_total', Value, 1);
let $c1 = query_get_value(SHOW GLOBAL STATUS LIKE 'rapid_query_vectorized_window_scalar_rows_total', Value, 1);
--let $simd = `SELECT $s1 - $s0`
--let $scalar = `SELECT $c1 - $c0`
--echo # sparse NULLs, 24 clean groups x 256 rows x 4 kernels
--echo # rows through the SIMD kernels (24576 expected):
--echo $simd
--echo # rows through the scalar kernels (8192 expected):
--echo $scalar

--echo # Control: the same four kernels over a column with no NULL at all.
let $s0 = query_get_value(SHOW GLOBAL STATUS LIKE 'rapid_query_vectorized_window_simd_rows_total', Value, 1);
let $c0 = query_get_value(SHOW GLOBAL STATUS LIKE 'rapid_query_vectorized_window_scalar_rows_total', Value, 1);
--disable_result_log
SELECT id, COUNT(v) OVER w AS c, SUM(v) OVER w AS s, MIN(v) OVER w AS mn, MAX(v) OVER w AS mx
FROM nb WINDOW w AS (ORDER BY o);
--enable_result_log
let $s1 = query_get_value(SHOW GLOBAL STATUS LIKE 'rapid_query_vectorized_window_simd_rows_total', Value, 1);
let $c1 = query_get_value(SHOW GLOBAL STATUS LIKE 'rapid_query_vectorized_window_scalar_rows_total', Value, 1);
--let $simd = `SELECT $s1 - $s0`
--let $scalar = `SELECT $c1 - $c0`
--echo # rows through the SIMD kernels (32768 expected):
--echo $simd
--echo # rows through the scalar kernels (0 expected):
--echo $scalar

SET SESSION use_secondary_engine = OFF;
--echo # and the dispatch must not have changed a single value:
SELECT (SELECT COUNT(*) FROM sh_wf_base.n1) - (SELECT COUNT(*) FROM sh_wf_rpd.n1) AS row_delta,
       (SELECT COUNT(*) FROM (SELECT * FROM sh_wf_base.n1 EXCEPT ALL SELECT * FROM sh_wf_rpd.n1) x) AS only_innodb,
       (SELECT COUNT(*) FROM (SELECT * FROM sh_wf_rpd.n1 EXCEPT ALL SELECT * FROM sh_wf_base.n1) y) AS only_rapid;

--echo #
--echo # ---- Integer accumulator overflow ----
--echo #
--echo # SUM() over an integer argument returns DECIMAL, and MySQL accumulates it
--echo # one decimal addition per row. The operator accumulates in int64 instead
--echo # and only folds into a decimal carry on overflow, so a running frame that
--echo # crosses the int64 range on both the signed and the unsigned side has to
--echo # produce the same decimal.
CREATE TABLE wf_big_int (
  id INT PRIMARY KEY,
  p  INT,
  b  BIGINT,
  ub BIGINT UNSIGNED
) SECONDARY_ENGINE RAPID;
INSERT INTO wf_big_int VALUES
 (1, 1,  9223372036854775807, 18446744073709551615),
 (2, 1,  9223372036854775806, 18446744073709551614),
 (3, 1,  9223372036854775805, 18446744073709551613),
 (4, 1, -9223372036854775808,                    1),
 (5, 1,  9223372036854775807, 18446744073709551615),
 (6, 2, -9223372036854775808,                    0),
 (7, 2, -9223372036854775807,                    1),
 (8, 2, -9223372036854775806, 18446744073709551615);
ANALYZE TABLE wf_big_int;
ALTER TABLE wf_big_int SECONDARY_LOAD;

SET SESSION use_secondary_engine = OFF;
--source suite/secondary_engine/include/shannon_window_bigint.inc
SET SESSION use_secondary_engine = FORCED;
--source suite/secondary_engine/include/shannon_window_bigint.inc

--echo # Those three run on MySQL's iterators (a ROWS running frame needs no
--echo # buffer, and the trailing ORDER BY materializes above the window step).
--echo # The overflow fold itself is this operator's own code, so drive it
--echo # through the shape the operator survives -- a bare select with a single
--echo # window step, captured with CREATE TABLE ... AS -- and compare row by
--echo # row. A second window step in the same query would materialize the
--echo # first one and take the whole island native again, so they are split.
--echo # AVG stays out of the capture: materializing AVG() of these extremes
--echo # overflows MySQL's own frame-buffer column, in both engines alike. The
--echo # fold under test is the SUM accumulator, and I1/I2 above still pin AVG.
SET SESSION use_secondary_engine = OFF;
CREATE TABLE sh_wf_base.i1 AS
SELECT id, p, SUM(b) OVER w AS sb, SUM(ub) OVER w AS sub,
       MIN(b) OVER w AS mnb, MAX(ub) OVER w AS mxub
FROM wf_big_int
WINDOW w AS (PARTITION BY p ORDER BY id
             ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING);
CREATE TABLE sh_wf_base.i2 AS
SELECT id, p, SUM(b) OVER w AS sb, SUM(ub) OVER w AS sub
FROM wf_big_int WINDOW w AS (PARTITION BY p ORDER BY id);

SET SESSION use_secondary_engine = FORCED;
let $before = query_get_value(SHOW GLOBAL STATUS LIKE 'rapid_query_vectorized_window_rows_total', Value, 1);
CREATE TABLE sh_wf_rpd.i1 AS
SELECT id, p, SUM(b) OVER w AS sb, SUM(ub) OVER w AS sub,
       MIN(b) OVER w AS mnb, MAX(ub) OVER w AS mxub
FROM wf_big_int
WINDOW w AS (PARTITION BY p ORDER BY id
             ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING);
CREATE TABLE sh_wf_rpd.i2 AS
SELECT id, p, SUM(b) OVER w AS sb, SUM(ub) OVER w AS sub
FROM wf_big_int WINDOW w AS (PARTITION BY p ORDER BY id);
let $after = query_get_value(SHOW GLOBAL STATUS LIKE 'rapid_query_vectorized_window_rows_total', Value, 1);
--let $emitted = `SELECT $after - $before`
--echo # rows emitted by the vectorized window operator (16 expected, eight rows twice):
--echo $emitted

SET SESSION use_secondary_engine = OFF;
--echo # every number must be 0:
SELECT (SELECT COUNT(*) FROM sh_wf_base.i1) - (SELECT COUNT(*) FROM sh_wf_rpd.i1) AS row_delta,
       (SELECT COUNT(*) FROM (SELECT * FROM sh_wf_base.i1 EXCEPT ALL SELECT * FROM sh_wf_rpd.i1) x) AS only_innodb,
       (SELECT COUNT(*) FROM (SELECT * FROM sh_wf_rpd.i1 EXCEPT ALL SELECT * FROM sh_wf_base.i1) y) AS only_rapid;
SELECT (SELECT COUNT(*) FROM sh_wf_base.i2) - (SELECT COUNT(*) FROM sh_wf_rpd.i2) AS row_delta,
       (SELECT COUNT(*) FROM (SELECT * FROM sh_wf_base.i2 EXCEPT ALL SELECT * FROM sh_wf_rpd.i2) x) AS only_innodb,
       (SELECT COUNT(*) FROM (SELECT * FROM sh_wf_rpd.i2 EXCEPT ALL SELECT * FROM sh_wf_base.i2) y) AS only_rapid;
--echo # the folded sums themselves, whole-partition then running:
SELECT * FROM sh_wf_rpd.i1 ORDER BY id;
SELECT * FROM sh_wf_rpd.i2 ORDER BY id;

--echo #
--echo # ---- Spilling the buffered partition ----
--echo #
--echo # A whole-partition frame cannot emit anything until the partition has
--echo # been read, so its record images are what overflows the operator's memory
--echo # budget and goes to a temporary file. Reaching 64MB with real data would
--echo # take a very large partition, so shrink the budget to four records.
--source include/have_debug.inc

SET SESSION use_secondary_engine = OFF;
--source suite/secondary_engine/include/shannon_window_spill.inc

SET SESSION use_secondary_engine = FORCED;
SET SESSION debug = '+d,rapid_window_tiny_buffer';
--source suite/secondary_engine/include/shannon_window_spill.inc

--echo # The spilled queries must have gone through the vectorized operator, not
--echo # quietly fallen back to the native one.
let $before = query_get_value(SHOW GLOBAL STATUS LIKE 'rapid_query_vectorized_window_rows_total', Value, 1);
--disable_result_log
SELECT id, SUM(v) OVER (PARTITION BY p ORDER BY id
                        ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING)
FROM big;
--enable_result_log
let $after = query_get_value(SHOW GLOBAL STATUS LIKE 'rapid_query_vectorized_window_rows_total', Value, 1);
--let $emitted = `SELECT $after - $before`
--echo # rows emitted by the vectorized window operator while spilling (6000 expected):
--echo $emitted

SET SESSION debug = '-d,rapid_window_tiny_buffer';

--echo #
--echo # ---- Empty input ----
--echo #
CREATE TABLE wf_empty (id INT PRIMARY KEY, p INT, o INT, v INT) SECONDARY_ENGINE RAPID;
ANALYZE TABLE wf_empty;
ALTER TABLE wf_empty SECONDARY_LOAD;
SET SESSION use_secondary_engine = OFF;
SELECT p, ROW_NUMBER() OVER w, SUM(v) OVER w FROM wf_empty
  WINDOW w AS (PARTITION BY p ORDER BY o);
SET SESSION use_secondary_engine = FORCED;
SELECT p, ROW_NUMBER() OVER w, SUM(v) OVER w FROM wf_empty
  WINDOW w AS (PARTITION BY p ORDER BY o);

SET SESSION use_secondary_engine = DEFAULT;
DROP TABLE wf_empty;
DROP TABLE algn;
DROP TABLE edge;
DROP TABLE nb;
DROP DATABASE sh_wf_base;
DROP DATABASE sh_wf_rpd;
DROP DATABASE sh_wf_spill;
DROP TABLE wf_big_int;
DROP TABLE big;
DROP TABLE wf;
DROP DATABASE sh_wf_db;
