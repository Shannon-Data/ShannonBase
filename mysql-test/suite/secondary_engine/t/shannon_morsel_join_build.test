--source include/have_debug.inc
--source include/have_debug_sync.inc
--source include/no_ps_protocol.inc
CREATE DATABASE rapid_join_build;
USE rapid_join_build;
SET use_secondary_engine=OFF;
SET cte_max_recursion_depth=140000;
CREATE TABLE b(id INT PRIMARY KEY,k INT,k2 INT,g INT,v DECIMAL(12,2),s VARCHAR(12)) SECONDARY_ENGINE=rapid;
CREATE TABLE p(id INT PRIMARY KEY,k INT,k2 INT,g INT,v BIGINT) SECONDARY_ENGINE=rapid;
INSERT INTO p WITH RECURSIVE seq AS (SELECT 1 n UNION ALL SELECT n+1 FROM seq WHERE n<140000)
 SELECT n,IF(MOD(n,23)=0,NULL,MOD(n,20000)),MOD(n,3),MOD(n,9),n-70000 FROM seq;
INSERT INTO b SELECT id,IF(MOD(id,17)=0,NULL,MOD(id,20000)),k2,MOD(id,5),
 IF(MOD(id,11)=0,NULL,(id-35000)*1.25),IF(MOD(id,13)=0,NULL,CONCAT('v',MOD(id,97))) FROM p WHERE id<=70000;
ANALYZE TABLE b,p;
ALTER TABLE b SECONDARY_LOAD;
ALTER TABLE p SECONDARY_LOAD;
SET use_secondary_engine=FORCED;
--disable_warnings
SET optimizer_switch='hypergraph_optimizer=on';
--enable_warnings
SET secondary_engine_cost_threshold=0;
--echo # Both build and finalize must execute, with composite keys, NULLs and encoded payloads.
--let $workers = 2
while ($workers <= 8) {
 SET rapid_parallel_workers=1;
 --output $MYSQLTEST_VARDIR/log/build_serial.out
 SELECT p.id,b.id,b.s FROM p JOIN b ON p.k=b.k AND p.k2=b.k2 LIMIT 256;
 eval SET rapid_parallel_workers=$workers;
 --output $MYSQLTEST_VARDIR/log/build_parallel.out
 SELECT p.id,b.id,b.s FROM p JOIN b ON p.k=b.k AND p.k2=b.k2 LIMIT 256;
 --diff_files $MYSQLTEST_VARDIR/log/build_serial.out $MYSQLTEST_VARDIR/log/build_parallel.out
 --let $assert_query = SELECT p.g,b.g,SUM(b.v),SUM(p.v),COUNT(b.s),COUNT(*) FROM p JOIN b ON p.k=b.k AND p.k2=b.k2 GROUP BY p.g,b.g
 --source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
 --let $assert_query = SELECT SUM(b.v),AVG(p.v),COUNT(*) FROM p JOIN b ON p.k=b.k AND p.k2=b.k2
 --source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
 --let $workers = `SELECT $workers*2`
}
--remove_file $MYSQLTEST_VARDIR/log/build_serial.out
--remove_file $MYSQLTEST_VARDIR/log/build_parallel.out
SET rapid_parallel_workers=2;
--echo # Budget refusals in either stage discard all private state before serial replay.
--let $hook = rapid_parallel_join_build_budget
--let $stages = 2
while ($stages) {
 eval SET debug='+d,$hook';
 --let $assert_query = SELECT SUM(b.v),COUNT(*) FROM p JOIN b ON p.k=b.k AND p.k2=b.k2
 --source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
 eval SET debug='-d,$hook';
 --let $hook = rapid_parallel_join_finalize_budget
 --dec $stages
}
--echo # Errors from either stage join all threads, then the next execution succeeds.
SET debug='+d,rapid_parallel_join_build_failure';
--error ER_SECONDARY_ENGINE_PLUGIN
SELECT SUM(b.v),COUNT(*) FROM p JOIN b ON p.k=b.k AND p.k2=b.k2;
SET debug='-d,rapid_parallel_join_build_failure';
SET debug='+d,rapid_parallel_join_finalize_failure';
--error ER_SECONDARY_ENGINE_PLUGIN
SELECT SUM(b.v),COUNT(*) FROM p JOIN b ON p.k=b.k AND p.k2=b.k2;
SET debug='-d,rapid_parallel_join_finalize_failure';
--let $assert_query = SELECT SUM(b.v),COUNT(*) FROM p JOIN b ON p.k=b.k AND p.k2=b.k2
--source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
--echo # Prepared executions rebuild or reuse a complete immutable build only.
PREPARE stmt FROM 'SELECT SUM(b.v),COUNT(*) FROM p JOIN b ON p.k=b.k AND p.k2=b.k2';
EXECUTE stmt;
EXECUTE stmt;
DEALLOCATE PREPARE stmt;
--echo # A bounded build replays through the existing ordered spill implementation.
SET join_buffer_size=1048576;
SET debug='+d,rapid_operator_budget_floor,rapid_parallel_join_build_budget';
--let $assert_query = SELECT SUM(b.v),COUNT(*) FROM p JOIN b ON p.k=b.k AND p.k2=b.k2
--source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
SET debug='-d,rapid_operator_budget_floor,rapid_parallel_join_build_budget';
SET join_buffer_size=DEFAULT;
--echo # Cancellation at the finalize barrier cannot publish partial hash chains.
SET DEBUG_SYNC='rapid_before_parallel_join_finalize SIGNAL finalize_ready WAIT_FOR finalize_continue';
--let $victim = `SELECT CONNECTION_ID()`
--send SELECT SUM(b.v),COUNT(*) FROM p JOIN b ON p.k=b.k AND p.k2=b.k2
--connect (killer,localhost,root,,rapid_join_build)
SET DEBUG_SYNC='now WAIT_FOR finalize_ready';
--disable_query_log
eval KILL QUERY $victim;
--enable_query_log
SET DEBUG_SYNC='now SIGNAL finalize_continue';
--connection default
--error ER_QUERY_INTERRUPTED
--reap
SET DEBUG_SYNC='RESET';
--disconnect killer
--let $assert_query = SELECT SUM(b.v),COUNT(*) FROM p JOIN b ON p.k=b.k AND p.k2=b.k2
--source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
--echo # Build workers share the coordinator snapshot across concurrent committed DML.
SET use_secondary_engine=OFF;
--let $snapshot_sum = query_get_value(SELECT SUM(b.v) AS s FROM p JOIN b ON p.k=b.k AND p.k2=b.k2, s, 1)
--let $snapshot_count = query_get_value(SELECT COUNT(*) AS n FROM p JOIN b ON p.k=b.k AND p.k2=b.k2, n, 1)
SET use_secondary_engine=FORCED;
SET DEBUG_SYNC='rapid_parallel_workers_started SIGNAL build_started WAIT_FOR build_continue EXECUTE 1';
--disable_query_log
--send_eval SELECT SUM(b.v)=$snapshot_sum AS snapshot_sum,COUNT(*)=$snapshot_count AS snapshot_count FROM p JOIN b ON p.k=b.k AND p.k2=b.k2
--enable_query_log
--connect (writer,localhost,root,,rapid_join_build)
SET DEBUG_SYNC='now WAIT_FOR build_started';
SET use_secondary_engine=OFF;
UPDATE b SET v=-v WHERE id<=2000;
DELETE FROM b WHERE id BETWEEN 2001 AND 3000;
INSERT INTO b VALUES (70001,1,1,1,123.45,'new');
SET DEBUG_SYNC='now SIGNAL build_continue';
--connection default
--reap
SET DEBUG_SYNC='RESET';
--disconnect writer
--let $assert_query = SELECT SUM(b.v),COUNT(*) FROM p JOIN b ON p.k=b.k AND p.k2=b.k2
--source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
--echo # An empty filtered build must publish no dangling row references.
--let $assert_query = SELECT SUM(b.v),COUNT(*) FROM p JOIN b ON p.k=b.k AND p.k2=b.k2 WHERE b.s='absent'
--source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
SET use_secondary_engine=OFF;
DROP DATABASE rapid_join_build;
