--source include/have_debug_sync.inc
--source include/no_ps_protocol.inc
--source include/resource_group_init.inc
SET use_secondary_engine=OFF;
CREATE RESOURCE GROUP ri_ap TYPE=USER VCPU=0;
CREATE RESOURCE GROUP ri_original TYPE=USER VCPU=1;
SET GLOBAL rapid_resource_isolation=SOFT;
CREATE TABLE ri_cpu(id INT PRIMARY KEY,v INT) SECONDARY_ENGINE=rapid;
INSERT INTO ri_cpu VALUES(1,7);
ALTER TABLE ri_cpu SECONDARY_LOAD;
connect (holder,localhost,root,,test);
SET RESOURCE GROUP ri_original;
SET use_secondary_engine=FORCED;
SET DEBUG_SYNC='rapid_resource_ap_admitted SIGNAL ri_cpu_ready WAIT_FOR ri_cpu_continue';
let $holder_id= `SELECT CONNECTION_ID()`;
--send SELECT SUM(v) FROM ri_cpu
connection default;
SET DEBUG_SYNC='now WAIT_FOR ri_cpu_ready';
eval SELECT RESOURCE_GROUP FROM performance_schema.threads WHERE PROCESSLIST_ID=$holder_id;
# Destination group MDL is pinned during execution.
SET lock_wait_timeout=1;
--error ER_LOCK_WAIT_TIMEOUT
DROP RESOURCE GROUP ri_ap FORCE;
SET DEBUG_SYNC='now SIGNAL ri_cpu_continue';
connection holder;
--reap
SET use_secondary_engine=OFF;
SELECT RESOURCE_GROUP FROM performance_schema.threads WHERE PROCESSLIST_ID=CONNECTION_ID();
SET use_secondary_engine=ON;
SET secondary_engine_cost_threshold=0;
SET debug='+d,secondary_engine_rapid_optimize_error';
SELECT SUM(v) FROM ri_cpu;
SET debug='-d,secondary_engine_rapid_optimize_error';
SET use_secondary_engine=OFF;
SELECT RESOURCE_GROUP FROM performance_schema.threads WHERE PROCESSLIST_ID=CONNECTION_ID();
SET RESOURCE GROUP USR_default;
disconnect holder;
connection default;
ALTER TABLE ri_cpu SECONDARY_UNLOAD;
DROP RESOURCE GROUP ri_ap;
CREATE RESOURCE GROUP ri_ap TYPE=SYSTEM VCPU=0;
ALTER TABLE ri_cpu SECONDARY_LOAD;
SET use_secondary_engine=FORCED;
--error ER_SECONDARY_ENGINE_PLUGIN,ER_SECONDARY_ENGINE
SELECT SUM(v) FROM ri_cpu;
SHOW WARNINGS;
SET use_secondary_engine=ON;
SET secondary_engine_cost_threshold=0;
SELECT SUM(v) FROM ri_cpu;
SET use_secondary_engine=OFF;
SELECT RESOURCE_GROUP FROM performance_schema.threads WHERE PROCESSLIST_ID=CONNECTION_ID();
ALTER TABLE ri_cpu SECONDARY_UNLOAD;
DROP TABLE ri_cpu;
SET GLOBAL rapid_resource_isolation=OFF;
DROP RESOURCE GROUP ri_ap;
DROP RESOURCE GROUP ri_original;
SET DEBUG_SYNC='RESET';
