--loose-rapid_schema_embedding=OFF
--log-bin
--binlog-format=ROW
--binlog-row-image=FULL
--binlog-row-metadata=FULL
--sync-binlog=1
--innodb-flush-log-at-trx-commit=1
--rapid-resource-ap-limit=1
--rapid-resource-sync-limit=2
--rapid-resource-maint-limit=1
--rapid-use-dynamic-offload=OFF
--rapid-resource-tp-group=ri_tp
--rapid-resource-ap-group=ri_ap
--rapid-resource-sync-group=ri_sync
--rapid-resource-maint-group=ri_maint
--rapid-resource-maint-user-group=ri_maint_user
