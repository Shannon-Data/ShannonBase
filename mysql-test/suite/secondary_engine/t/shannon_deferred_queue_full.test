--source include/have_debug.inc
--source include/no_ps_protocol.inc
--disable_query_log
CALL mtr.add_suppression('Rapid deferred COMMIT queue unavailable or full; restart requires primary reload');
CALL mtr.add_suppression('Rapid propagation (retry [1-3]/3 for|quarantined) table .*sh_deferred_full.t to imcs failed');
--enable_query_log
CREATE DATABASE sh_deferred_full;
USE sh_deferred_full;
CREATE TABLE t(id INT PRIMARY KEY, v INT) SECONDARY_ENGINE=rapid;
INSERT INTO t VALUES(1,10);
ALTER TABLE t SECONDARY_LOAD;
SET GLOBAL rapid_lazy_commit_marker=ON;
SET GLOBAL innodb_flush_log_at_trx_commit=2;
# Keep one source outcome unconfirmed, then exhaust the debug capacity.
SET debug='+d,rapid_deferred_unflushed_lsn,rapid_deferred_queue_limit';
INSERT INTO t VALUES(2,20);
INSERT INTO t VALUES(3,30);
SET debug='-d,rapid_deferred_unflushed_lsn,rapid_deferred_queue_limit';
SET GLOBAL innodb_flush_log_at_trx_commit=1;
SET GLOBAL rapid_lazy_commit_marker=OFF;
SET use_secondary_engine=FORCED;
--error ER_SECONDARY_ENGINE
SELECT * FROM t ORDER BY id;
SET use_secondary_engine=OFF;
SELECT * FROM t ORDER BY id;
ALTER TABLE t SECONDARY_UNLOAD;
ALTER TABLE t SECONDARY_LOAD;
--let $assert_digest = SELECT GROUP_CONCAT(CONCAT(id,':',v) ORDER BY id) FROM t
--source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
SET use_secondary_engine=OFF;
DROP DATABASE sh_deferred_full;
