--source include/have_debug.inc
--source include/no_ps_protocol.inc
CREATE DATABASE sh_upsert_recovery;
USE sh_upsert_recovery;
CREATE TABLE r (id INT PRIMARY KEY, v INT) SECONDARY_ENGINE=rapid;
CREATE TABLE i LIKE r;
CREATE TABLE u LIKE r;
INSERT INTO r VALUES (1,10);
INSERT INTO i VALUES (1,10);
INSERT INTO u VALUES (1,10);
ALTER TABLE r SECONDARY_LOAD;
ALTER TABLE i SECONDARY_LOAD;
ALTER TABLE u SECONDARY_LOAD;
REPLACE INTO r VALUES (1,20);
INSERT IGNORE INTO i VALUES (1,99),(2,20);
INSERT INTO u VALUES (1,30),(2,20) ON DUPLICATE KEY UPDATE v=VALUES(v);
SET use_secondary_engine=FORCED;
--error ER_SECONDARY_ENGINE
SELECT * FROM r;
--error ER_SECONDARY_ENGINE
SELECT * FROM i;
--error ER_SECONDARY_ENGINE
SELECT * FROM u;
# Invalid capture histories must stay invalid across a crash. Recovery must
# reload all three primary results rather than resurrect an old checkpoint.
--let $restart_parameters = restart: --rapid_reload_on_restart=ON
--source include/kill_and_restart_mysqld.inc
USE sh_upsert_recovery;
--let $wait_condition = SELECT COUNT(*)=3 FROM performance_schema.rpd_table_id WHERE SCHEMA_NAME='sh_upsert_recovery'
--source include/wait_condition.inc
--let $wait_condition = SELECT CAST(VARIABLE_VALUE AS UNSIGNED)=3 FROM performance_schema.global_status WHERE VARIABLE_NAME='rapid_recovery_primary_reloads'
--source include/wait_condition.inc
SELECT VARIABLE_VALUE FROM performance_schema.global_status WHERE VARIABLE_NAME='rapid_recovery_primary_reloads';
--let $assert_digest = SELECT GROUP_CONCAT(CONCAT(id,':',v) ORDER BY id) FROM r
--source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
--let $assert_digest = SELECT GROUP_CONCAT(CONCAT(id,':',v) ORDER BY id) FROM i
--source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
--let $assert_digest = SELECT GROUP_CONCAT(CONCAT(id,':',v) ORDER BY id) FROM u
--source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
SET use_secondary_engine=FORCED;
SELECT * FROM r ORDER BY id;
SELECT * FROM i ORDER BY id;
SELECT * FROM u ORDER BY id;
SET use_secondary_engine=OFF;
DROP DATABASE sh_upsert_recovery;
