--source include/have_debug.inc
--source include/have_debug_sync.inc
--source include/no_ps_protocol.inc
SET use_secondary_engine=OFF;
SET GLOBAL rapid_resource_isolation=SOFT;
SET GLOBAL rapid_change_propagation_mode=COMMITTED_BINLOG;
CREATE TABLE cb_a (id INT PRIMARY KEY,v INT) SECONDARY_ENGINE=rapid;
CREATE TABLE cb_b (id INT PRIMARY KEY,v INT) SECONDARY_ENGINE=rapid;
INSERT INTO cb_a VALUES (1,10);
INSERT INTO cb_b VALUES (1,20);
ALTER TABLE cb_a SECONDARY_LOAD;
ALTER TABLE cb_b SECONDARY_LOAD;
SET DEBUG_SYNC='RESET';
SET GLOBAL debug='+d,rapid_pause_copy_apply_mutation';
BEGIN;
UPDATE cb_a SET v=11 WHERE id=1;
UPDATE cb_b SET v=21 WHERE id=1;
COMMIT;
# Source COMMIT returned while background apply remains suspended.
SET DEBUG_SYNC='now WAIT_FOR rapid_apply_mutation_waiting';
SET GLOBAL debug='-d,rapid_pause_copy_apply_mutation';
INSERT INTO cb_a VALUES (2,12);
SELECT SUM(v) FROM cb_a;
SELECT SUM(v) FROM cb_b;
connect (reader,localhost,root,,test);
SET use_secondary_engine=FORCED;
--send SELECT SUM(cb_a.v),SUM(cb_b.v) FROM cb_a JOIN cb_b ON cb_a.id=cb_b.id
connection default;
SET DEBUG_SYNC='now SIGNAL rapid_apply_mutation_continue';
connection reader;
--reap
disconnect reader;
connection default;
SET DEBUG_SYNC='RESET';
# Accumulate more than two parser batches of cross-table transactions. The
# final query must wait for both tables, even with only one SYNC grant.
SET GLOBAL debug='+d,rapid_committed_reader_stall';
--disable_query_log
let $transactions=600;
while ($transactions)
{
  BEGIN;
  UPDATE cb_a SET v=v+1 WHERE id=1;
  UPDATE cb_b SET v=v+1 WHERE id=1;
  COMMIT;
  dec $transactions;
}
--enable_query_log
SET GLOBAL debug='-d,rapid_committed_reader_stall';
SET use_secondary_engine=FORCED;
SELECT SUM(cb_a.v),SUM(cb_b.v) FROM cb_a JOIN cb_b ON cb_a.id=cb_b.id;
--let $assert_query = SELECT SUM(cb_a.v),SUM(cb_b.v) FROM cb_a JOIN cb_b ON cb_a.id=cb_b.id
--source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
SELECT SUM(v) FROM cb_a;
--let $assert_query = SELECT SUM(v) FROM cb_a
--source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
SET use_secondary_engine=OFF;
ALTER TABLE cb_a SECONDARY_UNLOAD;
ALTER TABLE cb_b SECONDARY_UNLOAD;
DROP TABLE cb_a,cb_b;
SET GLOBAL rapid_change_propagation_mode=CAPTURE;
SET GLOBAL rapid_resource_isolation=OFF;
