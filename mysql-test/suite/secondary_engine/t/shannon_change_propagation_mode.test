SET use_secondary_engine=OFF;
SELECT @@GLOBAL.rapid_change_propagation_mode;
--error ER_WRONG_VALUE_FOR_VAR
SET GLOBAL rapid_change_propagation_mode='INVALID';
SET GLOBAL rapid_change_propagation_mode='COMMITTED_BINLOG';
SELECT @@GLOBAL.rapid_change_propagation_mode;
CREATE TABLE t_propagation_mode (id INT PRIMARY KEY, v INT) SECONDARY_ENGINE=rapid;
INSERT INTO t_propagation_mode VALUES (1,10);
--error ER_SECONDARY_ENGINE_PLUGIN
ALTER TABLE t_propagation_mode SECONDARY_LOAD;
CREATE TABLE t_propagation_part (id INT PRIMARY KEY) SECONDARY_ENGINE=rapid
PARTITION BY HASH(id) PARTITIONS 2;
--error ER_SECONDARY_ENGINE
ALTER TABLE t_propagation_part SECONDARY_LOAD;
DROP TABLE t_propagation_part;
SET GLOBAL rapid_change_propagation_mode='CAPTURE';
ALTER TABLE t_propagation_mode SECONDARY_LOAD;
SET use_secondary_engine=FORCED;
BEGIN;
UPDATE t_propagation_mode SET v=20 WHERE id=1;
SELECT SUM(v) FROM t_propagation_mode;
ROLLBACK;
SELECT SUM(v) FROM t_propagation_mode;
# Changing the default does not change an already loaded CAPTURE backend.
SET GLOBAL rapid_change_propagation_mode='COMMITTED_BINLOG';
BEGIN;
UPDATE t_propagation_mode SET v=30 WHERE id=1;
SELECT SUM(v) FROM t_propagation_mode;
ROLLBACK;
SET GLOBAL rapid_change_propagation_mode='CAPTURE';
SET use_secondary_engine=OFF;
DROP TABLE t_propagation_mode;
