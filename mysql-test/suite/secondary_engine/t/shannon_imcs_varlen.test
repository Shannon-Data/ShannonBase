##############################################################################
# ShannonBase IMCS VarlenDataPool Tests
#
# Tests for VarlenDataPool integration with BLOB / TEXT / GEOMETRY / JSON:
#  - INLINE: small values (< 256B) stored directly in CU data slot
#  - POOL: medium values (256B–4KB) stored in VarlenDataPool blocks
#  - OVERFLOW: large values (> 4KB) stored in external overflow pages
#  - VarlenReference resolution in write → read → update → delete paths
#  - Zero-copy data access via resolve_data() in scan / predicate paths
#  - Interaction with RowDirectory is_overflow flag
##############################################################################

create database sh_imcs_varlen;
use sh_imcs_varlen;
--disable_warnings
SET USE_SECONDARY_ENGINE=FORCED;

--echo ########################################################################
--echo # Test 1: TINYBLOB — inline storage (< 256B)
--echo # Values small enough for INLINE should be stored in the CU slot
--echo ########################################################################

CREATE TABLE t_varlen_tinyblob (
    id INT PRIMARY KEY,
    data TINYBLOB
) SECONDARY_ENGINE=RAPID;

INSERT INTO t_varlen_tinyblob VALUES
(1, 'Hello World'),
(2, REPEAT('A', 100)),    -- 100 bytes, inline
(3, REPEAT('B', 255)),    -- 255 bytes, inline (max TINYBLOB)
(4, ''),                   -- empty string
(5, NULL);

ALTER TABLE t_varlen_tinyblob SECONDARY_LOAD;

SELECT id, LENGTH(data) FROM t_varlen_tinyblob ORDER BY id;
SELECT * FROM t_varlen_tinyblob WHERE data IS NOT NULL ORDER BY id;
SELECT * FROM t_varlen_tinyblob WHERE data IS NULL;
SELECT * FROM t_varlen_tinyblob WHERE data LIKE '%A%' ORDER BY id;
SELECT id, SUBSTRING(data, 1, 10) FROM t_varlen_tinyblob WHERE id = 2;

# UPDATE inline values
UPDATE t_varlen_tinyblob SET data = 'Updated' WHERE id = 1;
--SLEEP 1
SELECT id, data FROM t_varlen_tinyblob WHERE id = 1;
SELECT id, LENGTH(data) FROM t_varlen_tinyblob WHERE id = 1;

# DELETE with inline BLOB
DELETE FROM t_varlen_tinyblob WHERE id = 3;
--SLEEP 1
SELECT COUNT(*) FROM t_varlen_tinyblob;

DROP TABLE t_varlen_tinyblob;

--echo ########################################################################
--echo # Test 2: BLOB — pool storage (256B–4KB)
--echo # Medium BLOB values go through VarlenDataPool::allocate_in_pool()
--echo ########################################################################

CREATE TABLE t_varlen_blob (
    id INT PRIMARY KEY,
    name VARCHAR(50),
    payload BLOB
) SECONDARY_ENGINE=RAPID;

INSERT INTO t_varlen_blob VALUES
(1, 'small', REPEAT('X', 100)),          -- inline
(2, 'medium', REPEAT('Y', 512)),          -- pool (512B)
(3, 'large_medium', REPEAT('Z', 2048)),   -- pool (2KB)
(4, 'near_limit', REPEAT('W', 4000));

ALTER TABLE t_varlen_blob SECONDARY_LOAD;

# Verify data integrity
SELECT id, name, LENGTH(payload) FROM t_varlen_blob ORDER BY id;
SELECT id, name FROM t_varlen_blob WHERE LENGTH(payload) > 500 ORDER BY id;
SELECT id, SUBSTRING(payload, 1, 5), SUBSTRING(payload, -5) FROM t_varlen_blob WHERE id = 3;

# UPDATE pool-stored BLOB
UPDATE t_varlen_blob SET payload = REPEAT('U', 1024) WHERE id = 2;
--SLEEP 1
SELECT id, LENGTH(payload) FROM t_varlen_blob WHERE id = 2;

# UPDATE to NULL (deallocate from pool)
UPDATE t_varlen_blob SET payload = NULL WHERE id = 3;
--SLEEP 1
SELECT id, payload FROM t_varlen_blob WHERE id = 3;

# DELETE pool records
DELETE FROM t_varlen_blob WHERE id = 4;
--SLEEP 1
SELECT COUNT(*) FROM t_varlen_blob;

DROP TABLE t_varlen_blob;

--echo ########################################################################
--echo # Test 3: MEDIUMBLOB / LONGBLOB — large values (pool + overflow)
--echo # Values > POOL_THRESHOLD (4KB) go to overflow pages
--echo ########################################################################

CREATE TABLE t_varlen_large (
    id INT PRIMARY KEY,
    descr VARCHAR(100),
    data MEDIUMBLOB
) SECONDARY_ENGINE=RAPID;

INSERT INTO t_varlen_large VALUES
(1, '5KB blob', REPEAT('A', 5120)),          -- overflow
(2, '10KB blob', REPEAT('B', 10240)),         -- overflow
(3, '50KB blob', REPEAT('C', 51200)),         -- overflow
(4, '100KB blob', REPEAT('D', 102400));

ALTER TABLE t_varlen_large SECONDARY_LOAD;

# Verify data integrity for large BLOBs
SELECT id, descr, LENGTH(data) FROM t_varlen_large ORDER BY id;
SELECT id, SUBSTRING(data, 1, 10), SUBSTRING(data, -10) FROM t_varlen_large WHERE id = 3;

# Predicate on large BLOB metadata
SELECT id, descr FROM t_varlen_large WHERE LENGTH(data) > 10000 ORDER BY id;

# UPDATE large BLOB (deallocate old overflow + allocate new)
UPDATE t_varlen_large SET data = REPEAT('U', 8192) WHERE id = 1;
--SLEEP 1
SELECT id, LENGTH(data), SUBSTRING(data, 1, 5) FROM t_varlen_large WHERE id = 1;

# UPDATE to smaller (might change from overflow to pool or inline)
UPDATE t_varlen_large SET data = REPEAT('S', 200) WHERE id = 2;
--SLEEP 1
SELECT id, LENGTH(data) FROM t_varlen_large WHERE id = 2;

# DELETE large overflow records
DELETE FROM t_varlen_large WHERE id = 4;
--SLEEP 1
SELECT COUNT(*) FROM t_varlen_large;

DROP TABLE t_varlen_large;

--echo ########################################################################
--echo # Test 4: TEXT types through VarlenDataPool
--echo ########################################################################

CREATE TABLE t_varlen_text (
    id INT PRIMARY KEY,
    title VARCHAR(100),
    body TEXT,
    summary MEDIUMTEXT
) SECONDARY_ENGINE=RAPID;

INSERT INTO t_varlen_text VALUES
(1, 'Short', 'Short body', 'Short summary'),
(2, 'Medium', REPEAT('body text ', 50), REPEAT('summary text ', 100)),
(3, 'Large', REPEAT('BODY TEXT ', 500), REPEAT('SUMMARY TEXT ', 2000));

ALTER TABLE t_varlen_text SECONDARY_LOAD;

SELECT id, title, LENGTH(body), LENGTH(summary) FROM t_varlen_text ORDER BY id;

# LIKE predicate on TEXT columns
SELECT id, title FROM t_varlen_text WHERE body LIKE '%body%' ORDER BY id;
SELECT id, title FROM t_varlen_text WHERE summary LIKE '%SUMMARY%' ORDER BY id;

# UPDATE TEXT
UPDATE t_varlen_text SET body = CONCAT(body, ' APPENDED') WHERE id = 1;
--SLEEP 1
SELECT id, LENGTH(body), SUBSTRING(body, -10) FROM t_varlen_text WHERE id = 1;

DROP TABLE t_varlen_text;

--echo ########################################################################
--echo # Test 5: GEOMETRY type through VarlenDataPool
--echo ########################################################################

CREATE TABLE t_varlen_geom (
    id INT PRIMARY KEY,
    name VARCHAR(50),
    geo GEOMETRY
) SECONDARY_ENGINE=RAPID;

INSERT INTO t_varlen_geom VALUES
(1, 'point', ST_GeomFromText('POINT(10 20)')),
(2, 'linestring', ST_GeomFromText('LINESTRING(0 0, 10 10, 20 25)')),
(3, 'polygon', ST_GeomFromText('POLYGON((0 0, 10 0, 10 10, 0 10, 0 0))'));

ALTER TABLE t_varlen_geom SECONDARY_LOAD;

SELECT id, name, ST_AsText(geo) FROM t_varlen_geom ORDER BY id;
SELECT id, name FROM t_varlen_geom WHERE ST_Contains(geo, ST_GeomFromText('POINT(10 20)'));
SELECT id, name FROM t_varlen_geom WHERE ST_Within(ST_GeomFromText('POINT(5 5)'), geo);

# UPDATE geometry
UPDATE t_varlen_geom SET geo = ST_GeomFromText('POINT(30 40)') WHERE id = 1;
--SLEEP 1
SELECT id, name, ST_AsText(geo) FROM t_varlen_geom WHERE id = 1;

DROP TABLE t_varlen_geom;

--echo ########################################################################
--echo # Test 6: JSON type through VarlenDataPool
--echo ########################################################################

CREATE TABLE t_varlen_json (
    id INT PRIMARY KEY,
    doc JSON
) SECONDARY_ENGINE=RAPID;

INSERT INTO t_varlen_json VALUES
(1, '{"name": "Alice", "age": 30}'),
(2, '{"name": "Bob", "age": 25, "city": "NYC"}'),
(3, JSON_OBJECT('name', 'Charlie', 'items', JSON_ARRAY('a', 'b', 'c', 'd', 'e')));

ALTER TABLE t_varlen_json SECONDARY_LOAD;

SELECT id, doc FROM t_varlen_json ORDER BY id;
SELECT id, JSON_EXTRACT(doc, '$.name') FROM t_varlen_json ORDER BY id;
SELECT id, JSON_EXTRACT(doc, '$.age') FROM t_varlen_json WHERE JSON_EXTRACT(doc, '$.age') > 20;

# UPDATE JSON
UPDATE t_varlen_json SET doc = JSON_SET(doc, '$.age', 31) WHERE id = 1;
--SLEEP 1
SELECT id, doc FROM t_varlen_json WHERE id = 1;

DROP TABLE t_varlen_json;

--echo ########################################################################
--echo # Test 7: Mixed DML on BLOB columns
--echo # Verifies VarlenDataPool allocate/deallocate cycle correctness
--echo ########################################################################

CREATE TABLE t_varlen_dml (
    id INT PRIMARY KEY,
    label VARCHAR(50),
    content BLOB
) SECONDARY_ENGINE=RAPID;

INSERT INTO t_varlen_dml VALUES
(1, 'a', REPEAT('1', 300)),
(2, 'b', REPEAT('2', 1000)),
(3, 'c', REPEAT('3', 5000));

ALTER TABLE t_varlen_dml SECONDARY_LOAD;

# Mixed operations
INSERT INTO t_varlen_dml VALUES (4, 'd', REPEAT('4', 2000));
UPDATE t_varlen_dml SET content = REPEAT('X', 6000) WHERE id = 2;
DELETE FROM t_varlen_dml WHERE id = 1;
INSERT INTO t_varlen_dml VALUES (5, 'e', REPEAT('5', 800));

--SLEEP 1
SELECT id, label, LENGTH(content) FROM t_varlen_dml ORDER BY id;

# Repeated updates on same row (allocate → deallocate → allocate cycle)
UPDATE t_varlen_dml SET content = REPEAT('V1', 500) WHERE id = 3;
UPDATE t_varlen_dml SET content = REPEAT('V2', 2000) WHERE id = 3;
UPDATE t_varlen_dml SET content = REPEAT('V3', 10000) WHERE id = 3;
--SLEEP 1
SELECT id, LENGTH(content), SUBSTRING(content, 1, 4) FROM t_varlen_dml WHERE id = 3;

DROP TABLE t_varlen_dml;

--enable_warnings
DROP DATABASE sh_imcs_varlen;
