# Exercise a real SIGABRT in a dedicated MTR server, with core dumps disabled.
--source include/linux.inc
--source suite/secondary_engine/include/storage_layer_baseline.inc
CALL mtr.add_suppression("Attempting backtrace. You can use the following information to find out");
BEGIN;
INSERT INTO t VALUES (4,40);
UPDATE t SET v=11 WHERE id=1;
COMMIT;
BEGIN;
INSERT INTO t VALUES (5,50);
UPDATE t SET v=999 WHERE id=3;
--let $recovery_pid_file = `SELECT @@pid_file`
--let RECOVERY_PIDFILE = $recovery_pid_file
--source include/expect_crash.inc
--perl
open(my $fh, '<', $ENV{'RECOVERY_PIDFILE'}) or die "Cannot open test server pid file: $!";
my $pid = <$fh>;
close($fh);
chomp($pid);
die 'Invalid test server pid' unless $pid =~ /^\d+$/ && $pid > 1;
open(my $cmd, '<', "/proc/$pid/cmdline") or die "Cannot inspect test server: $!";
local $/;
my $command = <$cmd>;
die 'Refusing to signal a server outside this MTR instance' unless index($command, $ENV{'MYSQLTEST_VARDIR'}) >= 0;
kill('ABRT', $pid) == 1 or die "Cannot signal test server: $!";
EOF
--source include/wait_until_disconnected.inc
--let $restart_parameters = restart: --rapid_reload_on_restart=ON --skip-core-file
--source include/start_mysqld.inc
USE sh_storage_recovery;
--let $wait_condition = SELECT CAST(VARIABLE_VALUE AS UNSIGNED)=1 FROM performance_schema.global_status WHERE VARIABLE_NAME='rapid_recovery_storage_restores'
--source include/wait_condition.inc
--let $restores = `SELECT VARIABLE_VALUE FROM performance_schema.global_status WHERE VARIABLE_NAME='rapid_recovery_storage_restores'`
if ($restores != 1) {
 --die Abnormal crash must recover the certified native checkpoint
}
SET use_secondary_engine=FORCED;
SELECT id,v FROM t ORDER BY id;
--let $actual = `SELECT GROUP_CONCAT(CONCAT(id,':',v) ORDER BY id) FROM t`
if ($actual != 1:11,2:20,3:30,4:40) {
 --die Crash recovery must retain committed rows and exclude uncommitted changes
}
--let $assert_digest = SELECT GROUP_CONCAT(CONCAT(id,':',v) ORDER BY id) FROM t
--source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
DROP DATABASE sh_storage_recovery;
