--let $shannon_storage_layer_case = baseline
--source suite/secondary_engine/include/shannon_storage_layer.inc
# Source DDL is rejected while SECONDARY_ENGINE is defined. The unchanged
# schema must remain recoverable from the original native checkpoint.
--error ER_SECONDARY_ENGINE_DDL
ALTER TABLE t ADD COLUMN extra INT DEFAULT 7;
UPDATE t SET v=11 WHERE id=1;
# Recovery is expected to restore from the native storage image.
--let $storage_expected = 1:11,2:20,3:30
--let $shannon_storage_layer_case = verify
--source suite/secondary_engine/include/shannon_storage_layer.inc
