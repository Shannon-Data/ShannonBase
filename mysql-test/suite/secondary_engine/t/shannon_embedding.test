# Tests for the SECONDARY_ENGINE table option.
# Most DDLs are allowed on tables with SECONDARY_ENGINE when
# the corresponding SECONDARY_ENGINE plugin is not installed.
# Following tests are with SECONDARY_ENGINE plugin that doesn't exist.

# USED FOR embedding.
create database sh_embedding;
use sh_embedding;
--disable_warnings

SELECT DISTANCE(STRING_TO_VECTOR("[1.01231, 2.0123123, 3.0123123, 4.01231231]"), STRING_TO_VECTOR("[1, 2, 3, 4]"), "COSINE");

SELECT DISTANCE(STRING_TO_VECTOR("[1.01231, 2.0123123, 3.0123123, 4.01231231]"), STRING_TO_VECTOR("[1, 2, 3, 4]"), "DOT");

SELECT DISTANCE(STRING_TO_VECTOR("[1.01231, 2.0123123, 3.0123123, 4.01231231]"), STRING_TO_VECTOR("[1, 2, 3, 4]"), "EUCLIDEAN");

SELECT DISTANCE(STRING_TO_VECTOR("[1.01231, 2.0123123, 3.0123123, 4.01231231]"), STRING_TO_VECTOR("[1, 2, 3, 4]"), "L2");

SELECT DISTANCE(STRING_TO_VECTOR("[1.01231, 2.0123123, 3.0123123, 4.01231231]"), STRING_TO_VECTOR("[1, 2, 3, 4]"), "MANHATTAN");

SELECT DISTANCE(STRING_TO_VECTOR("[1.01231, 2.0123123, 3.0123123, 4.01231231]"), STRING_TO_VECTOR("[1, 2, 3, 4]"), "l1");

--error ER_WRONG_ARGUMENTS
SELECT DISTANCE(STRING_TO_VECTOR("[1, 2, 3, 4]"), STRING_TO_VECTOR("[1, 2, 3, 4]"), "HAMMING");

--error ER_WRONG_ARGUMENTS
SELECT DISTANCE(STRING_TO_VECTOR("[1, 2]"), STRING_TO_VECTOR("[1, 2, 3]"), "L1");

# Mixed-sign components.
#
# Every case above compares [1.01231, ...] with [1, 2, 3, 4], where the first
# vector is larger in every component. All the per-component differences are
# therefore positive, the fabs() in calculate_manhattan_distance() is a no-op,
# and an implementation that summed the signed differences instead would
# produce exactly the same numbers and pass. fabs() is the whole of what makes
# L1 a distance, so it needs a pair that can tell the two apart.
#
# Differences here are +2, -4, +6, -8:
#   MANHATTAN/L1  |2|+|-4|+|6|+|-8|            = 20   (signed sum would be -4)
#   EUCLIDEAN/L2  sqrt(4+16+36+64) = sqrt(120)
#   COSINE        the vectors are exact opposites, so similarity -1, distance 2
#   DOT           -(-30) = 30
# All four inputs are exactly representable in float32, so these are exact.
SELECT DISTANCE(STRING_TO_VECTOR("[1, -2, 3, -4]"), STRING_TO_VECTOR("[-1, 2, -3, 4]"), "MANHATTAN");

SELECT DISTANCE(STRING_TO_VECTOR("[1, -2, 3, -4]"), STRING_TO_VECTOR("[-1, 2, -3, 4]"), "L1");

SELECT DISTANCE(STRING_TO_VECTOR("[1, -2, 3, -4]"), STRING_TO_VECTOR("[-1, 2, -3, 4]"), "EUCLIDEAN");

SELECT DISTANCE(STRING_TO_VECTOR("[1, -2, 3, -4]"), STRING_TO_VECTOR("[-1, 2, -3, 4]"), "COSINE");

SELECT DISTANCE(STRING_TO_VECTOR("[1, -2, 3, -4]"), STRING_TO_VECTOR("[-1, 2, -3, 4]"), "DOT");

# Identical vectors: the metrics that are distances must be exactly zero, and
# cosine must not drift off zero through the norm division.
SELECT DISTANCE(STRING_TO_VECTOR("[1, 2, 3, 4]"), STRING_TO_VECTOR("[1, 2, 3, 4]"), "L1");

SELECT DISTANCE(STRING_TO_VECTOR("[1, 2, 3, 4]"), STRING_TO_VECTOR("[1, 2, 3, 4]"), "L2");

SELECT DISTANCE(STRING_TO_VECTOR("[1, 2, 3, 4]"), STRING_TO_VECTOR("[1, 2, 3, 4]"), "COSINE");

# Zero vector. Cosine is undefined here -- the norm product is 0 -- so
# calculate_cosine_distance() returns the maximum distance 1.0 rather than
# dividing. Nothing exercised that branch before. L1 and L2 have no such
# special case and just measure against the origin.
SELECT DISTANCE(STRING_TO_VECTOR("[0, 0, 0, 0]"), STRING_TO_VECTOR("[1, 2, 3, 4]"), "COSINE");

SELECT DISTANCE(STRING_TO_VECTOR("[1, 2, 3, 4]"), STRING_TO_VECTOR("[0, 0, 0, 0]"), "COSINE");

SELECT DISTANCE(STRING_TO_VECTOR("[0, 0, 0, 0]"), STRING_TO_VECTOR("[0, 0, 0, 0]"), "COSINE");

SELECT DISTANCE(STRING_TO_VECTOR("[0, 0, 0, 0]"), STRING_TO_VECTOR("[1, 2, 3, 4]"), "L1");

SELECT DISTANCE(STRING_TO_VECTOR("[0, 0, 0, 0]"), STRING_TO_VECTOR("[1, 2, 3, 4]"), "L2");

SELECT ML_MODEL_LIST();

--ERROR 6141
SELECT sys.ml_embed_row("What is artificial intelligence?", JSON_OBJECT("model_id", "all_minilm_l12_v2"));

--replace_column 1 IGNORE
SELECT sys.ml_embed_row("What is artificial intelligence?", JSON_OBJECT("model_id", "multilingual-e5-small"));

--replace_column 1 IGNORE
SELECT VECTOR_TO_STRING(sys.ml_embed_row("What is artificial intelligence?", JSON_OBJECT("model_id", "multilingual-e5-small")));

SELECT LENGTH(sys.ML_EMBED_ROW(REPEAT('测试超长文本',2000), JSON_OBJECT('model_id','multilingual-e5-small','truncate',true)));

--ERROR 6141
SELECT LENGTH(sys.ML_EMBED_ROW(REPEAT('测试超长文本',2000), JSON_OBJECT('model_id','multilingual-e5-small','truncate',false)));

CREATE TABLE tt (score int, name char(10), id int primary key, gender char(1));
INSERT INTO tt values(1, 'n1', 1, 'm'), (2, 'n2', 2, 'f'), (3, 'n3', 3, 'm');
CALL sys.ML_EMBED_TABLE("sh_embedding.tt.name", "sh_embedding.tt.embed_vect", JSON_OBJECT("model_id", "multilingual-e5-small"));

#duplicate column: Duplicate column name 'embed_vect
--ERROR 1060 
CALL sys.ML_EMBED_TABLE("sh_embedding.tt.name", "test.tt.embed_vect", JSON_OBJECT("model_id", "aall-MiniLM-L12-v2"));

#wrong source table: Input table does not exist
--ERROR 1644 
CALL sys.ML_EMBED_TABLE("test.tt.name", "test.tt.embed_vect", JSON_OBJECT("model_id", "aall-MiniLM-L12-v2"));

# wrong option format: model_id is required in options
--ERROR 1644
CALL sys.ML_EMBED_TABLE("test.tt.name", "test.tt.embed_vect", JSON_OBJECT("odel_id", "all-MiniLM-L12-v2"));

# wrong model name: ML operation failed. can not find the model:aall-MiniLM-L12-v2.
--ERROR 1644
CALL sys.ML_EMBED_TABLE("test.tt.name", "test.tt.embed_vect1", JSON_OBJECT("model_id", "aall-MiniLM-L12-v2"));

SELECT score, name, id, gender FROM tt order by id;
SHOW CREATE TABLE tt;

--enable_warnings
DROP DATABASE sh_embedding;
