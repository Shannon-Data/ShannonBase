--source include/have_debug.inc
--source include/no_ps_protocol.inc
# The deliberately unconfirmed transaction can be rejected by in-flight propagation.
--disable_query_log
CALL mtr.add_suppression('Rapid propagation (retry [1-3]/3 for|quarantined) table .*sh_deferred_stop.t to imcs failed');
--enable_query_log
CREATE DATABASE sh_deferred_stop;
USE sh_deferred_stop;
CREATE TABLE t(id INT PRIMARY KEY, v INT) SECONDARY_ENGINE=rapid;
INSERT INTO t VALUES(1,10);
ALTER TABLE t SECONDARY_LOAD;
--let $restart_parameters = restart: --rapid_reload_on_restart=ON
--source include/restart_mysqld.inc
USE sh_deferred_stop;
--let $wait_condition = SELECT COUNT(*)=1 FROM performance_schema.rpd_table_id WHERE SCHEMA_NAME='sh_deferred_stop' AND TABLE_NAME='t'
--source include/wait_condition.inc
--let $datadir = `SELECT @@datadir`
--let $manifest = $datadir/rapid_snapshots/sh_deferred_stop/t/checkpoints/checkpoint-1.manifest
--file_exists $manifest 60
SET GLOBAL rapid_lazy_commit_marker=ON;
SET GLOBAL innodb_flush_log_at_trx_commit=2;
# Simulate an outstanding source durability watermark and stop the actual worker.
SET debug='+d,rapid_deferred_unflushed_lsn,rapid_deferred_stop_after_enqueue';
INSERT INTO t VALUES(2,20);
SET debug='-d,rapid_deferred_unflushed_lsn,rapid_deferred_stop_after_enqueue';
SET GLOBAL innodb_flush_log_at_trx_commit=1;
FLUSH ENGINE LOGS;
--let $restart_parameters = restart: --rapid_reload_on_restart=ON
--source include/kill_and_restart_mysqld.inc
USE sh_deferred_stop;
--let $wait_condition = SELECT COUNT(*)=1 FROM performance_schema.rpd_table_id WHERE SCHEMA_NAME='sh_deferred_stop' AND TABLE_NAME='t'
--source include/wait_condition.inc
--let $wait_condition = SELECT CAST(VARIABLE_VALUE AS UNSIGNED)=1 FROM performance_schema.global_status WHERE VARIABLE_NAME='rapid_recovery_primary_reloads'
--source include/wait_condition.inc
SELECT VARIABLE_VALUE FROM performance_schema.global_status WHERE VARIABLE_NAME='rapid_recovery_primary_reloads';
--let $assert_digest = SELECT GROUP_CONCAT(CONCAT(id,':',v) ORDER BY id) FROM t
--source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
SET use_secondary_engine=OFF;
SELECT * FROM t ORDER BY id;
DROP DATABASE sh_deferred_stop;
