# A requested FULL policy without a validator must not publish AP or silently
# rebuild from TP. The default FAST policy is covered by storage_layer_binlog.
--let $shannon_storage_layer_case = baseline
--source suite/secondary_engine/include/shannon_storage_layer.inc
--let $storage_restart_debug = --debug=d,rapid_recovery_full_validation_unavailable
--let $storage_expected = 1:10,2:20,3:30
--let $shannon_storage_layer_case = manual_load
--source suite/secondary_engine/include/shannon_storage_layer.inc
