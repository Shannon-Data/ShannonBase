--source include/have_debug.inc
--source include/no_ps_protocol.inc
CALL mtr.add_suppression('Rapid could not reschedule table .*; reload required');
SET use_secondary_engine=OFF;
SET GLOBAL rapid_resource_isolation=AUTO;
CREATE DATABASE ri_pool_fail;
USE ri_pool_fail;
CREATE TABLE t(id INT PRIMARY KEY,v INT) SECONDARY_ENGINE=rapid;
INSERT INTO t WITH RECURSIVE seq(n) AS
 (SELECT 1 UNION ALL SELECT n+1 FROM seq WHERE n<400) SELECT n,0 FROM seq;
SET GLOBAL debug='+d,secondary_engine_rapid_propagation_stall,rapid_apply_pool_schedule_oom';
ALTER TABLE t SECONDARY_LOAD;
# The source update must complete despite a later background scheduling failure.
UPDATE t SET v=1;
let $wait_condition= SELECT COUNT(*)=1 FROM performance_schema.rpd_tables t JOIN performance_schema.rpd_table_id i ON t.ID=i.ID WHERE i.SCHEMA_NAME='ri_pool_fail' AND i.NAME='ri_pool_fail.t' AND t.STALE_REASON='RELOAD_REQUIRED';
--source include/wait_condition.inc
SET GLOBAL debug='-d,secondary_engine_rapid_propagation_stall,rapid_apply_pool_schedule_oom';
SELECT COUNT(*),SUM(v) FROM t;
SET use_secondary_engine=FORCED;
--error ER_SECONDARY_ENGINE
SELECT SUM(v) FROM t;
SET use_secondary_engine=OFF;
ALTER TABLE t SECONDARY_UNLOAD;
ALTER TABLE t SECONDARY_LOAD;
SET use_secondary_engine=FORCED;
SELECT COUNT(*),SUM(v) FROM t;
--let $assert_query = SELECT COUNT(*),SUM(v) FROM t
--source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
SET use_secondary_engine=OFF;
ALTER TABLE t SECONDARY_UNLOAD;
DROP DATABASE ri_pool_fail;
SET GLOBAL rapid_resource_isolation=OFF;
