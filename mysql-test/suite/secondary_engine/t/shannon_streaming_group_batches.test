# Many tiny groups must not copy the unread batch tail once per group.
# Also exercise one group spanning batches, NULLs, the last singleton and LIMIT.
--disable_warnings
SET use_secondary_engine=OFF;
CREATE TABLE stream_seq (i INT PRIMARY KEY);
INSERT INTO stream_seq WITH RECURSIVE n AS
 (SELECT 0 i UNION ALL SELECT i+1 FROM n WHERE i<255) SELECT i FROM n;
CREATE TABLE stream_groups (
 g INT NOT NULL, id INT NOT NULL, v DECIMAL(15,2), f DOUBLE,
 PRIMARY KEY(g,id)
) SECONDARY_ENGINE=rapid;
INSERT INTO stream_groups
 SELECT 1+a.i*256+b.i,c.i,
 IF(MOD(a.i,7)=0,NULL,(b.i-c.i)*1.25),IF(MOD(a.i,11)=0,NULL,b.i*0.1-c.i)
 FROM stream_seq a JOIN stream_seq b JOIN stream_seq c ON c.i<1+MOD(a.i+b.i,5);
INSERT INTO stream_groups SELECT 0,a.i*256+b.i,b.i*1.25,b.i*0.1
 FROM stream_seq a JOIN stream_seq b ON b.i<32;
INSERT INTO stream_groups VALUES (70000,0,NULL,NULL);
ALTER TABLE stream_groups SECONDARY_LOAD;
SET optimizer_switch='hypergraph_optimizer=on';
SET use_secondary_engine=FORCED;
--enable_warnings
--source include/elide_costs.inc
--replace_regex $elide_costs_and_rows
EXPLAIN FORMAT=TREE SELECT g,SUM(v),AVG(v),COUNT(v),MIN(v),MAX(v) FROM stream_groups GROUP BY g;
--let $assert_query = SELECT g,SUM(v),AVG(v),COUNT(v),MIN(v),MAX(v),SUM(f),AVG(f) FROM stream_groups GROUP BY g
--source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
--let $assert_query = SELECT g,SUM(v),COUNT(*) FROM stream_groups GROUP BY g ORDER BY g LIMIT 100
--let $assert_ordered = 1
--source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
--let $assert_query = SELECT g,SUM(v),COUNT(*) FROM stream_groups GROUP BY g HAVING SUM(v) IS NULL
--source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
# Re-execution after an early LIMIT must discard any retained batch tail.
PREPARE stream_stmt FROM 'SELECT g,SUM(v),COUNT(*) FROM stream_groups GROUP BY g ORDER BY g LIMIT 3';
EXECUTE stream_stmt;
EXECUTE stream_stmt;
DEALLOCATE PREPARE stream_stmt;
SET use_secondary_engine=OFF;
DROP TABLE stream_groups,stream_seq;
