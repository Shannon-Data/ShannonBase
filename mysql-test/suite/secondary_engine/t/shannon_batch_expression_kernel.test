# Column kernels must execute under normal cost selection and preserve SQL semantics.
--source include/have_debug.inc
CREATE DATABASE rapid_expression_kernel;
USE rapid_expression_kernel;
SET use_secondary_engine=OFF;
CREATE TABLE fact (id INT PRIMARY KEY, g INT, n BIGINT, d DECIMAL(15,2), s VARCHAR(16)) SECONDARY_ENGINE=rapid;
CREATE TABLE dim (id INT PRIMARY KEY, g INT, d DECIMAL(15,2), s VARCHAR(16)) SECONDARY_ENGINE=rapid;
INSERT INTO fact WITH RECURSIVE seq AS
 (SELECT 1 n UNION ALL SELECT n+1 FROM seq WHERE n<1000)
 SELECT n,MOD(n,17)+1,IF(MOD(n,7)=0,NULL,n-500),IF(MOD(n,11)=0,NULL,(n-500)*1.25),
        IF(MOD(n,13)=0,NULL,CONCAT('v',MOD(n,5))) FROM seq;
INSERT INTO dim SELECT id,id,id*0.01,IF(MOD(id,5)=0,NULL,CONCAT('d',MOD(id,3))) FROM fact WHERE id<=17;
ANALYZE TABLE fact,dim;
ALTER TABLE fact SECONDARY_LOAD;
ALTER TABLE dim SECONDARY_LOAD;
SET use_secondary_engine=FORCED;
--disable_warnings
SET optimizer_switch='hypergraph_optimizer=on';
--enable_warnings
SET SESSION debug='+d,rapid_require_batch_expression';

--echo # Global arithmetic aggregation uses kernels after its first row.
--let $before = query_get_value(SHOW GLOBAL STATUS LIKE 'rapid_query_vectorized_expression_rows_total', Value, 1)
--let $scalar_before = query_get_value(SHOW GLOBAL STATUS LIKE 'rapid_query_scalar_expression_rows_total', Value, 1)
--let $assert_query = SELECT SUM(d*(1-d)),AVG(d*2),COUNT(n*2),SUM(-n) FROM fact
--source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
--let $after = query_get_value(SHOW GLOBAL STATUS LIKE 'rapid_query_vectorized_expression_rows_total', Value, 1)
--let $scalar_after = query_get_value(SHOW GLOBAL STATUS LIKE 'rapid_query_scalar_expression_rows_total', Value, 1)
--let $kernels_used = `SELECT $after-$before=3996 AND $scalar_after-$scalar_before=4`
if ($kernels_used == 0) {
  --die Global arithmetic aggregate did not use column kernels
}

--echo # Grouped expressions and dictionary payloads cross a hash join.
--let $before = query_get_value(SHOW GLOBAL STATUS LIKE 'rapid_query_vectorized_expression_rows_total', Value, 1)
--let $assert_query = SELECT dim.s,SUM(fact.d*(1-dim.d)),AVG(fact.n*dim.d),COUNT(fact.s) FROM fact JOIN dim ON fact.g=dim.g GROUP BY dim.s
--source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
--let $after = query_get_value(SHOW GLOBAL STATUS LIKE 'rapid_query_vectorized_expression_rows_total', Value, 1)
--let $kernels_used = `SELECT $after>$before`
if ($kernels_used == 0) {
  --die Joined string payloads interrupted expression batches
}

--echo # Group boundaries, NULLs, decimal residuals and prepared reexecution.
--let $assert_query = SELECT g,SUM(d*n),COUNT(d*n) FROM fact WHERE d>n GROUP BY g ORDER BY g
--let $assert_ordered = 1
--source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
--let $assert_query = SELECT SUM(d*2),AVG(n*2),COUNT(n*2) FROM fact WHERE n IS NULL
--source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
--let $assert_query = SELECT SUM(d*2),COUNT(n*2) FROM fact WHERE id<0
--source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
PREPARE stmt FROM 'SELECT SUM(d*(1-d)),AVG(n*2) FROM fact';
EXECUTE stmt;
EXECUTE stmt;
DEALLOCATE PREPARE stmt;

--echo # Default EQ_REF batching follows the selected parent NLJ decision.
SET optimizer_switch='hypergraph_optimizer=off';
SET SESSION debug='+d,rapid_require_batch_lookup';
--let $before = query_get_value(SHOW GLOBAL STATUS LIKE 'rapid_query_vectorized_ref_batch_rows_total', Value, 1)
--let $assert_query = SELECT COUNT(*),SUM(fact.d*dim.d),COUNT(dim.s) FROM fact STRAIGHT_JOIN dim FORCE INDEX(PRIMARY) ON dim.id=fact.g
--source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
--let $after = query_get_value(SHOW GLOBAL STATUS LIKE 'rapid_query_vectorized_ref_batch_rows_total', Value, 1)
--let $lookup_used = `SELECT $after-$before=1000`
if ($lookup_used == 0) {
  --die Selected NLJ did not batch its single-row EQ_REF probes
}
SET SESSION debug='-d,rapid_require_batch_lookup,rapid_require_batch_expression';

--echo # Wide decimals and integer overflow retain MySQL fallback semantics.
SET use_secondary_engine=OFF;
CREATE TABLE wide (id INT PRIMARY KEY, a DECIMAL(65,0), b BIGINT) SECONDARY_ENGINE=rapid;
INSERT INTO wide VALUES (1,1,1),(2,12345678901234567890123456789012345678901234567890,9223372036854775807),(3,-1,-1);
ALTER TABLE wide SECONDARY_LOAD;
SET use_secondary_engine=FORCED;
--let $assert_query = SELECT SUM(a+1),AVG(a*2) FROM wide
--source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
--error ER_DATA_OUT_OF_RANGE
SELECT SUM(b*2) FROM wide;
SET use_secondary_engine=OFF;
--error ER_DATA_OUT_OF_RANGE
SELECT SUM(b*2) FROM wide;
DROP DATABASE rapid_expression_kernel;
