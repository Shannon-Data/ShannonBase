--source include/have_debug.inc
--source include/no_ps_protocol.inc
CALL mtr.add_suppression('Rapid transaction callback failed; affected loaded tables require reload');
CALL mtr.add_suppression('Rapid immediate COPY_INFO quarantined 1 table.*transaction callback failed');
CREATE DATABASE sh_transaction_exception;
USE sh_transaction_exception;
CREATE TABLE t (id INT PRIMARY KEY, v INT) SECONDARY_ENGINE=rapid;
INSERT INTO t VALUES (1,10);
ALTER TABLE t SECONDARY_LOAD;
# The after-commit callback cannot report a SQL error: the source COMMIT is
# already durable, so the committed row must survive while the tables are
# quarantined and Rapid stops serving the unpublished transaction.
SET debug='+d,rapid_transaction_commit_bad_alloc';
INSERT INTO t VALUES (2,20);
SET debug='-d,rapid_transaction_commit_bad_alloc';
SET use_secondary_engine=FORCED;
--error ER_SECONDARY_ENGINE
SELECT COUNT(*) FROM t;
SET use_secondary_engine=OFF;
SELECT * FROM t ORDER BY id;
ALTER TABLE t SECONDARY_UNLOAD;
ALTER TABLE t SECONDARY_LOAD;
--let $assert_digest = SELECT GROUP_CONCAT(CONCAT(id,':',v) ORDER BY id) FROM t
--source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
# Also fail after the durable source COMMIT record, before MVCC publication.
SET debug='+d,rapid_transaction_publish_bad_alloc';
UPDATE t SET v=30 WHERE id=1;
SET debug='-d,rapid_transaction_publish_bad_alloc';
SET use_secondary_engine=FORCED;
--error ER_SECONDARY_ENGINE
SELECT COUNT(*) FROM t;
SET use_secondary_engine=OFF;
SELECT * FROM t ORDER BY id;
ALTER TABLE t SECONDARY_UNLOAD;
ALTER TABLE t SECONDARY_LOAD;
--let $assert_digest = SELECT GROUP_CONCAT(CONCAT(id,':',v) ORDER BY id) FROM t
--source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
BEGIN;
UPDATE t SET v=99 WHERE id=1;
SET debug='+d,rapid_transaction_rollback_bad_alloc';
ROLLBACK;
SET debug='-d,rapid_transaction_rollback_bad_alloc';
SET use_secondary_engine=FORCED;
--error ER_SECONDARY_ENGINE
SELECT COUNT(*) FROM t;
SET use_secondary_engine=OFF;
SELECT * FROM t ORDER BY id;
ALTER TABLE t SECONDARY_UNLOAD;
ALTER TABLE t SECONDARY_LOAD;
--let $assert_digest = SELECT GROUP_CONCAT(CONCAT(id,':',v) ORDER BY id) FROM t
--source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
# The IMCU-list allocation is handled at finalization, without an observer catch.
SET debug='+d,rapid_transaction_finalize_bad_alloc';
INSERT INTO t VALUES (3,30);
SET debug='-d,rapid_transaction_finalize_bad_alloc';
SET use_secondary_engine=FORCED;
--error ER_SECONDARY_ENGINE
SELECT COUNT(*) FROM t;
SET use_secondary_engine=OFF;
SELECT * FROM t ORDER BY id;
ALTER TABLE t SECONDARY_UNLOAD;
ALTER TABLE t SECONDARY_LOAD;
--let $assert_digest = SELECT GROUP_CONCAT(CONCAT(id,':',v) ORDER BY id) FROM t
--source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
DROP DATABASE sh_transaction_exception;
