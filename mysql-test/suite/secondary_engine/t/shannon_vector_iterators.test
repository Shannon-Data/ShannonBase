# Tests for the SECONDARY_ENGINE table option.
# Most DDLs are allowed on tables with SECONDARY_ENGINE when
# the corresponding SECONDARY_ENGINE plugin is not installed.
# Following tests are with SECONDARY_ENGINE plugin that doesn't exist.

--source include/elide_costs.inc

create database sh_vector_iterators;
use sh_vector_iterators;
--disable_warnings

CREATE TABLE customers (
    customer_id INT PRIMARY KEY AUTO_INCREMENT,
    customer_name VARCHAR(100),
    email VARCHAR(100),
    registration_date DATE,
    country VARCHAR(50),
    credit_score INT
) SECONDARY_ENGINE=rapid;

CREATE TABLE orders (
    order_id INT PRIMARY KEY AUTO_INCREMENT,
    customer_id INT,
    order_date DATE,
    total_amount DECIMAL(10,2),
    product_category VARCHAR(50),
    quantity INT,
    FOREIGN KEY (customer_id) REFERENCES customers(customer_id)
) SECONDARY_ENGINE=rapid;

# Insert test data using stored procedures
--disable_query_log
--eval LOAD DATA INFILE '$MYSQLTEST_VARDIR/std_data/vectorized_iterator/customers_data.csv' INTO TABLE customers FIELDS TERMINATED BY ',' ;
--eval LOAD DATA INFILE '$MYSQLTEST_VARDIR/std_data/vectorized_iterator/orders_data.csv' INTO TABLE orders FIELDS TERMINATED BY ',' ;
# innodb_stats_auto_recalc refreshes persistent statistics for these
# freshly-bulk-loaded tables asynchronously in a background thread. Without an
# explicit ANALYZE TABLE here, whether that recalculation has finished by the
# time the cost-based EXPLAINs below run is a timing race: under concurrent
# MTR load the background thread can still be catching up, so a cost-based
# (non-FORCED) join-order/offload decision that's a close tie can pick a
# different candidate than it does on an idle machine. Analyze explicitly so
# the cardinality estimates--and therefore the plan--are deterministic.
--disable_result_log
ANALYZE TABLE customers, orders;
--enable_result_log
--enable_query_log

SELECT COUNT(*) FROM customers;
SELECT COUNT(*) FROM orders;
############### GETS THE RESULT FROM INNODB ###########################
--echo ############### GETS THE RESULT FROM INNODB ###########################
--echo # Baseline. The tables are not SECONDARY_LOADed yet, but say so explicitly
--echo # rather than relying on that: this block is the reference the Rapid runs
--echo # below are checked against, so it must be InnoDB by construction.
SET USE_SECONDARY_ENGINE=OFF;
SELECT 
    c.country,
    COUNT(DISTINCT c.customer_id) as customer_count,
    COUNT(o.order_id) as total_orders,
    SUM(o.quantity) as total_quantity
FROM customers c
JOIN orders o ON c.customer_id = o.customer_id
GROUP BY c.country
ORDER BY total_orders DESC;

--echo # The query the Rapid sections below actually run, computed on InnoDB.
--echo # Without this there is no reference for sum(c.customer_id),
--echo # sum(o.order_id) or sum(o.total_amount) -- the projection above shares
--echo # only country/customer_count/total_orders with it, so the three sums the
--echo # vectorized aggregate produces were never checked against anything.
SELECT 
    c.country,
    COUNT(DISTINCT c.customer_id),
    COUNT(o.order_id) as total_orders,
    sum(c.customer_id),
    sum(o.order_id),
    sum(o.total_amount)
FROM customers c
JOIN orders o ON c.customer_id = o.customer_id  
GROUP BY c.country
ORDER BY total_orders DESC;
SET USE_SECONDARY_ENGINE=DEFAULT;

############### GETS THE RESULT FROM RAPID VIA VECTORIZED  EXECUTION ###########################
--echo ############### GETS THE RESULT FROM RAPID VIA VECTORIZED  EXECUTION ###########################
SET USE_SECONDARY_ENGINE=ON;
SET secondary_engine_cost_threshold=10;
SET GLOBAL rapid_use_dynamic_offload=off;

ALTER TABLE customers SECONDARY_LOAD;
ALTER TABLE orders SECONDARY_LOAD;

SET USE_SECONDARY_ENGINE=FORCED;
SELECT order_id, total_amount, product_category FROM orders order by order_id LIMIT 10;
SELECT customer_id, customer_name, credit_score FROM customers order by customer_id LIMIT 10;
SET USE_SECONDARY_ENGINE=ON;

--echo ############### No.1 Testing Vectorized Count (legacy optimizer) ###########################
--echo # State the planner rather than inheriting it. This block is the legacy
--echo # (greedy) half of the legacy/hypergraph pair below, and if it ever ran
--echo # under hypergraph -- a changed default, a reordered block -- it would
--echo # still pass while testing the same path twice.
SET SESSION optimizer_switch='hypergraph_optimizer=off';

--replace_regex $elide_costs_and_rows
explain format=tree SELECT 
    c.country,
    COUNT(DISTINCT c.customer_id),
    COUNT(o.order_id) as total_orders,
    sum(c.customer_id),
    sum(o.order_id),
    sum(o.total_amount)
FROM customers c
JOIN orders o ON c.customer_id = o.customer_id  
GROUP BY c.country
ORDER BY total_orders DESC;

SELECT 
    c.country,
    COUNT(DISTINCT c.customer_id),
    COUNT(o.order_id) as total_orders,
    sum(c.customer_id),
    sum(o.order_id),
    sum(o.total_amount)
FROM customers c
JOIN orders o ON c.customer_id = o.customer_id  
GROUP BY c.country
ORDER BY total_orders DESC;

--echo ############### No.2 Same query under the hypergraph optimizer ###########################
--echo # The two planners reach Rapid's cost model through different hooks, and
--echo # only the greedy one was covered here. Greedy calls
--echo # compare_secondary_engine_cost() once per complete join order, which walks
--echo # join->positions[] (RpdCostEstimator::cost(const JOIN *)); hypergraph never
--echo # calls it at all and instead prices every AccessPath through
--echo # ModifyAccessPathCost(). A mis-costed Rapid AccessPath could therefore
--echo # reshape this plan -- or stop it being offloaded -- with nothing in this
--echo # file failing. Run the same join both ways and require the same rows.
SET SESSION optimizer_switch='hypergraph_optimizer=on';

--replace_regex $elide_costs_and_rows
explain format=tree SELECT 
    c.country,
    COUNT(DISTINCT c.customer_id),
    COUNT(o.order_id) as total_orders,
    sum(c.customer_id),
    sum(o.order_id),
    sum(o.total_amount)
FROM customers c
JOIN orders o ON c.customer_id = o.customer_id  
GROUP BY c.country
ORDER BY total_orders DESC;

SELECT 
    c.country,
    COUNT(DISTINCT c.customer_id),
    COUNT(o.order_id) as total_orders,
    sum(c.customer_id),
    sum(o.order_id),
    sum(o.total_amount)
FROM customers c
JOIN orders o ON c.customer_id = o.customer_id  
GROUP BY c.country
ORDER BY total_orders DESC;

SET SESSION optimizer_switch='hypergraph_optimizer=default';

SET USE_SECONDARY_ENGINE=ON;
SET secondary_engine_cost_threshold=0;
SET GLOBAL rapid_use_dynamic_offload=off;

#EXPLAIN FORMAT=TREE SELECT COUNT(*) FROM customers;
SELECT COUNT(*) FROM customers;

#--replace_regex $elide_costs_and_rows
#explain SELECT 
#    c.country,
#    COUNT(DISTINCT c.customer_id) as customer_count,
#    COUNT(o.order_id) as total_orders,
#    SUM(o.quantity) as total_quantity
#FROM customers c
#JOIN orders o ON c.customer_id = o.customer_id
#GROUP BY c.country
#ORDER BY total_orders DESC;

SELECT 
    c.country,
    COUNT(DISTINCT c.customer_id),
    COUNT(o.order_id) as total_orders,
    sum(c.customer_id),
    sum(o.order_id),
    sum(o.total_amount)
FROM customers c
JOIN orders o ON c.customer_id = o.customer_id  
GROUP BY c.country
ORDER BY total_orders DESC;

--disable_query_log
SET GLOBAL rapid_use_dynamic_offload=on;
--enable_query_log
--enable_warnings
DROP DATABASE sh_vector_iterators;
