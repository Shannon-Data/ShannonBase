--source include/have_debug_sync.inc
--source include/no_ps_protocol.inc
SET use_secondary_engine=OFF;
SET GLOBAL rapid_change_propagation_mode=COMMITTED_BINLOG;
CREATE TABLE cb_rotate(id INT PRIMARY KEY,v INT) SECONDARY_ENGINE=rapid;
INSERT INTO cb_rotate VALUES(1,10);
ALTER TABLE cb_rotate SECONDARY_LOAD;
INSERT INTO cb_rotate VALUES(2,20);
SET DEBUG_SYNC='now WAIT_FOR rapid_decode_opened';
FLUSH BINARY LOGS;
SET GLOBAL debug='-d,rapid_pause_committed_decode';
SET DEBUG_SYNC='now SIGNAL rapid_decode_continue';
SET use_secondary_engine=FORCED;
SELECT COUNT(*),SUM(v) FROM cb_rotate;
SET use_secondary_engine=OFF;
ALTER TABLE cb_rotate SECONDARY_UNLOAD;
DROP TABLE cb_rotate;
SET GLOBAL rapid_change_propagation_mode=CAPTURE;
SET DEBUG_SYNC='RESET';
