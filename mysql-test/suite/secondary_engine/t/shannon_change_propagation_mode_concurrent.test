--source include/have_debug_sync.inc
--source include/no_ps_protocol.inc
SET use_secondary_engine=OFF;
CREATE TABLE t_mode_load (id INT PRIMARY KEY) SECONDARY_ENGINE=rapid;
CREATE TABLE t_mode_part (id INT PRIMARY KEY) SECONDARY_ENGINE=rapid
PARTITION BY HASH(id) PARTITIONS 2;
INSERT INTO t_mode_load VALUES (1);
INSERT INTO t_mode_part VALUES (1), (2);
--connect (loader,localhost,root,,test)
SET DEBUG_SYNC='rapid_change_propagation_load_admitted SIGNAL load_admitted WAIT_FOR continue_load';
--send ALTER TABLE t_mode_load SECONDARY_LOAD
--connection default
SET DEBUG_SYNC='now WAIT_FOR load_admitted';
# The table is not registered yet; the load admission guard must reject SET.
--error ER_SECONDARY_ENGINE_PLUGIN
SET GLOBAL rapid_change_propagation_mode='COMMITTED_BINLOG';
SELECT @@GLOBAL.rapid_change_propagation_mode;
--error ER_SECONDARY_ENGINE_PLUGIN
SET GLOBAL rapid_propagation_mode=REDO_LOG_PARSE;
SELECT @@GLOBAL.rapid_propagation_mode;
SET DEBUG_SYNC='now SIGNAL continue_load';
--connection loader
--reap
--connection default
ALTER TABLE t_mode_load SECONDARY_UNLOAD;
--connection loader
SET DEBUG_SYNC='rapid_change_propagation_load_admitted SIGNAL part_admitted WAIT_FOR continue_part';
--send ALTER TABLE t_mode_part SECONDARY_LOAD
--connection default
SET DEBUG_SYNC='now WAIT_FOR part_admitted';
--error ER_SECONDARY_ENGINE_PLUGIN
SET GLOBAL rapid_change_propagation_mode=1;
SELECT @@GLOBAL.rapid_change_propagation_mode;
--error ER_SECONDARY_ENGINE_PLUGIN
SET GLOBAL rapid_propagation_mode=REDO_LOG_PARSE;
SELECT @@GLOBAL.rapid_propagation_mode;
SET DEBUG_SYNC='now SIGNAL continue_part';
--connection loader
--reap
SET DEBUG_SYNC='RESET';
--disconnect loader
--connection default
ALTER TABLE t_mode_part SECONDARY_UNLOAD;
# A load completing after SET validation must also prevent the actual update.
--connect (setter,localhost,root,,test)
SET DEBUG_SYNC='rapid_change_propagation_mode_checked SIGNAL mode_checked WAIT_FOR continue_set';
--send SET GLOBAL rapid_change_propagation_mode='COMMITTED_BINLOG'
--connection default
SET DEBUG_SYNC='now WAIT_FOR mode_checked';
ALTER TABLE t_mode_load SECONDARY_LOAD;
SET DEBUG_SYNC='now SIGNAL continue_set';
--connection setter
--error ER_SECONDARY_ENGINE_PLUGIN
--reap
SET DEBUG_SYNC='RESET';
--disconnect setter
--connection default
SELECT @@GLOBAL.rapid_change_propagation_mode;
ALTER TABLE t_mode_load SECONDARY_UNLOAD;
--connect (sync_setter,localhost,root,,test)
SET DEBUG_SYNC='rapid_propagation_mode_checked SIGNAL sync_checked WAIT_FOR continue_sync_set';
--send SET GLOBAL rapid_propagation_mode=REDO_LOG_PARSE
--connection default
SET DEBUG_SYNC='now WAIT_FOR sync_checked';
ALTER TABLE t_mode_load SECONDARY_LOAD;
SET DEBUG_SYNC='now SIGNAL continue_sync_set';
--connection sync_setter
--error ER_SECONDARY_ENGINE_PLUGIN
--reap
SET DEBUG_SYNC='RESET';
--disconnect sync_setter
--connection default
SELECT @@GLOBAL.rapid_propagation_mode;
ALTER TABLE t_mode_load SECONDARY_UNLOAD;
SET GLOBAL rapid_propagation_mode=REDO_LOG_PARSE;
SELECT @@GLOBAL.rapid_propagation_mode;
SET GLOBAL rapid_propagation_mode=DIRECT_NOTIFICATION;
SET GLOBAL rapid_change_propagation_mode='COMMITTED_BINLOG';
SELECT @@GLOBAL.rapid_change_propagation_mode;
SET GLOBAL rapid_change_propagation_mode='CAPTURE';
DROP TABLE t_mode_load, t_mode_part;
SET DEBUG_SYNC='RESET';
