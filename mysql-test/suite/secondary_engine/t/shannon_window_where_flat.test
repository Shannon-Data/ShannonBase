##############################################################################
# ShannonBase: vectorized window over a NON-partitioned table with a filter on
# the window input.
#
# A non-partitioned table uses a vectorized scan, so the window above it is the
# vectorized operator. The WHERE is applied before the window function, so the
# window is computed over the surviving rows only. The 1024-row ingest pass and
# the physical partition boundary are both exercised by the large table. The
# derived-table form keeps the window scope whole; the direct form shrinks it.
# ShannonBase copyright 2023-
##############################################################################

--source include/no_ps_protocol.inc

create database sh_wff;
use sh_wff;
--disable_warnings
create table wf (id int primary key, p int not null, v int not null) secondary_engine=rapid;
--enable_warnings

set session cte_max_recursion_depth = 5000;
insert into wf (id, p, v)
with recursive seq(n) as (
  select 1 union all select n + 1 from seq where n < 2500
)
select n, n div 1000, n from seq;
set session cte_max_recursion_depth = default;

alter table wf secondary_load;

--echo # ===== InnoDB baseline =====
set session use_secondary_engine = off;
select count(*) as total, sum(v) as sv from wf;
select id, p, v, running from (select id, p, v, sum(v) over (partition by p order by id) as running from wf) t where id in (1023,1024,1025,2047,2048,2049,2499) order by id;

--echo # ===== Rapid =====
set session use_secondary_engine = forced;
select count(*) as total, sum(v) as sv from wf;
select id, p, v, running from (select id, p, v, sum(v) over (partition by p order by id) as running from wf) t where id in (1023,1024,1025,2047,2048,2049,2499) order by id;

use test;
drop database sh_wff;
