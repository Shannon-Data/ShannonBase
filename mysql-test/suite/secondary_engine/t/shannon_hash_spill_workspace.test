--source include/have_debug.inc
--source include/no_ps_protocol.inc
CREATE DATABASE sh_spill_workspace;
USE sh_spill_workspace;
CREATE TABLE b (bid INT PRIMARY KEY, bkey INT, bval INT, pad CHAR(32)) SECONDARY_ENGINE=rapid;
CREATE TABLE p (pid INT PRIMARY KEY, pkey INT, pval INT, pad CHAR(32)) SECONDARY_ENGINE=rapid;
INSERT INTO b WITH RECURSIVE seq(n) AS
 (SELECT 1 UNION ALL SELECT n+1 FROM seq WHERE n<400)
 SELECT n,n,n*2,CONCAT('build',n) FROM seq;
INSERT INTO p WITH RECURSIVE seq(n) AS
 (SELECT 1 UNION ALL SELECT n+1 FROM seq WHERE n<800)
 SELECT n,MOD(n,500)+1,n,CONCAT('probe',n) FROM seq;
ALTER TABLE b SECONDARY_LOAD;
ALTER TABLE p SECONDARY_LOAD;
--disable_warnings
SET optimizer_switch='hypergraph_optimizer=on';
--enable_warnings
SET use_secondary_engine=FORCED;
SET secondary_engine_cost_threshold=0;
SET join_buffer_size=4096;
SET debug='+d,rapid_operator_budget_floor';
# The 64-KiB operator cap cannot hold every partition's charged file buffer.
# Refuse the spill without exceeding the workspace or losing query rows.
--error ER_SECONDARY_ENGINE_PLUGIN
SELECT pkey,SUM(bval),SUM(pval),COUNT(*) FROM p JOIN b ON pkey=bkey GROUP BY pkey;
SET debug='-d,rapid_operator_budget_floor';
SELECT COUNT(*) FROM b;
SET use_secondary_engine=OFF;
DROP DATABASE sh_spill_workspace;
