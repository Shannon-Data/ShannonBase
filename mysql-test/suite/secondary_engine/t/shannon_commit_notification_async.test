--source include/have_debug.inc
--source include/no_ps_protocol.inc
CREATE DATABASE sh_async_commit;
USE sh_async_commit;
CREATE TABLE t (id INT PRIMARY KEY, v INT) SECONDARY_ENGINE=rapid;
INSERT INTO t VALUES (1,10),(2,20);
ALTER TABLE t SECONDARY_LOAD;
SET SESSION debug='+d,rapid_assert_source_2pc';
SET GLOBAL debug='+d,rapid_finalize_commits_stall';
SET use_secondary_engine=FORCED;
BEGIN;
UPDATE t SET v=110 WHERE id=1;
SELECT SUM(v) FROM t;
COMMIT;
# COMMIT must finish even while physical Rapid commit finalization is paused.
--connect (observer,localhost,root,,sh_async_commit)
SET use_secondary_engine=FORCED;
SELECT SUM(v) FROM t;
--let $actual = `SELECT SUM(v) FROM t`
if ($actual != 130) {
  --die Source ReadView must expose a committed creator before Rapid finalization
}
--connection default
SET GLOBAL debug='-d,rapid_finalize_commits_stall';
SET SESSION debug='-d,rapid_assert_source_2pc';
--let $assert_digest = SELECT GROUP_CONCAT(CONCAT(id,':',v) ORDER BY id) FROM t
--source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
--disconnect observer
DROP DATABASE sh_async_commit;
