# Model incomplete persistence after power loss. This does not cut device power
# or emulate loss of the OS/controller write cache.
--let $shannon_storage_layer_case = baseline
--source suite/secondary_engine/include/shannon_storage_layer.inc
UPDATE t SET v=11 WHERE id=1;
INSERT INTO t VALUES (4,40);
--source include/kill_mysqld.inc
# A torn newer manifest and orphan temporary files must not supersede the last
# complete, checksummed generation. Alter files only while the server is down.
--write_file $datadir/rapid_snapshots/sh_storage_recovery/t/checkpoints/checkpoint-999999.manifest
partial-manifest-after-power-loss
EOF
--write_file $datadir/rapid_snapshots/sh_storage_recovery/t/checkpoints/checkpoint-1000000.manifest.tmp.123
unpublished-manifest
EOF
--mkdir $datadir/rapid_snapshots/sh_storage_recovery/t/snapshots/checkpoint-999999.tmp
--write_file $datadir/rapid_snapshots/sh_storage_recovery/t/snapshots/checkpoint-999999.tmp/imcu_0.snap
incomplete-native-data
EOF
--let $restart_parameters = restart: --rapid_reload_on_restart=ON
--source include/start_mysqld.inc
USE sh_storage_recovery;
--let $wait_condition = SELECT CAST(VARIABLE_VALUE AS UNSIGNED)=1 FROM performance_schema.global_status WHERE VARIABLE_NAME='rapid_recovery_storage_restores'
--source include/wait_condition.inc
--let $restores = `SELECT VARIABLE_VALUE FROM performance_schema.global_status WHERE VARIABLE_NAME='rapid_recovery_storage_restores'`
if ($restores != 1) {
 --die Incomplete candidates must not prevent recovery from the complete generation
}
SET use_secondary_engine=FORCED;
SELECT id,v FROM t ORDER BY id;
--let $actual = `SELECT GROUP_CONCAT(CONCAT(id,':',v) ORDER BY id) FROM t`
if ($actual != 1:11,2:20,3:30,4:40) {
 --die Power-loss file simulation lost committed rows or published partial data
}
--let $assert_digest = SELECT GROUP_CONCAT(CONCAT(id,':',v) ORDER BY id) FROM t
--source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
DROP DATABASE sh_storage_recovery;
