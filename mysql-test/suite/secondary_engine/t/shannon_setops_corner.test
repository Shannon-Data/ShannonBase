##############################################################################
# ShannonBase: set operations and DISTINCT, including their NULL semantics.
#
# UNION / INTERSECT / EXCEPT deduplicate with NULL considered equal to NULL --
# the opposite of the `=` operator -- so a NULL row must survive UNION once,
# match in INTERSECT, and be removed by EXCEPT. The ALL variants keep the
# multiplicity: INTERSECT ALL keeps min(m,n) copies and EXCEPT ALL keeps
# max(m-n,0). DISTINCT and COUNT(DISTINCT) fold NULLs the same way, except
# that COUNT ignores them entirely.
#
# INTERSECT, INTERSECT ALL, EXCEPT ALL and multi-argument COUNT(DISTINCT) had
# no coverage in this suite at all.
#
# The hypergraph set-operation refusal ("Table not loaded in IMCS") was the
# materialised UNION's internal temp table failing the IMCS-loaded check; it
# is fixed as of 2026-09-21 and those forms now answer as InnoDB does.
#
# Derived INTERSECT/EXCEPT materialization is refused until the secondary
# plan preserves its rows. FORCED must fail explicitly; ON must
# fall back to InnoDB. Successful set operations are compared with InnoDB.
# ShannonBase copyright 2023-
##############################################################################

--source include/no_ps_protocol.inc

create database sh_setop;
use sh_setop;
--disable_warnings
create table s1 (id int primary key, k int null, g int not null) secondary_engine=rapid;
create table s2 (id int primary key, k int null, g int not null) secondary_engine=rapid;
--enable_warnings

# s1: 1 appears twice, 2 three times, NULL twice, plus 3 and 4.
insert into s1 values (1,1,10),(2,1,10),(3,2,20),(4,2,20),(5,2,30),
                      (6,null,10),(7,null,30),(8,3,20),(9,4,30);
# s2: 1 once, 2 twice, NULL once, plus 5. 3 and 4 are missing on purpose so
# EXCEPT has something to keep.
insert into s2 values (1,1,10),(2,2,20),(3,2,30),(4,null,10),(5,5,10);

alter table s1 secondary_load;
alter table s2 secondary_load;

--let $shannon_reads = suite/secondary_engine/include/shannon_setops_reads.inc
--source suite/secondary_engine/include/shannon_3way.inc

# Pin the derived-set-operation boundary: a supported-looking empty answer is
# forbidden. Both optimizers must refuse FORCED and return the primary result
# in ON mode. The full-result assertion also checks that fallback result.
--disable_query_log
--disable_result_log
--disable_warnings
--let $setop_mode = 2
while ($setop_mode) {
  if ($setop_mode == 2) {
    SET optimizer_switch='hypergraph_optimizer=off';
  }
  if ($setop_mode == 1) {
    SET optimizer_switch='hypergraph_optimizer=on';
  }
  SET use_secondary_engine=FORCED;
  --error ER_SECONDARY_ENGINE
  SELECT COUNT(*) FROM (SELECT k FROM s1 INTERSECT SELECT k FROM s2) d;
  --error ER_SECONDARY_ENGINE
  SELECT COUNT(*) FROM (SELECT k FROM s1 EXCEPT SELECT k FROM s2) d;
  --error ER_SECONDARY_ENGINE
  SELECT COUNT(*) FROM (SELECT k FROM s1 INTERSECT SELECT k FROM s2 UNION SELECT k FROM s1) d;
  SET use_secondary_engine=ON;
  --let $assert_query = SELECT COUNT(*) FROM (SELECT k FROM s1 INTERSECT SELECT k FROM s2) d
  --let $assert_queries_off = 1
  --let $assert_results_off = 1
  --let $assert_warnings_off = 1
  --source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
  --let $assert_query = SELECT COUNT(*) FROM (SELECT k FROM s1 EXCEPT SELECT k FROM s2) d
  --let $assert_queries_off = 1
  --let $assert_results_off = 1
  --source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
  --let $assert_query = SELECT COUNT(*) FROM (SELECT k FROM s1 INTERSECT SELECT k FROM s2 UNION SELECT k FROM s1) d
  --let $assert_queries_off = 1
  --let $assert_results_off = 1
  --source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
  --dec $setop_mode
}
--let $assert_warnings_off =
SET use_secondary_engine=OFF;
SET optimizer_switch=default;
--enable_warnings
--enable_result_log
--enable_query_log

--echo ##### the same set operations over an empty right-hand side
delete from s2;
--SLEEP 1
--source suite/secondary_engine/include/shannon_3way.inc

use test;
drop database sh_setop;
