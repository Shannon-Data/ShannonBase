CALL mtr.add_suppression("Rapid COMMITTED_BINLOG: Source binlog was reset");
SET use_secondary_engine=OFF;
SET GLOBAL rapid_change_propagation_mode=COMMITTED_BINLOG;
CREATE TABLE cb_reset (id INT PRIMARY KEY,v INT) SECONDARY_ENGINE=rapid;
INSERT INTO cb_reset VALUES (1,10);
ALTER TABLE cb_reset SECONDARY_LOAD;
UPDATE cb_reset SET v=11 WHERE id=1;
SET use_secondary_engine=FORCED;
SELECT SUM(v) FROM cb_reset;
--let $assert_query = SELECT SUM(v) FROM cb_reset
--source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
SET use_secondary_engine=OFF;
RESET BINARY LOGS AND GTIDS;
UPDATE cb_reset SET v=12 WHERE id=1;
SET use_secondary_engine=FORCED;
--error ER_SECONDARY_ENGINE
SELECT SUM(v) FROM cb_reset;
SHOW WARNINGS;
SET use_secondary_engine=ON;
SELECT SUM(v) FROM cb_reset;
--let $assert_query = SELECT SUM(v) FROM cb_reset
--source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
SET use_secondary_engine=OFF;
ALTER TABLE cb_reset SECONDARY_UNLOAD;
ALTER TABLE cb_reset SECONDARY_LOAD;
SET use_secondary_engine=FORCED;
SELECT SUM(v) FROM cb_reset;
--let $assert_query = SELECT SUM(v) FROM cb_reset
--source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
SET use_secondary_engine=OFF;
ALTER TABLE cb_reset SECONDARY_UNLOAD;
DROP TABLE cb_reset;
SET GLOBAL rapid_change_propagation_mode=CAPTURE;
