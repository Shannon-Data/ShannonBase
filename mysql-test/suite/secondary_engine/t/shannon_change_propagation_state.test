##############################################################################
# ShannonBase Rapid: change-propagation state reporting
#
# HeatWave reports per-table change propagation through rpd_tables.POOL_TYPE:
# TRANSACTIONAL means propagation is enabled for the table, SNAPSHOT means it
# is disabled.  Rapid declared the enum and surfaced the column but never
# assigned the field, so every loaded table reported SNAPSHOT -- the opposite
# of the truth -- while its changes were in fact being propagated.
#
# Also covers the global rapid_change_propagation_status status variable.
##############################################################################

DROP DATABASE IF EXISTS sh_cp;
CREATE DATABASE sh_cp;
USE sh_cp;

--echo #
--echo # 1. The global status variable tracks the propagation coordinator, which
--echo #    starts lazily on the first load: OFF with nothing loaded, ON after.
--echo #
SELECT VARIABLE_VALUE AS before_any_load FROM performance_schema.global_status
 WHERE VARIABLE_NAME = 'rapid_change_propagation_status';

--echo #
--echo # 2. A loaded table reports TRANSACTIONAL, the documented value for
--echo #    "change propagation is enabled for this table".
--echo #
CREATE TABLE t1 (id INT PRIMARY KEY, v INT) SECONDARY_ENGINE=rapid;
INSERT INTO t1 VALUES (1,10),(2,20),(3,30);
ALTER TABLE t1 SECONDARY_LOAD;

SELECT VARIABLE_VALUE AS after_load FROM performance_schema.global_status
 WHERE VARIABLE_NAME = 'rapid_change_propagation_status';

SELECT i.NAME, t.POOL_TYPE, t.LOAD_STATUS, t.STALE_REASON
  FROM performance_schema.rpd_tables t
  JOIN performance_schema.rpd_table_id i ON t.ID = i.ID
 WHERE i.SCHEMA_NAME = 'sh_cp';

--echo #
--echo # 3. The documented HeatWave query shape runs unchanged.
--echo #
SELECT NAME, POOL_TYPE
  FROM performance_schema.rpd_tables, performance_schema.rpd_table_id
 WHERE rpd_tables.ID = rpd_table_id.ID AND SCHEMA_NAME LIKE 'sh_cp';

--echo #
--echo # 4. Propagated DML is visible to a secondary-engine read (read-your-writes
--echo #    through the query watermark), and the table stays TRANSACTIONAL.
--echo #
INSERT INTO t1 VALUES (4,40);
UPDATE t1 SET v = 99 WHERE id = 1;
DELETE FROM t1 WHERE id = 2;
SET SESSION use_secondary_engine=FORCED;
SELECT id, v FROM t1 ORDER BY id;
SET SESSION use_secondary_engine=DEFAULT;

SELECT i.NAME, t.POOL_TYPE, t.LOAD_STATUS
  FROM performance_schema.rpd_tables t
  JOIN performance_schema.rpd_table_id i ON t.ID = i.ID
 WHERE i.SCHEMA_NAME = 'sh_cp';

ALTER TABLE t1 SECONDARY_UNLOAD;
DROP TABLE t1;
DROP DATABASE sh_cp;
