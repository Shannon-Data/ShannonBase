--source include/have_debug.inc
--source include/no_ps_protocol.inc
CREATE DATABASE sh_bloom;
USE sh_bloom;
SET SESSION use_secondary_engine=OFF;
CREATE TABLE b(id INT PRIMARY KEY, k INT, k2 INT, v INT) SECONDARY_ENGINE=rapid;
CREATE TABLE p(id INT PRIMARY KEY, k INT, k2 INT, v INT) SECONDARY_ENGINE=rapid;
INSERT INTO b WITH RECURSIVE n AS (SELECT 1 AS i UNION ALL SELECT i+1 FROM n WHERE i<256)
SELECT i, IF(i=256,NULL,i DIV 2), i%3, i FROM n;
SET SESSION cte_max_recursion_depth=10000;
INSERT INTO p WITH RECURSIVE n AS (SELECT 1 AS i UNION ALL SELECT i+1 FROM n WHERE i<8192)
SELECT i, IF(i%13=0,NULL,i), i%3, i FROM n;
ALTER TABLE b SECONDARY_LOAD;
ALTER TABLE p SECONDARY_LOAD;
SET SESSION optimizer_switch='hypergraph_optimizer=on';
SET SESSION secondary_engine_cost_threshold=0;
SET SESSION use_secondary_engine=FORCED;
SET SESSION debug='-d,rapid_bloom_disabled';
SET SESSION debug='+d,rapid_stats';
SELECT COUNT(*),SUM(p.v) FROM p JOIN b ON p.k=b.k;
SET SESSION debug='-d,rapid_stats';
--let $grep_file = $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $grep_pattern = RAPID_STATS .*bloom_rejects=[1-9]
--source include/wait_for_pattern_in_file.inc
# Scan pushdown must execute and preserve results.
--let $assert_query = SELECT COUNT(*),SUM(p.v) FROM p JOIN b ON p.k=b.k
--source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
SET SESSION debug='+d,rapid_bloom_pushdown_disabled';
--let $assert_query = SELECT COUNT(*),SUM(p.v) FROM p JOIN b ON p.k=b.k
--source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
SET SESSION debug='-d,rapid_bloom_pushdown_disabled';
--let $assert_query = SELECT p.k,COUNT(*),SUM(p.v) FROM p JOIN b ON p.k=b.k GROUP BY p.k ORDER BY p.k
--let $assert_ordered = 1
--source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
--let $assert_query = SELECT COUNT(*),SUM(p.v) FROM p JOIN b ON p.k=b.k AND p.k2=b.k2 AND p.v>b.v
--source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
--let $assert_query = SELECT COUNT(*),SUM(p.v) FROM p JOIN b ON p.k<=>b.k
--source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
--let $assert_query = SELECT COUNT(*),SUM(p.v) FROM p JOIN b ON p.k=b.k JOIN b AS b2 ON p.k=b2.k
--source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
--let $assert_query = SELECT COUNT(*),SUM(p.v) FROM p WHERE EXISTS(SELECT 1 FROM b WHERE p.k=b.k)
--source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
--let $assert_query = SELECT COUNT(*),SUM(p.v) FROM p LEFT JOIN b ON p.k=b.k
--source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
--let $assert_query = SELECT COUNT(*),SUM(p.v) FROM p WHERE NOT EXISTS(SELECT 1 FROM b WHERE p.k=b.k)
--source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
# Every fallback path must still return the same rows. Whether the filter really
# stayed out of the plan is internal state: ask for it with rapid_stats if needed.
SET SESSION debug='+d,rapid_bloom_disabled';
SELECT COUNT(*),SUM(p.v) FROM p JOIN b ON p.k=b.k;
--let $assert_query = SELECT COUNT(*),SUM(p.v) FROM p JOIN b ON p.k=b.k
--source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
SET SESSION debug='-d,rapid_bloom_disabled';
SET SESSION debug='+d,rapid_bloom_allocation_failure';
SELECT COUNT(*),SUM(p.v) FROM p JOIN b ON p.k=b.k;
--let $assert_query = SELECT COUNT(*),SUM(p.v) FROM p JOIN b ON p.k=b.k
--source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
SET SESSION debug='-d,rapid_bloom_allocation_failure';
SET SESSION debug='+d,rapid_bloom_resource_pressure';
SELECT COUNT(*),SUM(p.v) FROM p JOIN b ON p.k=b.k;
--let $assert_query = SELECT COUNT(*),SUM(p.v) FROM p JOIN b ON p.k=b.k
--source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
SET SESSION debug='-d,rapid_bloom_resource_pressure';
# Pressure arriving after build must release the optional filter safely, and the
# adaptive give-up is visible as bloom_disabled in the stats line.
SET SESSION debug='+d,rapid_stats';
SET SESSION debug='+d,rapid_bloom_probe_pressure';
SELECT COUNT(*),SUM(p.v) FROM p JOIN b ON p.k=b.k;
SET SESSION debug='-d,rapid_bloom_probe_pressure';
SET SESSION debug='-d,rapid_stats';
--let $grep_file = $MYSQLTEST_VARDIR/log/mysqld.1.err
--let $grep_pattern = RAPID_STATS .*bloom_disabled=[1-9]
--source include/wait_for_pattern_in_file.inc
# Almost every non-NULL key matches: sampling must stop unnecessary checks.
SELECT COUNT(*),SUM(p.v) FROM p JOIN b ON p.k%128=b.k;
--let $assert_query = SELECT COUNT(*),SUM(p.v) FROM p JOIN b ON p.k%128=b.k
--source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
PREPARE q FROM 'SELECT COUNT(*),SUM(p.v) FROM p JOIN b ON p.k=b.k WHERE b.id<=?';
SET @n=256;
EXECUTE q USING @n;
SET @n=0;
EXECUTE q USING @n;
SET @n=128;
EXECUTE q USING @n;
DEALLOCATE PREPARE q;
# Surviving rows occur only after several fully rejected physical batches.
SET use_secondary_engine=OFF;
ALTER TABLE b SECONDARY_UNLOAD;
UPDATE b SET k=k+8000;
ALTER TABLE b SECONDARY_LOAD;
ALTER TABLE p SECONDARY_UNLOAD;
UPDATE p SET k=-id WHERE k IS NULL;
ALTER TABLE p SECONDARY_LOAD;
SET use_secondary_engine=FORCED;
--let $assert_query = SELECT COUNT(*),SUM(p.v) FROM p JOIN b ON p.k=b.k
--source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
# At about 20% rejection, stop scan compaction but keep useful local filtering.
SET use_secondary_engine=OFF;
ALTER TABLE p SECONDARY_UNLOAD;
UPDATE p SET k=8000+id%160;
ALTER TABLE p SECONDARY_LOAD;
SET use_secondary_engine=FORCED;
--let $assert_query = SELECT COUNT(*),SUM(p.v) FROM p JOIN b ON p.k=b.k
--source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
# A nonmerged LIMIT input is a semantic barrier to scan pushdown.
--let $assert_query = SELECT COUNT(*) FROM (SELECT k FROM p LIMIT 100) d JOIN b ON d.k=b.k
--source suite/secondary_engine/include/assert_rapid_matches_innodb.inc
SET use_secondary_engine=OFF;
DROP DATABASE sh_bloom;
