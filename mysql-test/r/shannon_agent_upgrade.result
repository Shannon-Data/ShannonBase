#
# Now simulate an older datadir for the four tables this change adds:
# drop them and let the block build them. They are empty and nothing
# else references them, so this is the part of an upgrade that can be
# rehearsed safely.
#
DROP TABLE mysql.agent_artifact;
DROP TABLE mysql.agent_memory_edge;
DROP TABLE mysql.agent_derive_queue;
DROP TABLE mysql.agent_usage;
