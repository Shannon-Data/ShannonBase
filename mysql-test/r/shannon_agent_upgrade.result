#
# Rebuilt, with the keys that make them usable rather than merely
# present: the artifact dedup key, the hashed edge key, and the queue's
# uniqueness constraint that keeps a retry loop from growing it.
#
SELECT TABLE_NAME FROM information_schema.TABLES
WHERE TABLE_SCHEMA='mysql'
   AND TABLE_NAME IN ('agent_artifact','agent_memory_edge','agent_derive_queue','agent_usage')
ORDER BY TABLE_NAME;
TABLE_NAME
agent_artifact
agent_derive_queue
agent_memory_edge
agent_usage
SELECT TABLE_NAME, INDEX_NAME, NON_UNIQUE FROM information_schema.STATISTICS
WHERE TABLE_SCHEMA='mysql'
   AND INDEX_NAME IN ('uk_artifact_hash','uk_edge','uk_task')
GROUP BY TABLE_NAME, INDEX_NAME, NON_UNIQUE ORDER BY TABLE_NAME;
TABLE_NAME	INDEX_NAME	NON_UNIQUE
agent_artifact	uk_artifact_hash	0
agent_derive_queue	uk_task	0
agent_memory_edge	uk_edge	0
#
# And the upgraded columns and indexes on the pre-existing tables are
# still there -- the block reported them as already present, so it must
# not have removed them.
#
SELECT TABLE_NAME, INDEX_NAME FROM information_schema.STATISTICS
WHERE TABLE_SCHEMA='mysql' AND INDEX_TYPE='FULLTEXT'
 GROUP BY TABLE_NAME, INDEX_NAME ORDER BY TABLE_NAME;
TABLE_NAME	INDEX_NAME
agent_memory	ftx_content
agent_semantic_fact	ftx_statement
agent_sql_trace	ftx_desc
SELECT TABLE_NAME, COLUMN_NAME, EXTRA FROM information_schema.COLUMNS
WHERE TABLE_SCHEMA='mysql' AND COLUMN_NAME='turn_id'
 ORDER BY TABLE_NAME;
TABLE_NAME	COLUMN_NAME	EXTRA
agent_artifact	turn_id	
agent_memory	turn_id	STORED GENERATED
agent_sql_trace	turn_id	
#
# The rebuilt tables are writable, which a CREATE that merely parsed
# would not prove: the generated edge_key has to compute, and the
# unique keys have to reject a duplicate.
#
INSERT INTO mysql.agent_memory_edge (principal_prefix, src_kind, src_id, rel, dst_kind, dst_id)
VALUES ('0000upgrade00000','fact','1','scoped_to','table','orders');
