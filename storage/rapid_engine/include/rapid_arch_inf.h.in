#ifndef __SHANNONBASE_RAPID_ARCH_INFO_H__
#define __SHANNONBASE_RAPID_ARCH_INFO_H__

// Overflow-checked arithmetic below is expressed with templates when the
// compiler has no builtins, so these are needed on every platform.
#include <limits>
#include <type_traits>

#define ALIGN_WORD(WORD, TYPE_SIZE) ((WORD + TYPE_SIZE - 1) & ~(TYPE_SIZE - 1))

// OS platform: POSIX (Linux/macOS) vs Windows. Independent of the CPU arch below.
#if defined(_WIN32)
#define SHANNON_WINDOWS_PLATFORM
#else
#define SHANNON_POSIX_PLATFORM
#endif

// Linux-specific APIs must use this centralized OS capability macro.
#if defined(__linux__)
#define SHANNON_LINUX_PLATFORM
#endif

// macOS-only APIs (mach/sysctl, libc quirks) must use this centralized macro.
// Defined for every Apple build, independently of the CPU arch selected below.
#if defined(__APPLE__)
#define SHANNON_MACOS_PLATFORM
#endif

// clang-format off
#if defined(__APPLE__) && defined(__arm64__)
    // Apple silicon: NEON is mandatory. The OS is already identified by
    // SHANNON_MACOS_PLATFORM above; this block only selects the CPU features.
    #define SHANNON_ARM_PLATFORM

    static_assert(__ARM_NEON, "Expected NEON on Apple arm64 but __ARM_NEON is unset");
    #include <arm_neon.h>
    #define SHANNON_ARM_VECT_SUPPORTED
#elif defined(__arm__) || defined(__aarch64__)
    #define SHANNON_ARM_PLATFORM

    #if defined(__ARM_NEON) || defined(__ARM_NEON__)
        #include <arm_neon.h>
        #define SHANNON_ARM_VECT_SUPPORTED
    #endif
    #if defined(__ARM_FEATURE_SVE)
        #include <arm_sve.h>
        #define SHANNON_ARM_SVE_SUPPORTED
    #endif
#elif defined(__x86_64__) || defined(__i386__) || defined(_M_X64) || defined(_M_IX86)
    #define SHANNON_X86_PLATFORM
     #if defined(_MSC_VER)
        #if defined(__AVX512F__) && defined(__AVX512BW__)
            #include <immintrin.h>
            #define SHANNON_AVX512_VECT_SUPPORTED
            // AVX-512 implies AVX2/SSE4.2; hardware CRC32 is available.
            #define SHANNON_CRC32_HW_SUPPORTED
            #if defined(_M_X64)
                #define SHANNON_CRC32_U64_SUPPORTED
            #endif
        #elif defined(__AVX2__) || defined(__AVX__)
            #include <immintrin.h>
            #define SHANNON_AVX_VECT_SUPPORTED
            // /arch:AVX[2] makes SSE4.2 intrinsics available on MSVC.
            #define SHANNON_CRC32_HW_SUPPORTED
            #if defined(_M_X64)
                #define SHANNON_CRC32_U64_SUPPORTED
            #endif
        #elif defined(_M_IX86_FP) && (_M_IX86_FP >= 2)
            // /arch:SSE2 — only SSE2 guaranteed; no CRC32.
            #include <emmintrin.h>
            #define SHANNON_SSE_VECT_SUPPORTED
        #endif  // MSVC arch tiers
    #else // GCC / Clang
        // Ordinary inline code may use only ISA enabled by the compiler,
        // never capabilities detected on the machine producing the binary.
        #if defined(__AVX2__)
            #include <immintrin.h>
            #define SHANNON_AVX_VECT_SUPPORTED
        #endif
        #if defined(__SSE2__)
            #include <emmintrin.h>
            #define SHANNON_SSE2_VECT_SUPPORTED
        #endif
        #if defined(__SSE4_2__)
            #define SHANNON_SSE_VECT_SUPPORTED
            #include <nmmintrin.h>
            #define SHANNON_CRC32_HW_SUPPORTED
            #if defined(__x86_64__)
                #define SHANNON_CRC32_U64_SUPPORTED
            #endif
        #endif
    #endif  // _MSC_VER
#else
    #error "Unsupported platform for ShannonBase"
#endif  // platform

// clang-format off
// ISA capability macros for the hand-written kernels in utils/SIMD_Impl.h:
// each answers "may this build emit that instruction set", never "does this CPU
// have it". Runtime selection still goes through SIMD::detect_simd_support().
#if defined(SHANNON_X86_PLATFORM)
    #if defined(__SSE2__) || defined(_M_X64) || (defined(_M_IX86_FP) && _M_IX86_FP >= 2)
        #define SHANNON_HAVE_SSE2 1
    #endif
    #if defined(__SSE4_2__) || defined(__AVX__) || defined(SHANNON_AVX_VECT_SUPPORTED)
        #define SHANNON_HAVE_SSE42 1
    #endif
    #if defined(__AVX__) || (defined(_MSC_VER) && defined(SHANNON_AVX_VECT_SUPPORTED))
        #define SHANNON_HAVE_AVX 1
    #endif
    #if defined(__AVX2__)
        #define SHANNON_HAVE_AVX2 1
    #endif
    #if defined(__GNUC__) || defined(__clang__)
        // Compile AVX2 kernels as function-level ISA variants so a baseline
        // binary still contains them.
        #define SHANNON_RUNTIME_AVX2 1
        #define SHANNON_TARGET_AVX2 __attribute__((target("avx2")))
    #else
        #define SHANNON_TARGET_AVX2
    #endif
#elif defined(SHANNON_ARM_VECT_SUPPORTED)
    #define SHANNON_HAVE_NEON 1
    #if defined(__aarch64__) || defined(_M_ARM64)
        #define SHANNON_HAVE_NEON_A64 1   // vaddvq_*, vminq_f64, 64-bit lanes are A64-only
    #endif
#endif
// clang-format on

#if defined(SHANNON_SSE_VECT_SUPPORTED) || defined(SHANNON_AVX_VECT_SUPPORTED) ||    \
    defined(SHANNON_AVX512_VECT_SUPPORTED) || defined(SHANNON_ARM_VECT_SUPPORTED) || \
    defined(SHANNON_ARM_SVE_SUPPORTED) || defined(SHANNON_HAVE_SSE2)
    #define SHANNON_VECTORIZE_SUPPORT
#endif

#if defined(SHANNON_AVX512_VECT_SUPPORTED)
    #define SHANNON_VECTOR_WIDTH 512
#elif defined(SHANNON_AVX_VECT_SUPPORTED)
    #define SHANNON_VECTOR_WIDTH 256
#elif defined(SHANNON_SSE_VECT_SUPPORTED) || defined(SHANNON_HAVE_SSE2)
    #define SHANNON_VECTOR_WIDTH 128
#elif defined(SHANNON_ARM_VECT_SUPPORTED) || defined(SHANNON_ARM_SVE_SUPPORTED)
    #define SHANNON_VECTOR_WIDTH 128    // NEON = 128-bit; SVE >= 128-bit
#else
    #define SHANNON_VECTOR_WIDTH  64
    #define SHANNON_SCALAR_FALLBACK
#endif

#if defined(SHANNON_ARM_PLATFORM) && defined(__ARM_FEATURE_CRC32)
    #define SHANNON_ARM_CRC32_SUPPORTED
    #if defined(__aarch64__)
        #define SHANNON_CRC32_U64_SUPPORTED   // __crc32cd available
    #endif
#endif
// clang-format on

// ---------------------------------------------------------------------------
// Overflow-checked arithmetic.
//
// Contract, identical to the GCC/Clang __builtin_*_overflow family: *RESULT
// receives the wrapped result, and the expression is true only when the
// mathematical result does not fit in *RESULT's type.
//
// Engine code goes through these macros instead of spelling a builtin, so a
// platform without builtins keeps exactly the same semantics.
// ---------------------------------------------------------------------------
#if defined(__has_builtin)
    #if __has_builtin(__builtin_add_overflow)
        #define SHANNON_OVERFLOW_BUILTINS_SUPPORTED
    #endif
#elif defined(__GNUC__) && (__GNUC__ >= 5)
    #define SHANNON_OVERFLOW_BUILTINS_SUPPORTED
#endif

// clang-format off
#if defined(SHANNON_OVERFLOW_BUILTINS_SUPPORTED)
    // GCC >= 5, Clang and Apple clang. *RESULT selects the result type, so any
    // mix of operand widths and signedness is handled natively.
    #define SHANNON_ADD_OVERFLOW(a, b, r) __builtin_add_overflow((a), (b), (r))
    #define SHANNON_SUB_OVERFLOW(a, b, r) __builtin_sub_overflow((a), (b), (r))
    #define SHANNON_MUL_OVERFLOW(a, b, r) __builtin_mul_overflow((a), (b), (r))
#else
    // MSVC and every other compiler: same primitive, same contract, slower.
    #define SHANNON_ADD_OVERFLOW(a, b, r) ::ShannonBase::Arch::add_overflow((a), (b), (r))
    #define SHANNON_SUB_OVERFLOW(a, b, r) ::ShannonBase::Arch::sub_overflow((a), (b), (r))
    #define SHANNON_MUL_OVERFLOW(a, b, r) ::ShannonBase::Arch::mul_overflow((a), (b), (r))
#endif
// clang-format on

// Portable form of the three operations above: *RESULT receives the wrapped
// result and true is returned on overflow. Always compiled so the code stays
// type-checked on platforms that use the builtins; instantiated only on those
// that do not.
namespace ShannonBase {
namespace Arch {
template <typename T, typename U, typename R>
inline bool add_overflow(T a, U b, R *r) {
  using C = typename std::common_type<T, U, R>::type;
  const C x = static_cast<C>(a), y = static_cast<C>(b);
  if constexpr (std::is_signed<C>::value) {
    if ((y > 0 && x > (std::numeric_limits<C>::max)() - y) || (y < 0 && x < (std::numeric_limits<C>::min)() - y))
      return true;
  } else if (x > (std::numeric_limits<C>::max)() - y) {
    return true;
  }
  *r = static_cast<R>(x + y);
  return false;
}

template <typename T, typename U, typename R>
inline bool sub_overflow(T a, U b, R *r) {
  using C = typename std::common_type<T, U, R>::type;
  const C x = static_cast<C>(a), y = static_cast<C>(b);
  if constexpr (std::is_signed<C>::value) {
    if ((y > 0 && x < (std::numeric_limits<C>::min)() + y) || (y < 0 && x > (std::numeric_limits<C>::max)() + y))
      return true;
  } else if (x < y) {
    return true;
  }
  *r = static_cast<R>(x - y);
  return false;
}

template <typename T, typename U, typename R>
inline bool mul_overflow(T a, U b, R *r) {
  using C = typename std::common_type<T, U, R>::type;
  const C x = static_cast<C>(a), y = static_cast<C>(b);
  const C max = (std::numeric_limits<C>::max)();
  if constexpr (std::is_signed<C>::value) {
    const C min = (std::numeric_limits<C>::min)();
    if (x == 0 || y == 0) {
      *r = 0;
      return false;
    }
    if ((x == -1 && y == min) || (y == -1 && x == min)) return true;
    if (x > 0 ? (y > 0 ? x > max / y : y < min / x) : (y > 0 ? x < min / y : y < max / x)) return true;
  } else if (y != 0 && x > max / y) {
    return true;
  }
  *r = static_cast<R>(x * y);
  return false;
}
}  // namespace Arch
}  // namespace ShannonBase

// cache line size
#define CACHE_LINE_SIZE @CACHE_LINE_SIZE@

#define CACHE_L1_SIZE @CACHE_L1@
#define CACHE_L2_SIZE @CACHE_L2@
#define CACHE_L3_SIZE @CACHE_L3@

// The sizes above come from a CPUID probe at configure time. A probe that
// misfires yields an implausible figure, and a working set derived from it
// would collapse to a single row; use these when dividing a grant by a cache.
// One bad probe must not turn into a batch of one.
#define CACHE_L1_BYTES (CACHE_L1_SIZE >= (8 * 1024) ? CACHE_L1_SIZE : (32 * 1024))
#define CACHE_L2_BYTES (CACHE_L2_SIZE >= (64 * 1024) ? CACHE_L2_SIZE : (256 * 1024))
#define CACHE_L3_BYTES (CACHE_L3_SIZE >= (1024 * 1024) ? CACHE_L3_SIZE : (8 * 1024 * 1024))

#define SHANNON_ALIGNAS alignas(CACHE_LINE_SIZE)

#if defined(SHANNON_AVX512_VECT_SUPPORTED)
    #define SHANNON_SIMD_ALIGN  64   // _mm512_load_* requires 64-byte alignment
#elif defined(SHANNON_AVX_VECT_SUPPORTED)
    #define SHANNON_SIMD_ALIGN  32   // _mm256_load_* requires 32-byte alignment
#elif defined(SHANNON_SSE_VECT_SUPPORTED)
    #define SHANNON_SIMD_ALIGN  16   // _mm_load_*   requires 16-byte alignment
#elif defined(SHANNON_HAVE_SSE2)
    #define SHANNON_SIMD_ALIGN  16   // SSE2 is the x86-64 baseline
#elif defined(SHANNON_ARM_VECT_SUPPORTED)
    #define SHANNON_SIMD_ALIGN  16   // vld1q_*: no hw requirement, 16 is optimal
#else
    #define SHANNON_SIMD_ALIGN   8   // scalar, natural word alignment
#endif
#define SHANNON_SIMD_ALIGNAS alignas(SHANNON_SIMD_ALIGN)

#if !defined(__cplusplus) && (!defined(__STDC__) || (__STDC_VERSION__ < 201112L))
/*! \brief Thread local specifier no-op in C using standards before C11. */
#define SHANNON_THREAD_LOCAL
#elif !defined(__cplusplus)
/*! \brief Thread local specifier. */
#define SHANNON_THREAD_LOCAL _Thread_local
#elif defined(_MSC_VER)
/*! \brief Thread local specifier. */
#define SHANNON_THREAD_LOCAL __declspec(thread)
#else
/*! \brief Thread local specifier. */
#define SHANNON_THREAD_LOCAL thread_local
#endif

constexpr int PREFETCH_AHEAD = 2;

// clang-format off
/* prefetch
 * can be disabled, by declaring NO_PREFETCH build macro */
#if defined(SHANNON_NO_PREFETCH)
#  define SHANNON_PREFETCH_L1(addr)  (void)(addr)  /* disabled */
#  define SHANNON_PREFETCH_L2(addr)  (void)(addr)  /* disabled */
#  define SHANNON_PREFETCH_L3(addr)  (void)(addr)  /* disabled */
#  define SHANNON_PREFETCH_R(addr)  (void)(addr)  /* disabled */
#  define SHANNON__PREFETCH_RW(addr)  (void)(addr)  /* disabled */
#else
#  if defined(_MSC_VER) && (defined(_M_X64) || defined(_M_IX86))  /* _mm_prefetch() is not defined outside of x86/x64 */
#    include <xmmintrin.h>   /* _mm_prefetch lives here, not in mmintrin.h */
#    define SHANNON_PREFETCH_L1(addr)  _mm_prefetch((const char*)(addr), _MM_HINT_T0)
#    define SHANNON_PREFETCH_L2(addr)  _mm_prefetch((const char*)(addr), _MM_HINT_T1)
#    define SHANNON_PREFETCH_L3(addr)  _mm_prefetch((const char*)(addr), _MM_HINT_T2)
#    define SHANNON_PREFETCH_R(addr)   _mm_prefetch((const char*)(addr), _MM_HINT_T2)
#    define SHANNON__PREFETCH_RW(addr)   _mm_prefetch((const char*)(addr), _MM_HINT_T2)
#  elif defined(__GNUC__) && ( (__GNUC__ >= 4) || ( (__GNUC__ == 3) && (__GNUC_MINOR__ >= 1) ) )
#    define SHANNON_PREFETCH_L1(addr)  __builtin_prefetch((addr), 0 /* rw==read */, 3 /* locality */)
#    define SHANNON_PREFETCH_L2(addr)  __builtin_prefetch((addr), 0 /* rw==read */, 2 /* locality */)
#    define SHANNON_PREFETCH_L3(addr)  __builtin_prefetch((addr), 0 /* rw==read */, 1 /* locality */)
#    define SHANNON_PREFETCH_R(addr)   __builtin_prefetch((addr), 0 /* rw==read */, 1 /* locality */)
/*   Minimize cache-miss latency by moving data at addr into a cache before it is read or written. */
#    define SHANNON__PREFETCH_RW(addr) __builtin_prefetch((addr), 1 /* rw==write */, 1 /* locality */)
#  elif defined(__aarch64__)
#    define SHANNON_PREFETCH_L1(addr)  __asm__ __volatile__("prfm pldl1keep, %0" ::"Q"(*(addr)))
#    define SHANNON_PREFETCH_L2(addr)  __asm__ __volatile__("prfm pldl2keep, %0" ::"Q"(*(addr)))
#    define SHANNON_PREFETCH_L3(addr)  __asm__ __volatile__("prfm pldl3keep, %0" ::"Q"(*(addr)))
#    define SHANNON_PREFETCH_R(addr)   __asm__ __volatile__("prfm pldl3keep, %0" ::"Q"(*(addr)))
#    define SHANNON__PREFETCH_RW(addr) __asm__ __volatile__("prfm pldl3strm, %0" ::"Q"(*(addr)))
#  else
#    define SHANNON_PREFETCH_L1(addr) (void)(addr)  /* disabled */
#    define SHANNON_PREFETCH_L2(addr) (void)(addr)  /* disabled */
#    define SHANNON_PREFETCH_L3(addr) (void)(addr)  /* disabled */
#    define SHANNON_PREFETCH_R(addr)   (void)(addr)  /* disabled */
#    define SHANNON__PREFETCH_RW(addr) (void)(addr)  /* disabled */
#  endif
#endif  /* NO_PREFETCH */
// clang-format on

#endif  //__SHANNONBASE_RAPID_ARCH_INFO_H__