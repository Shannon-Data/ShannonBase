--
-- DEVELOPMENT TOOLING. Not installed into the release sys schema.
--
-- Build template for the agent self-check routines. Generated from
-- agent/js/*.js and agent/devtools/js/*.js by run_genagentjsfile.cmake, with
-- JS_INCLUDE_DIRS="agent/js;agent/devtools/js".
--
-- Install it into a dev server, then run agent_devtools.py:
--   ./scripts/sys_schema/agent/devtools/run_checks.sh --socket /tmp/mysql.sock -u root
--
-- These routines describe the agent's contract but are not part of its
-- interface: someone using sys.shannon_chat never needs them, and both of
-- them write (memory/recall rows, conversation rows, a real DROP TABLE in
-- the policy cases). They are kept out of the shipped schema for that
-- reason; see SELFCHECK.md.

-- sys.shannon_agent_selfcheck - contract self-checks for the agent.
--
-- kind='tools'  : asserts that the tool registry, the JSON-Schema validation
--                 it drives, the approval metadata derived from it, and the
--                 Prompt catalogue rendered from it all still agree. Returns
--                 one row 'OK' when they do, one row per problem when not.
--                 Reads no user data.
-- kind='memory' : drives the layered-memory primitives directly. They are
--                 otherwise reachable only through sys.shannon_chat(), which
--                 needs a live LLM, so none of the ordering / atomicity /
--                 dedup / redaction / retention / isolation behaviour could
--                 be tested without a model. Every operation stays inside the
--                 calling principal's own scope: there is no argument that
--                 can point it at another principal's memory.
--
-- mysql-test/suite/agent/t/shannon_tool_contract.test and
-- mysql-test/suite/agent/t/shannon_memory.test assert on this output.
DROP FUNCTION IF EXISTS sys.shannon_agent_selfcheck;
DROP PROCEDURE IF EXISTS sys.shannon_agent_selfcheck;

CREATE DEFINER='mysql.sys'@'localhost' PROCEDURE sys.shannon_agent_selfcheck(
  IN kind  VARCHAR(16),
  IN op    VARCHAR(32),
  IN label VARCHAR(64)
) SQL SECURITY INVOKER LANGUAGE JAVASCRIPT
COMMENT '
Description
-----------
ShannonBase Agent contract self-checks.

Parameters
-----------
kind   VARCHAR  tools | memory
op     VARCHAR  memory only: seed | verify | load | isolation | recall_facts |
                redact | compact | budget | rank | conflict | recover |
                expire | forget | cleanup
                The memory kind writes to mysql.agent_*, so it is opt-in:
                SET @shannon_agent_selfcheck_allow_writes = 1 first.
label  VARCHAR  memory only: scopes the operation to one test conversation.

Returns
-----------
A (k, v) result set. For kind=''tools'' a single row (''result'', ''OK'') means
every tool contract still holds.

Example
-----------
CALL sys.shannon_agent_selfcheck(''tools'', NULL, NULL);
CALL sys.shannon_agent_selfcheck(''memory'', ''seed'', ''t1'');
'
AS $$
  //@include lib_selfcheck.js
  sys.send_result_set({columns: ["k", "v"],
                       rows: shannon_agent_selfcheck(kind, op, label)});
$$;

DELIMITER ;

DROP FUNCTION IF EXISTS sys.shannon_agent_loopcheck;
DROP PROCEDURE IF EXISTS sys.shannon_agent_loopcheck;

CREATE DEFINER='mysql.sys'@'localhost' PROCEDURE sys.shannon_agent_loopcheck(
  IN casename VARCHAR(64)
) SQL SECURITY INVOKER LANGUAGE JAVASCRIPT
COMMENT '
Description
-----------
ShannonBase Agent loop self-checks, driven by a scripted model.

Parameters
-----------
casename VARCHAR  one loop case, or NULL to run every case.

Returns
-----------
A (k, v) result set: one (''result'', <problem>) row per disagreement, or a
single (''result'', ''OK'') when the case behaved as specified.

Example
-----------
CALL sys.shannon_agent_loopcheck(''finish_clean'');
'
AS $$
  //@include lib_agent_eval.js
  var loop_problems = shannon_loop_selfcheck(casename);
  var loop_rows = [];
  for (var li = 0; li < loop_problems.length; li++)
    loop_rows.push(['result', String(loop_problems[li])]);
  sys.send_result_set({columns: ["k", "v"], rows: loop_rows});
$$;

DELIMITER ;
