-- agent/js/*.js by run_genagentjsfile.cmake. Edit the .js files instead.

DROP FUNCTION IF EXISTS shannon_agent_default;

CREATE DEFINER='mysql.sys'@'localhost' FUNCTION shannon_agent_default(
    user_message     TEXT,
    conversation_id  VARCHAR(64)
) RETURNS LONGTEXT CHARACTER SET utf8mb4 SQL SECURITY INVOKER LANGUAGE JAVASCRIPT
AS $$

__AGENT_BODY__

return shannon_agent_run(user_message, conversation_id);

$$;

DELIMITER ;

-- sys.shannon_agent_selfcheck - contract self-checks for the agent.
--
-- kind='tools'  : asserts that the tool registry, the JSON-Schema validation
--                 it drives, the approval metadata derived from it, and the
--                 Prompt catalogue rendered from it all still agree. Returns
--                 one row 'OK' when they do, one row per problem when not.
--                 Reads no user data.
-- kind='memory' : drives the layered-memory primitives directly. They are
--                 otherwise reachable only through sys.shannon_chat(), which
--                 needs a live LLM, so none of the ordering / atomicity /
--                 dedup / redaction / retention / isolation behaviour could
--                 be tested without a model. Every operation stays inside the
--                 calling principal's own scope: there is no argument that
--                 can point it at another principal's memory.
--
-- mysql-test/t/shannon_agent_tool_contract.test and
-- mysql-test/t/shannon_agent_memory.test assert on this output.
DROP FUNCTION IF EXISTS sys.shannon_agent_selfcheck;
DROP PROCEDURE IF EXISTS sys.shannon_agent_selfcheck;

CREATE DEFINER='mysql.sys'@'localhost' PROCEDURE sys.shannon_agent_selfcheck(
  IN kind  VARCHAR(16),
  IN op    VARCHAR(32),
  IN label VARCHAR(64)
) SQL SECURITY INVOKER LANGUAGE JAVASCRIPT
COMMENT '
Description
-----------
ShannonBase Agent contract self-checks.

Parameters
-----------
kind   VARCHAR  tools | memory
op     VARCHAR  memory only: seed | verify | load | isolation | recall_facts |
                redact | compact | budget | rank | conflict | recover |
                expire | forget | cleanup
                The memory kind writes to mysql.agent_*, so it is opt-in:
                SET @shannon_agent_selfcheck_allow_writes = 1 first.
label  VARCHAR  memory only: scopes the operation to one test conversation.

Returns
-----------
A (k, v) result set. For kind=''tools'' a single row (''result'', ''OK'') means
every tool contract still holds.

Example
-----------
CALL sys.shannon_agent_selfcheck(''tools'', NULL, NULL);
CALL sys.shannon_agent_selfcheck(''memory'', ''seed'', ''t1'');
'
AS $$
  //@include lib_selfcheck.js
  sys.send_result_set({columns: ["k", "v"],
                       rows: shannon_agent_selfcheck(kind, op, label)});
$$;

DELIMITER ;

-- sys.shannon_chat - dispatcher / plugin resolution
DROP FUNCTION IF EXISTS sys.shannon_chat;
DROP PROCEDURE IF EXISTS sys.shannon_chat;

CREATE DEFINER='mysql.sys'@'localhost' PROCEDURE sys.shannon_chat(
  IN user_message TEXT
) SQL SECURITY INVOKER LANGUAGE JAVASCRIPT
COMMENT '
Description
-----------
ShannonBase Agent - intelligent SQL assistant embedded in ShannonBase.
Accepts a natural-language message and a conversation UUID; returns a
text answer.

Parameters
-----------
user_message    TEXT         Natural-language question or instruction.

Session configuration  (@chat_options JSON)
-----------
Set @chat_options before calling to customise behaviour.
All keys are optional; defaults are shown in parentheses.

Model settings:
  model_options.provider           VARCHAR   Remote LLM provider override
                                    (deepseek|dashscope|anthropic|qianfan).
  model_options.endpoint           VARCHAR   Custom API endpoint
  model_options.model_id           VARCHAR   LLM model ("Qwen3.5-2B-ONNX")
  model_options.api_key            VARCHAR   API key for remote provider
  model_options.temperature        FLOAT     Sampling temperature (0.25)
  model_options.max_tokens         INT       Max generation tokens (1200)
  model_options.top_p              FLOAT     Top-p sampling (0.95)
  model_options.repeat_penalty     FLOAT     Repeat penalty (1.1)
  model_options.frequency_penalty  FLOAT     Frequency penalty (0.0)
  model_options.presence_penalty   FLOAT     Presence penalty (0.0)
  model_options.deepseek_thinking  BOOL      Enable DeepSeek thinking mode
  model_options.reasoning_effort   VARCHAR   low|medium|high
  model_options.language           VARCHAR   Force output language (zh|en)
  model_options.timeout_ms         INT       Remote call timeout
  model_options.workspace_id       VARCHAR   Provider workspace/project id
  model_options.region             VARCHAR   Provider region
  model_options.api_config         JSON      Raw provider-specific passthrough

RAG settings (rag_options) — controls which knowledge base ML_RAG searches:
  rag_options.vector_store          JSON ARR  ["schema.table", ...]
  rag_options.schema                JSON ARR  Restrict auto-discovery
  rag_options.document_name         JSON ARR  Restrict to specific documents
  rag_options.exclude_vector_store  JSON ARR
  rag_options.exclude_document_name JSON ARR
  rag_options.vector_store_columns  JSON OBJ  Column name overrides
  rag_options.n_citations            INT       Citations retrieved (6)
  rag_options.distance_metric        VARCHAR   COSINE|DOT|EUCLIDEAN|L2|MANHATTAN|L1
  rag_options.embed_model_id         VARCHAR   Embedding model
  rag_options.retrieval_options      JSON OBJ  {max_distance, percentage_distance, segment_overlap}
  rag_options.skip_generate          BOOL      1=retrieve only (default)

  NOTE (legacy): if rag_options is omitted, falls back to top-level
  retrieve_top_k / retrieval_options / embed_model_id / tables for
  backward compatibility with older @chat_options configs.

Budget / quality:
  plan_log_max_tokens INT   Max chars of query results passed to LLM (4000)
  summary_max_tokens  INT   Max tokens for summary LLM calls (2000)

History and memory:
  conversation_id     VARCHAR  UUID for the conversation session. Omit to
                               auto-continue the last conversation on this
                               connection; set to "new" to force a fresh session.
  history_length      INT   Legacy alias for
                            memory_options.short_term.recent_turns (5)
  schema_name         VARCHAR  Restrict schema-metadata lookups (DDL only)

  memory_options      JSON  Layered memory configuration. All keys optional:
    enabled                              BOOL  Master switch (true)
    short_term.recent_turns              INT   Recent turns considered (5)
    short_term.max_tokens                INT   Token budget for those turns (1500)
    short_term.summarize_after_turns     INT   Fold older turns into a rolling
                                               summary past this many (8)
    short_term.summary_max_tokens        INT   Summary size cap (600)
    short_term.keep_recent_after_compact INT   Turns always kept verbatim (3)
    long_term.episodic_enabled           BOOL  Vector recall over past turns (true)
    long_term.episodic_top_k             INT   (3)
    long_term.episodic_max_distance      FLOAT (0.6)
    long_term.semantic_enabled           BOOL  Vector recall over remembered
                                               facts (true)
    long_term.semantic_top_k             INT   (3)
    long_term.default_ttl_days           INT   expires_at for new rows; 0 = never (90)
    long_term.skip_embed_routes          ARRAY Route prefixes stored but not
                                               embedded (["review"])
    procedural.few_shot_top_k            INT   Few-shot SQL examples (3)
    redact.patterns                      ARRAY Regexes masked before anything is
                                               persisted or embedded
    retention.enabled / retention.purge_batch  Batched expiry cleanup (true / 500)
    retention.max_facts_per_principal    INT   Long-term fact cap per principal;
                                               stalest evicted first (2000)
    vector_index                         VARCHAR Always ''scan'' today: a linear
                                               DISTANCE(), which is what
                                               upstream MySQL provides

  All long-term recall is isolated to the calling SQL principal
  (SHA2(CURRENT_USER(),256) truncated to 16 hex). The isolation filter is
  injected by the agent and cannot be overridden through @chat_options.

  Set by the agent (read-only for callers):
  memory_degraded     BOOL  A memory read or write failed -- typically the
                            caller has no grants on mysql.agent_*. See
                            mysql.agent_memory_audit for the reason.

Example
-----------
SET @chat_options = JSON_OBJECT("conversation_id", UUID());
CALL sys.shannon_chat("当前库有哪些表？");

SET @chat_options = JSON_MERGE_PATCH(@chat_options, JSON_OBJECT(
  "model_options", JSON_OBJECT("temperature", 0.5)
));
CALL sys.shannon_chat("后续问题");

SET @chat_options = JSON_MERGE_PATCH(@chat_options, JSON_OBJECT(
  "conversation_id", "new"
));
CALL sys.shannon_chat("换个话题的新问题");
'
AS $$
  //@include lib_dispatcher.js
  var resolved_id = resolve_conversation_id();
  sys.exec_sql("SET @_shannon_last_conv_id = '" + esc(resolved_id) + "'");
  /* Pin the resolved id back into @chat_options.  Without this a literal
     conversation_id:"new" is never consumed: it stays in @chat_options and
     every later CALL keeps minting a brand-new conversation, so history and
     agent memory can never accumulate after the first "new". */
  query("SET @chat_options = JSON_SET(COALESCE(@chat_options, JSON_OBJECT())," +
        " '$.conversation_id', '" + esc(resolved_id) + "')");
  var __answer = dispatcher(user_message, resolved_id);
  sys.send_result_set({columns: ["response"], rows: [[__answer]]});
$$;

DELIMITER ;
